
@{
    ViewBag.Title = "DieMoldMasterlist";
    Layout = "~/Areas/MoldDie/Views/Shared/_MainLayout.cshtml";
}

<section>
    <div class="Mold_ToolHeader flex_space mb-4">

        <div class="flex_align">
            <div class="control-group">
                <label class="control-label">
                    <i class="fas fa-calendar"></i>  Search here
                </label>
                <div class="search-box">
                    <input type="text" placeholder="Search here ... " id="RegisterSearch" />
                </div>
            </div>

            

        </div>
        <button class="btn-primary-custom" id="addbtn"><i class="fa-solid fa-plus"></i> Add Data</button>
    </div>



    <div class="TrackTable" id="DieWrapper">
        <table>
            <thead>
                <tr>
                    <th>PartNo. </th>
                    <th>PartDescription</th>
                    <th id="MonthHeader">Dimension Quality</th>
                    <th>Die Serial</th>
                    <th>Die Number</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="DieMoldToolist">
            </tbody>
        </table>
    </div>


</section>
<div class="pagination" id="pagination">

    <div class="pagination-items">
    </div>
</div>

@Html.Partial("_MasterlistModelForms")


<script type="module" asp-append-version="true">
     import {
         getMethod,
         postMethod
     } from '@Url.Content("~/Scripts/modules/index.js")';

    class DieMoldMasterController {
        constructor() {
            this.tbody = document.querySelector('.TrackTable tbody');

            this.SearchInput = document.getElementById("RegisterSearch");

            this.moldform = document.getElementById("addnewform");

            // Modal
            this.addToolingModal = new bootstrap.Modal(document.getElementById('AddTooling'));

            this.searchChange = document.getElementById("RegisterSearch");


            this.moldIDText = document.getElementById("MoldID");
            this.partNoText = document.getElementById("PartNo");
            this.partDescript = document.getElementById("PartDescription");
            this.dimension = document.getElementById("Dimension_Quality");
            this.DieSerialText = document.getElementById("DieSerial");
            this.dieNumber = document.getElementById("DieNumber");
            this.processID = document.getElementById("ProcessID");
            this.Cavity = document.getElementById("Cavity");

            this.formTitle = document.getElementById("formtitle");
            this.submitBtn = document.getElementById("btnSave");
            this.openAddmodal = document.getElementById("addbtn");
        }

        async init() {
            await this.GetMoldDieMasterlist();

            this.bindTableEvents();
            this.bindOpenDialog();
            this.bindFormEvents()
            this.bindfilterEvents();
        }


        /* =========================================================
             GET MASTERLIST
        ========================================================= */
        async GetMoldDieMasterlist() {
            try {
                const res = await getMethod('@Url.Action("GetMoldDieMasterList", "Mold")',
                    {
                        search: this.searchChange.value,
                        page: 1,
                        pageSize: 50
                    });

                if (!res?.Success) {
                    console.log('No data Masterlist Found ');
                    return;
                }
                this.renderTable(res.Data);
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }

        renderTable(data) {
                if (!this.tbody) return;

                //this.recordCount.textContent = `${data.length} ${data.length === 1 ? 'entry' : 'entries'}`;

                if (data.length === 0) {
                    this.tbody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align:center; padding:32px; color:#86868b;">
                                No data available.
                            </td>
                        </tr>`;
                    return;
                }

                this.tbody.innerHTML = data.map(row => {

                return `
                   <tr class='fade-in'
                        data-MoldID="${row.MoldID}"
                        data-partno="${row.PartNo}"
                        data-descript="${row.PartDescription ?? ''}"
                        data-dimension="${row.Dimension_Quality ?? ''}"
                        data-dieSerial="${row.DieSerial ?? ''}"
                        data-dienum="${row.DieNumber ?? ''}"
                        data-process="${row.ProcessID ?? ''}"
                        data-cavity="${row.Cavity ?? ''}"
                   >
                            <td style='font-weight: 600;'>${row.PartNo}</td>
                              <td>${row.PartDescription}</td>
                              <td>${row.Dimension_Quality}</td>
                              <td>${row.DieSerial}</td>
                              <td>${row.DieNumber}</td>
                              <td>
                                <button type="button" class="btn-icon btn-edit" title="Edit">
                                   <i class='fa-regular fa-pen-to-square action_btn'></i>
                                </button>

                                <button type="button" class="btn-icon btn-delete" title="Delete">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                             </td>
                    </tr>`;

                }).join('');

        }

        bindOpenDialog() {


            this.openAddmodal.addEventListener('click', (e) => {
                e.preventDefault();

                this.ResetForms();
                this.formTitle.textContent = 'Add Record';
                this.submitBtn.innerHTML = '<i class="fas fa-check"></i> Save Record';
                this.addToolingModal.show();
            });
        }

        bindFormEvents() {
            this.moldform.addEventListener('submit', (e) => this.handleSubmit(e));
        }

        async handleSubmit(e) {
            e.preventDefault();

             const moldid = parseInt(this.moldIDText.value, 10);
             const payload = {
                 MoldID: moldid > 0 ? moldid : 0,
                 PartNo: this.partNoText.value.trim(),
                 PartDescription: this.partDescript.value.trim(),
                 Dimension_Quality: this.dimension.value,
                 DieSerial: this.DieSerialText.value,
                 DieNumber: parseInt(this.dieNumber.value, 10),
                 ProcessID: this.processID.value
            };

            console.log(payload);

            //this.submitBtn.disabled = true;
             try {
                 const res = await postMethod('@Url.Action("SaveMoldieMasterlist", "Mold")', payload);

                 console.log(res);
                 if (!res?.Success) {
                     //this.showToast(res?.Message || 'Save failed.', true);
                     return;
                 }

                 //this.showToast(payload.NCRID > 0 ? 'Record updated.' : 'Record added.');
                 this.ResetForms();
                 await this.GetMoldDieMasterlist();
                 this.addToolingModal.hide();
             } catch (error) {
                 console.log('Error saving record:', error);
                 //this.showToast('Save failed.', true);
             } finally {
                 //this.submitBtn.disabled = false;
             }
        }

        bindTableEvents() {
            this.tbody.addEventListener('click', (e) => {
                const editBtn = e.target.closest('.btn-edit');
                const deleteBtn = e.target.closest('.btn-delete');

                if (editBtn) {
                    const row = editBtn.closest('tr');
                    this.populateFormForEdit(row);
                } else if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    this.openDeleteModal(row.dataset.ncrId);
                }
            });
        }

        populateFormForEdit(row) {
            console.log(row.dataset.moldid);
            this.moldIDText.value = parseInt(row.dataset.moldid);
            this.partNoText.value = row.dataset.partno;
            this.partDescript.value = row.dataset.descript;
            this.dimension.value = row.dataset.dimension;
            this.DieSerialText.value = row.dataset.dieserial;
            this.dieNumber.value = parseInt(row.dataset.dienum);
            this.processID.value = row.dataset.process;
            this.Cavity.value = row.dataset.cavity;

            this.addToolingModal.show();
            this.formTitle.textContent = 'Edit Record';
            this.submitBtn.innerHTML = '<i class="fas fa-check"></i> Update Record';
            //this.cancelBtn.style.display = '';

            //document.getElementById('formCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        ResetForms() {
            this.moldIDText.value = "";
            this.partNoText.value ="";
            this.partDescript.value = "";
            this.dimension.value = "";
            this.DieSerialText.value = "";
            this.dieNumber.value = "";
            this.processID.value = "";
        }

        bindfilterEvents() {
            this.searchChange.addEventListener('input', async () => {
                await this.GetMoldDieMasterlist();
            });
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const controller = new DieMoldMasterController();
        controller.init();
    });
</script>