
@{
    ViewBag.Title = "DieMoldMasterlist";
    Layout = "~/Areas/MoldDie/Views/Shared/_MainLayout.cshtml";
}

<section>
    <div class="Mold_ToolHeader flex_space mb-4">

        <div class="flex_align">
            <div class="control-group">
                <label class="control-label">
                    <i class="fas fa-calendar"></i>  Search here
                </label>
                <div class="search-box">
                    <input type="text" placeholder="Search here ... " id="RegisterSearch" />
                </div>
            </div>

            <div class="control-group">
                <label class="control-label">
                    <i class="fas fa-tags"></i> Filter by Description
                </label>
                <select id="DescriptionID" class="filter-select">
                    <option value="">-- Select Description --</option>
                </select>
            </div>

        </div>
        <button class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#AddTooling"><i class="fa-solid fa-plus"></i> Add Data</button>
    </div>



    <div class="TrackTable" id="DieWrapper">
        <table>
            <thead>
                <tr>
                    <th>PartNo. </th>
                    <th>PartDescription</th>
                    <th id="MonthHeader">Dimension Quality</th>
                    <th>Die Serial</th>
                    <th>Die Number</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="DieMoldToolist">
            </tbody>
        </table>
    </div>


</section>
<div class="pagination" id="pagination">

    <div class="pagination-items">
    </div>
</div>

@Html.Partial("_MasterlistModelForms")


<script type="module" asp-append-version="true">
     import {
         getMethod,
         postMethod
     } from '@Url.Content("~/Scripts/modules/index.js")';

    class DieMoldMasterController {
        constructor() {
            this.tbody = document.querySelector('.TrackTable tbody');

            this.SearchInput = document.getElementById("RegisterSearch");

        }

        async init() {
            await this.GetMoldDieMasterlist();

            this.bindTableEvents();
        }


        /* =========================================================
             GET MASTERLIST 
        ========================================================= */
        async GetMoldDieMasterlist() {
            try {
                const res = await getMethod('@Url.Action("GetMoldDieMasterList", "Mold")',
                    {
                        search: '',
                        page: 1,
                        pageSize: 50
                    });

                console.log(res);
                //if (!res?.Success) {
                //    console.log('No data Masterlist Found ');
                //    return;
                //}
                //this.renderTable(res.data);
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }

        renderTable(data) {
                if (!this.tbody) return;

                //this.recordCount.textContent = `${data.length} ${data.length === 1 ? 'entry' : 'entries'}`;

                if (data.length === 0) {
                    this.tbody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align:center; padding:32px; color:#86868b;">
                                No data available.
                            </td>
                        </tr>`;
                    return;
                }

                this.tbody.innerHTML = data.map(row => {

                return `
                   <tr class='fade-in'
                        data-partno="${row.PartNo}"
                        data-descript="${row.PartDescription ?? ''}"
                        data-dimension="${row.Dimension_Quality ?? ''}"
                        data-dieSerial="${row.DieSerial ?? ''}"
                        data-dienum="${row.DieNumber ?? ''}"
                   >
                            <td style='font-weight: 600;'>${row.PartNo}</td>
                              <td>${row.PartDescription}</td>
                              <td>${row.Dimension_Quality}</td>
                              <td>${row.DieSerial}</td>
                              <td>${row.DieNumber}</td>
                              <td>
                                <button type="button" class="btn-icon btn-edit" title="Edit">
                                   <i class='fa-regular fa-pen-to-square action_btn'></i>
                                </button>

                                <button type="button" class="btn-icon btn-delete" title="Delete">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                             </td>
                    </tr>`;

                }).join('');

        }

        bindTableEvents() {
            this.tbody.addEventListener('click', (e) => {
                const editBtn = e.target.closest('.btn-edit');
                const deleteBtn = e.target.closest('.btn-delete');

                if (editBtn) {
                    const row = editBtn.closest('tr');
                    this.populateFormForEdit(row);
                } else if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    this.openDeleteModal(row.dataset.ncrId);
                }
            });
        }

        populateFormForEdit(row) {

            //this.editIndexInput.value = row.dataset.ncrId;
            //this.regNoInput.value = row.dataset.regNo;
            //this.modelInput.value = row.dataset.model;
            //this.processSelect.value = row.dataset.processId;
            //this.fourMSelect.value = row.dataset.fourmId;
            //this.ncrTypeSelect.value = row.dataset.ncrType;
            //this.lineSelect.value = row.dataset.line;
            //this.GroupID.value = row.dataset.group;

            //this.formTitle.textContent = 'Edit Record';
            //this.submitBtn.innerHTML = '<i class="fas fa-check"></i> Update Record';
            //this.cancelBtn.style.display = '';

            //document.getElementById('formCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

    }

    document.addEventListener('DOMContentLoaded', function () {
        const controller = new DieMoldMasterController();
        controller.init();
    });
</script>