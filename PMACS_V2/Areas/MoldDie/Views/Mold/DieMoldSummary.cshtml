
@{
    ViewBag.Title = "DieMoldSummary";
    Layout = "~/Areas/MoldDie/Views/Shared/_MainLayout.cshtml";
}

<section>
    <header class="DashHeader">
        <div>
            <span id="ChangeTitle">Overview / Summary</span>
        </div>

        <div class="flex_align" style="display: flex; align-items: center; gap: 10px;">
            <div class="select-container">
                <select id="yearselect"></select>
            </div>

            <div class="select-container">
                <select id="monthSelect"></select>
            </div>

            <div class="select-container">
                <select id="ProcessID">
                    <option value="M002">Mold  Frame</option>
                    <option value="M001">ACM</option>
                    <option value="M003">Mold Impeller</option>
                    <option value="M004">Slot Insulator </option>
                    <option value="M005">Stepping Motor</option>
                </select>
            </div>

            <div class="DashAction flex_align">
                <button type="button" id="changeSummary" class="active"><i class="fa-solid fa-chart-line"></i></button>
                <button type="button" id="changeMonth"> <i class="fa-regular fa-calendar-days"></i></button>
            </div>
        </div>
    </header>


    <div class="SummaryMainDisplay" id="OverallDisplay">
        <div class="MoldiefooterContainer flex_space" id="Summaryfooter">
            <div class="flex_align">
                <div class="searchinputContainer">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search here ... " id="searchbox" />
                    <div class="line"></div>
                </div>

                <div class="flex_align">
                    <div class="statusbox dieMax"></div>
                    <small>Max Die life - </small>
                    <strong id="maxcount">0</strong>
                    <div class="statusbox dieMonitor"></div>
                    <small>For Monitoring -</small>
                    <strong id="Monicount">0</strong>
                    <div class="statusbox dieEnd"></div>
                    <small>End of life - </small>
                    <strong id="Endcount">0</strong>
                </div>
            </div>



            <div id="SummaryPaginationContainer" class="paginationPartlocal"></div>
        </div>


        <div class="DieMainTable" id="DieWrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width: 10%; text-align: left; padding-left: 1.5em;">Part No </th>
                        <th>Dimension/ Quality</th>
                        <th style="width: 10%;">Die number</th>
                        <th style="width: 10%;">Die Serial No.</th>
                        <th>2011-2015</th>
                        <th>Shot Count </th>
                        <th>Status</th>
                        @*<th>Renarks</th>*@
                    </tr>
                </thead>
                <tbody id="SummarylistData">
                </tbody>
            </table>
        </div>



    </div>

    <div id="MonthlyDisplay" style="display: none;">

        <div class="DieMainTable" id="DieWrapper">
            <table>
                <thead>
                    <tr>
                        <th style="text-align: left !important; padding-left: 1.5em;">Part Number </th>
                        @*<th>Part Description </th>*@
                        <th>Dimension/ Quality </th>
                        <th>No. of Cavity</th>
                        <th>Die Serial</th>
                        <th id="MonthHeader">Jan-16</th>
                        <th>TotalQty</th>
                    </tr>
                </thead>
                <tbody id="DieMoldMonthly">
                </tbody>
            </table>

            <div class="MoldiefooterContainer" id="Monitorfooter">
                <span>Showing  <span id="MonitorpagecountID">-</span> to <span id="MonitortotalpageID">-</span> of  <span id="MonitorDatalengthID">-</span> Entries</span>

                <div id="PaginationContainer" class="paginationPartlocal"></div>
            </div>

        </div>

    </div>
</section>





<script type="module" asp-append-version="true">
     import {
         getMethod,
         postMethod
     } from '@Url.Content("~/Scripts/modules/index.js")';

     class DieMoldSummaryController {
         constructor() {
             this.tbody = $("#SummarylistData");
             this.MonthDisplay = $("#DieMoldMonthly");
             this.yearSelect = $("#yearselect");

             // Filter Selection
             this.filtermonth = document.getElementById("monthSelect");
             this.filteryear = document.getElementById("ProcessID");
         }

         async init() {
             await this.GetMoldDieSummaryData();
         }

         async GetMoldDieSummaryData() {
              try {
                  const res = await getMethod('@Url.Action("GetMoldDieSummaryList", "Mold")', {
                      Months: 0,
                      Year: 0,
                      ProcessID: this.filteryear.value
                  });

                   console.log(res);
                   if (!res?.Success) {
                       console.log('No data Registration Found ');
                       return;
                   }

                  this.DisplayTotalCountMoldie(res.Data.MoldDieSummary);
                  this.renderTable(res.Data.FinalSummary);
               } catch (error) {
                   console.error('Error fetching 4M data:', error);
               }
         }

         DisplayTotalCountMoldie(Countdata) {
             if (!Array.isArray(Countdata)) return;

             const moni = document.getElementById("Monicount");
             const end = document.getElementById("Endcount");
             const max = document.getElementById("maxcount");

             // Default values
             moni.innerText = "0";
             end.innerText = "0";
             max.innerText = "0";


             Countdata.forEach(row => {
                 switch (row.Category) {
                     case "For Monitoring":
                         moni.innerText = row.MoldDie;
                         break;

                     case "End of life":
                         end.innerText = row.MoldDie;
                         break;

                     case "Max Die life":
                         max.innerText = row.MoldDie;
                         break;
                 }
             });
         }

         renderTable(data) {
             if (!Array.isArray(data)) return;

             this.tbody.innerHTML = "";

             // Group by DieSerial
             const groups = new Map();

             data.forEach(row => {
                 if (!groups.has(row.DieSerial)) {
                     groups.set(row.DieSerial, []);
                 }
                 groups.get(row.DieSerial).push(row);
             });


             // Render rows
             groups.forEach(groupRows => {
                 const first = groupRows[0];
                 const percentage = Number(first.Status) || 0;

                 groupRows.forEach((row, index) => {
                     console.log(first.Dimension_Quality);
                     
                 });
             });

         }
     }



    document.addEventListener('DOMContentLoaded', function () {
        const controller = new DieMoldSummaryController();
        controller.init();
    });
</script>