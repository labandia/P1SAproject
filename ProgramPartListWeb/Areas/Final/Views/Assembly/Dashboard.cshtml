                        <p class="card-row-value" style='font-size: 1.5rem;'>${item.Model || '-'}</p>
                    </div>

            <div class="card-row" style=' margin: 1em 0;'>
                <p class="card-row-label" style="margin-bottom:8px; font-size: 1.1rem;">
                    Material Status : <span class="card-row-label" style='font-size: 1.1rem;'>${completionPct}%</span>
                </p>
                <div class="badge-row">${badges}</div>
            </div>
                  ${showNext ? `
             <div class="card-row" style=' margin: 1em 0;'>
                 <p class="card-row-label" style="font-size: 1.1rem;">Next Process Model</p>
                 <p class="card-row-value-normal next-model-text" style="font-size: 1.5rem; min-height: 1.8rem;"></p>
             </div>` : `<div class="card-row" style=' margin: 1em 0;'>
