        /* ================= LOAD DATA ================= */
        async LoadActiveShopOrders() {
            // console.log("Load Java" + selected);
            if (this.isAnimating) return;

            try {
                const res = await getMethod('@Url.Action("GetListActiveShopOrders", "Assembly")', { });

                if (!res?.Success) {
                    if (!this.isExpanded) this.RenderEmptyState();
                    return;                                   // network/server error: don't close anything
                }

                const apiData = res.data ?? [];
                const lookup = new Map(apiData.map(item => [item.Line, item]));
                const records = this.assemblyRecords.map(r => ({
                    Line: r.Line,
                    FinalShopOrder: "",
                    Model: "",
                    CompletedSection: "",
                    NextItem: "",
                    Note: "",
                    OrderRemarks: "",
                    RecordID: null,
                    PlanQty: 0,
                    InputQty: 0,
                    ...(lookup.get(r.Line) ?? {})
                }));
                this.allCardsData = records;

                if (this.isExpanded && this.currentCenteredCard && this.activeLineId) {

                    if (this.activeIsOven) {
                        const ovenItems = await this.fetchOvenItems(this.activeLineId);
                        const updatedRecord = records.find(r => r.Line === this.activeLineId);
                        const hasMain = !!(updatedRecord?.FinalShopOrder ?? '').trim();

                        // close only when BOTH the oven items and the normal order are gone
                        if (ovenItems.length === 0 && !hasMain) { await this.resetToGrid(); return; }

                        if (hasMain) this.prevModelprocess = updatedRecord.NextItem;

                        this.renderOvenCards(ovenItems, this.activeLineId, {
                            mainItem: hasMain ? updatedRecord : null
                        });
                        return;
                    }

                    const updatedRecord = records.find(r => r.Line === this.activeLineId);

                    // Line no longer has an active order (e.g. just cancelled) -> close the card
                    if (!updatedRecord || !(updatedRecord.FinalShopOrder ?? '').trim()) {
                        await this.resetToGrid();
                        return;
                    }

                    this.prevModelprocess = updatedRecord.NextItem;
                    this.updateModalContent(updatedRecord, { animateNextModel: true });

                } else if (!this.isExpanded) {
                    apiData.length === 0 ? this.RenderEmptyState() : this.RenderCardList(records);
                }
            } catch (err) {
                console.error(err);
            }
        }


        /* ========== TYPING ANIMATION ========== */
        async typeText(element, text, speed = 10, loop = false) {
            if (this._typingAbort) {
                this._typingAbort();
                this._typingAbort = null;
            }

            if (!element) return;

            const displayText = text || "-";
            if (displayText === "-" || displayText.length <= 1) {
                element.textContent = displayText;
                element.classList.remove('typing-cursor');
                element.classList.add('typing-done');
                return;
            }

            let cancelled = false;
            const abort = () => { cancelled = true; };
            this._typingAbort = abort;

            const runTyping = async () => {
                if (cancelled) return;
                element.textContent = "";
                element.classList.add('typing-cursor');
                element.classList.remove('typing-done');

                const chars = displayText.split("");
                for (let i = 0; i < chars.length; i++) {
                    if (cancelled) {
                        element.textContent = displayText;
                        element.classList.remove('typing-cursor');
                        element.classList.add('typing-done');
                        return;
                    }
                    element.textContent += chars[i];
                    let delay = speed;
                    if (chars[i] === "." || chars[i] === "," || chars[i] === "!" || chars[i] === "?") {
                        delay = speed * 2.5;
                    } else if (chars[i] === " ") {
                        delay = speed * 0.6;
                    }
                    await new Promise(r => setTimeout(r, delay));
                }

                // finished typing
                element.classList.remove('typing-cursor');
                element.classList.add('typing-done');

                // loop if requested and not cancelled
                if (loop && !cancelled) {
                    await new Promise(r => setTimeout(r, 2000)); // pause before restart
                    if (!cancelled) {
                        runTyping(); // restart
                    }
                }
            };

            runTyping();
        }




