            // Close button listener
            const closeBtn = root.querySelector('.close-centered-btn');
            if (closeBtn) closeBtn.addEventListener('click', () => this.resetToGrid());

            // Quantity
            const qtyInput = root.querySelector('.completed-qty');
            if (qtyInput) {
                const updateQty = async (value) => {
                    const newQty = parseInt(value || 0);
                    if (!newQty || newQty === item.InputQty) return;

                    if (newQty > item.PlanQty) {
                        qtyInput.value = item.InputQty;
                        return;
                    }
                    try {
                        await postMethod('@Url.Action("UpdateQuantityLine", "Assembly")', {
                            recordID: item.RecordID,
                            Qty: newQty
                        });
                        await this.LoadActiveShopOrders();
                    } catch (err) {
                        console.error(err);
                    }
                };

                qtyInput.addEventListener('blur', async (e) => { await updateQty(e.target.value); });
                qtyInput.addEventListener('keydown', async (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        qtyInput.blur();
                    }
                });
            }

            // Status select + Complete/Save button (scoped to THIS card)
            const selectionStatus = root.querySelector('.selectionQuantity');
            const completeBtn = root.querySelector('.btn-completed');

            const setBtnLabel = (status) => {
                if (!completeBtn) return;
                completeBtn.innerHTML =
                    `<iconify-icon icon="fluent-mdl2:completed" width="15"></iconify-icon> ${status === 4 ? 'Completed' : 'Save'}`;
            };

            if (selectionStatus) {
                selectionStatus.addEventListener('change', (e) => {
                    e.stopPropagation();
                    const status = parseInt(e.target.value, 10);
                    this.statusByRecord.set(item.RecordID, status);
                    setBtnLabel(status);
                });
            }

            // ============== COMPLETE BUTTON PROCESS ====================
            if (completeBtn) {
                completeBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();

                    const selectedStatus = parseInt(selectionStatus.value, 10);
                    if (selectedStatus === 0) {
                        alert("Please select a Status.");
                        return;
                    }
                    console.log("IS OVEN SELECTED : " + item.IsOven);
                    // 5 / 6 : FSI / Cell Line Completed, 4 : Completed
                    const isCompleted = (selectedStatus === 5 || selectedStatus === 6) ? 0 : 1;

                    const res = await postMethod('@Url.Action("CompleteStatusLine", "Assembly")', {
                        recordID: item.RecordID,
                        line: item.Line,
                        IsStatus: isCompleted,
                        QuanStats: selectedStatus,
                        IsOven: item.IsOven
                    });
                    if (!res?.Success) return;

                    alert("Update Status Successfully");
                    this.statusByRecord.delete(item.RecordID);

                    if (this.activeIsOven) {
                        await this.LoadActiveShopOrders();   // re-renders remaining cards or closes
                        return;
                    }

                    const hasNextProcess = !!(item.NextItem && item.NextItem.trim() !== "");
                    if (!hasNextProcess) await this.resetToGrid();
                    else await this.LoadActiveShopOrders();

                    this.prevModelprocess = "";
                });
            }

            // ============== CANCEL  BUTTON PROCESS ====================
            const cancelbtn = root.querySelector('.btn-cancel');
            if (cancelbtn) {
                cancelbtn.addEventListener('click', async (e) => {
                    e.stopPropagation();

                    // Oven lines: confirmation modal performs the actual cancel
                    if (item.Line === 'L2' || item.Line === 'L6') {
                        this.ovenId = item.RecordID;
                        this.cancelModal.show();
                        return;
                    }

                    cancelbtn.disabled = true;   // prevent double submit
                    try {
                        const res = await postMethod('@Url.Action("cancelProcess", "Assembly")', {
                            recordID: item.RecordID
                        });

                        if (!res?.Success) {
                            alert(res?.Message || "Cancel failed.");
                            cancelbtn.disabled = false;
                            return;
                        }

                        this.statusByRecord.delete(item.RecordID);
                        // Refresh decides whether to show the next record or close the card
                        await this.LoadActiveShopOrders();
                    } catch (err) {
                        console.error(err);
                        alert("Cancel failed. Please try again.");
                        cancelbtn.disabled = false;
                    }
                });
            }

            // Double click -> ShopOrderLine
            root.addEventListener('dblclick', (e) => {
                if (e.target.closest('input, button, select')) return;
                localStorage.setItem("LineSet", item.Line);
                window.location.href = '@Url.Action("ShopOrderLine", "Assembly")?Line=' + encodeURIComponent(item.Line);
            });

            // Next model text
            const nextModelEl = root.querySelector('.next-model-text');
            if (nextModelEl) {
                if (animateNextModel) {
                    this.typeText(nextModelEl, item.NextItem || '-', 50);
                } else {
                    nextModelEl.textContent = item.NextItem || '-';
                    nextModelEl.classList.remove('typing-cursor');
                    nextModelEl.classList.add('typing-done');
                }
            }
        }

        formatTimeSpan(time) {
        if (!time) return '-';

        const hours = String(time.Hours ?? 0).padStart(2, '0');
        const minutes = String(time.Minutes ?? 0).padStart(2, '0');

        return `${hours}:${minutes}`;
    }


