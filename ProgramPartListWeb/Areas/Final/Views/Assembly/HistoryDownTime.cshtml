<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

  class DownTimeHistoryController {
      constructor() {
          this.tbody = document.querySelector('.upload-table tbody');

          this.inputsearch = document.getElementById('searchinput');
          this.selectLine = document.getElementById('filterdata');
      }

      async init() {
         await this.LoadDownTimeMonitor(); 

         this.bindEvents();

      }

      bindEvents() {
          this.inputsearch.addEventListener('input', (e) => {
              e.preventDefault();
              this.LoadDownTimeMonitor();
          });

          this.selectLine.addEventListener('change', (e) => {
              e.preventDefault();
              this.LoadDownTimeMonitor();
          });
      }

      async LoadDownTimeMonitor() {
          try {

            const res = await getMethod('@Url.Action("GetDownTimeHistoryList", "DownTime")', {
                searchtext: this.inputsearch.value,
                Linename: this.selectLine.value
            });
            console.log(res);
            if (res?.Success) {

                this.renderTable(res.data);
            }


          } catch (error) {
              console.error('Error fetching data:', error);

          }
      }

      renderTable(data) {
          if (!this.tbody) return;
          if (data.length === 0) {
              this.tbody.innerHTML = `
            <tr>
                <td colspan="11" style="text-align:center; padding:32px; color:#86868b;">
                    No data available.
                </td>
            </tr>`;
              return;
          }

          this.tbody.innerHTML = data.map(row => {
              const shift = this.getShift(row.TimeStart);


              return `
          <tr  class='fade-in'  data-order-line="${row.Line}"   >
                    <td>${row.DateStart}</td>
                    <td>${row.Line}</td>
                    <td class='ShopOrderLayout' style='text-align: left;'>
                        <span class='ShopOrderLayout_ShopOrder'>${row.FinalShopOrder}</span>
                        <p style="margin:.2em 0;color:#8a8f9e;">${row.ItemNo}</p>
                         <span
                            class="model-text"
                            title="${row.Model}">
                            ${row.Model}
                        </span>
                    </td>

                    <td>${row.PlanQty}</td>
                    <td>${this.formatTimeSpan(row.TimeStart)} - ${this.formatTimeSpan(row.TimeEnd)}</td>
                     <td><span class="shift-badge shift-${shift.toLowerCase()}">${shift}</span></td>
                    <td>${row.Downtime || ''}</td>
                    <td class="status-column">${row.GroupName || ''}</td>
                    <td>${row.DownTimeCode || '-'}</td>
                    <td>${row.Details || ''}</td>
            </tr>`

          }).join('');
      }

      formatTime(time) {
          if (!time) return '-';

          // Example: "08:30:00"
          if (typeof time === 'string') {
              return time.substring(0, 5);
          }

          return '-';
      }
      formatTimeSpan(time) {
          if (!time) return '-';

          const hours = String(time.Hours ?? 0).padStart(2, '0');
          const minutes = String(time.Minutes ?? 0).padStart(2, '0');

          return `${hours}:${minutes}`;
      }

      // Day shift: 06:30 - 18:29 | Night shift: 18:30 - 06:29 (wraps past midnight)
      getShift(time) {
          if (!time) return '-';

          const hours = time.Hours ?? 0;
          const minutes = time.Minutes ?? 0;
          const totalMinutes = (hours * 60) + minutes;

          const dayStart = (6 * 60) + 30;   // 06:30
          const dayEnd = (18 * 60) + 30;    // 18:30

          return (totalMinutes >= dayStart && totalMinutes < dayEnd) ? 'DS' : 'NS';
      }
}

    document.addEventListener('DOMContentLoaded', function () {
        const controller = new DownTimeHistoryController();
        controller.init();
    });
</script>