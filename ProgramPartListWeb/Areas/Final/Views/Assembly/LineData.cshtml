
@{
    ViewBag.Title = "LineData";
    Layout = "~/Areas/Final/Views/Shared/_ManageLayout.cshtml";
}

<section style="padding: 30px 20px">
    <!-- MAIN PANEL -->
    <!-- header section -->
    <div class="headerManage  flex justify-between items-center mb-6">
        <div class="flex items-center gap-lg-3">
            <div>
                <h2 class="font-semibold mb-1" style="font-size: 24px;">Final Assembly Data</h2>
                <p class="text-sm" style="color:#86868b;">Current Data of the Final Assembly </p>
            </div>
            <div class="subheader-item" style="padding-left: 10px;">
                <iconify-icon icon="lucide:clock" style="font-size: 14px; color: #6c47ff"></iconify-icon>
                <span>Last Upload Date: <strong id="lastUpdateText">-- : -- : -- </strong></span>
            </div>
            <!-- filters bar -->
            <div class="flex items-center gap-3 mb-4 flex-wrap">
            </div>
        </div>
        <div class="flex gap-3">
            <div class="ms-wrapper" id="lineMultiSelect">
                <button type="button" class="filter-chip text-sm font-medium ms-toggle" id="lineMsToggle">
                    <span id="lineMsLabel">Line : ALL</span>
                    <iconify-icon icon="lucide:chevron-down" style="font-size:14px;"></iconify-icon>
                </button>
                <div class="ms-menu" id="lineMsMenu">
                    <label class="ms-item ms-all">
                        <input type="checkbox" id="lineMsAll" checked />
                        <span>ALL</span>
                    </label>
                    <div class="ms-list" id="lineMsList"></div>
                </div>
                <!-- holds the comma-separated selection (e.g. "L1,L5,CL1"); empty = ALL -->
                <input type="hidden" id="filterdata" value="" />
            </div>
            <div class="date-range">
                <input type="date" id="dateFrom" class="filter-chip text-sm" title="Plan Start: from" />
                <span class="date-range-sep">to</span>
                <input type="date" id="dateTo" class="filter-chip text-sm" title="Plan Start: to" />
                <button type="button" id="dateClearBtn" class="filter-chip text-sm" title="Clear dates">
                    <iconify-icon icon="lucide:x" style="font-size:14px;"></iconify-icon>
                </button>
            </div>
            <div class="search-input">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.34-4.34" />
                </svg>
                <input type="text" placeholder="Search here ..." id="searchinput" />
            </div>
        </div>
    </div>
    <div class="devices-table-wrapper">
        <div class="devices-table-wrapper">
            <div class="table-scroll TrackTable">
                <table class="upload-table">
                    <thead>
                        <tr>
                            <th>Line</th>
                            <th>Final Shop Order/ Partno / Model</th>
                            <th>QTY</th>
                            <th>Plan Start</th>
                            <th>Dispatch</th>
                            <th>Shipment Date</th>
                            <th>PCB</th>
                            <th>IMP</th>
                            <th>LW</th>
                            <th>MF</th>
                            <th>FP</th>
                            <th>STR</th>
                            <th>MP</th>
                            <th>WC</th>
                            <th>Note</th>
                            <th>IFS Finish Date</th>
                            <th>FA Status</th>
                            <th>Mode</th>
                            <th>WITH SR</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <!-- pagination footer -->
        <div class="flex justify-between items-center p-3 border-t" style="border-top: 1px solid #e5e5e5; background: white;">
            <div id="resultsText" class="text-sm" style="color:#86868b;">Showing <span id="newrecords"></span> of <span id="currentrecords">1,248</span> Records</div>
        </div>
    </div>
</section>
<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';


    /* ==========================================================
      LineMultiSelect
      - checkbox dropdown for the Line filter
      - writes the selection to the hidden #filterdata ("" = ALL)
      - persists the selection in localStorage and restores it on refresh
      ========================================================== */
    class LineMultiSelect {
        constructor() {
            this.toggle = document.getElementById('lineMsToggle');
            this.menu = document.getElementById('lineMsMenu');
            this.list = document.getElementById('lineMsList');
            this.allCb = document.getElementById('lineMsAll');
            this.label = document.getElementById('lineMsLabel');
            this.hidden = document.getElementById('filterdata');

            this.storageKey = 'FinalAssembly_SelectedLines';

            this.lines = [
                ...Array.from({ length: 20 }, (_, i) => `L${i + 1}`),
                'CL1', 'CL5', 'CL8', 'OP'
            ];
        }

        init() {
            this.list.innerHTML = this.lines.map(l => `
                <label class="ms-item">
                    <input type="checkbox" value="${l}" />
                    <span>${l}</span>
                </label>`).join('');

            // restore the saved selection BEFORE the first data load
            this.restore();

            this.toggle.addEventListener('click', (e) => {
                e.stopPropagation();
                this.menu.classList.toggle('open');
            });

            // keep the menu open when clicking inside it
            this.menu.addEventListener('click', (e) => e.stopPropagation());

            // close when clicking anywhere else
            document.addEventListener('click', () => this.menu.classList.remove('open'));

            // "ALL" checkbox
            this.allCb.addEventListener('change', () => {
                if (this.allCb.checked) {
                    this.itemCheckboxes().forEach(cb => cb.checked = false);
                } else if (this.selected().length === 0) {
                    this.allCb.checked = true; // never leave nothing selected
                }
                this.sync();
            });

            // individual line checkboxes
            this.list.addEventListener('change', () => {
                this.allCb.checked = this.selected().length === 0;
                this.sync();
            });
        }

        itemCheckboxes() {
            return [...this.list.querySelectorAll('input[type="checkbox"]')];
        }

        selected() {
            return this.itemCheckboxes().filter(cb => cb.checked).map(cb => cb.value);
        }

        updateUI() {
            const sel = this.selected();

            this.hidden.value = sel.join(',');   // "" means ALL

            this.label.textContent =
                sel.length === 0 ? 'Line : ALL' :
                    sel.length <= 3 ? `Line : ${sel.join(', ')}` :
                        `Line : ${sel.length} selected`;
        }

        save() {
            try {
                localStorage.setItem(this.storageKey, JSON.stringify(this.selected()));
            } catch (e) {
                console.warn('Unable to save line filter:', e);
            }
        }

        restore() {
            try {
                const saved = JSON.parse(localStorage.getItem(this.storageKey) || '[]');

                // only keep values that still exist in the list
                const valid = Array.isArray(saved)
                    ? saved.filter(v => this.lines.includes(v))
                    : [];

                this.itemCheckboxes().forEach(cb => cb.checked = valid.includes(cb.value));
                this.allCb.checked = valid.length === 0;
            } catch (e) {
                console.warn('Unable to restore line filter:', e);
            }

            // update label + hidden value, but don't fire "change"
            this.updateUI();
        }

        sync() {
            this.updateUI();
            this.save();

            // triggers the debounced LoadLineShopOrderList() in the controller
            this.hidden.dispatchEvent(new Event('change'));
        }
    }





  class FinaAssemblyController {
      constructor() {
        this.requestId = 0;
        this.selectedID = 0;
        this.selectedLine = "";
        this.currentPage = 1;
        this.pageSize = 100;
        this.isFirstLoad = true;

        this.tbody = document.querySelector('.upload-table tbody');
        this.searchinput = document.getElementById('searchinput');
        this.filterStatus = document.getElementById('filterdata');


        this.newRecords = document.getElementById("newrecords");
          this.currentRecords = document.getElementById("currentrecords");

          this.dateFrom = document.getElementById('dateFrom');
          this.dateTo = document.getElementById('dateTo');
          this.dateClearBtn = document.getElementById('dateClearBtn');
          this.dateStorageKey = 'FinalAssembly_DateRange';
    }

      async init() {
        new LineMultiSelect().init();   // restores saved lines before the first load
          this.setDefaultDateRange();      
          this.bindEvents();
        //this.enableHorizontalDragScroll();
        await this.LoadLineShopOrderList();
        await this.LoadTotalPartsSummary();
    }

      bindEvents() {

        // Search + filter debounce
        let debounceTimer;
        const debounced = () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => this.LoadLineShopOrderList(), 300);
        };
        this.searchinput.addEventListener('input', debounced);
          this.filterStatus.addEventListener('change', debounced);


          const onDateChange = (changed) => {
              // keep the range valid: start can't be after end
              if (this.dateFrom.value && this.dateTo.value && this.dateFrom.value > this.dateTo.value) {
                  if (changed === 'from') this.dateTo.value = this.dateFrom.value;
                  else this.dateFrom.value = this.dateTo.value;
              }
              this.saveDateRange();
              debounced();
          };

          this.dateFrom.addEventListener('change', () => onDateChange('from'));
          this.dateTo.addEventListener('change', () => onDateChange('to'));

          this.dateClearBtn.addEventListener('click', () => {
              this.dateFrom.value = '';
              this.dateTo.value = '';
              this.saveDateRange();
              debounced();
          });

          // Double-click table row -> ShopOrderLine
            this.tbody.addEventListener('dblclick', (e) => {

                // Ignore clicks on interactive elements
                if (e.target.closest('input, button, select, a')) return;

                const row = e.target.closest('tr[data-order-line]');

                if (!row) return;

                const line = row.dataset.orderLine;
                const shopOrder = row.dataset.shopOrder;
                const id = parseInt(row.dataset.id);

                const mode = 1;

                // Optional: save values for the next page
                localStorage.setItem("ShopOrder", shopOrder);
                localStorage.setItem("LineSet", line);

                window.location.href =
                    '@Url.Action("ShopOrderLine", "Assembly", new { area = "Final" })'
                    + '?line=' + encodeURIComponent(line)
                    + '&mode=' + encodeURIComponent(mode)
                    + '&shopOrder=' + encodeURIComponent(shopOrder)
                    + '&id=' + encodeURIComponent(id);
            });

      }

      async LoadTotalPartsSummary() {

       try {

           const res = await getMethod('@Url.Action("GetLastUpdateAndTotalPartlyShort", "Assembly")', {
               dispatch: 1
           });

           if (res?.Success) {
               document.getElementById("lastUpdateText").textContent = res.data.LastDate;
           }


       } catch (error) {
           console.error('Error fetching data:', error);

       }
     }


      enableHorizontalDragScroll() {

          const container = document.querySelector(".TrackTable");

          if (!container) return;

          let isDown = false;
          let startX;
          let scrollLeft;

          container.addEventListener("mousedown", (e) => {

              // Ignore buttons, inputs, selects, links
              if (
                  e.target.closest("button") ||
                  e.target.closest("input") ||
                  e.target.closest("select") ||
                  e.target.closest("a")
              ) {
                  return;
              }

              isDown = true;
              startX = e.pageX;
              scrollLeft = container.scrollLeft;

              container.classList.add("dragging");
              container.style.cursor = "grabbing";
          });

          document.addEventListener("mouseup", () => {
              isDown = false;
              container.classList.remove("dragging");
              container.style.cursor = "grab";
          });

          container.addEventListener("mousemove", (e) => {

              if (!isDown) return;

              e.preventDefault();

              const walk = (e.pageX - startX) * 2;

              container.scrollLeft = scrollLeft - walk;
          });

          container.style.cursor = "grab";
      }


      async LoadLineShopOrderList() {

        // each call gets an id; only the latest call is allowed to render
          const requestId = ++this.requestId;

    

        try {
                if (this.isFirstLoad) {
                    this.showTableSkeleton();
                    await new Promise(resolve => requestAnimationFrame(resolve));
                    this.isFirstLoad = false;
                }

                // "L1,L5,CL1" or "" (= ALL), kept in sync by LineMultiSelect
                const selectedLines = document.getElementById('filterdata').value;

               const res = await getMethod('@Url.Action("LineShopOrderData", "Assembly")', {
                    Linename: selectedLines,
                    searchtext: document.getElementById('searchinput').value,
                    dateFrom: this.dateFrom.value,   // "yyyy-MM-dd" or ""
                    dateTo: this.dateTo.value
               });

              
                    // a newer request was started while this one was in flight -> drop this result
                    if (requestId !== this.requestId) return;

                    if (!res?.Success) {
                        this.showMessage('Failed to load data.', 'red');
                        return;
                    }

                    const total = res.data.Total;
                    this.updateRecordCount(total, total);

                    if (total > 0) {
                        this.renderTable(res.data.payload);
                    } else {
                        this.showMessage('No data found for the selected line(s).', '#86868b');
                    }

            } catch (error) {
                console.error('Error fetching data:', error);

                this.tbody.innerHTML = `
                <tr>
                    <td colspan="12" style="text-align:center;color:red;">
                        Failed to load data.
                    </td>
                </tr>`;
            }
    }

    updateRecordCount(filteredCount, totalCount) {
        this.newRecords.textContent = filteredCount.toLocaleString();
        this.currentRecords.textContent = totalCount.toLocaleString();
    }
      renderTable(data) {

        if (!this.tbody) return;
            if (data.length === 0) {
                this.tbody.innerHTML = `
                <tr>
                    <td colspan="12" style="text-align:center; padding:32px; color:#86868b;">
                        No data available.
                    </td>
                </tr>`;
                return;
            }

        this.tbody.innerHTML = data.map(row => {
            let molding = row.Molding
                ? '<span class="sectionbadge badge-molding">AF</span>'
                : '-';

            let press = row.Press
                ? '<span class="sectionbadge badge-press">AG</span>'
                : '-';

            let rotor = row.Rotor
                ? '<span class="sectionbadge badge-rotor">BF</span>'
                : '-';

            let winding = row.Winding
                ? '<span class="sectionbadge badge-winding">FA</span>'
                : '-';

            let circuit = row.Circuit
                ? '<span class="sectionbadge badge-circuit">CE</span>'
                : '-';

            let harness = row.Harness
                ? '<span class="sectionbadge badge-harness">FG</span>'
                : '-';

            let Material = row.Material
                ? '<span class="sectionbadge badge-Material">DD</span>'
                : '-';



            const shipmentDateClass = this.getShipmentDateClass(row.ShipmentDate);


                return `
              <tr  class='fade-in'
                   data-order-line="${row.Line}"
                     data-shop-order="${row.FinalShopOrder}"
                     data-id="${row.RecordID}">
                        <td>${row.Line}</td>
                       <td class="ShopOrderLayout ${shipmentDateClass}" style="text-align: left;">
                            <span class='ShopOrderLayout_ShopOrder'>${row.FinalShopOrder}</span>
                            <p style="margin:.2em 0;color:#8a8f9e;">${row.ItemNo}</p>
                             <span
                                class="model-text"
                                title="${row.Model}">
                                ${row.Model}
                            </span>
                        </td>

                        <td>${row.PlanQty}</td>
                        <td>${this.formatDate(row.PlanStartDate)}</td>
                        <td>${row.DispatchDate}</td>
                        <td>${row.ShipmentDate || '-'}</td>

                        <td>${circuit}</td>
                        <td>${rotor}</td>
                        <td>${harness}</td>
                        <td>${molding}</td>
                        <td>${press}</td>
                        <td>${winding}</td>
                        <td>${Material}</td>
                        <td>${row.WC}</td>

                        <td>${row.Note || ''}</td>
                        <td>${this.formatDate(row.FinalFinishedDate)}</td>
                        <td class="status-column">${row.FAStatus || ''}</td>
                        <td>${row.ShipmentMode || ''}</td>
                        <td>${row.WithSR ? 'With SR': ''}</td>
                </tr>`

            }).join('');
     }

    showTableSkeleton() {
          this.tbody.innerHTML = Array(10).fill(`
        <tr>
            ${Array(18).fill(`
                <td>
                    <div class="skeleton-cell"></div>
                </td>
            `).join('')}
        </tr>
        `).join('');
    }


      showLoader() {
          document.getElementById('loadingOverlay')
              ?.classList.add('show');
      }

      hideLoader() {
          document.getElementById('loadingOverlay')
              ?.classList.remove('show');
      }

      showMessage(text, color) {
          this.tbody.innerHTML = `
        <tr>
            <td colspan="19" style="text-align:center; padding:32px; color:${color};">
                ${text}
            </td>
        </tr>`;
      }

     formatDate(dateString) {
            if (!dateString) return '';

            const timestamp = parseInt(dateString.match(/\d+/)[0]);
            const date = new Date(timestamp);

            return date.toLocaleDateString('en-US');
     }


      getShipmentDateClass(shipmentDate) {
          if (!shipmentDate) return '';

          // Parse the shipment date
          const shipment = new Date(shipmentDate);

          if (isNaN(shipment.getTime())) return '';


          // Normalize dates to local midnight
          const shipmentDay = new Date(
              shipment.getFullYear(),
              shipment.getMonth(),
              shipment.getDate()
          );

          const today = new Date();
          today.setHours(0, 0, 0, 0);

          const tomorrow = new Date(today);
          tomorrow.setDate(tomorrow.getDate() + 1);

          if (shipmentDay.getTime() === today.getTime()) {
              return 'shipment-today';
          }

          if (shipmentDay.getTime() === tomorrow.getTime()) {
              return 'shipment-tomorrow';
          }

          // Light Blue: Previous dates only
          if (shipmentDay.getTime() < today.getTime()) {
              return 'shipment-adjustment';
          }

          // Other future dates: no background color
          return '';
      }


      saveDateRange() {
          try {
              localStorage.setItem(this.dateStorageKey, JSON.stringify({
                  from: this.dateFrom.value,
                  to: this.dateTo.value
              }));
          } catch (e) {
              console.warn('Unable to save date range:', e);
          }
      }
      setDefaultDateRange() {
          // local date as yyyy-MM-dd (toISOString() would use UTC and can be off by a day)
          const d = new Date();
          const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

          this.dateFrom.value = today;
          this.dateTo.value = today;
      }
      todayString() {
          // local date as yyyy-MM-dd (toISOString() would use UTC and can be off by a day)
          const d = new Date();
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const dd = String(d.getDate()).padStart(2, '0');
          return `${d.getFullYear()}-${mm}-${dd}`;
      }

      restoreDateRange() {
          try {
              const raw = localStorage.getItem(this.dateStorageKey);

              if (raw === null) {
                  // first visit (nothing saved yet): default both dates to today
                  const today = this.todayString();
                  this.dateFrom.value = today;
                  this.dateTo.value = today;
                  this.saveDateRange();
                  return;
              }

              const saved = JSON.parse(raw);
              this.dateFrom.value = saved.from || '';
              this.dateTo.value = saved.to || '';
          } catch (e) {
              console.warn('Unable to restore date range:', e);
          }
      }


}

    document.addEventListener('DOMContentLoaded', function () {
        const controller = new FinaAssemblyController();
        controller.init();
    });
</script>