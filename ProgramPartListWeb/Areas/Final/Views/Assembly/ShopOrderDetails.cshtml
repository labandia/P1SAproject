                        <button type="button" id="OpenDownTime" class="trace-btn">
                            <i class="fas fa-clock"></i> FA Down Time Monitoring
                        </button>
                    </div>
                </div>
            </div>
            <div class="devices-table-wrapper">
                <div class="table-scroll" id="showTraceabilityTable">
                    <table class="devices-table">
                        <thead>
                            <tr>

                                <th class="fixedcolumn">Department </th>
                                <th style="text-align: center;">Time</th>
                                <th style="text-align: center;">Shop Order</th>
                                <th style="text-align: center;">Item Name </th>
                                <th style="text-align: center;">Item No.</th>
                                <th style="text-align: center;">Plan Quantity</th>
