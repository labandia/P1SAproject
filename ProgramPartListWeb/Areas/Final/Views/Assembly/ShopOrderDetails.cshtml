        formatDate(dateString) {
            if (!dateString) return '';

            const timestamp = parseInt(dateString.match(/\d+/)[0]);
            const date = new Date(timestamp);

            return date.toLocaleDateString('en-US');
        }

        SetFormDate(aspNetDate) {
            if (!aspNetDate) return '';

            const match = aspNetDate.match(/\d+/);
            if (!match) return '';

            const date = new Date(parseInt(match[0]));
            return date.toISOString().split('T')[0];
        }


        /* ================= RENDER MAIN TABLE ================= */
        renderTable(data) {
            if (!this.tbody) return;

            if (data.length === 0) {
                this.tbody.innerHTML = `
             <tr>
                 <td colspan="8" style="text-align:center; padding:32px; color:#86868b;">
                     No data available.
                 </td>
             </tr>`;
                return;
            }


            const sectionMap = {
                1: "Molding",
                2: "Press",
                3: "Rotor",
                4: "Winding",
                5: "Circuit",
                7: "Harness",
                9: "Material Prep"
            };


            const sectionCode = {
                1: "AF",
                2: "AG",
                3: "BF",
                4: "FA",
                5: "CE",
                7: "FG",
                9: "DD"
            };


            this.tbody.innerHTML = data.map(row => {
                let sectionLabel = '';

                switch (row.DepartmentID) {
                    case 1:
                        sectionLabel = '<span class="sectionbadge badge-molding">AF</span>'
                        break;
                    case 2:
                        sectionLabel = '<span class="sectionbadge badge-press">AG</span>'
                        break;
                    case 3:
                        sectionLabel = '<span class="sectionbadge badge-rotor">BF</span>'
                        break;
                    case 4:
                        sectionLabel = '<span class="sectionbadge badge-winding">FA</span>'
                        break;
                    case 5:
                        sectionLabel = '<span class="sectionbadge badge-circuit">CE</span>'
                        break;
                    case 7:
                        sectionLabel = '<span class="sectionbadge badge-harness">FG</span>'
                        break;
                    default:
                        sectionLabel = '<span class="sectionbadge badge-Material">DD</span>'
                        break;
                }


                return `
                    <tr>
                        <td>
                            <div class="flex items-center gap-2">
                                ${sectionLabel}
                                <span class="font-semibold">${this.escape(sectionMap[row.DepartmentID])}</span>
                            </div>
                        </td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.TimeInput)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.ShopOrder)}</td>
                        <td style="color:#515154;">${this.escape(row.ProcessName)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.ItemNo)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.PreparedQuantity)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.Customer)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.Modeltype)}</td>
                        <td style="color:#515154; text-align:center;">${this.escape(row.SubAssyIssued)}</td>
                    </tr>`;
                        }).join('');
        }


        renderMEIGTable(data) {
            if (!this.MEIGbody) return;

            if (data.length === 0) {
                this.MEIGbody.innerHTML = `
                 <tr>
                     <td colspan="10" style="text-align:center; padding:32px; color:#86868b;">
                         No data available.
                     </td>
                 </tr>`;
                return;
            }

            this.MEIGbody.innerHTML = data.map(row => {
                return `
                    <tr>
                        <td>${this.escape(row.Registration)}</td>
                        <td>${this.escape(row.CategoryName)}</td>
                        <td>${this.escape(row.PartsName)}</td>
                        <td>${this.escape(row.PartNumber)}</td>
                        <td>${this.escape(row.PinList)}</td>
                        <td>${this.escape(row.TimeIn)}</td>
                        <td>${this.escape(row.TimeOut)}</td>
                          <td>${this.escape(row.Lines)}</td>
                          <td>${this.escape(row.Issuer)}</td>
                          <td>${this.escape(row.Preparation)}</td>
                    </tr>`;
                    }).join('');
        }

        renderDownTimeTable(data) {
            if (!this.Downtimebody) return;

            if (data.length === 0) {
                this.Downtimebody.innerHTML = `
         <tr>
             <td colspan="10" style="text-align:center; padding:32px; color:#86868b;">
                 No data available.
             </td>
         </tr>`;
                return;
            }

            this.Downtimebody.innerHTML = data.map(row => {
                // Show Stop button only when TimeEnd has no value
                const stopButton =
                    !row.TimeEnd
                        ? `
                    <button
                        type="button"
                        class="btn-icon btn-edit"
                        title="Stop"
                        data-downtime-id="${row.DownTimeID}">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="1.5em"
                             height="1.5em"
                             viewBox="0 0 24 24">

                            <path d="M0 0h24v24H0z" fill="none" />

                            <path fill="currentColor"
                                d="M19.414 8.902a1 1 0 0 0 .293-.195l.5-.5a.999 1 0 1 0-1.414-1.414l-.5.5l-.115.173a8.97 8.97 0 0 0-5.189-2.41L13 5V4h1c.55 0 1-.45 1-1s-.45-1-1-1h-4c-.55 0-1 .45-1 1s.45 1 1 1h1v1l.012.057A9 9 0 0 0 12 23a9 9 0 0 0 7.414-14.098M12 21c-3.859 0-7-3.14-7-7s3.141-7 7-7s7 3.14 7 7s-3.141 7-7 7m1-8v-2c0-.55-.45-1-1-1s-1 .45-1 1v3c0 .55.45 1 1 1h3c.55 0 1-.45 1-1s-.45-1-1-1zm-1-5c-3.312 0-6 2.688-6 6s2.688 6 6 6s6-2.688 6-6s-2.688-6-6-6m0 11c-2.757 0-5-2.243-5-5s2.243-5 5-5s5 2.243 5 5s-2.243 5-5 5" />
                        </svg>
                    </button>
                  `
                        : '';




                return `
            <tr>
                <td>${this.escape(row.GroupName)}</td>
                <td>${this.escape(row.DownTimeCode)}</td>
                <td>${this.escape(row.DownTimeType)}</td>

                <td>${this.formatTimeSpan(row.TimeStart)}</td>
                <td>${this.formatTimeSpan(row.TimeEnd)}</td>
                <td style="text-align:center; white-space:nowrap;">
                     ${stopButton}
                </td>
                <td>${this.escape(row.Downtime)}</td>
                <td>${this.escape(row.PIC)}</td>
                <td>${this.escape(row.Details)}</td>


            </tr>`;
            }).join('');
        }




        formatTime(time) {
            if (!time) return '-';

            // Example: "08:30:00"
            if (typeof time === 'string') {
                return time.substring(0, 5);
            }

            return '-';
        }

        formatTimeSpan(time) {
            if (!time) return '-';

            const hours = String(time.Hours ?? 0).padStart(2, '0');
            const minutes = String(time.Minutes ?? 0).padStart(2, '0');

            return `${hours}:${minutes}`;
        }

        escape(str) {
            const d = document.createElement('div');
            d.textContent = str ?? '';
            return d.innerHTML;
        }
    }


    document.addEventListener('DOMContentLoaded', function () {
        const controller = new ShopOrderDetailsController();
        controller.init();
    });
</script>



