                </div>


                <div class="table-scroll" id="showMEIGTable" style="display: none;">
                    <table class="MEIG-table">
                        <thead>
                            <tr>
                                <th style="text-align: center;">Registration </th>
                                <th style="text-align: center;">Category</th>
                                <th style="text-align: center;">Name</th>
                                <th style="text-align: center;">Part number </th>
                                <th style="text-align: center;">Location Pins</th>
                                <th style="text-align: center;">TIME</th>
                                <th style="text-align: center;">OUT</th>
                                <th style="text-align: center;">Line </th>
                                <th style="text-align: center;">Issuer</th>
                                <th style="text-align: center;">Preparation</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="table-scroll" id="showDownTime" style="display: none;">
                    <table class="Downtime-table">
                        <thead>
                            <tr>
                                <th style="text-align: center;">Group  </th>
                                <th style="text-align: center;">Code </th>
                                <th style="text-align: center;">Type of Downtime</th>
                                <th style="text-align: center;">Start</th>
                                <th style="text-align: center;">End</th>
