                <span class="field-label">Lines : </span>
                <input type="text" class="field-box" id="Lines" name="Lines" />
            </div>

            <div class="field-group">
                <span class="field-label">Issuer : </span>
                <input type="text" class="field-box" id="Issuer" name="Issuer" />
            </div>

            <div class="field-group">
                <span class="field-label">Preparation : </span>
                <input type="text" class="field-box" id="Preparation" name="Preparation" />
            </div>

            <button type="submit" class="save-btn">
                <span class="icon-inline" style="width:13px;height:13px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" /><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7M7 3v4a1 1 0 0 0 1 1h7" /></svg>
                </span> Save Changes
            </button>
