</div>




<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

    class ShopOrderDetailsController {
        constructor() {
            this.downTimeTypes = [];

            this.tbody = document.querySelector('.devices-table tbody');
            this.MEIGbody = document.querySelector('.MEIG-table tbody');
            this.Downtimebody = document.querySelector('.Downtime-table tbody');
            this.recordID = document.getElementById('intID').value;

            this.changeForms = document.getElementById('OpenMEIG');
            this.downTimeForms = document.getElementById('OpenDownTime');
            this.openFinalAssembly =
                document.getElementById('OpenFinalAssembly');

            this.selectParts = document.getElementById('selectparts');
            this.partsDropDown = document.getElementById('CartsPartID');

            this.finalAssemblyPanel = document.getElementById('EditFinalAsembly');
            this.partsListPanel = document.getElementById('EditRegistrationParts');
            this.DownTimeListPanel = document.getElementById('AddEditDownTimeMonitoring');

            this.traceabilityTable =
                document.getElementById('showTraceabilityTable');

            this.meigTable =
                document.getElementById('showMEIGTable');

            this.downTimeTable =
                document.getElementById('showDownTime');

            this.formAssembly = document.getElementById('EditFinalAsembly');
            this.formParts = document.getElementById('EditRegistrationParts');

            this.strLine = "";
            this.finalShopOrder = "";
            this.intRecord = 0;

            this.tabButtons = [this.openFinalAssembly, this.changeForms, this.downTimeForms];
        }

        async init() {
            await this.LoadDetailsinfo();
            await this.LoadDownTimeType();
            this.bindEvents();

            this.setActiveButton(this.openFinalAssembly);
            //this.initializeDownTimeEvents();
        }

     


        setActiveButton(activeBtn) {
            this.tabButtons.forEach(btn => btn.classList.toggle('active', btn === activeBtn));
        }

        bindEvents() {
            this.formAssembly.addEventListener('submit', (e) => this.HandleSubmit(e));
            this.formParts.addEventListener('submit', (e) => this.HandlePartSubmit(e));
            this.DownTimeListPanel.addEventListener('submit', (e) => this.HandleDownTimeSubmit(e));

            // SATAS  List button
            this.openFinalAssembly.addEventListener('click', (e) => {
                e.preventDefault();
                this.ShowFinalAssembly();
            });

            // Parts List button
            this.changeForms.addEventListener('click', (e) => {
                e.preventDefault();
                this.ShowPartsList();
            });

            // Down Time button
            this.downTimeForms.addEventListener('click', (e) => {
                e.preventDefault();
                this.ShowDownTime();
            });


            this.Downtimebody.addEventListener('click', (e) => {
                const stopButton = e.target.closest('.btn-edit');

                if (!stopButton) return;

                const downTimeID = stopButton.dataset.downtimeId;

                console.log('DownTimeID:', downTimeID);

                this.HandleDownTimeStop(downTimeID);
            });


            this.selectParts.addEventListener('change', async (e) => {
                e.preventDefault();

                const res = await getMethod('@Url.Action("GetCatergoryPartslist", "Assembly")', {
                    cat: parseInt(e.target.value)
                });

                if (res?.Success) {
                    const select = document.getElementById("CartsPartID");

                    // Clear existing options
                    select.innerHTML = '<option value="">-- Select Name --</option>';

                    // Append new options
                    res.data.forEach(item => {
                        const option = document.createElement("option");
                        option.value = parseInt(item.CartsPartID);
                        option.textContent = item.PartsName; // Replace with your actual name field
                        select.appendChild(option);
                    });
                }
                console.log(res);
            });
        }

        ShowFinalAssembly() {
            this.setActiveButton(this.openFinalAssembly);


            // Tables
            this.traceabilityTable.style.display = 'block';
            this.meigTable.style.display = 'none';
            this.downTimeTable.style.display = 'none';

            // Forms
            this.finalAssemblyPanel.style.display = 'block';
            this.partsListPanel.style.display = 'none';
            this.DownTimeListPanel.style.display = 'none';

            // Buttons
            this.changeForms.style.display = 'block';
            this.downTimeForms.style.display = 'block';

        }

        ShowPartsList() {
            this.setActiveButton(this.changeForms);

            // Tables
            this.traceabilityTable.style.display = 'none';
            this.meigTable.style.display = 'block';
            this.downTimeTable.style.display = 'none';

            // Forms
            this.finalAssemblyPanel.style.display = 'none';
            this.partsListPanel.style.display = 'block';
            this.DownTimeListPanel.style.display = 'none';
            // Buttons
        }


        ShowDownTime() {
            this.setActiveButton(this.downTimeForms);

            // Tables
            this.traceabilityTable.style.display = 'none';
            this.meigTable.style.display = 'none';
            this.downTimeTable.style.display = 'block';

            // Forms
            this.finalAssemblyPanel.style.display = 'none';
            this.partsListPanel.style.display = 'none';
            this.DownTimeListPanel.style.display = 'block';
            // Buttons
        }

        async LoadDetailsinfo() {
            try {
                const res = await getMethod('@Url.Action("SelectedShopOrderData", "Assembly")', {
                    RecordID: this.recordID
                });
                if (!res?.Success) return;
                const data = res.data;
                //console.log(data);
                this.strLine = data.Line;
                this.finalShopOrder = data.FinalShopOrder;
                document.getElementById("finalShopOrderText").textContent = data.FinalShopOrder;
                document.getElementById("partnoText").textContent = data.ItemNo;
                document.getElementById("ModelText").textContent = data.Model;
                document.getElementById("QuanText").textContent = data.PlanQty;
                document.getElementById("LineText").textContent = data.Line;

                document.getElementById("PlanText").textContent = data.PlanQty;
                document.getElementById("DispatchText").textContent = data.DispatchDate;
                document.getElementById("WCText").textContent = data.WC;
                document.getElementById("IFSText").textContent = this.formatDate(data.FinalFinishedDate);
                document.getElementById('WithSR').checked = data.WithSR;

                document.getElementById('noteText').textContent = data.Note

                // Fill up the form
                document.getElementById("FAStatus").value = data.FAStatus;
                document.getElementById("ShipmentDate").value = this.SetFormDate(data.ShipmentDate);
                //document.getElementById("FAStatus").value = data.PlanQty;
                document.getElementById("Remarks").value = data.OrderRemarks;

                this.LoadTraceAbility(data.FinalShopOrder);
                this.LoadMEIGData(data.FinalShopOrder);
                this.LoadDownTimeData(data.FinalShopOrder);
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }
        async LoadTraceAbility(shoporder) {
            try {
              const res = await getMethod('@Url.Action("GetTraceabilityData", "Assembly")', {
                  shopOrder: shoporder
              });

              if (!res?.Success) return;
                const data = res.data;
                this.renderTable(data);
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }

        async LoadMEIGData(shoporder) {
            try {
              const res = await getMethod('@Url.Action("GetRegistrationList", "Assembly")', {
                  finalshopOrder: shoporder
              });
                console.log(res);
              if (!res?.Success) return;
                const data = res.data;

                this.renderMEIGTable(data);
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }

        async LoadDownTimeData(shoporder) {
            try {
              const res = await getMethod('@Url.Action("GetDownTimeList", "Assembly")', {
                  finalshopOrder: shoporder
              });
              console.log(res);
              if (!res?.Success) return;
                const data = res.data;

                this.renderDownTimeTable(data);


             
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        }




        async LoadDownTimeType() {
            try {
                const res = await getMethod('@Url.Action("GetDownTimeTypeList", "Assembly")', {});
               console.log(res);
               if (!res?.Success) return;

                // Adjust this depending on your API response structure
                const data = res?.data ?? res;

                if (!Array.isArray(data)) {
                    console.error("Invalid downtime type data:", data);
                    return;
                }
                this.downTimeTypes = data;
                this.populateGroupSelect(data);

               

             } catch (error) {
                 console.error('Error fetching data:', error);
             }
         }

        populateGroupSelect(data) {

            const groupSelect = document.getElementById("DownTimeGroup");
            const codeSelect = document.getElementById("DownTimeCode");

            if (!groupSelect) {
                console.error("DownTimeGroup not found");
                return;
            }

            if (!codeSelect) {
                console.error("DownTimeCode not found");
                return;
            }

            // Store the complete list
            this.downTimeTypes = data;

            // ==============================
            // Populate UNIQUE GROUPS
            // ==============================

            groupSelect.innerHTML = `
        <option value="">-- Select Group --</option>
    `;

            const uniqueGroups = [
                ...new Set(
                    data
                        .map(item => item.GroupName?.trim())
                        .filter(Boolean)
                )
            ];

            uniqueGroups.forEach(group => {

                const option = document.createElement("option");

                option.value = group;
                option.textContent = group;

                groupSelect.appendChild(option);
            });


            // ==============================
            // GROUP CHANGE
            // ==============================

            groupSelect.addEventListener("change", (e) => {

                const selectedGroup = e.target.value.trim();

                console.log("Selected Group:", selectedGroup);

                // Clear Code dropdown
                codeSelect.innerHTML = ``;

                if (!selectedGroup) {

                    
                    return;
                }


                // ==============================
                // FILTER BY GROUP
                // ==============================

                const filteredData = this.downTimeTypes.filter(item =>
                    String(item.GroupName ?? "").trim() === selectedGroup
                );

                console.log("Filtered Data:", filteredData);


                // ==============================
                // POPULATE DOWNTIME CODE
                // ==============================

                filteredData.forEach(item => {

                    const option = document.createElement("option");

                    option.value = item.DownTimeCode;

                    option.textContent =
                        `${item.DownTimeCode} - ${item.DownTimeType}`;

                    codeSelect.appendChild(option);
                });


               
            });


            // ==============================
            // CODE CHANGE
            // ==============================

            codeSelect.addEventListener("change", (e) => {

                const selectedCode = e.target.value;

                const selectedItem = this.downTimeTypes.find(item =>
                    String(item.DownTimeCode ?? "").trim() ===
                    String(selectedCode ?? "").trim()
                );

                if (!selectedItem) {
                    return;
                }

                console.log("Selected Code:", selectedItem);

            });
        }


      



        async HandleSubmit(e) {
            e.preventDefault();
            const formData = {
                RecordID: this.recordID,
                FAStatus: document.getElementById('FAStatus').value,
                ShipmentDate: document.getElementById('ShipmentDate').value,
                Mode: "",
                WithSR: document.getElementById('WithSR').checked,
                Remarks: document.getElementById('Remarks').value
            };

            await this.EditAssemblyStatus(formData);
        }

        async HandlePartSubmit(e) {
            e.preventDefault();
            const formdata = new FormData(this.formParts);
            formdata.append('FinalShopOrder', this.finalShopOrder);
            const data = Object.fromEntries(formdata);
            console.log(data);

            await this.AddRegistrationData(formdata);
        }

        async HandleDownTimeSubmit(e) {
            e.preventDefault();
            const formdata = new FormData(this.DownTimeListPanel);
            formdata.append('FinalShopOrder', this.finalShopOrder);
            const data = Object.fromEntries(formdata);
            console.log(data);

            await this.AddDownTimeMonitorData(formdata);
        }

        async HandleDownTimeStop(id) {
            try {
                const res = await postMethod('@Url.Action("EditDownTimeMonitoring", "Assembly")', {
                    ID : id
                });

                console.log(res);
                if (res?.Success) {
                    alert('DownTime Time is  Updated successfully!');
                    // Optionally reload data to reflect changes
                    await this.LoadDownTimeData(this.finalShopOrder);
                } else {
                    alert('Error: ' + (res?.Message || 'Could not save data.'));
                }
            } catch (error) {
                console.error('Save error:', error);
                alert('An error occurred while saving.');
            } 
        }


        async EditAssemblyStatus(formdata) {
            const savebtn = document.querySelector('#EditFinalAsembly .save-btn');
            savebtn.innerHTML = '<span>Saving...</span>';
            savebtn.disabled = true;

            const originalText = savebtn.innerHTML;

            try {
