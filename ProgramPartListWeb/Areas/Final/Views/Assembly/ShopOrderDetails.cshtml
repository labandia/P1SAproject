                <span class="field-label">Registration</span>
                <input type="text" class="field-box" placeholder="Enter Registration" id="Registration" name="Registration" />
            </div>
            <div class="field-group">
                <span class="field-label">Category </span>
                <select id="selectparts">
                    <option value="1">jig</option>
                    <option value="2">Inspection Tools</option>
                    <option value="3">Soldering Tools</option>
                    <option value="4">Special Unit</option>
                </select>
            </div>

            <div class="field-group">
                <span class="field-label">Select Names </span>
                <select id="CartsPartID" name="CartsPartID">
                </select>
            </div>

            <div class="field-group">
                <span class="field-label">Partnumber : </span>
                <input type="text" class="field-box" id="PartNumber" name="PartNumber" />
            </div>

            <div class="field-group">
                <span class="field-label">Pin List : </span>
                <input type="text" class="field-box" id="PinList" name="PinList" />
            </div>

            <div class="field-group">
