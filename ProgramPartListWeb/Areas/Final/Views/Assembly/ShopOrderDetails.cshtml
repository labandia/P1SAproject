                    <span class="detail-value" id="noteText">GA200+1A27+OVN+CAULK+L603</span>
                </div>
            </div>
        </div>

        <!-- Traceability Table -->
        <div>
            <div class="trace-header">

                <!-- Header with modern buttons -->
                <div class="trace-header-modern">
                    <div class="trace-buttons-modern">
                        <button type="button" id="OpenFinalAssembly" class="trace-btn active">
                            <i class="fas fa-microchip"></i> SATAS data
                        </button>
                        <button type="button" id="OpenMEIG" class="trace-btn">
                            <i class="fas fa-clipboard-list"></i> Parts List Preparation
