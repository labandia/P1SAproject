                <div class="details-row">
                    <div class="detail-item">
                        <span class="detail-label">Plan Quantity</span>
                        <span class="detail-value" id="PlanText">20/05/2026</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Dispatch Date</span>
                        <span class="detail-value" id="DispatchText">05/22/2026 06:44</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">WC</span>
