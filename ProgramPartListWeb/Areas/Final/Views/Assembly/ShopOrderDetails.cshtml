

@{
    Layout = "~/Areas/Final/Views/Shared/_FinalShopDetails.cshtml";
    var intID = Request.QueryString["id"];
}


<input type="hidden" id="intID" value="@intID" />

<div class="content-row">
    <!-- Main content panel -->
