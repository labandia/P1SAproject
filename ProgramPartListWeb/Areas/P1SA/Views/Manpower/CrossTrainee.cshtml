
@{
    ViewBag.Title = "CrossTrainee";
    Layout = "~/Areas/P1SA/Views/Shared/_ManpowerLayout.cshtml";
}

<div class="topbar">
    <div>
        <h1 id="topbarTitle">
            Cross Trainee & Temporary Assignment
        </h1>
        <p id="topbarSub">
            Employees on loan to other departments
        </p>
    </div>
    <div class="topbar-actions" id="topbarActions">
        <button class="cusbtn" id="btnDownloadTemplate">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v11M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Download Template
        </button>
        <button class="cusbtn" id="btnImport">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 15V4M7 9l5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Import Excel
        </button>
        <button class="cusbtn cusbtn-primary" id="openaddform"
                data-bs-toggle="modal"
                data-bs-target="#addEmployeeModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /></svg>
            Add Employee
        </button>
    </div>
</div>