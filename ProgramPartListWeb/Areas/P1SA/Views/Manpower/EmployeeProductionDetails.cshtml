
@{
    ViewBag.Title = "EmployeeProductionDetails";
    Layout = "~/Areas/P1SA/Views/Shared/_ManpowerLayout.cshtml";
    var empID = Request.QueryString["employeeID"];
    var roles = Request.QueryString["role"];

    // Change layout based on role
    if (!string.IsNullOrEmpty(roles))
    {
        switch (roles.ToLower())
        {
            case "0":
                Layout = "~/Areas/P1SA/Views/Shared/_ManpowerLayout.cshtml";
                break;

            case "1":
                Layout = "~/Areas/P1SA/Views/Shared/_ProductionLayout.cshtml";
                break;
        }
    }


}

<input type="hidden" id="employID" value="@empID" />
<input type="hidden" id="rolesID" value="@roles" />

<div class="empdetail-head panel">
    <div class="drawer-head-main">
        <div class="avatar avatar-lg" id="drawerAvatar">
            <img id="drawerAvatarImage"
                 src="@Url.Content("~/Content/Images/no-image.png")"
                 alt="Employee Photo">
        </div>
        <div>
            <h2 id="drawerName">Employee Name</h2>
            <div class="emp-sub" id="drawerSub">Code · Department · Agency</div>
        </div>
    </div>
    <button class="drawer-close" id="Backbtn" title="Back to Employee List">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
</div>


<div class="drawer-tabs panel" style="padding:0 20px;margin-top:14px;">
    <div class="drawer-tab active" data-tab="details">Details</div>
    <div class="drawer-tab" data-tab="edit">Edit</div>
    <div class="drawer-tab" data-tab="records">Attendance &amp; Absence</div>
    <div class="drawer-tab" data-tab="status">Change Status</div>
</div>

<div class="panel" style="margin-top:14px;">
    <!-- DETAILS -->
    <div class="drawer-pane active detail-grid" id="pane-details">
        <div class="detail-row"><span class="k">Employee Code</span><span class="v mono" id="d-code"></span></div>
        <div class="detail-row"><span class="k">Gender</span><span class="v" id="d-gender"></span></div>
        <div class="detail-row"><span class="k">Date Hired</span><span class="v mono" id="d-hired"></span></div>
        <div class="detail-row"><span class="k">Date of Birth</span><span class="v mono" id="d-dob"></span></div>
        <div class="detail-row"><span class="k">Email</span><span class="v" id="d-email"></span></div>
        <div class="detail-row"><span class="k">Phone</span><span class="v mono" id="d-phone"></span></div>
        <div class="detail-row"><span class="k">Address</span><span class="v" id="d-address"></span></div>
        <div class="detail-row"><span class="k">Pick-up Point</span><span class="v" id="d-pickup"></span></div>
        <div class="detail-row"><span class="k">Province</span><span class="v" id="d-province"></span></div>
        <div class="detail-row"><span class="k">Educational Attainment</span><span class="v" id="d-education"></span></div>
        <div class="detail-row"><span class="k">Directed By</span><span class="v" id="d-directedby"></span></div>
        <div class="detail-row"><span class="k">Category</span><span class="v" id="d-category"></span></div>
        <div class="detail-row"><span class="k">Department</span><span class="v" id="d-department"></span></div>
        <div class="detail-row"><span class="k">Job Title</span><span class="v" id="d-jobtitle"></span></div>
        <div class="detail-row"><span class="k">Agency</span><span class="v" id="d-agency"></span></div>
        <div class="detail-row"><span class="k">Status</span><span class="v" id="d-status"></span></div>
        @*<div class="detail-row"><span class="k">Date Hired</span><span class="v mono" id="d-hired"></span></div>*@
        <div class="detail-row"><span class="k">Remarks</span><span class="v" id="d-remarks"></span></div>
    </div>

    <!-- EDIT -->
    <div class="drawer-pane" id="pane-edit">
        <div class="photo-upload">
            <div class="avatar" id="editAvatarPreview">+</div>
            <button class="btn btn-ghost photo-upload-btn">
                Change Photo

            </button>
            <input type="file" accept="image/*" id="editPhotoInput">
        </div>
        <div class="section-label" style="margin-top:0;">Basic Information</div>
        <div class="field-group"><label>Full Name</label><input type="text" id="e-name"></div>
        <div class="field-row-3">
            <div class="field-group">
                <label>Gender</label>
                <select id="e-gender" class="form-select">
                    <option value="False">Male</option>
                    <option value="True">Female</option>
                </select>
            </div>
            <div class="field-group"><label>Date of Birth</label><input type="date" id="e-dob"></div>
            <div class="field-group"><label>Email</label><input type="email" id="e-email"></div>
        </div>
        <div class="field-row-3">
            <div class="field-group"><label>Phone</label><input type="text" id="e-phone"></div>
            <div class="field-group"><label>Pick-up Point</label><input type="text" id="e-pickup"></div>
            <div class="field-group"><label>Province</label><input type="text" id="e-province"></div>
        </div>
        <div class="field-group"><label>Address</label><input type="text" id="e-address"></div>
        <div class="section-label">Assignment</div>
        <div class="field-row-3">
            <div class="field-group">
                <label>Department</label>
                <select id="e-department">
                    <option value="1">Molding</option>
                    <option value="2">Press</option>
                    <option value="3">Rotor</option>
                    <option value="4">Winding</option>
                    <option value="5">Circuit</option>
                </select>
            </div>
            <div class="field-group">
                <label>Job Title</label>
                <select id="e-jobtitle">
                    <option value="1">Supervisor</option>
                    <option value="2">Junior Supervisor</option>
                    <option value="3">Leader</option>
                    <option value="4">Technical Trainer</option>
                    <option value="5">Production Operator</option>
                    <option value="6">Regular/GGWP</option>
                    <option value="8">Casual</option>
                </select>
            </div>
            <div class="field-group">
                <label>Agency</label>
                <select id="e-agency">
                    <option value="1">SDP</option>
                    <option value="2">TMS</option>
                    <option value="4">SYNERGY</option>
                    <option value="3">ONESOURCE</option>
                    <option value="5">Golden</option>
                </select>
            </div>
        </div>
        <div class="field-row">
            <div class="field-group"><label>Date Hired</label><input type="date" id="e-hired"></div>
            <div class="field-group"><label>Remarks</label><input type="text" id="e-remarks" placeholder="Optional notes for this record"></div>
        </div>
    </div>

    <!-- ATTENDANCE & ABSENCE RECORDS -->
    <div class="drawer-pane" id="pane-records">
        <div class="mini-stat-row" id="recordsStatRow"></div>
        <div class="records-grid">
            <div>
                <div class="section-label" style="margin-top:0;">Recent Attendance</div>
                <div class="mini-table-wrap">
                    <table class="mini-table">
                        <thead><tr><th>Date</th><th>Time In</th><th>Time Out</th><th>Late</th><th>OT</th></tr></thead>
                        <tbody id="recordsAttendanceBody"></tbody>
                    </table>
                </div>
            </div>
            <div>
                <div class="section-label" style="margin-top:0;">Recent Absences</div>
                <div class="mini-table-wrap">
                    <table class="mini-table">
                        <thead><tr><th>Date</th><th>Reason</th><th>Status</th></tr></thead>
                        <tbody id="recordsAbsenceBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- CHANGE STATUS -->
    <div class="drawer-pane" id="pane-status">
        <div class="status-options" id="statusOptions" style="max-width:480px;">
            <label class="status-option sel-active"><input type="radio" name="stat" value="Active"><span>Active — return to work</span></label>
            <label class="status-option sel-awol"><input type="radio" name="stat" value="AWOL"><span>AWOL — absent without leave</span></label>
            <label class="status-option sel-resigned"><input type="radio" name="stat" value="Resigned"><span>Resigned</span></label>
        </div>
        <div class="field-row" style="max-width:480px;">
            <div class="field-group">
              <label>Date Resigned / AWOL</label>
              <input type="date" id="statusDate">
            </div>
        </div>
        <div class="field-group" style="max-width:480px;">
            <label>Remarks</label>
            <textarea rows="3" id="statusRemarks" placeholder="Reason for this status change (required for AWOL and Resigned)"></textarea>
        </div>
    </div>


</div>

<div class="addemp-actions">
    <button class="btn btn-ghost" id="drawerCancel">Cancel</button>
    <button class="btn btn-primary" id="drawerSave">Save Changes</button>
</div>





<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

    class EmployeeDetailsController {
        constructor() {
            this.avatarPalette = ["#2C5F74", "#8A7C5C", "#B98A2E", "#6B4A4A", "#4A7856", "#5C6B8A", "#8A5C6B", "#5C8A78"];


            this.editPhotoData = null;

            this.editPhotoInput = document.getElementById('editPhotoInput');

            this.savedata = document.getElementById('drawerSave');

        }

        async init() {
            this.bindEvents();

            await this.fetchEmployeeData();
        }

        bindEvents() {
            document.getElementById("Backbtn")
                .addEventListener("click", () => {
                    let selectedrole = document.getElementById("rolesID");
                    if (parseInt(selectedrole.value) === 0) {
                        window.location.href = `/P1SA/Manpower/ManageEmployee`;
                    } else {
                        window.location.href = `/P1SA/Manpower/Productions`;
                    }
             });

            this.editPhotoInput.addEventListener('change', (e) => {
                 const file = e.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = function (ev) {
                     editPhotoData = ev.target.result;
                     const editAvatar = document.getElementById('editAvatarPreview');
                     editAvatar.style.background = 'transparent';
                     editAvatar.innerHTML = `<img src="${editPhotoData}" style="width:100%;height:100%;object-fit:cover;">`;
                 };
                 reader.readAsDataURL(file);
             });


            this.savedata.addEventListener('click', async () => {
                // Basic required-field guard before hitting the server
                const fullName = document.getElementById('e-name').value.trim();
                if (!fullName) {
                    alert('Full Name is required.');
                    return;
                }

                const selectedStatus = document.querySelector('input[name="stat"]:checked');

                let statusId = 1; // Default Active

                if (selectedStatus) {
                    switch (selectedStatus.value) {
                        case 'Active':
                            statusId = 1;
                            break;

                        case 'AWOL':
                            statusId = 2;
                            break;

                        case 'Resigned':
                            statusId = 3;
                            break;
                    }
                }

                const payload = {
                    EmployeeId: parseInt(document.getElementById('employID').value, 10),
                    FullName: fullName,
                    Gender: document.getElementById('e-gender').value === 'True',
                    DateOfBirth: document.getElementById('e-dob').value || null,
                    Email: document.getElementById('e-email').value,
                    Phone: document.getElementById('e-phone').value,
                    Address: document.getElementById('e-address').value,
                    PickUpPoint: document.getElementById('e-pickup').value,
                    Province: document.getElementById('e-province').value,
                    DepartmentId: parseInt(document.getElementById('e-department').value, 10),
                    JobTitleId: parseInt(document.getElementById('e-jobtitle').value, 10),
                    AgencyId: parseInt(document.getElementById('e-agency').value, 10),
                    DateHired: document.getElementById('e-hired').value || null,
                    Remarks: document.getElementById('e-remarks').value,
                    StatusId: statusId,

                    DateResigned: document.getElementById('statusDate').value || null
                };

                this.savedata.disabled = true; // prevent double-submit while the request is in flight


                console.log(payload);
                try {
                    const res = await postMethod('@Url.Action("EditEmployeeDetails", "Manpower")', payload);

                    if (res?.Success) {
                        await this.fetchEmployeeData(); // re-pull so Details tab reflects the saved values
                        // switch back to the Details tab
                        document.querySelector('.drawer-tab[data-tab="details"]').click();
                    } else {
                        alert(res?.Message || 'Save failed.');
                    }
                } catch (error) {
                    console.error('Error saving employee:', error);
                    alert('An error occurred while saving.');
                } finally {
                    this.savedata.disabled = false;
                }


            });


            // ============================================================ // DRAWER TABS // ============================================================
            const tabs = document.querySelectorAll(".drawer-tab");
            const panes = document.querySelectorAll(".drawer-pane");


           tabs.forEach(tab => {
                tab.addEventListener("click", function () {
                    // Get the tab name
                    const tabName = this.getAttribute("data-tab");
                    if (!tabName) { return; }
                    // ---------------------------------------------------- // Remove ACTIVE from all tabs // ----------------------------------------------------
                    tabs.forEach(item => { item.classList.remove("active"); });
                    // ---------------------------------------------------- // Remove ACTIVE from all panes // ----------------------------------------------------
                    panes.forEach(pane => { pane.classList.remove("active"); });
                    // ---------------------------------------------------- // Activate clicked tab // ----------------------------------------------------
                    this.classList.add("active");
                    // ---------------------------------------------------- // Activate matching pane // // details -> pane-details // edit -> pane-edit // records -> pane-records // status -> pane-status // ----------------------------------------------------
                    const selectedPane = document.getElementById(`pane-${tabName}`);
                    if (selectedPane)
                    {
                        selectedPane.classList.add("active");
                    }
                });
            });

        }

        async fetchEmployeeData() {
            try {
                const ID = document.getElementById('employID').value;
                const res = await getMethod('@Url.Action("GetEmployeeDetails", "Manpower")', { employeeID: ID });
                console.log(res);
                if (!res?.Success) {
                    return;
                }

                this.populateEmployeeDetails(res.data);
            } catch (error) {
                console.error('Error fetching employee data:', error);
            }
        }

       populateEmployeeDetails(data) {

                console.log(data);

                // ============================================================
                // BASIC EMPLOYEE INFORMATION
                // ============================================================

                document.querySelector('#drawerName').textContent =
                    data.FullName ?? '-';

                document.getElementById('drawerSub').textContent =
                    `${data.EmployeeCode ?? '-'} · ${data.DepartmentName ?? '-'} · ${data.StatusName ?? '-'}`;


                // ============================================================
                // IMAGE PATHS
                // ============================================================

                const imageBaseUrl =
                    '@Url.Action("DisplaytheImage", "Manpower", new { area = "P1SA" })';

                const defaultImage =
                    '@Url.Content("~/Content/Images/no-image.png")';


                const imagePath = data.ImageFileName
                    ? `${imageBaseUrl}?filename=${encodeURIComponent(data.ImageFileName)}`
                    : defaultImage;


                // ============================================================
                // DRAWER AVATAR
                // ============================================================

                const drawerAvatarImage =
                    document.querySelector('#drawerAvatarImage');

                if (drawerAvatarImage) {

                    drawerAvatarImage.src = imagePath;

                    drawerAvatarImage.onerror = function () {
                        this.onerror = null;
                        this.src = defaultImage;
                    };
                }


                // ============================================================
                // DETAILS PANEL
                // ============================================================

                document.querySelector('#d-code').textContent =
                    data.EmployeeCode ?? '-';

                document.querySelector('#d-gender').textContent =
                    data.Gender ? 'Female' : 'Male';

                document.querySelector('#d-hired').textContent =
                    data.DateHired ?? '-';

                document.querySelector('#d-dob').textContent =
                    data.DateOfBirth ?? '-';

                document.querySelector('#d-email').textContent =
                    data.Email ?? '-';

                document.querySelector('#d-phone').textContent =
                    data.Phone ?? '-';

                document.querySelector('#d-address').textContent =
                    data.Address ?? '-';

                document.querySelector('#d-pickup').textContent =
                    data.PickUpPoint ?? '-';

                document.querySelector('#d-province').textContent =
                    data.Province ?? '-';

                document.querySelector('#d-education').textContent =
                    data.EducationalAttain ?? '-';

                document.querySelector('#d-directedby').textContent =
                    data.DirectedBy ?? '-';

                document.querySelector('#d-category').textContent =
                    data.CategoryName ?? '-';

                document.querySelector('#d-department').textContent =
                    data.DepartmentName ?? '-';

                document.querySelector('#d-jobtitle').textContent =
                    data.JobName ?? '-';

                document.querySelector('#d-agency').textContent =
                    data.AgencyName ?? '-';

                document.querySelector('#d-status').textContent =
                    data.StatusName ?? '-';

                // FIXED: DateResigned instead of DateHired
               document.querySelector('#d-hired').textContent =
                   data.DateHired ?? '-';

                document.querySelector('#d-remarks').textContent =
                    data.Remarks ?? '-';


                // ============================================================
                // EDIT FORM
                // ============================================================

                document.getElementById('e-name').value =
                    data.FullName ?? '';


                // ------------------------------------------------------------
                // Gender
                // ------------------------------------------------------------

                const gender = data.Gender;

                if (
                    gender === true ||
                    gender === 'True' ||
                    gender === 'true' ||
                    gender === 1 ||
                    gender === '1'
                ) {
                    document.getElementById('e-gender').value = 'True';
                }
                else {
                    // Default = Male
                    document.getElementById('e-gender').value = 'False';
                }


                // ------------------------------------------------------------
                // Other fields
                // ------------------------------------------------------------

                document.getElementById('e-dob').value =
                    data.DateOfBirth
                        ? data.DateOfBirth.substring(0, 10)
                        : '';

                document.getElementById('e-email').value =
                    data.Email ?? '';

                document.getElementById('e-phone').value =
                    data.Phone ?? '';

                document.getElementById('e-address').value =
                    data.Address ?? '';

                document.getElementById('e-pickup').value =
                    data.PickUpPoint ?? '';

                document.getElementById('e-province').value =
                    data.Province ?? '';

                document.getElementById('e-department').value =
                    data.DepartmentId ?? '';

                document.getElementById('e-jobtitle').value =
                    data.JobTitleId ?? '';

                document.getElementById('e-agency').value =
                    data.AgencyId ?? '';

                document.getElementById('e-remarks').value =
                    data.Remarks ?? '';


                // ============================================================
                // DATE HIRED
                // ============================================================

                document.getElementById('e-hired').value =
                    data.DateHired
                        ? data.DateHired.substring(0, 10)
                        : new Date().toISOString().split('T')[0];


                // ============================================================
                // EDIT EMPLOYEE PHOTO
                // ============================================================

                this.editPhotoData = data.ImageFileName || null;

                const editAvatar =
                    document.getElementById('editAvatarPreview');

                if (editAvatar) {

                    if (data.ImageFileName) {

                        // Use the SAME image URL as drawer
                        const editImagePath =
                            `${imageBaseUrl}?filename=${encodeURIComponent(data.ImageFileName)}`;

                        editAvatar.style.background = 'transparent';
                        editAvatar.style.color = '';

                        editAvatar.innerHTML =
                            `<img src="${editImagePath}"
                                  alt="${data.FullName || 'Employee'}"
                                  style="width:100%;height:100%;object-fit:cover;"
                                  onerror="this.onerror=null; this.src='${defaultImage}';">`;

                    }
                    else {

                        editAvatar.style.background =
                            this.colorFor(data.FullName || '');

                        editAvatar.style.color = '#fff';

                        editAvatar.innerHTML =
                            this.initials(data.FullName || '');
                    }
                }


                // ============================================================
                // STATUS
                // ============================================================

                let statusId = data.StatusId;

                if (
                    statusId === null ||
                    statusId === undefined ||
                    statusId === ''
                ) {
                    statusId = 1; // Default Active
                }

                let statusValue = 'Active';

                if (statusId == 1) {
                    statusValue = 'Active';
                }
                else if (statusId == 2) {
                    statusValue = 'AWOL';
                }
                else if (statusId == 3) {
                    statusValue = 'Resigned';
                }

                const statusRadio =
                    document.querySelector(
                        `input[name="stat"][value="${statusValue}"]`
                    );

                if (statusRadio) {
                    statusRadio.checked = true;
                }


                // ============================================================
                // STATUS DATE
                // ============================================================

                document.getElementById('statusDate').value =
                    data.DateResigned
                        ? data.DateResigned.substring(0, 10)
                        : '';


                // ============================================================
                // STATUS REMARKS
                // ============================================================

                document.getElementById('statusRemarks').value =
                    data.Remarks ?? '';
            }

        initials(name) {
            return name.trim().split(/\s+/).map(p => p[0]).slice(0, 2).join('').toUpperCase();
        }

        colorFor(name) {
            let sum = 0; for (let i = 0; i < name.length; i++) sum += name.charCodeAt(i);
            return this.avatarPalette[sum % avatarPalette.length];
        }

    }

    document.addEventListener("DOMContentLoaded", () => {
        const req = new EmployeeDetailsController();
        req.init();
    });
</script>
