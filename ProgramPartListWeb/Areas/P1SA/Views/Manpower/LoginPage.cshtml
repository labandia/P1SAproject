@{
    ViewBag.Title = "ManageEmployee";
    Layout = null;
    var roleid = Request.QueryString["role"];

}

<input type="hidden" id="roleid" value="@roleid" />
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LoginPage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@100;200;300;400;500;600;700&family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="~/Content/css/ManpowerLogin.css" rel="stylesheet" />

    <!-- Iconify (same CDN) -->
    <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
</head>
<body>

    <div class="shell">

        <!-- ============ LEFT: BRAND PANEL ============ -->
        <div class="brand-panel">
            <div class="brand-mark">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="3" stroke="#7C97A3" stroke-width="1.6" /><path d="M7 12h10M7 8h6M7 16h4" stroke="#7C97A3" stroke-width="1.6" stroke-linecap="round" /></svg>
                <div>
                    <div class="brand-name">Production Manpower Systems Portal</div>
                    <div class="brand-sub">SANYO DENKI PHILIPPINES, INC.</div>
                </div>
            </div>

            <div class="brand-message">
                <h1>Manpower &amp; New Hired Employee systems, in one place.</h1>
                <p>Sign in with your department to view employee records, attendance, and onboarding for your section.</p>
            </div>

            <div class="brand-stats">
                <div class="brand-stat"><div class="v">248</div><div class="k">Active employees</div></div>
                <div class="brand-stat"><div class="v">6</div><div class="k">Sections online</div></div>
                <div class="brand-stat"><div class="v">7</div><div class="k">Pending hires</div></div>
            </div>
        </div>

        <!-- ============ RIGHT: LOGIN FORM ============ -->
        <div class="form-panel">
            <div class="login-card">
                <h2>Sign in</h2>
                <div class="sub">Enter your credentials and select your department.</div>

                <div class="error-banner" id="errorBanner">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" /><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /></svg>
                    <span>Employee ID, password, and department are all required.</span>
                </div>

                <form id="loginForm" novalidate>
                    <div class="field-group">
                        <label for="empId">Employee ID</label>
                        <input type="text" id="empId" placeholder="e.g. EMP-02145" autocomplete="username">
                    </div>

                    <div class="field-group">
                        <label for="password">Password</label>
                        <div class="pw-wrap">
                            <input type="password" id="password" placeholder="Enter your password" autocomplete="current-password">
                            <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" id="eyeIcon"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" /></svg>
                            </button>
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="department">Department</label>
                        <select id="department" required>
                            <option value="0" disabled selected>Select your department</option>
                            <option value="1">Molding Section</option>
                            <option value="2">Press Section</option>
                            <option value="3">Rotor Section</option>
                            <option value="4">Winding Section</option>
                            <option value="5">Circuit Section</option>
                            <option value="6">Process Control Section</option>
                            <option value="7">Final Assembly Section</option>
                        </select>
                    </div>

                    <div class="row-between">
                        <label class="remember"><input type="checkbox" id="remember"> Remember this device</label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-signin">Sign In</button>
                </form>

                <div class="divider-note">Internal use only · Contact IT if you can't access your account</div>
            </div>
        </div>

    </div>

    <script type="text/javascript">
        const pwInput = document.getElementById('password');
        const pwToggle = document.getElementById('pwToggle');
        pwToggle.addEventListener('click', () => {
            const isPw = pwInput.type === 'password';
            pwInput.type = isPw ? 'text' : 'password';
            pwToggle.setAttribute('aria-label', isPw ? 'Hide password' : 'Show password');
        });

        const form = document.getElementById('loginForm');
        const errorBanner = document.getElementById('errorBanner');
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const empId = document.getElementById('empId').value.trim();
            const pw = pwInput.value.trim();
            const dept = document.getElementById('department').value;

            if (!empId || !pw || !dept) {
                errorBanner.classList.add('show');
                return;
            }
            errorBanner.classList.remove('show');
            // On successful sign-in, continue to the system selector
            window.location.href = '/P1SA/Manpower/LoginPage';
        });

        // let logbtn = document.getElementById('loginBtn');

        // if (logbtn) {
        //     logbtn.addEventListener('click', function (e) {
        //         e.preventDefault();

        //         let roles = document.getElementById("roleid").value;

        //         if (parseInt(roles) === 0) {
        //             window.location.href = '/P1SA/Manpower/ManageEmployee';
        //         } else {
        //             window.location.href = '/P1SA/Manpower/Productions';
        //         }

        //     });
        // }
    </script>
</body>
</html>
