        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="addEmployeeModalLabel">Add New Employee</h5>
                    <small class="text-muted">Fields match the P1SA_Employees record.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- PHOTO -->
                <div class="photo-upload">
                    <div class="avatar mb-2" id="newAvatarPreview"><span>+</span></div>
                    <label class="btn btn-ghost photo-upload-btn">
                        Upload Photo
                        <input type="file" accept="image/*" id="newPhotoInput" hidden>
                    </label>
                </div>

