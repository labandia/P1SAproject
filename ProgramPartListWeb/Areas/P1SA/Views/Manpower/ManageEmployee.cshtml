
@{
    ViewBag.Title = "ManageEmployee";
    Layout = "~/Areas/P1SA/Views/Shared/_ManpowerLayout.cshtml";
}

<div class="topbar">
    <div>
        <h1 id="topbarTitle">Employee List</h1>
        <p id="topbarSub">Loading…</p>
    </div>
    <div class="topbar-actions" id="topbarActions">
        <button class="cusbtn" id="btnDownloadTemplate">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v11M7 10l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Download Template
        </button>
        <button class="cusbtn" id="btnImport">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 15V4M7 9l5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Import Excel
        </button>
        <button class="cusbtn cusbtn-primary" id="openaddform"
                data-bs-toggle="modal"
                data-bs-target="#addEmployeeModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /></svg>
            Add Employee
        </button>
    </div>
</div>


@*<div class="decorator-bar"><span>// SYS.OP.LEADS</span><span>LAT: 45.92</span><span>LONG: -12.03</span><div class="tech-line flex-1"></div><span>[ STATUS: ONLINE ]</span></div>*@

<div class="filterbar">
    <input id="searchinput" class="search-input" type="text" placeholder="Search by Employee Code or Full Name...">
    <div class="divider"></div>
    <select class="filter-select" id="AgencyID">
        <option value="0">Agency : ALL</option>
        <option value="1">SDP</option>
        <option value="2">TMS(Techinics MS)</option>
        <option value="3">Onesource</option>
        <option value="4">SynergyOne </option>
    </select>
    <select class="filter-select" id="GenderID">
        <option value="2">GENDER : ALL</option>
        <option value="0">MALE</option>
        <option value="1">FEMALE</option>
    </select>
    <select class="filter-select" id="AffiliID">
        <option value="0">POSITION : ALL</option>
        <option value="1">SUPERVISOR</option>
        <option value="2">JUNIOR SUPERVISOR</option>
        <option value="3">LEADER</option>
        <option value="4">TECHNICAL TRAINER</option>
        <option value="5">PRODUCTION OPERATOR</option>
        <option value="6">SDP</option>
    </select>

    <select id="StatusID" class="filter-select">
        <option value="0">SORT : Active</option>
        <option value="1">SORT : AWOL</option>
        <option value="2">SORT : Resigned</option>
    </select>
    <div class="divider"></div>
    <span class="filter-count" id="employeeCount">— of — shown</span>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>
                    Employee ID
                </th>
                <th>
                    Gender
                </th>
                <th>
                    Position
                </th>

                <th>
                    Date Hired
                </th>
                <th>
                    Status
                </th>
                <th>
                    Category
                </th>
            </tr>
        </thead>
        <tbody id="employeeTableBody"></tbody>
    </table>
</div>


<!-- ============ ADD EMPLOYEE MODAL ============ -->
