<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';


    class EmployeeController {
        constructor() {
            this.EmployeeData = [];
            this.currentPage = 1;
            this.pageSize = 100;

            this.tbody = document.getElementById("employeeTableBody");
            //this.paginationContainer = document.getElementById("EmployeePagination");


            this.modalOverlay = document.getElementById('modalOverlay');
        }

        async init() {
            this.bindEvents();

            await this.LoadEmployeeData();
        }

        bindEvents() {
            document.getElementById("GenderID")
                .addEventListener("change", () => {
                    this.currentPage = 1;
                    this.LoadEmployeeData();
                });

            document.getElementById("AffiliID")
                .addEventListener("change", () => {
                    this.currentPage = 1;
                    this.LoadEmployeeData();
                });

            document.getElementById("AgencyID")
                .addEventListener("change", () => {
                    this.currentPage = 1;
                    this.LoadEmployeeData();
                });

            document.getElementById("StatusID")
                .addEventListener("change", () => {
                    this.currentPage = 1;
                    this.LoadEmployeeData();
                });

            document.getElementById("searchinput")
                .addEventListener("input", () => {
                    this.currentPage = 1;
                    this.LoadEmployeeData();
                });

            document.getElementById("openaddform")
                .addEventListener("click", () => {
                    // window.location.href = '/P1SA/Manpower/AddNewEmployee';
                    // this.modalOverlay.classList.add('open');
                    document.getElementById("n-hired").value =
                        new Date().toISOString().split("T")[0];
                });

            document.getElementById("modalSave")
                .addEventListener("click", () => this.SaveNewEmployee());



            // ============================================================
            // PHOTO PREVIEW
            // ============================================================
            document.getElementById("newPhotoInput")
                .addEventListener("change", (event) => {

                    const file = event.target.files[0];
                    const preview = document.getElementById("newAvatarPreview");

                    if (!file) {
                        preview.textContent = "+";
                        preview.style.backgroundImage = "";
                        return;
                    }

                    if (!file.type.startsWith("image/")) {
                        alert("Please select a valid image file.");
                        event.target.value = "";
                        preview.textContent = "+";
                        preview.style.backgroundImage = "";
                        return;
                    }

                    const imageUrl = URL.createObjectURL(file);

                    preview.textContent = "";
                    preview.style.backgroundImage = `url("${imageUrl}")`;
                    preview.style.backgroundSize = "cover";
                    preview.style.backgroundPosition = "center";
                    preview.style.backgroundRepeat = "no-repeat";
                });

        }

        /* ================= LOAD DATA ================= */
        async LoadEmployeeData() {
            let searchText = document.getElementById("searchinput").value.trim();

            const gender = document.getElementById("GenderID").value;
            const pos = document.getElementById("AffiliID").value;
            const agency = document.getElementById("AgencyID").value;
            const status = document.getElementById("StatusID").value;

            const objparams = {
                search: searchText,
                depid: 1,
                gender: gender,
                pos: pos,
                agency: agency,
                status: status,
                role: 0,
                page: this.currentPage,
                pageSize: this.pageSize
            };

            try {

                const res = await getMethod('@Url.Action("GetEmployeelist", "Manpower")', objparams);
                if (!res?.Success) {
                   this.renderEmpty();
                   return;
                }
                this.EmployeeData = res.data.payload ?? [];
                const total = res.data?.Total ?? this.EmployeeData.length;

                this.renderTable(this.EmployeeData);

                document.getElementById('topbarSub').textContent = `${this.EmployeeData.length} records in total `;
                //this.renderPagination(total);

            }
            catch (err) {
                console.error(err);
                this.renderError();
            }

        }


        renderTable(data) {

            this.tbody.innerHTML = "";

            if (!data.length) {
                this.renderEmpty();
                return;
            }

            const fragment = document.createDocumentFragment();
            const imageBaseUrl = '@Url.Action("DisplaytheImage", "Manpower", new { area = "P1SA" })';

            data.forEach(row => {


              const imagePath = row.ImageFileName
        ? `${imageBaseUrl}?filename=${encodeURIComponent(row.ImageFileName)}`
        : '@Url.Content("~/Content/Images/no-image.png")';



                //console.log(imagePath);
                const tr = document.createElement("tr");

                tr.style.cursor = "pointer";

                tr.innerHTML = `  <tr>
                                <td>
                                  <div class="user-cell">
                                   <img
                                        class="cell-avatar"
                                        src="${imagePath}"
                                        loading="lazy"
                                        onerror="this.onerror=null; this.src='@Url.Content("~/Content/Images/no-image.png")';"
                                    />


                                      <div class="user-details">
                                          <span class="user-name-bold">${row.FullName}</span>
                                          <span class="user-time">${row.EmployeeCode}</span>
                                      </div>
                                  </div>
                                </td>

                                <td>
                                 <div  class="source-text">${row.Gender == 1 ? 'FEMALE' : 'MALE'}</div>
                                </td>

                                <td>
                                  <div class="contact-cell">
                                    <span>
                                      <div style="width:14px;height:14px;display:flex;align-items:center;justify-content:center;margin-right:8px">
                                      <iconify-icon icon="lucide:phone" style="font-size:14px;color:inherit"></iconify-icon>
                                       </div>${row.JobName}
                                    </span>

                                    <span>
                                      <div style="width:14px;height:14px;display:flex;align-items:center;justify-content:center;margin-right:8px">
                                      <iconify-icon icon="lucide:mail" style="font-size:14px;color:inherit"></iconify-icon>
                                      </div>${row.AgencyName}
                                   </span>
                                 </div>
                               </td>

                             <td>
                               <div class="contact-cell">
                                   <span>
                                     <div style="width:14px;height:14px;display:flex;align-items:center;justify-content:center;margin-right:8px">
                                     <iconify-icon icon="lucide:phone" style="font-size:14px;color:inherit"></iconify-icon>
                                      </div>${row.DateHired}
                                   </span>

                                   <span>
                                     <div style="width:14px;height:14px;display:flex;align-items:center;justify-content:center;margin-right:8px">
                                     <iconify-icon icon="lucide:mail" style="font-size:14px;color:inherit"></iconify-icon>
                                     </div>LOS : ${row.LOS} yrs
                                  </span>
                                </div>

                             </td>

                                <td>
                                  <span class="status-text success">${row.StatusName}</span>
                                </td>

                                <td>
                                  <span class="source-text">${row.CategoryName}</span>
                                </td>
                            </tr>
                     `;

                  tr.addEventListener("click", () => {
                      window.location.href = `/P1SA/Manpower/EmployeeProductionDetails?EmployeeId=${row.EmployeeId}&role=0`;
                  });

                  fragment.appendChild(tr);
            });

            this.tbody.appendChild(fragment);

        }


        renderEmpty() {
            this.tbody.innerHTML = `<tr>
                 <td colspan="5" style="text-align:center;color:#999">
                     ⚠️ No records found
                 </td>
             </tr>`;
        }

        renderError() {
            this.tbody.innerHTML = `<tr>
             <td colspan="5" style="text-align:center;color:red">
                 Failed to load data
             </td>
         </tr>`;
        }


        renderPagination(totalItems) {
            const totalPages = Math.ceil(totalItems / this.pageSize);


            const startItem = totalItems === 0
                ? 0
                : (this.currentPage - 1) * this.pageSize + 1;


            const endItem = Math.min(this.currentPage * this.pageSize, totalItems);

            // Update text info
            // update text
            document.getElementById("resultsText").textContent =
                `SHOWING_INDEX: ${startItem}-${endItem} OF ${totalItems}`;

            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            // button states
            prevBtn.classList.toggle("disabled", this.currentPage === 1);
            nextBtn.classList.toggle("disabled", this.currentPage === totalPages || totalPages === 0);

            // remove old listeners by cloning
            prevBtn.replaceWith(prevBtn.cloneNode(true));
            nextBtn.replaceWith(nextBtn.cloneNode(true));

            const newPrevBtn = document.getElementById("prevBtn");
            const newNextBtn = document.getElementById("nextBtn");

            newPrevBtn.addEventListener("click", () => {
                if (this.currentPage > 1) {
                    this.currentPage--;
                    this.LoadEmployeeData();
                }
            });

            newNextBtn.addEventListener("click", () => {
                if (this.currentPage < totalPages) {
                    this.currentPage++;
                    this.LoadEmployeeData();
                }
            });
        }


        /* ================= ADD EMPLOYEE ================= */
        async SaveNewEmployee() {
            const employeeCode = document.getElementById("n-code").value.trim();
            const fullName = document.getElementById("n-name").value.trim();
            const dateHired = document.getElementById("n-hired").value;

            // Minimal required-field guard — mirrors P1SAEmployeesInputModel's non-nullable members
            if (!employeeCode || !fullName || !dateHired) {
                alert("Employee Code, Full Name, and Date Hired are required.");
                return;
            }

            const model = {
                EmployeeCode: employeeCode,
                FullName: fullName,
                Gender: document.getElementById("n-gender").value === "Female",
                DateHired: dateHired,
                DateOfBirth: document.getElementById("n-dob").value || null,
                Email: document.getElementById("n-email").value.trim(),
                Phone: document.getElementById("n-phone").value.trim(),
                Address: document.getElementById("n-address").value.trim(),
                PickUpPoint: document.getElementById("n-pickup").value.trim(),
                Province: null, // no field in modal yet — left null, not omitted, so the model shape stays explicit
                Category: document.querySelector('input[name="cat"]:checked').value === "Direct" ? 0 : 1,
                JobTitleId: parseInt(document.getElementById("n-jobtitle").value, 10),
                DepartmentId: parseInt(document.getElementById("n-department").value, 10),
                AgencyId: parseInt(document.getElementById("n-agency").value, 10),
                StatusId: 0, // Active — new hires default to Active status
                Remarks: document.getElementById("n-remarks").value.trim() || null
            };

            const saveBtn = document.getElementById("modalSave");
            saveBtn.disabled = true;
            saveBtn.textContent = "Saving...";



            try {
                const res = await postMethod('@Url.Action("AddEmployeeList", "Manpower")', model);
                console.log(res);
                if (!res?.Success) {
                    alert(res?.Message ?? "Failed to save employee.");
                    return;
                }
                const newEmployeeId = res.data.EmployeeId;
                const newEmployeeCode = res.data.EmployeeCode;
                // Photo is optional and uploaded separately since it needs the new EmployeeId for the filename
                const photoInput = document.getElementById("newPhotoInput");
                if (photoInput.files.length > 0) {
                    const formData = new FormData();
                    formData.append("EmployeeId", newEmployeeId);
                    formData.append("EmployeeCode", newEmployeeCode);
                    formData.append("photo", photoInput.files[0]);

                    const photo = await postMethod('@Url.Action("UploadEmployeePhoto", "Manpower")', formData);
                    console.log("IMAGE HERE");
                    console.log(photo);
                    
                }

                bootstrap.Modal.getInstance(document.getElementById("addEmployeeModal")).hide();
                this.resetAddForm();
                this.currentPage = 1;
                await this.LoadEmployeeData();

            } catch (err) {
                console.error(err);
                alert("An error occurred while saving the employee.");
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = "Save Employee";
            }
        }


        resetAddForm() {
            [
                "n-name",
                "n-code",
                "n-dob",
                "n-email",
                "n-phone",
                "n-address",
                "n-pickup",
                "n-hired",
                "n-remarks"
            ].forEach(id => {
                document.getElementById(id).value = "";
            });

            document.getElementById("n-gender").selectedIndex = 0;
            document.getElementById("n-civilStats").selectedIndex = 0;
            document.getElementById("n-department").selectedIndex = 0;
            document.getElementById("n-jobtitle").selectedIndex = 0;
            document.getElementById("n-agency").selectedIndex = 0;

            document.getElementById("catDirect").checked = true;

            // Reset photo
            const photoInput = document.getElementById("newPhotoInput");
            const preview = document.getElementById("newAvatarPreview");

            photoInput.value = "";

            preview.textContent = "+";
            preview.style.backgroundImage = "";
        }

    }

    document.addEventListener("DOMContentLoaded", () => {
        const req = new EmployeeController();
        req.init();
    });
</script>