






<!DOCTYPE html>

<html>
<head>
    @Html.Partial("_SystemConfig")
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>P1SA MANPOWER DATA</title>
    <link href="~/Content/css/ManpowerDesign.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">


    <script src="~/Scripts/iconify-icon.min.js"></script>
    <script src="~/Scripts/Shared/bootstrap.bundle.min.js"></script>
    <link href="~/Content/Shared/bootstrap.min.css" rel="stylesheet" />

    @Scripts.Render("~/bundles/shared-js")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="shell">
        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="3" stroke="#5C7A87" stroke-width="1.6" /><path d="M7 12h10M7 8h6M7 16h4" stroke="#5C7A87" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <div><div class="brand-name">Manpower System</div></div>
                </div>
                <div class="brand-sub">SANYO DENKI PHILIPPINES</div>
            </div>

            <nav class="nav" id="nav">

                @*<div class="nav-item" data-module="dashboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="4" y="13" width="4" height="7" rx="0.8" stroke="currentColor" stroke-width="1.6" /><rect x="10" y="8" width="4" height="12" rx="0.8" stroke="currentColor" stroke-width="1.6" /><rect x="16" y="4" width="4" height="16" rx="0.8" stroke="currentColor" stroke-width="1.6" /></svg>
                    <span>Dashboard Overall</span>
                </div>*@

                <div class="nav-item" data-module="employees">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.6" /><path d="M5 20c1.2-3.8 4-5.6 7-5.6s5.8 1.8 7 5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <span>Employee List</span>
                </div>

                <div class="nav-item" data-module="attendance">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="15" rx="1.5" stroke="currentColor" stroke-width="1.6" /><path d="M4 9.5h16M8 3v3.5M16 3v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <span>Attendance Summary</span>
                </div>

                <div class="nav-item" data-module="absence">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.4" stroke="currentColor" stroke-width="1.6" /><path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <span>Absence</span>
                </div>

                <div class="nav-item" data-module="crosstrainee">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 7l6 4-6 4V7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M20 7l-6 4 6 4V7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <span>Cross Trainee</span>
                </div>

            </nav>

            <div class="sidebar-foot">
                <div class="who">HR Manpower Admin</div>
                Production Support · Shift A
            </div>
        </aside>

        <!-- ============ MAIN ============ -->
        <main class="main">


            <div class="contentV2">
                @RenderBody();
            </div>
        </main>
    </div>


    <script>
    document.addEventListener("DOMContentLoaded", function () {

        var navItems = document.querySelectorAll("#nav .nav-item");
          // dashboard: '@Url.Action("Dashboard", "Manpower", new { area = "P1SA" })',
        var navRoutes = {
            employees: '@Url.Action("ManageEmployee", "Manpower", new { area = "P1SA" })',
            attendance: '@Url.Action("AttendanceSummary", "Manpower", new { area = "P1SA" })',
            absence: '@Url.Action("ManageAbsence", "Manpower", new { area = "P1SA" })',
            crosstrainee: '@Url.Action("CrossTrainee", "Manpower", new { area = "P1SA" })'
        };


        // ============================================================
        // CURRENT URL
        // ============================================================
        var currentPath = window.location.pathname.toLowerCase();


        // ============================================================
        // ACTIVE NAV
        // ============================================================
        navItems.forEach(function (item) {

            var module = item.getAttribute("data-module");
            var route = navRoutes[module];

            if (route &&
                currentPath === new URL(route, window.location.origin)
                    .pathname
                    .toLowerCase()) {

                item.classList.add("active");
            }

        });


        // ============================================================
        // CLICK NAV
        // ============================================================
        navItems.forEach(function (item) {

            item.style.cursor = "pointer";

            item.addEventListener("click", function () {

                var module = this.getAttribute("data-module");
                var route = navRoutes[module];

                if (!route) {
                    console.warn("Route not found:", module);
                    return;
                }

                // Active immediately
                navItems.forEach(function (nav) {
                    nav.classList.remove("active");
                });

                this.classList.add("active");

                // Navigate
                window.location.href = route;
            });

        });

    });
    </script>
</body>
</html>




