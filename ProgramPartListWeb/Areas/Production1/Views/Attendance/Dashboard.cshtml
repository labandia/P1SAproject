
@{
    Layout = "~/Areas/Production1/Views/Shared/_AttendanceLayout.cshtml";
}
<div class="dashboard-wrapper">
    <div class="dashboard">

        <!-- HEADER -->
        <header>
            <h2>📋PRODUCTION 1 ATTENDANCE DASHBOARD - <span> <strong id="shiftDay">DAYSHIFT</strong>(<span id="datetodayShift">-/--/----</span>)</span></h2>
            <div class="animToggleWrap" style="display: none;">
                <button id="manualRefreshBtn" class="manualRefreshBtn" title="Refresh now" type="button">
                    <svg id="refreshIcon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                              d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6" />
                    </svg>
                    <span>Refresh</span>
                </button>


                <label class="animToggle" for="refreshToggleInput" title="Toggle auto-refresh">
                    <input type="checkbox" id="refreshToggleInput" checked>
                    <span class="animToggle_track"><span class="animToggle_thumb"></span></span>
                    <span class="animToggle_label" id="refreshToggleLabel">Auto-Refresh: ON</span>
                </label>
            </div>

            <div id="screenSizeBadge" class="screenSizeBadge" title="Screen / Viewport size">
                🖥️ Screen: <strong id="screenSize">-- x --</strong>
                &nbsp;|&nbsp;
                Viewport: <strong id="viewportSize">-- x --</strong>
            </div>
        </header>

        <!-- KPI CARDS -->
        <div class="attendSummary">
            <!-- Total Headcount -->
            <div class="attendSummary_card loop-anim">
                
                <div class="attendSummary_content">
                    <span>Total Headcount</span>
                    <p id="totalhead">0</p>
                </div>
            </div>
            <!-- Present -->
            <div class="attendSummary_card loop-anim">
                
                <div class="attendSummary_content">
                    <span>Present</span>
                    <p id="presentCount">0</p>
                </div>
            </div>
            <!-- Absent -->
            <div class="attendSummary_card loop-anim">
                
                <div class="attendSummary_content">
                    <span>Absent</span>
                    <p id="absentCount">0</p>
                </div>
            </div>
            <!-- Absent Rate -->
            <div class="attendSummary_card loop-anim">
                <div class="attendSummary_content">
                    <span>Attendance Rate</span>
                    <p id="absentrateCount">0% </p>
                </div>
            </div>

            <!-- 10% Reduction Target -->
            <div class="attendSummary_card loop-anim">
                <div class="attendSummary_content">
                    <span>10% Reduction Target</span>
                    <p id="targetCount">0</p>
                </div>
            </div>
            <!-- Actual Result -->
            <div class="attendSummary_card loop-anim">
                <div class="attendSummary_content">
                    <span>Actual Result</span>
                    <p id="actualCount">0</p>
                </div>
            </div>
            <!-- Achievement -->
            <div class="attendSummary_card loop-anim">
                <div class="attendSummary_content">
                    <span>Overall Achievement</span>
                    <p id="achieveRate">0%</p>
                </div>
            </div>
        </div>

        <div class="chartsRow">
            <div class="chartCard">
                <div class="chartCardHead">
                    <h3>Target vs. Actual Result</h3>
                    <div class="chartLegend">
                        <span><i style="background:#2f80d8"></i>10% Reduction Target</span>
                        <span><i style="background:#f57c2b"></i>Actual Result</span>
                    </div>
                </div>
                <div class="chartBox"><canvas id="targetChart"></canvas></div>
            </div>
            <div class="chartCard">
                <div class="chartCardHead">
                    <h3>Production 1 Status</h3>
                    <div class="chartLegend">
                        <span><i style="background:#34c77b"></i>Achieved <b id="achCnt" style="margin-left:4px">0</b></span>
                        <span><i style="background:#f0596a"></i>Not <b id="notCnt" style="margin-left:4px">0</b></span>
                    </div>
                </div>
                <div class="chartBox"><canvas id="statusChart"></canvas></div>
            </div>
            <div class="chartCard">
                <div class="chartCardHead"><h3>Actual Result Breakdown</h3></div>
                <div class="chartBox"><canvas id="otChart"></canvas></div>
            </div>
        </div>

        <!-- TWO COLUMN -->
        <div class="analysisTables">

            <!-- LEFT COLUMN -->
            <div class="col">
                <!-- Department Table -->
                <div class="tablecontainer maintable">
                    <div class="tableHeader">
                        <h3>🏢 Attendance Breakdown</h3>

                        <div class="date-filter">
                            <button type="button" id="datePrev" class="dateBtn" tabindex="0">&#9664;</button>
                            <input type="text" id="filterDate" readonly />
                            <button type="button" id="dateNext" class="dateBtn" tabindex="0">&#9654;</button>
                            <button type="button" id="dateToday" class="dateBtn" tabindex="0" style="width:auto;padding:0 6px;">Today</button>
                        </div>
                    </div>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th rowspan="2" >Section</th>
                                    <th colspan="6" class="grp sepL" style="text-align:center;">Attendance</th>
                                    <th colspan="9" class="grp sepL" style="text-align:center;">10% reduction and overtime</th>
                                </tr>
                                <tr class="subtheader">
                                    <th >DS</th>
                                    <th>NS</th>
                                    <th class="sepL">Total</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Rate</th>
                                    <th>Reduct 10%</th>
                                    <th>0 </th>
                                    <th>1 </th>
                                    <th>2 </th>
                                    <th>3 </th>
                                    <th>Total OT</th>
                                    <th>Gap</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="departmentBreakdown">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th id="TotalDay">0</th>
                                    <th id="TotalNight">0</th>
                                    <th id="TotalGHead">0</th>
                                    <th id="TotalPresent">0</th>
                                    <th id="TotalAbsent">0</th>
                                    <th id="TotalRate">0%</th>
                                    <th class="rc rc-first" id="TotalReduct">0</th>
                                    <th class="rc" id="TotalOt">0</th>
                                    <th class="rc" id="TotalOt1">0</th>
                                    <th class="rc" id="TotalOt2">0</th>
                                    <th class="rc" id="TotalOt3">0</th>
                                    <th class="rc" id="TotalActual">0</th>
