    </div>
</div>

<script src="~/Scripts/chart.js"></script>
<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

    const REFRESH_INTERVAL_MS = 10000; // 1 minute



    class AttendanceDashboardController {
        constructor() {
            this.isfilter = 0;
            this.summarydata = [];

            this.filterDateSelect =
                document.getElementById("filterDate");

            this.tbody =
                document.querySelector('.maintable tbody');

            this._animFrames = new Map();

            // IMPORTANT:
            // This survives every refreshAll()
            this._lastValues = new Map();

            this._refreshTimer = null;
            this.autoRefreshEnabled = true;

            this.targetChart = this.statusChart = this.otChart = null;
        }

        async init() {
            this.setShift();
            setInterval(() => this.setShift(), 10000); // fixed: was calling setShift() immediately and passing undefined to setInterval

            this.updateScreenSize();
            window.addEventListener('resize', () => this.updateScreenSize());

            await this.refreshAll();

            this.initRefreshToggle();
            this.initManualRefresh();
            this.initDateButtons();

            this.filterDateSelect.addEventListener('change', async (e) => {
                this.isfilter = 1;
                await this.refreshAll();
            });
        }

        initDateButtons() {
            const input = this.filterDateSelect;

            const pad = n => String(n).padStart(2, '0');

            const fmt = d =>
                `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            // Normalize a date string to yyyy-MM-dd
            const normalizeDate = (value) => {
                if (!value) return null;

                const text = String(value).trim();

                // yyyy-MM-dd or yyyy-MM-dd HH:mm:ss
                const isoMatch = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);

                if (isoMatch) {
                    return `${isoMatch[1]}-${pad(Number(isoMatch[2]))}-${pad(Number(isoMatch[3]))}`;
                }

                // MM/dd/yyyy
                const usMatch = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);

                if (usMatch) {
                    return `${usMatch[3]}-${pad(Number(usMatch[1]))}-${pad(Number(usMatch[2]))}`;
                }

                return null;
            };

            // Get today's date from the database display
            const getDatabaseToday = () => {
                const text = document.getElementById('datetodayShift')
                    ?.textContent?.trim();

                return normalizeDate(text) || fmt(new Date());
            };

            const shift = async (days) => {
                const baseDate =
                    normalizeDate(input.value) || getDatabaseToday();

                const parts = baseDate.split('-');

                const d = new Date(
                    Number(parts[0]),
                    Number(parts[1]) - 1,
                    Number(parts[2])
                );

                d.setDate(d.getDate() + days);

                input.value = fmt(d);
                this.isfilter = 1;

                await this.refreshAll();
            };

            const prev = document.getElementById('datePrev');
            const next = document.getElementById('dateNext');
            const today = document.getElementById('dateToday');

            if (prev) {
                prev.addEventListener('click', () => shift(-1));
            }

            if (next) {
                next.addEventListener('click', () => shift(1));
            }

            if (today) {
                today.addEventListener('click', async () => {
                    input.value = getDatabaseToday();
                    this.isfilter = 0;

                    await this.refreshAll();
                });
            }
        }

        initManualRefresh() {
            const btn = document.getElementById('manualRefreshBtn');
            if (!btn) return;

            btn.addEventListener('click', () => {
                // Hard refresh: cache-busting param forces the browser to bypass
                // cache and re-request everything (HTML, scripts, styles) fresh —
                // same effect as Ctrl+Shift+R.
                const url = new URL(window.location.href);
                url.searchParams.set('_hardrefresh', Date.now());
                window.location.href = url.toString();
            });
        }

        initRefreshToggle() {
            const toggle = document.getElementById('refreshToggleInput');
            const label = document.getElementById('refreshToggleLabel');
            if (!toggle) return;

            // start enabled by default (checkbox is checked in the markup)
            this.startAutoRefresh();

            toggle.addEventListener('change', () => {
                this.autoRefreshEnabled = toggle.checked;

                if (this.autoRefreshEnabled) {
                    this.startAutoRefresh();
                    if (label) label.textContent = 'Auto-Refresh: ON';
                } else {
                    this.stopAutoRefresh();
                    if (label) label.textContent = 'Auto-Refresh: OFF';
                }
            });
        }

        startAutoRefresh() {
            // clear any existing timer first so toggling on/off repeatedly never stacks intervals
            this.stopAutoRefresh();
            this._refreshTimer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL_MS);
        }

        stopAutoRefresh() {
            if (this._refreshTimer) {
                clearInterval(this._refreshTimer);
                this._refreshTimer = null;
            }
        }

        async refreshAll() {
            await this.GetAttendanceSummary();
            await this.GetAttendanceBreakDown();
            await this.GetAttendanceTrends();
        }


        async GetAttendanceSummary() {
            try {
                   const filterDate = document.getElementById("filterDate");

                    const res = await getMethod(
                        '@Url.Action("GetAttendanceSummary", "Attendance")',
                        {
                            filterDate: filterDate.value,
                            isfilter: this.isfilter
                        }
                    );

                    if (!res?.Success) {
                        console.log('No data found in Group Data');
                        return;
                    }

                    this.summarydata = res.data.Listdata;
                    this.RenderAttendanceSummary(this.summarydata);

                    // Database date
                    const today = res.data.today.split(" ")[0];

                    document.getElementById("datetodayShift").textContent = today;

                    // Initialize the date filter using the database date
                    if (!filterDate.value || this.isfilter === 0) {
                        filterDate.value = today;
                    }

            } catch (error) {
                console.error('Error fetching attendance summary:', error);
            }
        }

        RenderAttendanceSummary(data) {
            // console.log("Attendance Summary:", data);
            const totalEl = document.getElementById("totalhead");
            const presentEl = document.getElementById("presentCount");
            const absentEl = document.getElementById("absentCount");
            const absentRateEl = document.getElementById("absentrateCount");

            const reductEl = document.getElementById("targetCount");
            const actualEl = document.getElementById("actualCount");
            // const achievEL = document.getElementById("achieveRate");

            totalEl.innerText = "0";
            presentEl.innerText = "0";
            absentEl.innerText = "0";
            absentRateEl.innerText = "0";
            reductEl.innerText = "0";
            actualEl.innerText = "0";
            // achievEL.innerText = "0";

            // For the Summary section on the right
            const SumtotalEl = document.getElementById("totalHeadcount");
            const SumpresentEl = document.getElementById("totalPresent");
            const SumabsentEl = document.getElementById("totalAbsent");
            const SumabsentRateEl = document.getElementById("totalAntendanceRate");
            const SumbsentRateEl = document.getElementById("totalAbsentRate");



            SumtotalEl.innerText = "0";
            SumpresentEl.innerText = "0";
            SumabsentEl.innerText = "0";
            SumabsentRateEl.innerText = "0";
            SumbsentRateEl.innerText = "0";

            this.animateNumber(totalEl, data.TotalHeadCount, 1200);
            this.animateNumber(presentEl, data.TotalEmployees, 1200);
            this.animateNumber(absentEl, data.TotalAbsent, 1200);
            this.animateNumber(absentRateEl, data.AttendRate, 1200, ' %');

            // this.animateNumber(reductEl, data.TotalEmployees, 1200);
            // this.animateNumber(actualEl, data.TotalAbsent, 1200);
            // this.animateNumber(achievEL, data.AttendRate, 1200, ' %');


            // Right Summary
            this.animateNumber(
                SumtotalEl,
                data.TotalHeadCount, 1200);

            this.animateNumber(
                SumpresentEl,
                data.TotalEmployees, 1200);

            this.animateNumber(
                SumabsentEl,
                data.TotalAbsent, 1200);

            this.animateNumber(
                SumabsentRateEl,
                data.AttendRate, 1200, ' %');

            this.animateNumber(
                SumbsentRateEl,
                data.AbsentRate, 1200, ' %');
        }




        async GetAttendanceBreakDown() {
            try {
                let strdate = document.getElementById("filterDate").value;

                const res = await getMethod('@Url.Action("GetAttendanceBreakDown", "Attendance")', { filterDate: strdate, isfilter: this.isfilter });
                if (!res?.Success) {
                    console.log('No data found in Group Data ');
                    return;
                }
                console.log(res);
                this.renderTable(res.data);
                //console.log(res.data);
                //console.log(res.data);
            } catch (error) {
                console.error('Error fetching group data:', error);
            }
        }

        renderTable(data) {
            if (!this.tbody) return;

            // keep a mutable copy so edits recompute totals without a re-fetch
            this.currentData = data.map(row => ({ ...row }));

            if (data.length === 0) {
                this.tbody.innerHTML = `
                     <tr>
                         <td colspan="12" style="text-align:center; padding:32px; color:#86868b;">
                             No data available.
                         </td>
                     </tr>`;
                this.RenderTotals([], 0);
                this.RenderCharts([]);
                return;
            }

            let countAchieve = 0;

            this.tbody.innerHTML = this.currentData.map(row => {

                if (row.ResultStatus == 'Achieved') {
                    console.log("GOOD");
                    countAchieve += 1;
                }

                return `
                   <tr class='fade-in'
                       data-dash-id="${row.DashID}">
                             <td style='font-weight: 600;'>${row.DepartmentName}</td>
                             <td>
                                 <input type="number" class="edit-input" data-dash-id="${row.DashID}" data-field="DayShiftCount" value="${row.DayShiftCount ?? 0}" min="0">
                             </td>
                             <td>
                                 <input type="number" class="edit-input" data-dash-id="${row.DashID}" data-field="NightShiftCount" value="${row.NightShiftCount ?? 0}" min="0">
                             </td>

                             <td>${row.TotalHeadCount || ''}</td>
                             <td>${row.PresentCount}</td>
                             <td class="status-column">${row.Absent || '0'}</td>
                             <td style='border: 1px solid #2a4a72;  border-left: none;'> <span class="rate-badge">${row.AttendanceRate ?? '0'}%</span>    </td>

                             <td>${row.ReductionPercent || ''}</td>
                             <td>${row.Overtime || '0'}</td>
                             <td>${row.Overtime_1 || '0'}</td>
                             <td>${row.Overtime_2 || '0'}</td>
                             <td>${row.Overtime_3 || '0'}</td>
                             <td>${row.ActualResult || '0'}</td>
                             <td>${row.GapResult || '0'}</td>

                             <td> <span class="status-pill ${row.ResultStatus == 'Achieved' ? 'ok' : 'bad'}">${row.ResultStatus || ''}</span></td>
                     </tr>`;
            }).join('');

            this.RenderTotals(this.currentData, countAchieve);
            this.RenderCharts(this.currentData);    // <-- add
            this.BindEditInputs();
        }

        RenderTotals(data, totalachive) {
            const totals = data.reduce((acc, row) => {
                acc.day += Number(row.DayShiftCount) || 0;
                acc.night += Number(row.NightShiftCount) || 0;
                acc.head += Number(row.TotalHeadCount) || 0;
                acc.present += Number(row.PresentCount) || 0;
                acc.absent += Number(row.Absent) || 0;
                acc.reduct += Number(row.ReductionPercent) || 0;
                acc.over += Number(row.Overtime) || 0;
                acc.over1 += Number(row.Overtime_1) || 0;
                acc.over2 += Number(row.Overtime_2) || 0;
                acc.over3 += Number(row.Overtime_3) || 0;
                acc.actual += Number(row.ActualResult) || 0;
                acc.gap += Number(row.GapResult) || 0;
                return acc;
            }, { day: 0, night: 0, head: 0, present: 0, absent: 0, reduct: 0, over: 0, over1: 0, over2: 0, over3: 0, actual: 0, gap: 0 });

            const attendRate = totals.head > 0 ? ((totals.present / totals.head) * 100).toFixed(0) : 0;
            const achieve = totals.reduct > 0 ? ((totals.actual / totals.reduct) * 100).toFixed(2) : '0';

            const isTotal = ((totalachive / 7 * 100)).toFixed(2);
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

            set('TotalDay', totals.day);
            set('TotalNight', totals.night);
            set('TotalGHead', totals.head);
            set('TotalPresent', totals.present);
            set('TotalAbsent', totals.absent);
            set('TotalRate', `${attendRate}%`);
            set('TotalReduct', totals.reduct);
            set('TotalOt', totals.over);
            set('TotalOt1', totals.over1);
            set('TotalOt2', totals.over2);
            set('TotalOt3', totals.over3);
            set('TotalActual', totals.actual);
            set('TotalGap', totals.gap);
            set('IsStatus', isTotal);
            set('TotalAchieve', `${isTotal}%`);
            console.log(`Total Achieves` + isTotal);
            // KPI cards
            set('targetCount', totals.reduct);
            set('actualCount', totals.actual);
            set('achieveRate', `${isTotal}%`);
            set('ot1Count', totals.over1);   // only if you add the OT cards
            set('ot2Count', totals.over2);
            set('ot3Count', totals.over3);
        }

        BindEditInputs() {
                this.tbody.querySelectorAll('.edit-input').forEach(input => {
                    input.addEventListener('change', async (e) => {
                        const dashId = e.target.dataset.dashId;
                        const field = e.target.dataset.field;
                        const value = Number(e.target.value) || 0;

                        const rowData = this.currentData.find(r => r.DashID == dashId);
                        if (rowData) rowData[field] = value;
                        console.log(`ID :${dashId} - Column : ${field} - value : ${value}`)
                        // keep tfoot in sync with the edited value immediately
                        // this.RenderTotals(this.currentData);
                        await this.UpdateAttendanceBreakDown(dashId, field, value, e.target);
                    });
                });
            }


            async UpdateAttendanceBreakDown(dashId, field, value, inputEl) {
                try {
                    const res = await postMethod('@Url.Action("UpdateAttendanceBreakDown", "Attendance")', {
                        DashID: dashId,
                        [field]: value
                    });


                    if (!res?.Success) {
                        console.log('Update failed for DashID ' + dashId);
                        inputEl.classList.add('input-error');
                        return;
                    }

                    inputEl.classList.remove('input-error');
                    await this.GetAttendanceSummary();
                    await this.GetAttendanceBreakDown();
                    await this.GetAttendanceTrends();
                } catch (error) {
                    console.error('Error updating breakdown:', error);
                    inputEl.classList.add('input-error');
                }
            }

             async GetAttendanceTrends() {
                 try {
                     let strdate = document.getElementById("filterDate").value;

                     const res = await getMethod('@Url.Action("GetAttendanceTrends", "Attendance")', { filterDate: strdate });
                     if (!res?.Success) {
                        console.log('No data found in Group Data ');
                        return;
                     }
                     this.RenderTrendsChart(res.data);
                     //console.log(res.data);
                 } catch (error) {
                     console.error('Error fetching group data:', error);
                 }
             }

        RenderTrendsChart(data) {
            const labels = data.map(d => {
                const date = new Date(d.DateToday);
                return `${date.getMonth() + 1}/${date.getDate()}`;
            });
            const attendRates = data.map(d => d.AttendRate);
            const absentRates = data.map(d => d.AbsentRate);

            if (this.trendChart) {
                this.trendChart.destroy();
                this.trendChart = null;
            }
            const chartContainer = document.getElementById('ChartTrends');
            chartContainer.style.maxHeight = '160px';


            // clips the chart area horizontally based on animation progress,
            // giving a "drawing" effect instead of the default fade-in.
            const drawLinePlugin = {
                id: 'drawLine',
                beforeDatasetsDraw(chart) {
                    const { ctx, chartArea: { left, top, width, height } } = chart;
                    const progress = chart.$drawLineProgress ?? 0;
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(left, top, width * progress, height);
                    ctx.clip();
                },
                afterDatasetsDraw(chart) {
                    chart.ctx.restore();
                }
            };

            // draws each point's value above the point, in the dataset's color.
            // runs after the clip plugin restores the context, so labels are not
            // clipped and only appear once the line has actually drawn past them
            const pointLabelsPlugin = {
                id: 'pointLabels',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const progress = chart.$drawLineProgress ?? 0;

                    chart.data.datasets.forEach((dataset, datasetIndex) => {
                        const meta = chart.getDatasetMeta(datasetIndex);
                        if (meta.hidden) return;

                        meta.data.forEach((point, index) => {
                            const pointProgress = (index + 1) / meta.data.length;
                            if (progress < pointProgress) return;

                            const value = Math.round(dataset.data[index]);
                            ctx.save();
                            ctx.fillStyle = dataset.borderColor;
                            ctx.font = 'bold 11px sans-serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            ctx.fillText(`${value}%`, point.x, point.y - 8);
                            ctx.restore();
                        });
                    });
                }
            };
            const ctx = document.getElementById('trendChart').getContext('2d');
            this.trendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Attendance Rate',
                            data: attendRates,
                            borderColor: '#2E5AAC',
                            backgroundColor: '#2E5AAC',
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#2E5AAC',
                            pointBorderWidth: 2,
                            tension: 0.3,
                            fill: false
                        },
                        {
                            label: 'Absent Rate',
                            data: absentRates,
                            borderColor: '#E8842C',
                            backgroundColor: '#E8842C',
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#E8842C',
                            pointBorderWidth: 2,
                            tension: 0.3,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: { top: 14 }
                    },
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            ticks: {
                                stepSize: 25,
                                autoSkip: false,
                                maxTicksLimit: 5,
                                font: { size: 7 },
                                color: '#fff',
                                callback: v => `${v}%`
                            },
                            grid: { color: 'rgba(255, 255, 255, 0.1)' }
                        },
                        x: {
                            ticks: {
                                font: { size: 7 },
                                color: '#fff'
                            },
                            grid: { color: 'rgba(255, 255, 255, 0.1)' }
                        }
                    },
                    animation: {
                        duration: 1500,
                        easing: 'easeInOutQuart',
                        onProgress: (animation) => {
                            animation.chart.$drawLineProgress =
                                animation.currentStep / animation.numSteps;
                        }
                    }
                },
                plugins: [drawLinePlugin, pointLabelsPlugin]
            });
        }

            setShift() {
                const now = new Date();

                const hour = now.getHours();
                const minute = now.getMinutes();

                // Convert current time to minutes since midnight
                const currentMinutes = hour * 60 + minute;

                const dayShiftStart = 6 * 60 + 30;   // 06:30
                const nightShiftStart = 18 * 60 + 30; // 18:30

                let shift;
                let shiftDate = new Date(now);

                if (currentMinutes >= dayShiftStart && currentMinutes < nightShiftStart) {
                    // 06:30 AM - 06:29 PM
                    shift = "DAYSHIFT";
                } else {
                    // 06:30 PM - 06:29 AM
                    shift = "NIGHTSHIFT";

                    // After midnight, still belongs to the previous day's night shift
                    if (currentMinutes < dayShiftStart) {
                        shiftDate.setDate(shiftDate.getDate() - 1);
                    }
                }

                const dateText = `${shiftDate.getMonth() + 1}/${shiftDate.getDate()}/${shiftDate.getFullYear()}`;

                document.getElementById("shiftDay").textContent =
                    `${shift}`;
        }


        // NEW METHOD — add this anywhere in the class body
        fitDashboard() {
            const wrapper = document.querySelector('.dashboard-wrapper');
            const stage = document.querySelector('.dashboard');
            if (!wrapper || !stage) return;

            // reset any previous scale before measuring, or offsetHeight would read the already-scaled size
            stage.style.transform = 'scale(1)';

            const naturalWidth = stage.offsetWidth;
            const naturalHeight = stage.offsetHeight;
            const availWidth = wrapper.clientWidth;
            const availHeight = wrapper.clientHeight;

            const scale = Math.min(availWidth / naturalWidth, availHeight / naturalHeight);

            stage.style.transform = `scale(${scale})`;
            wrapper.style.height = `${naturalHeight * scale}px`;
        }

        animateNumber(el, endValue, duration = 800, suffix ='') {
            if (!el) return;

            if (this._animFrames.has(el)) {
                cancelAnimationFrame(this._animFrames.get(el));
                this._animFrames.delete(el);
            }

            const startValue = parseFloat(el.innerText.replace(/,/g, '')) || 0;
            const change = endValue - startValue;

            // Value unchanged — still give a visual "refreshed" cue instead of a silent no-op
            if (change === 0) {
                el.innerText = this.changeformatnumber(endValue);
                el.style.transition = 'none';
                el.style.opacity = '0.35';
                requestAnimationFrame(() => {
                    el.style.transition = `opacity ${Math.min(duration, 400)}ms ease`;
                    el.style.opacity = '1';
                });
                return;
            }

            const startTime = performance.now();
            const ease = t => 1 - Math.pow(1 - t, 3);

            const step = (now) => {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = ease(progress);
                const current = startValue + change * eased;

                el.innerText = this.changeformatnumber(Math.round(current)) + suffix;

                if (progress < 1) {
                    const frameId = requestAnimationFrame(step);
                    this._animFrames.set(el, frameId);
                } else {
                    el.innerText = this.changeformatnumber(endValue) + suffix;
                    this._animFrames.delete(el);
                }
            };

            const frameId = requestAnimationFrame(step);
            this._animFrames.set(el, frameId);
        }

        stopLoop(el) {
            if (this._animFrames?.has(el)) {
                cancelAnimationFrame(this._animFrames.get(el));
                this._animFrames.delete(el);
            }
        }

        animateNumberIfChanged(el, endValue, duration = 800, suffix = '') {
            if (!el) return;

            endValue = Number(endValue) || 0;

            const key = el.id;

            // First load
            if (!this._lastValues.has(key)) {
                this._lastValues.set(key, endValue);

                el.textContent =
                    this.changeformatnumber(endValue) + suffix;

                return;
            }

            const previousValue = this._lastValues.get(key);

            // No change -> DO NOTHING
            if (previousValue === endValue) {
                return;
            }

            // Cancel previous animation
            this.stopLoop(el);

            const startValue = previousValue;
            const change = endValue - startValue;

            const startTime = performance.now();

            const ease = t => 1 - Math.pow(1 - t, 3);

            const step = (now) => {

                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = ease(progress);

                const current =
                    startValue + (change * eased);

                el.textContent =
                    this.changeformatnumber(Math.round(current)) + suffix;

                if (progress < 1) {

                    const frameId = requestAnimationFrame(step);
                    this._animFrames.set(el, frameId);

                } else {

                    // Final value
                    el.textContent =
                        this.changeformatnumber(endValue) + suffix;

                    // IMPORTANT:
                    // Save the value only after animation completes
                    this._lastValues.set(key, endValue);

                    this._animFrames.delete(el);
                }
            };

            const frameId = requestAnimationFrame(step);
            this._animFrames.set(el, frameId);
        }



        RenderCharts(data) {


            if (typeof Chart === 'undefined') return;

            const TEXT = '#fff';
            const GRID = 'rgba(255,255,255,0.1)';

            const labels = data.map(r => r.DepartmentName);
            const targets = data.map(r => Number(r.ReductionPercent) || 0);
            const actuals = data.map(r => Number(r.ActualResult) || 0);

            const sum = f => data.reduce((a, r) => a + (Number(r[f]) || 0), 0);
            const ot = [
                sum('Overtime'),
                sum('Overtime_1'),
                sum('Overtime_2'),
                sum('Overtime_3')
            ];

            const achieved = actuals.filter((a, i) => a >= targets[i]).length;
            const notAchieved = data.length - achieved;

            document.getElementById('achCnt').textContent = achieved;
            document.getElementById('notCnt').textContent = notAchieved;


            // ============================================================
            // BAR VALUE LABELS
            // ============================================================
            const barLabels = {
                id: 'barLabels',

                afterDatasetsDraw(chart) {
                    const { ctx } = chart;

                    chart.data.datasets.forEach((ds, i) => {
                        const meta = chart.getDatasetMeta(i);

                        if (meta.hidden) return;

                        meta.data.forEach((bar, idx) => {

                            ctx.save();

                            ctx.fillStyle = TEXT;

                            // Smaller value text
                            ctx.font = 'bold 8px sans-serif';

                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';

                            // Smaller gap from bar
                            ctx.fillText(
                                ds.data[idx],
                                bar.x,
                                bar.y - 2
                            );

                            ctx.restore();
                        });
                    });
                }
            };


            // ============================================================
            // DONUT LABELS
            // ============================================================
            const donutLabels = {
                id: 'donutLabels',

                afterDatasetsDraw(chart) {

                    const { ctx } = chart;

                    const values = chart.data.datasets[0].data;

                    const total = values.reduce(
                        (a, b) => a + b,
                        0
                    );

                    const meta = chart.getDatasetMeta(0);

                    meta.data.forEach((arc, i) => {

                        if (!values[i]) return;

                        const p = arc.getCenterPoint();

                        const pct = (
                            (values[i] / total) * 100
                        ).toFixed(1);

                        ctx.save();

                        ctx.fillStyle = '#fff';
                        ctx.textAlign = 'center';

                        // Smaller count
                        ctx.font = 'bold 10px sans-serif';



                        // Smaller percentage
                        ctx.font = '8px sans-serif';

                        ctx.fillText(
                            `(${pct}%)`,
                            p.x,
                            p.y + 0
                        );

                        ctx.restore();
                    });


                    // Center total
                    const {
                        left,
                        right,
                        top,
                        bottom
                    } = chart.chartArea;

                    const cx = (left + right) / 2;
                    const cy = (top + bottom) / 2;

                    ctx.save();

                    ctx.fillStyle = TEXT;
                    ctx.textAlign = 'center';

                    // Smaller center number
                    ctx.font = 'bold 18px sans-serif';



                    // Smaller center text
                    ctx.font = '8px sans-serif';

                    ctx.fillText(
                        'Production 1',
                        cx,
                        cy + 4
                    );

                    ctx.restore();
                }
            };


            // ============================================================
            // AXIS SETTINGS
            // ============================================================
            const axes = {

                y: {
                    beginAtZero: true,

                    ticks: {
                        font: {
                            size: 7
                        },
                        color: TEXT,
                        precision: 0,
                        padding: 2
                    },

                    grid: {
                        color: GRID
                    }
                },

                x: {

                    ticks: {
                        font: {
                            size: 7
                        },

                        color: TEXT,

                        maxRotation: 0,
                        minRotation: 0,

                        padding: 2
                    },

                    grid: {
                        display: false
                    }
                }
            };


            // ============================================================
            // BASE OPTIONS
            // ============================================================
            const base = {

                responsive: true,

                maintainAspectRatio: false,

                // Re-enabled so charts animate again on every refresh
                // (_upsert destroys and recreates them each time)
                animation: {
                    duration: 900,
                    easing: 'easeOutQuart'
                },

                layout: {
                    padding: {
                        top: 4,
                        right: 2,
                        bottom: 2,
                        left: 2
                    }
                },

                plugins: {
                    legend: {
                        display: false
                    }
                }
            };


            // ============================================================
            // 1. TARGET VS ACTUAL
            // ============================================================
            this._upsert(
                'targetChart',
                'targetChart',
                {
                    type: 'bar',

                    data: {
                        labels,

                        datasets: [
                            {
                                label: '10% Reduction Target',
                                data: targets,
                                backgroundColor: '#2f80d8',
                                borderRadius: 2,

                                // Make bars slightly thinner
                                barPercentage: 0.55,
                                categoryPercentage: 0.75
                            },

                            {
                                label: 'Actual Result',
                                data: actuals,
                                backgroundColor: '#f57c2b',
                                borderRadius: 2,

                                barPercentage: 0.55,
                                categoryPercentage: 0.75
                            }
                        ]
                    },

                    options: {
                        ...base,

                        scales: axes
                    },

                    plugins: [
                        barLabels
                    ]
                }
            );


            // ============================================================
            // 2. DEPARTMENT STATUS
            // ============================================================
            this._upsert(
                'statusChart',
                'statusChart',
                {
                    type: 'doughnut',

                    data: {
                        labels: [
                            'Achieved',
                            'Not Achieved'
                        ],

                        datasets: [
                            {
                                data: [
                                    achieved,
                                    notAchieved
                                ],

                                backgroundColor: [
                                    '#43a047',
                                    '#d94a38'
                                ],

                                borderWidth: 2
                            }
                        ]
                    },

                    options: {
                        ...base,

                        cutout: '55%',

                        // sweep + grow effect for the donut
                        animation: {
                            ...base.animation,
                            animateRotate: true,
                            animateScale: true
                        }
                    },

                    plugins: [
                        donutLabels
                    ]
                }
            );


            // ============================================================
            // 3. OVERTIME
            // ============================================================
            this._upsert(
                'otChart',
                'otChart',
                {
                    type: 'bar',

                    data: {
                        labels: [
                            'No OT',
                            '1 hr OT',
                            '2 hrs OT',
                            '3 hrs OT'
                        ],

                        datasets: [
                            {
                                data: ot,

                                backgroundColor: [
                                    '#2f80d8',
                                    '#2f80d8',
                                    '#fbb417',
                                    '#e53935'
                                ],

                                borderRadius: 2,

                                barPercentage: 0.40,
                                categoryPercentage: 0.65
                            }
                        ]
                    },

                    options: {
                        ...base,

                        scales: axes
                    },

                    plugins: [
                        barLabels
                    ]
                }
            );
        }

        _upsert(key, canvasId, config) {
            // Same pattern as RenderTrendsChart: destroy + recreate so the
            // initial animation plays on every refresh.
            if (this[key]) {
                this[key].destroy();
                this[key] = null;
            }

            this[key] = new Chart(
                document.getElementById(canvasId).getContext('2d'),
                config
            );
        }

        changeformatnumber(n) {
            return n.toLocaleString('en-US');
        }
        updateScreenSize() {
            const screenEl = document.getElementById('screenSize');
            const viewportEl = document.getElementById('viewportSize');

            // Physical monitor resolution
            if (screenEl) screenEl.textContent = `${window.screen.width} x ${window.screen.height}`;

            // Actual usable browser area (what your dashboard really has to fit in)
            if (viewportEl) viewportEl.textContent = `${window.innerWidth} x ${window.innerHeight}`;
        }

        // Navigate to the previous or next date
        ChangeFilterDate(days) {
            const filterDate = document.getElementById("filterDate");

            // Use the database date displayed on the dashboard as the fallback
            const today = document.getElementById("datetodayShift").textContent;

            const selectedDate = new Date(
                (filterDate.value || today) + "T12:00:00"
            );

            selectedDate.setDate(selectedDate.getDate() + days);

            const pad = v => String(v).padStart(2, "0");

            filterDate.value =
                `${selectedDate.getFullYear()}-${pad(selectedDate.getMonth() + 1)}-${pad(selectedDate.getDate())}`;

            this.isfilter = 1;

            this.GetAttendanceSummary();
        };

        // Return to the database's current date
        GoToToday() {
            const today = document.getElementById("datetodayShift").textContent;

            document.getElementById("filterDate").value = today;

            this.isfilter = 0;

            this.GetAttendanceSummary();
        };
    }


