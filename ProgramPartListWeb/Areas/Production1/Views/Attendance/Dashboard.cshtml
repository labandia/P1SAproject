
@{
    Layout = "~/Areas/Production1/Views/Shared/_AttendanceLayout.cshtml";
}
<div class="dashboard-wrapper">
    <div class="dashboard">

        <!-- HEADER -->
        <header>
            <h2>📋PRODUCTION 1 ATTENDANCE DASHBOARD - <span > <strong id="shiftDay">DAYSHIFT</strong>(<span id="datetoday">-/--/----</span>)</span></h2>
            <div class="animToggleWrap">
                <label class="animToggle" for="refreshToggleInput" title="Toggle auto-refresh">
                    <input type="checkbox" id="refreshToggleInput" checked>
                    <span class="animToggle_track"><span class="animToggle_thumb"></span></span>
                    <span class="animToggle_label" id="refreshToggleLabel">Auto-Refresh: ON</span>
                </label>
            </div>
        </header>

        <!-- KPI CARDS -->
        <div class="attendSummary">
            <!-- Total Headcount -->
            <div class="attendSummary_card loop-anim">
                <div class="IconContainer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <g fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m16.719 19.752l-.64-5.124A3 3 0 0 0 13.101 12h-2.204a3 3 0 0 0-2.976 2.628l-.641 5.124A2 2 0 0 0 9.266 22h5.468a2 2 0 0 0 1.985-2.248" />
                            <circle cx="12" cy="5" r="3" />
                            <circle cx="4" cy="9" r="2" />
                            <circle cx="20" cy="9" r="2" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 14h-.306a2 2 0 0 0-1.973 1.671l-.333 2A2 2 0 0 0 3.361 20H7m13-6h.306a2 2 0 0 1 1.973 1.671l.333 2A2 2 0 0 1 20.639 20H17" />
                        </g>
                    </svg>


                </div>
                <div class="attendSummary_content">
                    <span>Total Headcount</span>
                    <p id="totalhead">0</p>
                </div>
            </div>
            <!-- Present -->
            <div class="attendSummary_card loop-anim">
                <div class="IconContainer" style="background: radial-gradient(circle at 30% 30%, #21AA98, #057922); color: #fff !important; ">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                        <path d="M12 11v4" />
                        <path d="M10 13h4" />
                    </svg>
                </div>
                <div class="attendSummary_content">
                    <span>Present Employees</span>
                    <p id="presentCount">0</p>
                </div>
            </div>
            <!-- Absent -->
            <div class="attendSummary_card loop-anim">
                <div class="IconContainer" style="background: radial-gradient(circle at 30% 30%, #C55216, #EA1D1D); color: #fff !important; ">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <g fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="7" cy="6" r="3" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 13H5.818a3 3 0 0 0-2.964 2.537L2.36 18.69A2 2 0 0 0 4.337 21H9m12.64-2.309l-.494-3.154A3 3 0 0 0 18.182 13h-2.364a3 3 0 0 0-2.964 2.537l-.493 3.154A2 2 0 0 0 14.337 21h5.326a2 2 0 0 0 1.976-2.309" />
                            <circle cx="17" cy="6" r="3" />
                        </g>
                    </svg>

                </div>
                <div class="attendSummary_content">
                    <span>Absent Employees</span>
                    <p id="absentCount">0</p>
                </div>
            </div>
            <!-- Absent Rate -->
            <div class="attendSummary_card loop-anim">
                <div class="attendSummary_absentRate">
                    <span>Attendance Rate</span>
                    <p id="absentrateCount">0% </p>
                </div>
            </div>
        </div>



        <!-- TWO COLUMN -->
        <div class="analysisTables">

            <!-- LEFT COLUMN -->
            <div class="col">
                <!-- Department Table -->
                <div class="tablecontainer maintable">
                    <div class="tableHeader">
                        <h3>🏢 Department Breakdown</h3>

                        <input type="date" id="filterDate" />
                    </div>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th style="text-align: center;">Department</th>
                                    <th style="text-align: center; width: 60px;">Dayshift</th>
                                    <th style="text-align: center;">NightShift</th>
                                    <th style="text-align: center;">Headcount</th>
                                    <th style="text-align: center;">Present</th>
                                    <th style="text-align: center;">Absent</th>
                                    <th style="text-align: center;">Attendance Rate</th>
                                </tr>
                            </thead>
                            <tbody id="departmentBreakdown">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th id="TotalDay">0</th>
                                    <th id="TotalNight">0</th>
                                    <th id="TotalGHead">0</th>
                                    <th id="TotalPresent">0</th>
                                    <th id="TotalAbsent">0</th>
                                    <th id="TotalRate">0%</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Trends -->
                <div class="Trends loop-anim" >


                    <div class="trendHeader">
                        <h3>📈 Attendance & Absenteeism Trends</h3>
                        <div class="trend-sub">Y‑axis: Percentage · X‑axis: 8/20 – 8/25</div>
                    </div>
                    <div id="ChartTrends">
                        <canvas id="trendChart" height="100"></canvas>
                    </div>

                    <div class="trends_legends">
                        <div class="trends_groupbadge">
                            <div class="Trends_badge blue"></div>
                            <small>Attendance Rate %</small>
                        </div>

                        <div class="trends_groupbadge">
                            <div class="Trends_badge orange"></div>
                            <small>Absent Rate %</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: SUMMARY -->
            <div class="col">
                <div class="summary loop-anim">
                    <div class="summary_Header">
                        <h3>📋 Total Summary</h3>
                    </div>
                    <div class="summary_content">
                        <div class="summary_details">
                            <i>👥</i>
                            <p>Headcount</p>
                            <span id="totalHeadcount">0</span>
                        </div>
                        <div class="summary_details">
                            <i>✅</i>
                            <p>Present</p>
                            <span id="totalPresent">0</span>
                        </div>
                        <div class="summary_details">
                            <i>❌</i>
                            <p>Absent</p>
                            <span id="totalAbsent">0</span>
                        </div>
                        <div class="summary_attendanceDetails">
                            <p>📊 Attendance Rate</p>
                            <span id="totalAntendanceRate">0</span>
                        </div>
                        <div class="summary_attendanceDetails">
                            <p>📉 Absent Rate</p>
                            <span id="totalAbsentRate">0%</span>
