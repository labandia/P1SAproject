@{
    Layout = null;
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Awardees</title>
   
    <style>
        @@font-face {
            font-family: 'Poppins';
            src: url('/Content/fonts/Poppins-Regular.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            overflow: hidden;
            background-image: linear-gradient(306deg, rgba(54, 54, 54, 0.05) 0%, rgba(54, 54, 54, 0.05) 33.333%,rgba(85, 85, 85, 0.05) 33.333%, rgba(85, 85, 85, 0.05) 66.666%,rgba(255, 255, 255, 0.05) 66.666%, rgba(255, 255, 255, 0.05) 99.999%),linear-gradient(353deg, rgba(81, 81, 81, 0.05) 0%, rgba(81, 81, 81, 0.05) 33.333%,rgba(238, 238, 238, 0.05) 33.333%, rgba(238, 238, 238, 0.05) 66.666%,rgba(32, 32, 32, 0.05) 66.666%, rgba(32, 32, 32, 0.05) 99.999%),linear-gradient(140deg, rgba(192, 192, 192, 0.05) 0%, rgba(192, 192, 192, 0.05) 33.333%,rgba(109, 109, 109, 0.05) 33.333%, rgba(109, 109, 109, 0.05) 66.666%,rgba(30, 30, 30, 0.05) 66.666%, rgba(30, 30, 30, 0.05) 99.999%),linear-gradient(189deg, rgba(77, 77, 77, 0.05) 0%, rgba(77, 77, 77, 0.05) 33.333%,rgba(55, 55, 55, 0.05) 33.333%, rgba(55, 55, 55, 0.05) 66.666%,rgba(145, 145, 145, 0.05) 66.666%, rgba(145, 145, 145, 0.05) 99.999%),linear-gradient(90deg, rgb(9, 201, 186),rgb(18, 131, 221));
        }
        /* ---------------------------------
            Award layout — responsive: two columns side-by-side on wide
            screens, stacked on narrow screens. Sizing uses relative units
            and object-fit instead of fixed pixel widths, and the old
            "zoom: 60%" hack has been removed in favor of proper scaling.
         --------------------------------- */

        .award-container {
            width: 100%;
            min-height: 100vh;
            padding: clamp(16px, 4vw, 30px) clamp(10px, 3vw, 24px);
        }


        .award-content {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: 1fr;
            align-items: center;
            justify-content: center;
            gap: clamp(8px, 2vw, 24px);
            /*            min-height: calc(100vh - clamp(32px, 8vw, 60px));*/
            min-height:50vh;
        }

        .award-title,
        .awardheader {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            min-width: 0; /* grid items don't shrink below content size by default */
            min-height: 0;
            overflow: visible;
        }

        .award-heading {
            position: absolute;
            left: 50%;
            top: 5%;
            transform: translateX(-50%) rotate(180deg);
            z-index: 999;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            margin: 0;
            font-size: clamp(40px, 9vw, 100px);
            font-weight: 700;
            letter-spacing: 2px;
            color: white;
            white-space: nowrap;
            opacity: 0.4;
            pointer-events: none;
        }

        img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            aspect-ratio: 900 / 900; /* real source dimensions — reserves correct space before load, avoids shift/crop */
            object-fit: contain; /* scales to fit, keeps the image's real aspect ratio */
            background-position: center;
            display: block;
            border-radius: 12px;
/*            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);*/
            opacity: 0;
            animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
        }

        @@keyframes popIn {
            0% {
                opacity: 0;
                transform: scale(0.6) rotate(-4deg);
            }

            60% {
                opacity: 1;
                transform: scale(1.05) rotate(1deg);
            }

            100% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
            }
        }

        /* ---------------------------------
            Confetti surprise
         --------------------------------- */

        .confetti-piece {
            position: fixed;
            top: -20px;
            width: 10px;
            height: 16px;
            opacity: 0.9;
            pointer-events: none;
            animation-name: confetti-fall;
            animation-timing-function: linear;
            animation-fill-mode: forwards;
        }

        @@keyframes confetti-fall {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }

            100% {
                transform: translateY(105vh) rotate(720deg);
                opacity: 0.9;
            }
        }

        /* ---------------------------------
            Responsive breakpoints
            Tablet: stack the two image slots instead of squeezing
            them side by side, since each source image is a tall
            portrait photo (2479x3301) that gets too narrow at 50% width.
         --------------------------------- */

        @@media (max-width: 900px) {
            .award-content {
                grid-template-columns: 1fr;
                grid-template-rows: repeat(2, minmax(0, 1fr));
                min-height: calc(100vh - clamp(32px, 8vw, 60px));
            }

            

            .award-title,
            .awardheader {
                max-height: 45vh; /* each slot gets roughly half the viewport height */
            }
        }

        /* Phones: vertical rotated heading text becomes hard to read at
          small sizes, so switch it to normal horizontal text stacked
          above the images instead of overlapping them. */
        @@media (max-width: 600px) {
            .award-heading {
                position: static;
                transform: none;
                writing-mode: horizontal-tb;
                text-orientation: initial;
                text-align: center;
                font-size: 10px;
                margin-bottom: 12px;
                opacity: 0.6;
            }

            .award-container {
                display: flex;
                flex-direction: column;
            }

            .award-content {
                flex: 1;
            }
        }

        @@media(max-width: 1300px) and (max-height: 650px){
            .award-heading {
                font-size: 50px !important;
                margin-top: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="award-container">
        <div class="award-content" id="awardContent">
            <div class="award-title">
                <img id="slot1" class="NoImages lazy" alt="Awardee 1" />
            </div>
            <div class="awardheader" id="slot2Wrap">
                <img id="slot2" class="NoImages lazy" alt="Awardee 2" />
            </div>
        </div>
    </div>
    <h2 class="award-heading">Congratulations</h2>

    <script>
        /* ---------- Confetti (unchanged) ---------- */
        var runConfettiSequence = (function () {
            var colors = ['#09c9ba', '#1283dd', '#ffd166', '#ef476f', '#ffffff'];
            var burstCount = 60;
            var loopDurationMs = 60000;
            var intervalMs = 1200;
            var intervalId = null;

            function launchConfettiBurst() {
                for (var i = 0; i < burstCount; i++) {
                    var piece = document.createElement('div');
                    piece.className = 'confetti-piece';
                    piece.style.left = Math.random() * 100 + 'vw';
                    piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    piece.style.animationDuration = (2.5 + Math.random() * 2) + 's';
                    piece.style.animationDelay = (Math.random() * 0.4) + 's';
                    piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                    document.body.appendChild(piece);
                    piece.addEventListener('animationend', function () { this.remove(); });
                }
            }

            return function () {
                if (intervalId !== null) return;
                launchConfettiBurst();
                intervalId = setInterval(launchConfettiBurst, intervalMs);
                setTimeout(function () {
                    clearInterval(intervalId);
                    intervalId = null;
                }, loopDurationMs);
            };
        })();

        /* ---------- Awardee rotator: 2 images, switch every 30s ---------- */
        document.addEventListener('DOMContentLoaded', function () {

            var listUrl  = '@Url.Action("GetAwardeeImages", "DataAnalysis", new { area = "Production1" })';
            var imageUrl = '@Url.Action("DisplaytheImage", "DataAnalysis", new { area = "Production1" })';
            var noImage  = '@Url.Content("~/Content/Images/no-image.png")';

            var PER_PAGE = 2;
            var ROTATE_MS = 30000; // 30 seconds

            var content   = document.getElementById('awardContent');
            var slots     = [document.getElementById('slot1'), document.getElementById('slot2')];
            var slot2Wrap = document.getElementById('slot2Wrap');

            var files = [];
            var index = 0;
            var timer = null;

            function buildSrc(filename) {
                return imageUrl + '?filename=' + encodeURIComponent(filename);
            }

            // Restart the popIn CSS animation on an <img>
            function replayAnimation(img) {
                img.style.animation = 'none';
                void img.offsetHeight; // force reflow
                img.style.animation = '';
            }

            function setSlot(img, filename) {
                img.onerror = function () {
                    this.onerror = null;
                    this.src = noImage;
                };
                img.alt = filename;
                img.src = buildSrc(filename);
                replayAnimation(img);
            }

            function showCurrentPair() {
                if (files.length === 0) {
                    return;
                }

                // Take up to 2 files, wrapping around the end of the list
                var pair = [];
                var count = Math.min(PER_PAGE, files.length);
                for (var i = 0; i < count; i++) {
                    pair.push(files[(index + i) % files.length]);
                }

                setSlot(slots[0], pair[0]);

                if (pair.length > 1) {
                    slot2Wrap.style.display = '';
                    content.classList.remove('single');
                    setSlot(slots[1], pair[1]);
                } else {
                    // Only one image available — center it
                    slot2Wrap.style.display = 'none';
                    content.classList.add('single');
                }

                runConfettiSequence();
            }

            function loadList() {
                return fetch(listUrl, { cache: 'no-store' })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Failed to retrieve awardee images.');
                        return response.json();
                    })
                    .then(function (result) {
                        if (!result || !result.success) {
                            console.warn(result && result.message);
                            files = [];
                            return files;
                        }

                        // data is [{ FileName, FullPath }, ...]; keep only the file names
                        files = (result.data || [])
                            .map(function (item) {
                                return typeof item === 'string' ? item : item.FileName;
                            })
                            .filter(Boolean);

                        return files;
                    });
            }

            function advance() {
                if (files.length <= PER_PAGE) {
                    // Nothing new to rotate to; just refresh the list in case it changed
                    loadList().then(function () { index = 0; showCurrentPair(); });
                    return;
                }

                index += PER_PAGE;

                if (index >= files.length) {
                    // Finished a full cycle: wrap around and re-fetch for new awardees
                    index = 0;
                    loadList()
                        .catch(function (e) { console.error(e); })
                        .then(showCurrentPair);
                } else {
                    showCurrentPair();
                }
            }

            loadList()
                .then(function () {
                    if (files.length === 0) {
                        content.innerHTML =
                            '<p style="color:white;text-align:center;">No awardee images found.</p>';
                        return;
                    }
                    index = 0;
                    showCurrentPair();
                    timer = setInterval(advance, ROTATE_MS);
                })
                .catch(function (error) {
                    console.error('Error loading awardee images:', error);
                });
        });
    </script>
</body>
</html>


