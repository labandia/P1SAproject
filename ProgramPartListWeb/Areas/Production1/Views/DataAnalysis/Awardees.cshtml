@{
    Layout = null;
}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Awardees</title>
   
    <style>
        @@font-face {
            font-family: 'Poppins';
            src: url('/Content/fonts/Poppins-Regular.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            overflow: hidden;
            background-image: linear-gradient(306deg, rgba(54, 54, 54, 0.05) 0%, rgba(54, 54, 54, 0.05) 33.333%,rgba(85, 85, 85, 0.05) 33.333%, rgba(85, 85, 85, 0.05) 66.666%,rgba(255, 255, 255, 0.05) 66.666%, rgba(255, 255, 255, 0.05) 99.999%),linear-gradient(353deg, rgba(81, 81, 81, 0.05) 0%, rgba(81, 81, 81, 0.05) 33.333%,rgba(238, 238, 238, 0.05) 33.333%, rgba(238, 238, 238, 0.05) 66.666%,rgba(32, 32, 32, 0.05) 66.666%, rgba(32, 32, 32, 0.05) 99.999%),linear-gradient(140deg, rgba(192, 192, 192, 0.05) 0%, rgba(192, 192, 192, 0.05) 33.333%,rgba(109, 109, 109, 0.05) 33.333%, rgba(109, 109, 109, 0.05) 66.666%,rgba(30, 30, 30, 0.05) 66.666%, rgba(30, 30, 30, 0.05) 99.999%),linear-gradient(189deg, rgba(77, 77, 77, 0.05) 0%, rgba(77, 77, 77, 0.05) 33.333%,rgba(55, 55, 55, 0.05) 33.333%, rgba(55, 55, 55, 0.05) 66.666%,rgba(145, 145, 145, 0.05) 66.666%, rgba(145, 145, 145, 0.05) 99.999%),linear-gradient(90deg, rgb(9, 201, 186),rgb(18, 131, 221));
        }
        /* ---------------------------------
            Award layout — responsive: two columns side-by-side on wide
            screens, stacked on narrow screens. Sizing uses relative units
            and object-fit instead of fixed pixel widths, and the old
            "zoom: 60%" hack has been removed in favor of proper scaling.
         --------------------------------- */

        .award-container {
            width: 100%;
            min-height: 100vh;
            padding: clamp(16px, 4vw, 30px) clamp(10px, 3vw, 24px);
        }


        .award-content {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: 1fr;
            align-items: center;
            justify-content: center;
            gap: clamp(8px, 2vw, 24px);
            /*            min-height: calc(100vh - clamp(32px, 8vw, 60px));*/
            min-height:50vh;
        }

        .award-title,
        .awardheader {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            min-width: 0; /* grid items don't shrink below content size by default */
            min-height: 0;
            overflow: visible;
        }

        .award-heading {
            position: absolute;
            left: 50%;
            top: 5%;
            transform: translateX(-50%) rotate(180deg);
            z-index: 999;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            margin: 0;
            font-size: clamp(40px, 9vw, 100px);
            font-weight: 700;
            letter-spacing: 2px;
            color: white;
            white-space: nowrap;
            opacity: 0.4;
            pointer-events: none;
        }

        img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            aspect-ratio: 900 / 900; /* real source dimensions — reserves correct space before load, avoids shift/crop */
            object-fit: contain; /* scales to fit, keeps the image's real aspect ratio */
            background-position: center;
            display: block;
            border-radius: 12px;
/*            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);*/
            opacity: 0;
            animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
        }

        @@keyframes popIn {
            0% {
                opacity: 0;
                transform: scale(0.6) rotate(-4deg);
            }

            60% {
                opacity: 1;
                transform: scale(1.05) rotate(1deg);
            }

            100% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
            }
        }

        /* ---------------------------------
            Confetti surprise
         --------------------------------- */

        .confetti-piece {
            position: fixed;
            top: -20px;
            width: 10px;
            height: 16px;
            opacity: 0.9;
            pointer-events: none;
            animation-name: confetti-fall;
            animation-timing-function: linear;
            animation-fill-mode: forwards;
        }

        @@keyframes confetti-fall {
            0% {
                transform: translateY(0) rotate(0deg);
                opacity: 1;
            }

            100% {
                transform: translateY(105vh) rotate(720deg);
                opacity: 0.9;
            }
        }

        /* ---------------------------------
            Responsive breakpoints
            Tablet: stack the two image slots instead of squeezing
            them side by side, since each source image is a tall
            portrait photo (2479x3301) that gets too narrow at 50% width.
         --------------------------------- */

        @@media (max-width: 900px) {
            .award-content {
                grid-template-columns: 1fr;
                grid-template-rows: repeat(2, minmax(0, 1fr));
                min-height: calc(100vh - clamp(32px, 8vw, 60px));
            }

            

            .award-title,
            .awardheader {
                max-height: 45vh; /* each slot gets roughly half the viewport height */
            }
        }

        /* Phones: vertical rotated heading text becomes hard to read at
          small sizes, so switch it to normal horizontal text stacked
          above the images instead of overlapping them. */
        @@media (max-width: 600px) {
            .award-heading {
                position: static;
                transform: none;
                writing-mode: horizontal-tb;
                text-orientation: initial;
                text-align: center;
                font-size: 10px;
                margin-bottom: 12px;
                opacity: 0.6;
            }

            .award-container {
                display: flex;
                flex-direction: column;
            }

            .award-content {
                flex: 1;
            }
        }

        @@media(max-width: 1300px) and (max-height: 650px){
            .award-heading {
                font-size: 50px !important;
                margin-top: 15px;
            }
        }
    </style>
</head>
<body>


    <div class="award-container">
        <div class="award-content">
            <div class="award-title">
                <img class="NoImages lazy"
                     src='@Url.Action("DisplaytheImage", "DataAnalysis", new { area = "Production1", filename = "Winnder2.png" })'
                     onerror="this.src='@Url.Content("~/Content/Images/no-image.png")'" />
            </div>
            <div class="awardheader">
                <img class="NoImages lazy"
                     src='@Url.Action("DisplaytheImage", "DataAnalysis", new { area = "Production1", filename = "awardee.png" })'
                     onerror="this.src='@Url.Content("~/Content/Images/no-image.png")'" />
            </div>
        </div>
    </div>
    <h2 class="award-heading">Congratulations</h2>

    <script>
        // Confetti — reusable so it can fire on first load AND again every
        // time the image pop-in animation replays. Each call bursts
        // repeatedly for 1 minute, then stops until called again.
        var runConfettiSequence = (function () {
            var colors = ['#09c9ba', '#1283dd', '#ffd166', '#ef476f', '#ffffff'];
            var burstCount = 60;
            var loopDurationMs = 60000; // 1 minute
            var intervalMs = 1200;
            var intervalId = null;

            function launchConfettiBurst() {
                for (var i = 0; i < burstCount; i++) {
                    var piece = document.createElement('div');
                    piece.className = 'confetti-piece';
                    piece.style.left = Math.random() * 100 + 'vw';
                    piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    piece.style.animationDuration = (2.5 + Math.random() * 2) + 's';
                    piece.style.animationDelay = (Math.random() * 0.4) + 's';
                    piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                    document.body.appendChild(piece);

                    piece.addEventListener('animationend', function () {
                        this.remove();
                    });
                }
            }

            return function runConfettiSequence() {
                // If a sequence is already running, let it keep going
                // rather than stacking a second interval on top of it.
                if (intervalId !== null) return;
                launchConfettiBurst();
                intervalId = setInterval(launchConfettiBurst, intervalMs);
                setTimeout(function () {
                    clearInterval(intervalId);
                    intervalId = null;
                }, loopDurationMs);
            };
        })();

        window.addEventListener('load', function () {
            setTimeout(runConfettiSequence, 200);
        });

        // Once the pop-in animation finishes, wait, then play it again —
        // repeating indefinitely instead of reloading the whole page.
        // Change REPLAY_DELAY_MS below to switch between the 1-minute and
        // 1.5-minute (1 min 30 sec) pacing.
        (function () {
            var images = document.querySelectorAll('.award-title img, .awardheader img');
            var REPLAY_DELAY_MS = 60000; // 60000 = 1 minute, 90000 = 1.5 minutes
            var pending = images.length;
            var scheduled = false;

            function replayAnimation(img) {
                // Removing and re-adding the animation, with a forced
                // reflow in between, restarts a CSS animation that has
                // already finished (just toggling the class won't).
                img.style.animation = 'none';
                // eslint-disable-next-line no-unused-expressions
                img.offsetHeight; // force reflow
                img.style.animation = '';
            }

            function scheduleReplay() {
                if (scheduled) return;
                scheduled = true;
                setTimeout(function () {
                    scheduled = false;
                    pending = images.length;
                    images.forEach(function (img) {
                        replayAnimation(img);
                        img.addEventListener('animationend', onOneAnimationDone, { once: true });
                    });
                    runConfettiSequence();
                }, REPLAY_DELAY_MS);
            }

            function onOneAnimationDone(e) {
                // Only react to the popIn animation, not the confetti-fall
                // animation which also fires animationend events elsewhere.
                if (e.animationName && e.animationName !== 'popIn') return;
                pending--;
                if (pending <= 0) {
                    scheduleReplay();
                }
            }

            if (images.length === 0) {
                // No images found — nothing to animate.
                return;
            }

            images.forEach(function (img) {
                img.addEventListener('animationend', onOneAnimationDone, { once: true });
            });
        })();
    </script>
</body>
</html>


