<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod, 
        getDepartmentName,
        formatDate
    } from '@Url.Content("~/Scripts/modules/index.js")';


    class EmployeeDetailsController {
        constructor() {
            this.employeeID = document.getElementById("empID");
        }

        async init() {
            await this.LoadEmployeeDetails();
        }

        BindEvents() {
        }

        async LoadEmployeeDetails() {
           try {

          
               const result = await getMethod('@Url.Action("GetEmployeeDetails", "Employees")', { employee: this.employeeID.value });
                if (!result?.Success) {
                    console.log('No data found in Group Data');
                    return;
                }




               console.log(result);

               if (!result?.Success) {
                    console.log('No data found in Group Data');
                    return;
                }

               this.RenderEmployeeDetail(result.data);

           } catch (error) {
                console.error('Error fetching attendance summary:', error);
           }
        }


        RenderEmployeeDetail(employees) {
            document.getElementById('heroname').textContent = employees.FullName !== "" ? employees.FullName : emp.FullName || emp.FirstName + ' ' + emp.LastName;
            document.getElementById('idnumber').textContent = employees.EmployeeCode;
            document.getElementById('IsStatus').textContent = employees.StatusName;
            document.getElementById('WithVech').textContent = employees.Information.WIthVech == 1 ? "With Vehicle " : "WithOut Vehicle";
            document.getElementById('Position').textContent = employees.Process;
            document.getElementById('AgencyName').textContent = employees.AgencyName;
            document.getElementById('department').textContent = getDepartmentName(employees.DepartmentId) + " Department ";

        }



    }


    document.addEventListener('DOMContentLoaded', function() {
        const controller = new EmployeeDetailsController();
        controller.init();
    });
</script>

