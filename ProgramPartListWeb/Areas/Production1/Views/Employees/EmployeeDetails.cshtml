<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod, 
        getDepartmentName,
        formatDate
    } from '@Url.Content("~/Scripts/modules/index.js")';


    class EmployeeDetailsController {
        constructor() {

            this.rosterList = document.getElementById('rosterList');


            this.employeeID = document.getElementById("empID");
            this.educationList = document.getElementById('eduItems');
            this.addresslist = document.getElementById('addressGrid');

        }

        async init() {
            this.BindEvents();
            await this.LoadEmployeeDetails();
        }

        BindEvents() {
            const tabs = document.querySelectorAll('.tabs .tab');
            const panels = document.querySelectorAll('.tab-panel');

            const activate = (name) => {
                tabs.forEach(t => {
                    const on = t.dataset.tab === name;
                    t.classList.toggle('active', on);
                    t.setAttribute('aria-selected', on);
                });
                panels.forEach(p => p.classList.toggle('active', p.dataset.panel === name));
                history.replaceState(null, '', '#' + name); // optional: remember tab on refresh
            };

            tabs.forEach(t => t.addEventListener('click', () => activate(t.dataset.tab)));

            // Open the tab from the URL hash on load (e.g. ...#education)
            const initial = location.hash.replace('#', '');
            if ([...tabs].some(t => t.dataset.tab === initial)) activate(initial);
        }

        async LoadEmployeeDetails() {
           try {
               const result = await getMethod('@Url.Action("GetEmployeeDetails", "Employees")', { employee: this.employeeID.value });
                if (!result?.Success) {
                    console.log('No data found in Group Data');
                    return;
                }
               console.log(result);
               if (!result?.Success) {
                    console.log('No data found in Group Data');
                    return;
                }

               this.RenderEmployeeDetail(result.data);

           } catch (error) {
                console.error('Error fetching attendance summary:', error);
           }
        }


        RenderEmployeeDetail(employees) {
            document.getElementById('heroname').textContent = employees.FullName !== "" ? employees.FullName : emp.FullName || emp.FirstName + ' ' + emp.LastName;
            document.getElementById('idnumber').textContent = employees.EmployeeCode;
            document.getElementById('IsStatus').textContent = employees.StatusName;
            document.getElementById('WithVech').textContent = employees.Information.WIthVech == 1 ? "With Vehicle " : "WithOut Vehicle";
            document.getElementById('Position').textContent = employees.Process;
            document.getElementById('AgencyName').textContent = employees.AgencyName;
            document.getElementById('department').textContent = getDepartmentName(employees.DepartmentId) + " Department ";


            // TAB 3: Employee personal Data
            document.getElementById('AgencySub').textContent = employees.AgencyName;
            document.getElementById('DepartSub').textContent = getDepartmentName(employees.DepartmentId) + " Department ";
            document.getElementById('ProcessSub').textContent = employees.Process;
            document.getElementById('WithVechSub').textContent = employees.StatusName;
            // document.getElementById('PickUpSub').textContent = employees.information.pickupText;
            document.getElementById('GenderSub').textContent = employees.Gender ? 'Female' : 'Male';
            document.getElementById('DateBirthSub').textContent = formatDate(employees.Information.DateOfBirth);
            document.getElementById('DateHiredSub').textContent = formatDate(employees.Information.DateHired);
            document.getElementById('SocialMediaSub').textContent = employees.Information.SocialMedia;
            document.getElementById('ContactSub').textContent = employees.Information.ContactNumber;

            let educData = employees.Education;


            if (educData.length === 0) {
                this.educationList.innerHTML = `
                <tr>
                    <td colspan="12" style="text-align:center; padding:32px; color:#86868b;">
                        No data available.
                    </td>
                </tr>`;
                return;
            }

            this.educationList.innerHTML = educData.map(row => {
                return `
                     <div class="edu-item">
                        <div class="edu-top">
                             <div>
                                 <div class="edu-title" id="SchoolName">${row.SchoolName}</div>
                                 <p class="edu-program" id="Course">${row.Course}</p>
                             </div>
                             <span class="year-badge" id="YearGraduated">Graduated ${row.YearGraduated}</span>
                         </div>
                     </div>`
            }).join('');


            let addressData = employees.Addresses;
            console.log(addressData);
            if (addressData.length === 0) {
                this.addresslist.innerHTML = `
                    <tr>
                        <td colspan="12" style="text-align:center; padding:32px; color:#86868b;">
                            No data available.
                        </td>
                    </tr>`;
                return;
            }

            this.addresslist.innerHTML = addressData.map(row => {
                return `  <div class="address-item">
                             <div class="address-top">
                                 <span class="address-title">${row.FullAddress}</span>
                                 <span class="address-code">${row.IsPermanent ? 'Permanent' : 'Temporary'}</span>
                             </div>
                             <p class="address-text">Poblacion, Morong, Bataan, Philippines 2108</p>
                         </div>`
            }).join('');


        }



    }


    document.addEventListener('DOMContentLoaded', function() {
        const controller = new EmployeeDetailsController();
        controller.init();
    });
</script>

