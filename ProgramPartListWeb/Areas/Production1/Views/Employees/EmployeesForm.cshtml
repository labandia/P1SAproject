@{
    ViewBag.Title = "EmployeesForm";
    Layout = "~/Areas/Production1/Views/Shared/_EmployeesLayout.cshtml";
}

<!-- ============================================================
      DESKTOP HEADER
      ============================================================ -->
<header class="desktop-header">
    <div class="h-16 w-full px-gutter-desktop flex items-center justify-between gap-gutter-desktop">
        <div class="flex items-center gap-space-xl">
            <div class="flex items-center gap-space-sm">
                <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16">
                        <path d="M0 0h16v16H0z" fill="none" />
                        <g fill="currentColor">
                            <path d="M11 6a3 3 0 1 1-6 0a3 3 0 0 1 6 0" />
                            <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1v-1c0-1-1-4-6-4s-6 3-6 4v1a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                        </g>
                    </svg>

                </div>
                <div class="flex flex-col">
                    <span class="font-title-md text-title-md text-on-surface leading-tight tracking-tight">SANYO DENKI</span>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">HR Encoder Portal</span>
                </div>
            </div>
            <nav class="hidden lg:flex items-center gap-space-xs">
                <a aria-current="page" class="px-space-md py-space-xs rounded-lg transition-colors bg-secondary-container text-on-secondary-container font-title-sm" href="#">Employee Records</a>
                <a class="px-space-md py-space-xs rounded-lg font-body-md text-body-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" href="#">Batch Encoding</a>
                <a class="px-space-md py-space-xs rounded-lg font-body-md text-body-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" href="#">Department Rosters</a>
                <a class="px-space-md py-space-xs rounded-lg font-body-md text-body-md text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" href="#">Audit Logs</a>
            </nav>
        </div>
        <div class="flex items-center gap-space-md">
            <div class="relative hidden md:block w-72 lg:w-96">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none">
                        <path fill="currentColor" d="M15.47 7.99a5.4 5.4 0 1 1-10.79 0a5.4 5.4 0 0 1 10.8 0" opacity=".2" />
                        <path fill="currentColor" d="M16.93 21.84H1.78a8.4 8.4 0 0 1 8.3-8.46c1.96 0 4.2.82 5.87 2.34L14.8 17.9s.74 1.66 2.13 3.94" opacity=".2" />
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.47 7.99a5.4 5.4 0 0 1-5.4 5.4a5.4 5.4 0 1 1 5.4-5.4" />
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1.78 21.68a8.3 8.3 0 0 1 11.28-7.74m7.3 6.68l1.88 1.87m-.98-4.36a3.2 3.2 0 0 1-3.2 3.2a3.2 3.2 0 1 1 3.2-3.2" />
                    </g>
                </svg>

                <input class="w-full h-10 pl-10 pr-space-md rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline text-body-sm font-body-sm focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all" placeholder="Search employee ID, badge, or name..." type="text">
            </div>


            <div class="h-8 w-px bg-surface-container-high mx-space-xs"></div>
            <div class="flex items-center gap-space-sm pl-space-xs">
                <div class="text-right hidden xl:block">
                    <div class="font-label-lg text-label-lg text-on-surface">T. Morimoto</div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant">Lead Encoder (Admin)</div>
                </div>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <g fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="7" r="5" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14h.352a3 3 0 0 1 2.976 2.628l.391 3.124A2 2 0 0 1 18.734 22H5.266a2 2 0 0 1-1.985-2.248l.39-3.124A3 3 0 0 1 6.649 14H7" />
                        </g>
                    </svg>

                </div>
            </div>
        </div>
    </div>
</header>

<!-- ============================================================
     MOBILE HEADER
     ============================================================ -->
<header class="mobile-header pt-safe">
    <div class="h-44 flex flex-col justify-between">
        <div class="h-6 px-4 flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
            <span class="font-semibold">9:41</span>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px]">signal_cellular_alt</span>
                <span class="material-symbols-outlined text-[16px]">wifi</span>
                <span class="material-symbols-outlined text-[16px]">battery_full</span>
            </div>
        </div>
        <div class="h-14 px-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center text-on-primary font-bold shadow-[0_2px_6px_rgba(0,73,190,0.25)]">
                    <span class="material-symbols-outlined text-[20px]">precision_manufacturing</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-primary uppercase tracking-wider font-semibold">Sanyo Denki HR Portal</span>
                    <span class="font-title-sm text-title-sm text-on-surface leading-tight font-semibold">Employee Encoder</span>
                </div>
            </div>
            <div class="flex items-center gap-1">

                <button class="w-11 h-11 flex items-center justify-center text-on-surface-variant hover:text-on-surface rounded-full transition-colors">
                    <span class="material-symbols-outlined text-[22px]">help</span>
                </button>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <g fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="7" r="5" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14h.352a3 3 0 0 1 2.976 2.628l.391 3.124A2 2 0 0 1 18.734 22H5.266a2 2 0 0 1-1.985-2.248l.39-3.124A3 3 0 0 1 6.649 14H7" />
                        </g>
                    </svg>

                </div>
            </div>
        </div>
        <div class="px-4 py-1 flex items-center justify-between">
            <span class="font-label-md text-label-md text-on-surface-variant font-medium" id="mobileStepLabel">Personal Details</span>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-label-sm font-label-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                Draft Auto-Saved
            </div>
        </div>
        <!-- Mobile step nav — functional -->
        <nav class="h-12 overflow-x-auto no-scrollbar flex items-center px-4 gap-2" id="mobileStepNav">
            <button class="step-tab step-tab--mobile is-active" data-step="1" type="button"><span class="step-tab__num">1</span>Personal Details</button>
            <button class="step-tab step-tab--mobile" data-step="2" type="button"><span class="step-tab__num">2</span>Employment</button>
            <button class="step-tab step-tab--mobile" data-step="3" type="button"><span class="step-tab__num">3</span>Address</button>
            <button class="step-tab step-tab--mobile" data-step="4" type="button"><span class="step-tab__num">4</span>Education &amp; Skills</button>
            <button class="step-tab step-tab--mobile" data-step="5" type="button"><span class="step-tab__num">5</span>Photo Upload</button>
            <button class="step-tab step-tab--mobile" data-step="6" type="button"><span class="step-tab__num">6</span>Work History</button>
        </nav>
    </div>
</header>

<!-- ============================================================
     MOBILE MAIN
     ============================================================ -->
<main class="mobile-main flex flex-col relative w-full bg-background min-h-screen" id="mobileMain">
    <div class="flex flex-col w-full pb-8">

        <div class="flex items-center gap-2 mb-4 px-1">
            <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
            <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Mobile · Subic Bay Plant 2</span>
        </div>

        <!-- ===== STEP 1: Personal Details (mobile) ===== -->
        <div class="step-panel is-active" data-step-panel="1" id="mobileStepPanel1">
            <div class="flex flex-col bg-surface-container-lowest rounded-xl p-4 shadow-sm">
                <div class="flex items-start justify-between pb-3 mb-4 bg-surface-container-low -mx-4 -mt-4 p-4 rounded-t-xl">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
                        <div>
                            <h2 class="font-title-md text-title-md text-on-surface font-semibold leading-tight">Legal Name &amp; Demographics</h2>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Enter official identity records accurately</p>
                        </div>
                    </div>
                    <span class="px-2 py-0.5 rounded bg-error-container text-on-error-container font-label-sm text-label-sm font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">asterisk</span> Required
                    </span>
                </div>

                <form class="flex flex-col gap-4" onsubmit="event.preventDefault();">
                    <div class="grid grid-cols-1 gap-space-md">
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant flex items-center justify-between" for="m-empCode">
                                <span>Employee Code <span class="text-error font-bold">*</span></span>
                                <span class="text-secondary font-normal text-[10px]">Auto-Gen Allowed</span>
                            </label>
                            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface
                                          font-title-sm text-title-sm focus:outline-none focus:bg-surface-container-lowest
                                          focus:ring-2 focus:ring-primary transition-all font-mono"
                                   id="m-empCode" name="employeeCode" type="text"
                                   placeholder="e.g. SDP-2025-XXXX"
                                   data-required="true" data-validate="code"
                                   data-invalid-msg="Use letters, numbers and dashes only.">
                            <span class="font-body-sm text-[11px] text-secondary">Designated for Subic Plant 2 Production Line</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-lastName">
                                Last Name (Surname) <span class="text-error font-bold">*</span>
                            </label>
                            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md
                                          focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all uppercase"
                                   id="m-lastName" name="lastName" type="text"
                                   placeholder="e.g. DELA CRUZ" autocomplete="family-name" maxlength="50"
                                   data-required="true">
                            <span class="font-body-sm text-[11px] text-secondary">Include suffix in separate field if applicable</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-firstName">
                                Given Name (First Name) <span class="text-error font-bold">*</span>
                            </label>
                            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md
                                          focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all uppercase"
                                   id="m-firstName" name="givenName" type="text"
                                   placeholder="e.g. Juan" autocomplete="given-name" maxlength="50"
                                   data-required="true">
                            <span class="font-body-sm text-[11px] text-secondary">Full first given names</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant flex items-center justify-between" for="m-middleName">
                                <span>Middle Name</span>
                                <span class="text-secondary font-normal text-[10px]">Optional</span>
                            </label>
                            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md
                                          focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all uppercase"
                                   id="m-middleName" name="middleName" type="text"
                                   placeholder="e.g. SANTOS" autocomplete="additional-name" maxlength="50">
                            <span class="font-body-sm text-[11px] text-secondary">Leave blank if no middle legal name</span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1 pt-space-xs pb-space-sm bg-gradient-to-r from-surface-container-low to-transparent p-space-md rounded-lg">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-space-sm">
                                <span class="w-7 h-7 rounded-md bg-secondary-container text-on-secondary-container flex items-center justify-center font-title-sm text-title-sm">B</span>
                                <h2 class="font-title-lg text-title-lg text-on-surface">Demographics &amp; Vital Details</h2>
                            </div>
                            <span class="font-label-sm text-label-sm text-secondary">Confidentiality Tier A</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant pl-9">
                            Required for automated medical insurance calculation and employee safety registries.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 gap-space-md">
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-dob">
                                Date of Birth <span class="text-error font-bold">*</span>
                            </label>
                            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface
                                          font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest
                                          focus:ring-2 focus:ring-primary transition-all"
                                   id="m-dob" name="dateOfBirth" type="date" autocomplete="bday"
                                   data-required="true" data-validate="dob"
                                   data-invalid-msg="Employee must be 18 years old or above." />
                            <span class="font-body-sm text-[11px] text-secondary">Age: <span class="font-semibold text-on-surface">26 years old</span></span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant">
                                Biological Sex <span class="text-error font-bold">*</span>
                            </label>
                            <!-- WHY data-gender-group / data-gender: one shared handler (initGenderToggles) drives
                                 both layouts and getGender() reads [data-gender].is-selected. Matching by button
                                 text never worked because the Material icon name ("male") is part of textContent. -->
                            <div class="h-11 p-1 bg-surface-container-low rounded-lg flex items-center gap-1" data-gender-group>
                                <button class="flex-1 h-full rounded-md font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-colors flex items-center justify-center gap-1" data-gender="Male" type="button">
                                    <span class="material-symbols-outlined text-[16px]">male</span>
                                    <span>Male</span>
                                </button>
                                <button class="is-selected flex-1 h-full rounded-md bg-surface-container-lowest text-primary font-label-md text-label-md shadow-sm flex items-center justify-center gap-1 font-semibold" data-gender="Female" type="button">
                                    <span class="material-symbols-outlined text-[16px]">female</span>
                                    <span>Female</span>
                                </button>
                            </div>
                            <span class="font-body-sm text-[11px] text-secondary">As declared in Birth Certificate</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-civilStatus">
                                Civil Status <span class="text-error font-bold">*</span>
                            </label>
                            <div class="relative">
                                <select class="w-full h-11 px-space-md pr-10 rounded-lg bg-surface-container-low text-on-surface
                                               font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest
                                               focus:ring-2 focus:ring-primary transition-all appearance-none cursor-pointer"
                                        id="m-civilStatus" name="civilStatus" data-required="true">
                                    <option selected value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated</option>
                                    <option value="Solo Parent">Solo Parent</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                            </div>
                            <span class="font-body-sm text-[11px] text-secondary">Affects tax dependency calculation</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-religion">
                                Religion / Affiliation
                            </label>
                            <div class="relative">
                                <select class="w-full h-11 px-space-md pr-10 rounded-lg bg-surface-container-low text-on-surface
                                               font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest
                                               focus:ring-2 focus:ring-primary transition-all appearance-none cursor-pointer"
                                        id="m-religion" name="religion">
                                    <option selected value="Roman Catholic">Roman Catholic</option>
                                    <option value="Iglesia ni Cristo">Iglesia ni Cristo</option>
                                    <option value="Islam">Islam</option>
                                    <option value="Evangelical Christian">Evangelical Christian</option>
                                    <option value="Seventh-day Adventist">Seventh-day Adventist</option>
                                    <option value="Other">Other / Prefer not to say</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                            </div>
                            <span class="font-body-sm text-[11px] text-secondary">Optional: for dietary and plant holiday needs</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant flex items-center justify-between" for="m-bloodType">
                                <span>Blood Type <span class="text-error font-bold">*</span></span>
                                <span class="text-primary font-medium text-[10px]">Safety Priority</span>
                            </label>
                            <div class="relative">
                                <select class="w-full h-11 px-space-md pr-10 rounded-lg bg-surface-container-low text-on-surface
                                               font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest
                                               focus:ring-2 focus:ring-primary transition-all appearance-none cursor-pointer"
                                        id="m-bloodType" name="bloodType" data-required="true">
                                    <option value="O+">O Positive (O+)</option>
                                    <option value="O-">O Negative (O-)</option>
                                    <option selected value="A+">A Positive (A+)</option>
                                    <option value="A-">A Negative (A-)</option>
                                    <option value="B+">B Positive (B+)</option>
                                    <option value="B-">B Negative (B-)</option>
                                    <option value="AB+">AB Positive (AB+)</option>
                                    <option value="AB-">AB Negative (AB-)</option>
                                    <option value="Unknown">Pending Lab Test</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                            </div>
                            <span class="font-body-sm text-[11px] text-secondary">Essential for cleanroom &amp; factory emergency response</span>
                        </div>

                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-sm text-label-sm text-on-surface-variant" for="m-citizenship">
                                Citizenship <span class="text-error font-bold">*</span>
                            </label>
                            <div class="relative">
                                <select class="w-full h-11 px-space-md pr-10 rounded-lg bg-surface-container-low text-on-surface
                                               font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest
                                               focus:ring-2 focus:ring-primary transition-all appearance-none cursor-pointer"
                                        id="m-citizenship" name="citizenship">
                                    <option selected value="Filipino">Filipino</option>
                                    <option value="Japanese">Japanese (Expatriate)</option>
                                    <option value="Dual">Dual Citizen</option>
                                    <option value="Other">Foreign National</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                            </div>
                            <span class="font-body-sm text-[11px] text-secondary">Subic Bay Freeport Zone Work Permit applies</span>
                        </div>
                    </div>
                </form>
            </div>

            <!-- ID photo: desktop keeps this in its always-visible sidebar; mobile has no sidebar,
                 so it lives here in step 1 instead of being its own step (which shifted every later step number). -->
            <div class="flex flex-col bg-surface-container-lowest rounded-xl p-4 shadow-sm mt-4">
                <div class="flex items-center justify-between mb-3">
                    <span class="font-title-sm text-title-sm text-on-surface">Employee Biometrics</span>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">ID Photo</span>
                </div>
                <div class="relative group cursor-pointer w-full max-w-[240px] mx-auto aspect-square rounded-xl bg-surface-container-low flex flex-col items-center justify-center p-4 transition-all overflow-hidden" id="dropzoneContainerMobile">
                    <div class="w-20 h-20 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm text-primary mb-space-sm transition-transform">
                        <span class="material-symbols-outlined text-[36px]">add_a_photo</span>
                    </div>
                    <span class="font-label-lg text-label-lg text-on-surface font-semibold text-center">Drag 2x2 badge photo here</span>
                    <span class="font-body-sm text-body-sm text-secondary text-center mt-1">PNG, JPG up to 5MB (White background mandatory)</span>
                    <input accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" type="file">
                </div>
                <div class="grid grid-cols-2 gap-2 pt-4">
                    <button class="h-10 px-2 rounded-lg bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 transition-colors" type="button">
                        <span class="material-symbols-outlined text-[18px] text-primary">folder_open</span>
                        <span>Browse PC</span>
                    </button>
                    <button class="h-10 px-2 rounded-lg bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md text-label-md flex items-center justify-center gap-2 transition-colors" type="button">
                        <span class="material-symbols-outlined text-[18px] text-secondary">photo_camera</span>
                        <span>Webcam</span>
                    </button>
                </div>
            </div>

            <div class="flex items-center gap-3 bg-secondary-container text-on-secondary-container p-3 rounded-xl mt-4">
                <div class="w-8 h-8 rounded-full bg-surface-container-lowest text-primary flex items-center justify-center shrink-0 shadow-sm">
