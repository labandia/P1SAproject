@{
    ViewBag.Title = "EmployeesForm";
    Layout = "~/Areas/Production1/Views/Shared/_EmployeesLayout.cshtml";
}

<!-- ============================================================
     HEADER
     ============================================================ -->
<header class="app-header">
    <div class="header-inner">
        <div class="header-left">
            <div class="brand">
                <div class="brand-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" />
                    </svg>
                </div>
                <div>
                    <div class="brand-title">
                        SANYO DENKI
                        <span class="brand-badge">HR Portal</span>
                    </div>
                    <p class="brand-sub">Employee Encoder System</p>
                </div>
            </div>
            <div class="header-divider"></div>
            <nav class="breadcrumb" aria-label="Breadcrumb">

                <span class="crumb-current">Create New Record</span>
            </nav>
        </div>
        <div class="header-right">
            <div class="search-box">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                <input type="text" placeholder="Search employee by ID, name..." />
                <kbd class="search-kbd">⌘K</kbd>
            </div>
            <button class="icon-btn" title="Notifications" type="button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
                <span class="notif-dot"></span>
            </button>
            <button class="icon-btn" title="Help" type="button">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
            </button>
        </div>
    </div>
</header>


<!-- ============================================================
     MAIN CONTENT
     ============================================================ -->
<main class="main-content">

    <!-- Content grid -->
    <div class="content-grid">

        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar">

            <!-- Profile card -->
            <div class="card profile-card">
                <div class="photo-upload">
                    <div class="photo-upload-area">
                        <div class="photo-upload-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                        </div>
                        <span class="photo-upload-title">Upload Employee Photo</span>
                        <span class="photo-upload-hint">JPG, PNG up to 2MB (or drag here)</span>
                    </div>
                    <div class="photo-actions">
                        <button class="btn-photo" type="button">
                            <svg class="icon-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Browse
                        </button>
                        <button class="btn-photo" type="button">
                            <svg class="icon-slate" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /><path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Webcam
                        </button>
                    </div>
                </div>

                <h3 class="sidebar-name" id="sidebarName">New Employee (Draft)</h3>
                <p class="sidebar-pisa" id="sidebarPisaId">Auto-assigning PISA ID...</p>
                <p class="sidebar-position">Position Not Assigned</p>

                <div class="divider"></div>

                <div class="readiness-widget">
                    <div class="readiness-header">
                        <span>Record Readiness</span>
                        <span id="readinessPercent">0% Complete</span>
                    </div>
                    <div class="readiness-bar-track">
                        <div class="readiness-bar-fill" id="readinessBar" style="width: 2%"></div>
                    </div>
                    <p class="readiness-hint" id="readinessHint">
                        <svg class="icon-amber" fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" fill-rule="evenodd" /></svg>
                        Fill in required personal details to advance
                    </p>
                </div>

                <div class="spec-grid">
                    <div class="spec-item">
                        <span class="spec-label">Status</span>
                        <span class="spec-value draft"><span class="dot"></span> Draft</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Type</span>
                        <span class="spec-value">Pending</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Plant</span>
                        <span class="spec-value" id="sidebarPlant">Unassigned</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Work Entries</span>
                        <span class="spec-value muted">0 Logged</span>
                    </div>
                </div>
            </div>

        </aside>

        <!-- ============ MAIN PANEL ============ -->
        <section class="main-panel">
            <div class="tabs-wrapper">

                <!-- Tab navigation -->
                <div class="tabs-nav-bar">
                    <nav class="tabs-nav" id="tabNav" aria-label="Tabs">
                        <button type="button" class="tab-link active" data-tab="personal">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Personal Details
                            <span class="tab-dot"></span>
                        </button>
                        <button type="button" class="tab-link" data-tab="employment">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Employment
                        </button>
                        <button type="button" class="tab-link" data-tab="address">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Addresses
                        </button>
                        <button type="button" class="tab-link" data-tab="contact">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Contacts &amp; Emergency
                        </button>
                        <button type="button" class="tab-link" data-tab="education">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Education
                        </button>
                        <button type="button" class="tab-link" data-tab="skills">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Skills &amp; Certs
                        </button>
                        <button type="button" class="tab-link" data-tab="work">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                            Work History
                        </button>
                    </nav>
                    <div class="tabs-mode-info">
                        <span class="mode-badge">New Hire Mode</span>
                        <span class="sections-label" id="sectionsCompletedLabel">0 of 7 Sections Completed</span>
                    </div>
                </div>

                <!-- Form body -->
                <form id="employeeForm" class="form-body" novalidate>

                    <!-- ============ STEP 1: PERSONAL ============ -->
                    <div class="step-panel active" data-step-panel="0">
                        <div class="info-banner">
                            <svg fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" fill-rule="evenodd" /></svg>
                            <div class="info-banner-text">
                                <span class="strong">Creating New Employee Record.</span> Fields marked with an asterisk (<span class="req-mark">*</span>) are required to Input.
                            </div>
                        </div>

                        <div class="section-header">
                            <div class="section-header-left">
                                <h3>
                                    <svg fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" fill-rule="evenodd" /></svg>
                                    Legal Name &amp; Demographics
                                </h3>
                                <p>Please ensure all entries match legal government identification cards.</p>
                            </div>
                            <span class="req-badge">* Required fields</span>
                        </div>


                        <div class="form-row cols-4">
                            <div class="form-group">
                                <label class="form-label" for="employeeCode">Employee Code <span class="req">*</span></label>
                                <input id="employeeCode" name="employeeCode" class="form-input mono" type="text"
                                       maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false"
                                       data-required="true" data-validate="code"
                                       data-invalid-msg="Use letters, numbers and dashes only."
                                       placeholder="e.g. 12345" />
                                <span class="error-text">Employee code is required.</span>
                            </div>


                            <div class="form-group">
                                <label class="form-label" for="lastName">Last Name <span class="req">*</span></label>
                                <input id="lastName" name="lastName" class="form-input" type="text" autocomplete="family-name" maxlength="50" placeholder="e.g. Dela Cruz" data-required="true" />
                                <span class="error-text">Last name is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="givenName">Given Name <span class="req">*</span></label>
                                <input id="givenName" name="givenName" class="form-input" type="text" autocomplete="given-name" maxlength="50" placeholder="e.g. Juan" data-required="true" />
                                <span class="error-text">Given name is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="middleName">Middle Name <span class="opt">(Optional)</span></label>
                                <input id="middleName" name="middleName" class="form-input" type="text" autocomplete="additional-name" maxlength="50" placeholder="e.g. Santos" />
                            </div>

                        </div>

                        <div class="form-row cols-4">
                            <div class="form-group">
                                <label class="form-label" for="dob">Date of Birth <span class="req">*</span></label>
                                <input id="dob" name="dob" class="form-input" type="date" autocomplete="bday" data-required="true" data-validate="dob" data-invalid-msg="Employee must be 18 years old or above." />
                                <span class="error-text">Date of birth is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Gender <span class="req">*</span></label>
                                <div class="radio-group" id="genderGroup">
                                    <label class="radio-option">
                                        <input type="radio" name="gender" value="Male" data-required="true" />
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                                        Male
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="gender" value="Female" data-required="true" />
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                                        Female
                                    </label>
                                </div>
                                <span class="error-text" data-error-for="gender">Please select a gender.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="civilStatus">Civil Status <span class="req">*</span></label>
                                <select id="civilStatus" name="civilStatus" class="form-select" data-required="true">
                                    <option value="" selected>Select Civil Status</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated / Divorced</option>
                                </select>
                                <span class="error-text">Civil status is required.</span>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="religion">Religion / Affiliation</label>
                                <input id="religion" name="religion" class="form-input" type="text" maxlength="60" placeholder="Select or type religion..." />
                            </div>

                        </div>

                        <div class="form-row cols-4">

                            <div class="form-group">
                                <label class="form-label" for="bloodType">Blood Type <span class="req">*</span></label>
                                <select id="bloodType" name="bloodType" class="form-select" data-required="true">
                                    <option value="" selected>Select Blood Type</option>
                                    <option value="A+">A Positive (A+)</option>
                                    <option value="A-">A Negative (A-)</option>
                                    <option value="B+">B Positive (B+)</option>
                                    <option value="B-">B Negative (B-)</option>
                                    <option value="AB+">AB Positive (AB+)</option>
                                    <option value="AB-">AB Negative (AB-)</option>
                                    <option value="O+">O Positive (O+)</option>
                                    <option value="O-">O Negative (O-)</option>
                                    <option value="Unknown">Unknown / To Follow</option>
                                </select>
                                <span class="error-text">Blood type is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="citizenship">Citizenship <span class="req">*</span></label>
                                <input id="citizenship" name="citizenship" class="form-input" type="text" maxlength="40" placeholder="e.g. Filipino" value="Filipino" data-required="true" />
                                <span class="error-text">Citizenship is required.</span>
                            </div>

                            <div class="form-group"></div>
                            <div class="form-group"></div>
                        </div>

                        
                    </div>

                    <!-- ============ STEP 2: EMPLOYMENT ============ -->
                    <div class="step-panel" data-step-panel="1">
                        <div class="section-header">
                            <div class="section-header-left">
                                <h3>
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                                    Employment Information
                                </h3>
                                <p>Record agency, department, and process assignment details.</p>
                            </div>
                            <span class="req-badge">* Required fields</span>
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label class="form-label" for="dateHired">Date Hired</label>
                                <input id="dateHired" name="dateHired" class="form-input" type="date" />
                            </div>
                            <div class="form-group" style="display: none;">
                                <label class="form-label" for="process">Process</label>
                                <input id="process" name="process" class="form-input" type="text" maxlength="60" placeholder="e.g. Assembly" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="agencyId">Agency <span class="req">*</span></label>
                                <select id="agencyId" name="agencyId" class="form-select" data-required="true">
                                    <option value="" selected>-- Select --</option>
                                    <option value="1">SDP</option>
                                    <option value="2">TMS</option>
                                    <option value="3">One Source</option>
                                    <option value="4">SyneryOne</option>
                                    <option value="5">Golden Hands</option>
                                </select>
                                <span class="error-text">Agency is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="departmentId">Department ID</label>
                                <select id="departmentId" name="departmentId" class="form-select">
                                    <option value="" selected>-- Select --</option>
                                    <option value="1">Molding</option>
                                    <option value="2">Press</option>
                                    <option value="3">Rotor</option>
                                    <option value="4">Winding</option>
                                    <option value="5">Circuit</option>
                                    <option value="6">Process Control</option>
                                    <option value="7">Final Assembly</option>
                                </select>
                            </div>
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label" for="remarks">Remarks</label>
                                <input id="remarks" name="remarks" class="form-input" type="text" maxlength="200" placeholder="e.g. Onboarding notes" />
                            </div>
                        </div>
                    </div>

                    <!-- ============ STEP 3: ADDRESSES ============ -->
                    <div class="step-panel" data-step-panel="2">
                        <div class="section-header">
                            <div class="section-header-left">
                                <h3>
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                                    Residential &amp; Permanent Address
                                </h3>
                                <p>Provide complete address details for government remittances and emergency response.</p>
                            </div>
                            <span class="req-badge">* Required fields</span>
                        </div>

                        <div class="form-row cols-2">
                            <div class="form-group">
                                <label class="form-label" for="permAddress">Permanent Address <span class="req">*</span></label>
                                <input id="permAddress" name="permAddress" class="form-input" type="text" maxlength="250" autocomplete="street-address" data-required="true" placeholder="House No., Street, Barangay, City / Municipality, Province, Zip Code" />
                                <span class="error-text">Permanent address is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="tempAddress">Temporary Address</label>
                                <input id="tempAddress" name="tempAddress" class="form-input" type="text" maxlength="250" placeholder="House No., Street, Barangay, City / Municipality, Province, Zip Code" />
                            </div>
                        </div>
                    </div>

                    <!-- ============ STEP 4: CONTACTS ============ -->
                    <div class="step-panel" data-step-panel="3">
                        <div class="section-header">
                            <div class="section-header-left">
                                <h3>
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
                                    Contact Details &amp; Emergency Contacts
                                </h3>
                                <p>Provide reachable contact numbers and at least one emergency contact.</p>
                            </div>
                            <span class="req-badge">* Required fields</span>
                        </div>

                        <div class="form-row cols-3">
                            <div class="form-group">
                                <label class="form-label" for="mobile">Contact Number <span class="req">*</span></label>
                                <input id="mobile" name="mobile" class="form-input" type="tel" inputmode="tel" autocomplete="tel" maxlength="16"
                                       data-required="true" data-validate="phone"
                                       data-invalid-msg="Enter a valid PH mobile number (e.g. 0917 123 4567)."
                                       placeholder="e.g. 0917 123 4567" />
                                <span class="error-text">Mobile number is required.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="personalEmail">Personal Email</label>
                                <input id="personalEmail" name="personalEmail" class="form-input" type="email" autocomplete="email" maxlength="100"
                                       data-validate="email" data-invalid-msg="Enter a valid email address."
                                       placeholder="e.g. juan.delacruz@email.com" />
                                <span class="error-text"></span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="facebook">Facebook Account</label>
