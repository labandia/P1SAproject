<script src="~/Scripts/chart.js"></script>
<script type="module">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

    // ============================================================
    //  EMPLOYEE ENCODER – ES6 Module
    // ============================================================

    const TOTAL_STEPS = 7;
    const STEP_LABELS = ['Personal Info', 'Employment', 'Addresses', 'Contacts', 'Education', 'Skills & IDs', 'Review & Enroll'];
    const STEP_TAB = ['personal', 'employment', 'address', 'contact', 'education', 'skills', 'work'];
    const TAB_STEP = Object.fromEntries(STEP_TAB.map((t, i) => [t, i]));

    // Create action of Areas/Production1/Controllers/EmployeesController
    const API_CREATE = '@Url.Action("Create", "Employees", new { area = "Production1" })';

    const ICON_ARROW = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>';
    const ICON_CHECK = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>';

    const digitsOf = s => (s || '').replace(/\D/g, '');

    // Fill a mask like "000-000-000-000" with the digits typed so far
    function applyMask(value, mask) {
        const digits = digitsOf(value);
        let out = '', di = 0;
        for (const ch of mask) {
            if (di >= digits.length) break;
            out += ch === '0' ? digits[di++] : ch;
        }
        return out.replace(/[^0-9]+$/, ''); // no dangling separator
    }

    // Format validators: only called when the field has a value
    const FORMAT_RULES = {
        dob(v) {
            const dob = new Date(v);
            if (isNaN(dob.getTime())) return false;
            const t = new Date();
            let age = t.getFullYear() - dob.getFullYear();
            const m = t.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && t.getDate() < dob.getDate())) age--;
            return age >= 18 && age <= 80;
        },
        phone: v => /^(\+63|0)9\d{9}$/.test(v.replace(/[\s-]/g, '')),
        // \x40 is the at-sign; a literal one here would be parsed by Razor as code
        email: v => /^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]{2,}$/.test(v),
        digits: v => /^\d{7,13}$/.test(v),
        year: v => /^\d{4}$/.test(v) && +v >= 1900 && +v <= new Date().getFullYear(),
        mask(v, f) {
            const maskLen = (f.dataset.mask.match(/0/g) || []).length;
            const n = digitsOf(v).length;
            const min = +f.dataset.minDigits;
            return min ? (n === min || n === maskLen) : n === maskLen;
        }
    };


    class EmployeeEncoder {
        constructor() {
            this.currentStep = 0;
            this.toastTimer = null;
            this.skills = [];   // pending skills, sent as Skilled[]

            this.dom = {
                form: document.getElementById('employeeForm'),
                panels: [...document.querySelectorAll('[data-step-panel]')],
                tabLinks: [...document.querySelectorAll('.tab-link')],
                prevBtn: document.getElementById('prevBtn'),
                nextBtn: document.getElementById('nextBtn'),
                draftBtn: document.getElementById('draftBtn'),
                clearBtn: document.getElementById('clearBtn'),
                cancelBtn: document.getElementById('cancelBtn'),
                readinessPercent: document.getElementById('readinessPercent'),
                readinessBar: document.getElementById('readinessBar'),
                readinessHint: document.getElementById('readinessHint'),
                sectionsCompletedLabel: document.getElementById('sectionsCompletedLabel'),
                sidebarName: document.getElementById('sidebarName'),
                sidebarPlant: document.getElementById('sidebarPlant'),
                toast: document.getElementById('toast'),
                toastMsg: document.getElementById('toastMsg'),
                skillDept: document.getElementById('skilldepartmentId'),
                skillProcess: document.getElementById('ProcessId'),
                skillSaveBtn: document.getElementById('SkillSavebtn'),
                skillsTable: document.getElementById('SkillsTable'),
                newProcessName: document.getElementById('NewProcessName'),
                addProcessBtn: document.getElementById('AddProcessBtn')
            };
            // reviewSummary: document.getElementById('reviewSummary'),

            this.init();
        }

        // ---------------- INIT ----------------
        init() {
            // remember each field's default (required) message so format errors can swap it and restore it
            this.dom.form.querySelectorAll('.error-text').forEach(el => { el.dataset.defaultMsg = el.textContent; });

            // DOB: must be 18+
            const dob = document.getElementById('dob');
            if (dob) {
                const t = new Date();
                dob.max = new Date(t.getFullYear() - 18, t.getMonth(), t.getDate()).toISOString().split('T')[0];
            }

            this.bindEvents();
            this.render(0);
            this.updateRadioUI();
            this.updateProgress();
        }

        // ---------------- EVENTS ----------------
        bindEvents() {
            this.dom.tabLinks.forEach(link =>
                link.addEventListener('click', () => {
                    const target = TAB_STEP[link.dataset.tab];
                    if (target !== undefined) this.goToStep(target);
                }));

            this.dom.prevBtn.addEventListener('click', () => this.goToStep(this.currentStep - 1, { skipValidation: true }));
            this.dom.nextBtn.addEventListener('click', () => this.handleNext());

            this.dom.draftBtn.addEventListener('click', () => this.showToast('Draft saved locally. You may continue later.', true));
            this.dom.cancelBtn.addEventListener('click', () => {
                if (confirm('Cancel and exit? Unsaved changes will be lost.')) this.showToast('Exited without saving.', false);
            });
            this.dom.clearBtn.addEventListener('click', () => {
                if (!confirm('Clear all fields? This cannot be undone.')) return;
                this.dom.form.reset();
                this.clearAllErrors();
                document.getElementById('citizenship').value = 'Filipino';
                this.updateRadioUI();
                this.updateProgress();
                this.goToStep(0, { skipValidation: true });
                this.showToast('All fields cleared.', false);
            });

            // Enter key must never submit/reload the page
            this.dom.form.addEventListener('submit', e => e.preventDefault());

            // Typing: sanitize/mask, silently clear errors once valid, update progress
            this.dom.form.addEventListener('input', e => this.handleInput(e));
            // Leaving a field: show errors
            this.dom.form.addEventListener('focusout', e => this.handleBlur(e));
            // Select / radio / date picks
            this.dom.form.addEventListener('change', e => this.handleChange(e));

            // ---- Skills ----
            this.dom.skillSaveBtn.addEventListener('click', () => this.addSkill());

            // edit/delete via delegation (rows are re-rendered)
            this.dom.skillsTable.addEventListener('click', e => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const idx = +btn.dataset.index;
                if (btn.dataset.action === 'delete') {
                    this.skills.splice(idx, 1);
                    this.renderSkills();
                } else if (btn.dataset.action === 'edit') {
                    const s = this.skills[idx];
                    this.dom.skillDept.value = s.DepartmentId;
                    this.dom.skillDept.dispatchEvent(new Event('change', { bubbles: true })); // reload processes if you have a handler
                    this.dom.skillProcess.value = s.ProcessId;
                    this.skills.splice(idx, 1);   // re-added on Save Skills
                    this.renderSkills();
                }
            });


            this.dom.skillDept.addEventListener('change', () => this.loadProcesses());
            this.dom.addProcessBtn.addEventListener('click', () => this.addProcess());
        }

        handleInput(e) {
            const t = e.target;
            if (!t.matches('input, select, textarea') || t.type === 'radio') return;

            if (t.dataset.digitsOnly === 'true') t.value = t.value.replace(/\D/g, '');
            if (t.dataset.mask) t.value = applyMask(t.value, t.dataset.mask);

            // live: only hide an existing error as soon as the value becomes valid
            if (t.classList.contains('is-invalid') && this.validateSingle(t)) this.applyFieldValidation(t, true);

            if (t.id === 'lastName' || t.id === 'givenName') this.updateSidebarName();
            this.updateProgress();
        }

        handleBlur(e) {
            const t = e.target;
            if (!t.matches('input, select, textarea') || t.type === 'radio') return;
            if (t.dataset.required === 'true' || t.value) this.applyFieldValidation(t, true);
        }

        handleChange(e) {
            const t = e.target;
            if (!t.matches('input, select, textarea')) return;

            if (t.type === 'radio') {
                this.updateRadioUI();
                this.validateRadioGroup(t.name, true);
            } else {
                this.applyFieldValidation(t, true);
            }
            if (t.id === 'lastName' || t.id === 'givenName') this.updateSidebarName();
            this.updateProgress();
        }

        // ---------------- NAVIGATION ----------------
        /** First step in [from, to) that has invalid required/format fields, or -1 */
        firstInvalidStep(from, to) {
            for (let s = from; s < to; s++) if (!this.validateStep(s, false)) return s;
            return -1;
        }

        goToStep(index, { skipValidation = false } = {}) {
            if (index < 0 || index >= TOTAL_STEPS) return;

            let target = index;
            let blocked = false;

            // moving forward (button or tab): every step we pass over must be valid
            if (index > this.currentStep && !skipValidation) {
                const bad = this.firstInvalidStep(this.currentStep, index);
                if (bad !== -1) { target = bad; blocked = true; }
            }

            this.render(target);

            if (blocked) {
                this.validateStep(target, true);
                this.showToast('Please complete the required fields in this step.', false);
            }
        }

        render(index) {
            this.currentStep = index;
            this.dom.panels.forEach(p => p.classList.toggle('active', Number(p.dataset.stepPanel) === index));
            this.setActiveTab(index);
            this.dom.prevBtn.disabled = index === 0;

            const isLast = index === TOTAL_STEPS - 1;
            this.dom.nextBtn.innerHTML = isLast
                ? `<span>Enroll Employee</span>${ICON_CHECK}`
                : `<span>Save &amp; Proceed to ${STEP_LABELS[index + 1]}</span>${ICON_ARROW}`;
            this.dom.nextBtn.classList.toggle('btn-success', isLast);
            this.dom.nextBtn.classList.toggle('btn-primary', !isLast);

            if (isLast) this.buildReview();
            this.updateProgress();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        async handleNext() {
            if (this.currentStep < TOTAL_STEPS - 1) {
                this.goToStep(this.currentStep + 1);
                return;
            }

            const bad = this.firstInvalidStep(0, TOTAL_STEPS);
            if (bad !== -1) {
                this.render(bad);
                this.validateStep(bad, true);
                this.showToast('Some required fields are missing. Please review highlighted fields.', false);
                return;
            }

            await this.enroll();
        }

        /**
         * Maps the form onto the server model: EmployeeProfile { Information, Education[], Addresses[], Skilled[] }.
         * Property names are PascalCase to match the C# classes exactly.
         * Form fields with no model property (suffix, religion, blood type, civil status, citizenship,
         * email, HR remarks, statutory IDs, skills text, extra work history) are NOT sent.
         */
        buildPayload() {
            const v = id => (document.getElementById(id)?.value || '').trim();
            const orNull = id => v(id) || null;
            const num = id => { const n = parseInt(v(id), 10); return isNaN(n) ? null : n; };
            const checked = name => this.dom.form.querySelector(`input[name="${name}"]:checked`)?.value;

            const education = [];
            // SchoolLevel: 2 = High School, 3 = College (see the SchoolLevel enum)
            if (v('collegeSchool')) education.push({ SchoolLevel: 3, SchoolName: v('collegeSchool'), Course: orNull('collegeCourse'), YearGraduated: num('collegeYear') });
            if (v('hsSchool')) education.push({ SchoolLevel: 2, SchoolName: v('hsSchool'), Course: orNull('hsCourse'), YearGraduated: num('hsYear') });

            const addresses = [{ FullAddress: v('permAddress'), IsPermanent: true }];
            if (v('tempAddress')) addresses.push({ FullAddress: v('tempAddress'), IsPermanent: false });

            return {
                EmployeeCode: v('employeeCode'),
                FirstName: v('givenName'),
                MiddleName: orNull('middleName'),
                LastName: v('lastName'),
                Process: orNull('process'),
                AgencyId: num('agencyId') || 0,
                DepartmentId: num('departmentId'),
                StatusId: 1,
                WIthVech: Number(checked('vehicleMode') || 0),
                Information: {
                    Gender: checked('gender') === 'Female',   // false = Male, true = Female
                    Category: false,                            // no form field yet: Direct Hired
                    DateOfBirth: orNull('dob'),
                    DateHired: v('dateHired')  || null,
                    ContactNumber: orNull('mobile'),
                    SocialMedia: orNull('facebook'),
                    PickUpPoint: num('pickUpPoint') || 0,
                    Remarks: orNull('remarks')
                },
                Education: education,
                Addresses: addresses,
                Skilled: this.skills.map(s => ({
                    ProcessId: s.ProcessId,
                    DepartmentId: s.DepartmentId
                })),
            };
        }

        /** POSTs the payload to EmployeesController.Create and reports the result. */
        async enroll() {
            const btn = this.dom.nextBtn;
            btn.disabled = true;           // block double-clicks: a second POST would create a duplicate
            let saved = false;

            console.log(this.buildPayload());

            try {

                const res = await postMethod('@Url.Action("SaveEmployee", "Employees")', this.buildPayload());
                // const data = await res.json().catch(() => null);
                console.log(res);
                // if (!res.ok || !data || !data.success) {
                //     this.showToast((data && data.message) || 'Enrollment failed. Please try again.', false);
                //     return;
                // }

                // saved = true;
                // document.getElementById('sidebarPisaId').textContent = data.employeeCode || ('Employee ID ' + data.employeeId);
                this.showToast('Employee record enrolled successfully!', true);
            } catch (err) {
                console.error(err);
                this.showToast('Network error. The record was not saved.', false);
            } finally {
                if (!saved) btn.disabled = false;   // stays disabled after success so it cannot be enrolled twice
            }
        }

        setActiveTab(stepIndex) {
            const key = STEP_TAB[stepIndex];
            this.dom.tabLinks.forEach(a => {
                const on = a.dataset.tab === key;
                a.classList.toggle('active', on);
                a.setAttribute('aria-selected', on ? 'true' : 'false');
                a.toggleAttribute('aria-current', on);
            });
        }

        // ---------------- SIDEBAR UI ----------------
        updateSidebarName() {
            const last = document.getElementById('lastName').value.trim();
            const given = document.getElementById('givenName').value.trim();
            const code = document.getElementById('employeeCode').value.trim();
            const full = `${given} ${last}`.trim();
            this.dom.sidebarName.textContent = full || 'New Employee (Draft)';
            this.dom.sidebarName.classList.toggle('filled', !!full);
            document.getElementById('sidebarPisaId').textContent = code || 'Employee code not set';
        }

        updateRadioUI() {
            this.dom.form.querySelectorAll('.radio-group .radio-option').forEach(lbl => {
                const input = lbl.querySelector('input');
                lbl.classList.toggle('selected', !!input?.checked);
            });
        }

        // ---------------- VALIDATION ----------------
        getFieldValue(field) {
            if (field.type === 'radio') {
                const c = this.dom.form.querySelector(`input[name="${field.name}"]:checked`);
                return c ? c.value : '';
            }
            return (field.value || '').trim();
        }

        /** returns '' when valid, otherwise 'empty' | 'format' */
        fieldProblem(field) {
            const value = this.getFieldValue(field);
            if (!value) return field.dataset.required === 'true' ? 'empty' : '';
            const rule = FORMAT_RULES[field.dataset.validate];
            if (rule && !rule(value, field)) return 'format';
            return '';
        }

        validateSingle(field) { return this.fieldProblem(field) === ''; }

        applyFieldValidation(field, show = true) {
            const problem = this.fieldProblem(field);
            const container = field.closest('.form-group') || field.parentElement;
            const errorEl = container?.querySelector('.error-text');

            field.classList.toggle('is-invalid', !!problem && show);
            field.setAttribute('aria-invalid', problem && show ? 'true' : 'false');

            if (errorEl) {
                if (problem === 'format' && field.dataset.invalidMsg) errorEl.textContent = field.dataset.invalidMsg;
                else if (errorEl.dataset.defaultMsg) errorEl.textContent = errorEl.dataset.defaultMsg;
                else if (problem === 'empty') errorEl.textContent = 'This field is required.';
                errorEl.classList.toggle('show', !!problem && show);
            }
            return !problem;
        }

        validateRadioGroup(name, show = true) {
            const radios = [...this.dom.form.querySelectorAll(`input[type="radio"][name="${name}"]`)];
            if (!radios.length || radios[0].dataset.required !== 'true') return true;
            const valid = radios.some(r => r.checked);
            const group = radios[0].closest('.radio-group');
            const err = this.dom.form.querySelector(`[data-error-for="${name}"]`);
            if (err) err.classList.toggle('show', !valid && show);
            if (group) group.classList.toggle('is-invalid', !valid && show);
            return valid;
        }

        validateStep(stepIndex, show = true) {
            const panel = this.dom.panels[stepIndex];
            if (!panel) return true;

            let allValid = true, firstInvalid = null;
            const radioNames = new Set();

            panel.querySelectorAll('input, select, textarea').forEach(field => {
                if (field.type === 'radio') {
                    if (field.dataset.required === 'true') radioNames.add(field.name);
                    return;
                }
                const valid = show ? this.applyFieldValidation(field, true) : this.validateSingle(field);
                if (!valid) { allValid = false; firstInvalid = firstInvalid || field; }
            });

            radioNames.forEach(name => {
                if (!this.validateRadioGroup(name, show)) {
                    allValid = false;
                    firstInvalid = firstInvalid || panel.querySelector(`input[name="${name}"]`);
                }
            });

            if (!allValid && show && firstInvalid) firstInvalid.focus();
            return allValid;
        }

        clearAllErrors() {
            this.dom.form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            this.dom.form.querySelectorAll('.error-text.show').forEach(el => el.classList.remove('show'));
            this.dom.form.querySelectorAll('.radio-group').forEach(g => g.classList.remove('is-invalid'));
            this.updateSidebarName();
        }

        // ---------------- PROGRESS ----------------
        computeStepCompletion(stepIndex) {
            const panel = this.dom.panels[stepIndex];
            if (!panel) return { filled: 0, total: 0, complete: false };

            let total = 0, filled = 0;
            const radioNames = new Set();

            panel.querySelectorAll('[data-required="true"]').forEach(f => {
                if (f.type === 'radio') { radioNames.add(f.name); return; }
                total++;
                if (this.getFieldValue(f) && this.validateSingle(f)) filled++;   // filled AND valid
            });

            radioNames.forEach(name => {
                total++;
                if (panel.querySelector(`input[name="${name}"]:checked`)) filled++;
            });

            // steps with no required fields count as complete only once passed
            const complete = total === 0 ? stepIndex < this.currentStep : filled === total;
            return { filled, total, complete };
        }

        updateProgress() {
            let totalRequired = 0, totalFilled = 0, completedSections = 0;

            for (let i = 0; i < TOTAL_STEPS; i++) {
                const { filled, total, complete } = this.computeStepCompletion(i);
                totalRequired += total;
                totalFilled += filled;
                if (complete) completedSections++;
            }

            const pct = totalRequired === 0 ? 0 : Math.round((totalFilled / totalRequired) * 100);

            this.dom.readinessPercent.textContent = pct + '% Complete';
            this.dom.readinessBar.style.width = Math.max(pct, 2) + '%';

            if (this.dom.readinessHint) {
                this.dom.readinessHint.innerHTML = pct === 100
                    ? '<svg class="icon-emerald" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> All set! You can enroll this employee.'
                    : '<svg class="icon-amber" fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" fill-rule="evenodd"/></svg> Fill in required details to advance';
            }

            this.dom.sectionsCompletedLabel.textContent = `${completedSections} of ${TOTAL_STEPS} Sections Completed`;

            const plant = document.getElementById('plantSelect');
            this.dom.sidebarPlant.textContent = plant?.value ? plant.options[plant.selectedIndex].text : 'Unassigned';

            this.updateSidebarName();
            if (this.currentStep === TOTAL_STEPS - 1) this.buildReview();
        }

        // ---------------- REVIEW ----------------
        buildReview() {
            const raw = id => (document.getElementById(id)?.value || '').trim();
            const val = id => raw(id) || '—';
            const sel = id => {
                const el = document.getElementById(id);
                return el && el.value ? el.options[el.selectedIndex].text : '—';
            };
            const rows = [];
            const add = (label, value) => rows.push(
                `<div class="review-item"><span class="review-label">${label}</span><span class="review-value">${this.escHtml(value)}</span></div>`);
            const join = (a, b) => a === '—' ? '—' : (b === '—' ? a : `${a} — ${b}`);

            const fullName = [raw('givenName'), raw('middleName'), raw('lastName')].filter(Boolean).join(' ');
            add('Employee Code', val('employeeCode'));
            add('Full Name', fullName || '—');
            add('Date of Birth', val('dob'));
            add('Gender', this.dom.form.querySelector('input[name="gender"]:checked')?.value || '—');
            add('Civil Status', val('civilStatus'));
            add('Hire Date', val('hireDate'));
            add('Citizenship', val('citizenship'));
            add('Blood Type', val('bloodType'));
            add('Agency', sel('agencyId'));
            add('Department', sel('departmentId'));
            add('Mobile', val('mobile'));
            add('Personal Email', val('personalEmail'));
            add('Pick-up Point', sel('pickUpPoint'));
            add('Permanent Address', val('permAddress'));
            add('Temporary Address', val('tempAddress'));
            add('College', join(val('collegeSchool'), val('collegeCourse')));
            add('High School', join(val('hsSchool'), val('hsCourse')));

            //this.dom.reviewSummary.innerHTML = rows.join('');
        }

        // ---------------- UTILITIES ----------------
        escHtml(s) {
            return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        showToast(msg, ok = true) {
            this.dom.toastMsg.textContent = msg;
            const icon = this.dom.toast.querySelector('svg');
            if (icon) icon.style.color = ok ? '#34d399' : '#fb7185';
            this.dom.toast.classList.add('show');
            clearTimeout(this.toastTimer);
            this.toastTimer = setTimeout(() => this.dom.toast.classList.remove('show'), 2400);
        }

        // ---------------- SKILLS ----------------
        addSkill() {
            const { skillDept, skillProcess } = this.dom;
            const processId = parseInt(skillProcess.value, 10);

            if (!skillDept.value || isNaN(processId)) {
                this.showToast('Select a department and process first.', false);
                return;
            }
            if (this.skills.some(s => s.ProcessId === processId)) {
                this.showToast('That skill is already added.', false);
                return;
            }

            this.skills.push({
                ProcessId: processId,
                DepartmentId: skillDept.value,                              // string in the C# model
                DepartmentName: skillDept.options[skillDept.selectedIndex].text,  // UI only
                SkilledName: skillProcess.options[skillProcess.selectedIndex].text,
                TaskName: null,
                IsPersonal: 0,
                IsCrossed: 0
            });

            this.renderSkills();
            this.showToast('Skill added.', true);
        }

        renderSkills() {
            this.dom.skillsTable.innerHTML = this.skills.length
                ? this.skills.map((s, i) => `
            <tr>
                <td>${this.escHtml(s.DepartmentName)}</td>
                <td>${this.escHtml(s.SkilledName)}</td>
                <td><button type="button" class="btn-table primary" data-action="edit" data-index="${i}">Edit</button></td>
                <td><button type="button" class="btn-table danger" data-action="delete" data-index="${i}">Delete</button></td>
            </tr>`).join('')
                : '<tr class="empty-row"><td colspan="4">No skills added yet</td></tr>';
        }

        // ---------------- PROCESSES ----------------
            async loadProcesses() {
                const deptId = this.dom.skillDept.value;
                const sel = this.dom.skillProcess;
                sel.innerHTML = '';
                if (!deptId) return;

                try {
                    const res = await getMethod('@Url.Action("GetProcessDepartment", "Employees")', { Department: deptId });
                    //const list = (res && typeof res.json === 'function') ? await res.json() : res;
                    if (!res?.Success) {
                        console.log('No data found in 4M ');
                        return;
                    }

                    const list = res.data;

                    sel.innerHTML = (list && list.length)
                        ? list.map(p => `<option value="${p.ProcessId}">${this.escHtml(p.ProcessName)}</option>`).join('')
                        : '<option value="">No process for this department</option>';

                } catch (err) {
                    console.error(err);
                    this.showToast('Failed to load processes.', false);
                }
            }

            async addProcess() {
                const deptId = parseInt(this.dom.skillDept.value, 10);
                const name = this.dom.newProcessName.value.trim();

                if (isNaN(deptId)) { this.showToast('Select a department first.', false); return; }
                if (!name) { this.showToast('Enter a process name.', false); return; }


                this.dom.addProcessBtn.disabled = true;
                try {
                    const res = await postMethod('@Url.Action("AddProcessEmployee", "Employees", new { area = "Production1" })',
                        { DepartmentId: deptId, ProcessName: name });

                    console.log(res);

                    if (!res.Success) {
                        this.showToast((res && res.message) || 'Could not add process.', false);
                       return;
                    }

                    //this.dom.newProcessName.value = '';
                    await this.loadProcesses();
                    this.showToast('Process added.', true);
                } catch (err) {
                    console.error(err);
                    this.showToast('Network error. Process not saved.', false);
                } finally {
                    this.dom.addProcessBtn.disabled = false;
                }
            }

    }

    const start = () => { window.employeeEncoder = new EmployeeEncoder(); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
</script>
