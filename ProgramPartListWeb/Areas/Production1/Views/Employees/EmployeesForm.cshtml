<script>
    /* ------------------------------------------------------------
       STEP NAVIGATION
       Single source of truth: currentStep (1..7).
       ------------------------------------------------------------ */
    let currentStep = 1;
    const TOTAL_STEPS = 7;

    const SAVE_URL = '@Url.Action("SaveEmployee", "Employees", new { area = "Production1" })';

    const STEP_LABELS = {
        1: 'Personal Details',
        2: 'Employment',
        3: 'Address',
        4: 'Education & Skills',
        5: 'Photo Upload',
        6: 'Work History',
        7: 'Work History'
    };

    const DESKTOP_NEXT_LABELS = {
        1: 'Save & Proceed to Employment',
        2: 'Save & Proceed to Addresses',
        3: 'Save & Proceed to Contacts',
        4: 'Save & Proceed to Education',
        5: 'Save & Proceed to Skills',
        6: 'Save & Proceed to Work History',
        7: 'Complete & Submit Record'
    };

    function goToStep(step) {
        const newStep = Math.max(1, Math.min(TOTAL_STEPS, step));
        currentStep = newStep;

        document.querySelectorAll('#mobileStepNav .step-tab').forEach(tab => {
            tab.classList.toggle('is-active', parseInt(tab.dataset.step, 10) === newStep);
        });
        document.querySelectorAll('#desktopStepNav .step-tab').forEach(tab => {
            tab.classList.toggle('is-active', parseInt(tab.dataset.step, 10) === newStep);
        });

        // Mobile has 6 panels; desktop step 7 maps to mobile 6.
        const mobilePanelStep = newStep > 6 ? 6 : newStep;
        document.querySelectorAll('#mobileMain [data-step-panel]').forEach(panel => {
            panel.classList.toggle('is-active', parseInt(panel.dataset.stepPanel, 10) === mobilePanelStep);
        });
        document.querySelectorAll('.desktop-main [data-step-panel]').forEach(panel => {
            panel.classList.toggle('is-active', parseInt(panel.dataset.stepPanel, 10) === newStep);
        });

        const mobileLabel = document.getElementById('mobileStepLabel');
        if (mobileLabel) mobileLabel.textContent = STEP_LABELS[mobilePanelStep] || 'Personal Details';

        const nextLabel = document.getElementById('d-nextLabel');
        if (nextLabel) nextLabel.textContent = DESKTOP_NEXT_LABELS[newStep] || 'Save & Proceed';

        const progressPct = Math.round((newStep / TOTAL_STEPS) * 100);
        const progressLabel = document.getElementById('desktopProgressLabel');
        const progressBar = document.getElementById('desktopProgressBar');
        if (progressLabel) progressLabel.textContent = progressPct + '% (Step ' + newStep + ' of ' + TOTAL_STEPS + ')';
        if (progressBar) progressBar.style.width = progressPct + '%';

        const prevBtn = document.getElementById('d-prevBtn');
        if (prevBtn) {
            const isFirst = newStep === 1;
            prevBtn.classList.toggle('opacity-60', isFirst);
            prevBtn.classList.toggle('cursor-not-allowed', isFirst);
            prevBtn.classList.toggle('bg-surface-container-low', true);
            prevBtn.classList.toggle('text-outline', isFirst);
            prevBtn.classList.toggle('text-on-surface-variant', !isFirst);
            prevBtn.disabled = isFirst;
        }

        const mobileProceedBtn = document.querySelector('.mobile-bottom-nav button[onclick*="goToStep"]');
        if (mobileProceedBtn) {
            mobileProceedBtn.disabled = newStep >= 6;
            mobileProceedBtn.classList.toggle('opacity-60', newStep >= 6);
            mobileProceedBtn.classList.toggle('cursor-not-allowed', newStep >= 6);
        }

        if (window.innerWidth < 1024) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            const desktopMain = document.querySelector('.desktop-main');
            if (desktopMain) window.scrollTo({ top: desktopMain.offsetTop, behavior: 'smooth' });
        }
    }

    /* ============================================================
       SAVE DATA
       ============================================================ */

    // WHY: the page renders BOTH a mobile and a desktop form with duplicate field
    // names (lastName, employeeCode, religion...). Reading document-wide would grab
    // the wrong copy, so we always read from whichever layout is currently visible.
    function getActiveRoot() {
        const desktop = document.querySelector('.desktop-main');
        return (desktop && desktop.style.display !== 'none')
            ? desktop
            : document.getElementById('mobileMain');
    }

    function val(root, name) {
        const el = root.querySelector('[name="' + name + '"]');
        return el ? (el.value || '').trim() : '';
    }

    // WHY: desktop DOB is <input type="date"> (yyyy-MM-dd) but mobile is free text
    // DD/MM/YYYY. The server only receives ISO so day/month can never be swapped.
    function toIsoDate(s) {
        if (!s) return null;
        if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
        const m = s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        return m ? m[3] + '-' + m[2] + '-' + m[1] : null;
    }

    function getGender(root) {
        if (root.id === 'mobileMain') {
            // Mobile: the active button carries bg-primary.
            const mMale = document.getElementById('m-gender-male');
            return mMale && mMale.classList.contains('bg-primary') ? 'Male' : 'Female';
        }
        // Desktop: buttons get data-gender + .is-selected in initSaveData().
        const sel = root.querySelector('[data-gender].is-selected');
        return sel ? sel.dataset.gender : '';
    }

    // Builds the payload in the exact shape of the C# EmployeeProfile model
    // (Information, Education[], Addresses[]) so the controller can bind it directly.
    // Property names are camelCase; MVC's model binder matches them case-insensitively.
    function collectEmployeeData() {
        const root = getActiveRoot();
        const vehicle = root.querySelector('input[name="vehicleMode"]:checked');

        // WHY: the desktop inputs only *display* uppercase via CSS; the typed value is
        // still whatever the encoder entered. HR records are uppercase, so normalise here.
        const lastName = val(root, 'lastName').toUpperCase();
        const firstName = val(root, 'givenName').toUpperCase();
        const middleName = val(root, 'middleName').toUpperCase();

        // Mobile uses four address inputs; desktop uses one free-text box.
        // FullAddress is a single column, so join the mobile parts into one string.
        let permAddress = val(root, 'permAddress');
        if (!permAddress) {
            permAddress = ['streetAddress', 'city', 'province', 'postalCode']
                .map(n => val(root, n)).filter(Boolean).join(', ');
        }
        const tempAddress = val(root, 'tempAddress');

        // SchoolLevel codes must match the SchoolLevel enum: 1 Elem, 2 HS, 3 College, 4 Voc.
        // WHY: rows with a blank school are skipped so we never insert empty education rows.
        const education = [];
        const addEdu = (level, school, course, year) => {
            if (!school) return;
            education.push({
                SchoolLevel: level,
                SchoolName: school,
                Course: course || null,
                YearGraduated: /^\d{4}$/.test(year) ? parseInt(year, 10) : null
            });
        };
        addEdu(3, val(root, 'collegeSchool'), val(root, 'collegeCourse'), val(root, 'collegeYear'));
        addEdu(2, val(root, 'hsSchool'), val(root, 'hsCourse'), val(root, 'hsYear'));

        const addresses = [];
        if (permAddress) addresses.push({ FullAddress: permAddress, IsPermanent: true });
        if (tempAddress) addresses.push({ FullAddress: tempAddress, IsPermanent: false });

        return {
            // ---- P1SA_Employees_Temp ----
            // 0 = new; the server resolves the real id by EmployeeCode
            EmployeeCode: val(root, 'employeeCode'),
            FullName: lastName + ', ' + firstName + (middleName ? ' ' + middleName : ''),
            FirstName: firstName,
            MiddleName: middleName,
            LastName: lastName,
            Process: val(root, 'process'),
            AgencyId: parseInt(val(root, 'agencyId'), 10) || 0,
            DepartmentId: parseInt(val(root, 'departmentId'), 10) || null,   // mobile sends text names -> null
            StatusId: 1,                         // Active

            // ---- P1SA_EmployeesInformation ----
            Information: {
                Gender: getGender(root) === 'Female',   // BIT: false = Male, true = Female
                Category: false,                        // not captured on this form (false = Direct Hired)
                DateOfBirth: toIsoDate(val(root, 'dateOfBirth')),
                DateHired: toIsoDate(val(root, 'dateHired')),
                DateResigned: null,
                ContactNumber: val(root, 'mobile'),
                SocialMedia: val(root, 'facebook'),
                PickUpPoint: parseInt(val(root, 'pickUpPoint'), 10) || 0,
                DirectedBy: null,
                JobTitleId: null,
                Remarks: val(root, 'remarks'),
                WIthVech: vehicle && vehicle.value === '1' ? 1 : 0   // property is spelled WIthVech in the model
            },

            // ---- P1SA_EmployeesEducation / P1SA_EmployeesAddress / skills ----
            Education: education,
            Addresses: addresses,
            Skilled: []
        };
    }

    // Jump to the step that contains a given field so the user can actually see it.
    function revealField(el) {
        const panel = el.closest('[data-step-panel]');
        if (panel) {
            const step = parseInt(panel.dataset.stepPanel, 10);
            // Mobile panels 1..6, desktop 1..7 — same numbering for the panel that owns the field.
            if (step !== currentStep) goToStep(step);
        }
        // WHY: wait a tick, the panel only becomes visible after goToStep toggles classes.
        setTimeout(() => {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.focus();
        }, 50);
    }

    // WHY: the markup already carries data-required / required hints; reuse them so there
    // is one source of truth. The server re-validates anyway (never trust the client).
    function validateEmployeeData(root, isDraft) {
        const errors = [];
        root.querySelectorAll('.field-invalid').forEach(e => e.classList.remove('field-invalid'));

        // A draft only needs the key (employee code); a final save needs every required field.
        const required = isDraft
            ? root.querySelectorAll('[name="employeeCode"]')
            : root.querySelectorAll('[data-required="true"], [required]');

        required.forEach(el => {
            if (!(el.value || '').trim()) {
                el.classList.add('field-invalid');
                errors.push(el);
            }
        });

        const dobEl = root.querySelector('[name="dateOfBirth"]');
        const iso = dobEl && toIsoDate(dobEl.value.trim());
        if (iso) {
            const dob = new Date(iso), now = new Date();
            let age = now.getFullYear() - dob.getFullYear();
            const m = now.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
            if (age < 18 && errors.indexOf(dobEl) === -1) {
                dobEl.classList.add('field-invalid');
                errors.push(dobEl);
            }
        }
        return errors;
    }

    function showToast(message, isError) {
        const t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:5rem;right:2rem;z-index:9999;padding:.75rem 1.5rem;' +
            'border-radius:.5rem;font-size:14px;color:#fff;box-shadow:0 8px 20px rgba(0,0,0,.2);' +
            'background:' + (isError ? '#ba1a1a' : '#2c3138');
        t.textContent = message;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3500);
    }

    let isSaving = false;

    async function saveEmployee(isDraft, btn) {
        if (isSaving) return;                    // WHY: stop double-click => duplicate inserts
        // const root = getActiveRoot();

        // const bad = validateEmployeeData(root, isDraft);
        // if (bad.length) {
        //     revealField(bad[0]);
        //     showToast('Please complete the required fields.', true);
        //     return;
        // }

        const payload = collectEmployeeData();
        console.log(payload);

        // const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');

        // isSaving = true;
        // const original = btn ? btn.innerHTML : null;
        // if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; }

        // try {
        //     const res = await fetch(SAVE_URL + '?draft=' + (isDraft ? 'true' : 'false'), {
        //         method: 'POST',
        //         credentials: 'same-origin',
        //         headers: {
        //             'Content-Type': 'application/json',
        //             'RequestVerificationToken': tokenEl ? tokenEl.value : ''
        //         },
        //         body: JSON.stringify(payload)
        //     });

        //     if (!res.ok) throw new Error('HTTP ' + res.status);
        //     const result = await res.json();

        //     showToast(result.message || (result.success ? 'Saved.' : 'Save failed.'), !result.success);
        // } catch (err) {
        //     console.error(err);
        //     showToast('Could not save. Nothing was saved.', true);
        // } finally {
        //     isSaving = false;
        //     if (btn) { btn.disabled = false; btn.innerHTML = original; }
        // }
    }

    // Find buttons by visible text so no markup edits are needed.
    function buttonsByText(scope, text) {
        return Array.prototype.filter.call(
            document.querySelectorAll(scope),
            b => b.textContent.replace(/\s+/g, ' ').trim() === text);
    }

    function initSaveData() {
        // --- Desktop gender toggle: tag buttons, track selection ---
        const deskGender = buttonsByText('.desktop-main button', 'Male')
            .concat(buttonsByText('.desktop-main button', 'Female'));
        deskGender.forEach(btn => {
            const g = btn.textContent.trim();
            btn.dataset.gender = g;
            if (g === 'Female') btn.classList.add('is-selected');   // matches the markup default
            btn.addEventListener('click', () => {
                deskGender.forEach(b => b.classList.remove('is-selected', 'bg-surface-container-lowest', 'text-primary', 'shadow-sm'));
                btn.classList.add('is-selected', 'bg-surface-container-lowest', 'text-primary', 'shadow-sm');
            });
        });

        // --- Desktop "Save as Draft" ---
        const draftBtn = document.getElementById('d-saveDraftBtn');
        if (draftBtn) draftBtn.addEventListener('click', () => saveEmployee(true, draftBtn));

        // --- Desktop final submit: the Proceed button doubles as Submit on step 7 ---
        const proceedBtn = document.getElementById('d-proceedStep2Btn');
        if (proceedBtn) {
            // WHY: capture phase runs BEFORE the inline onclick="goToStep(currentStep + 1)",
            // so currentStep still holds the step the user was on when they clicked.
            // Clicking from step 6 (which moves to 7) must not save; only a click made
            // while already on step 7 is the real "Complete & Submit Record".
            proceedBtn.addEventListener('click', () => {
                if (currentStep === TOTAL_STEPS) saveEmployee(false, proceedBtn);
            }, true);
        }

        // --- Mobile buttons (matched by text) ---
        buttonsByText('#mobileMain button, .mobile-bottom-nav button', 'Save as Draft')
            .forEach(b => b.addEventListener('click', () => saveEmployee(true, b)));
        buttonsByText('#mobileMain button', 'Complete & Submit Record')
            .forEach(b => b.addEventListener('click', () => saveEmployee(false, b)));
    }

    /* ============================================================
       PAGE WIRING
       ============================================================ */
    document.addEventListener('DOMContentLoaded', () => {
        // Step tabs (both navs)
        document.querySelectorAll('#mobileStepNav .step-tab, #desktopStepNav .step-tab').forEach(tab => {
            tab.addEventListener('click', () => goToStep(parseInt(tab.dataset.step, 10)));
        });

        // ---- Mobile gender toggle ----
        window.selectGenderMobile = function (type) {
            const maleBtn = document.getElementById('m-gender-male');
            const femaleBtn = document.getElementById('m-gender-female');
            if (!maleBtn || !femaleBtn) return;
            const on = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-primary text-on-primary shadow-sm font-label-lg text-label-lg font-semibold transition-all';
            const off = 'flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg font-semibold transition-all';
            maleBtn.className = type === 'male' ? on : off;
            femaleBtn.className = type === 'male' ? off : on;
        };

        // ---- Desktop clear form ----
        // WHY: the old handler referenced ids that don't exist (d-sssNumber) and only
        // cleared names. Clear every text/date input in the desktop form instead.
        const clearFieldsBtn = document.getElementById('d-clearFieldsBtn');
        if (clearFieldsBtn) {
            clearFieldsBtn.addEventListener('click', () => {
                if (confirm('Are you sure you want to clear all entered fields?')) {
                    document.querySelectorAll('.desktop-main input[type="text"], .desktop-main input[type="date"], .desktop-main input[type="tel"], .desktop-main input[type="email"]')
                        .forEach(el => { el.value = ''; el.classList.remove('field-invalid'); });
                    document.querySelectorAll('.desktop-main select').forEach(s => s.selectedIndex = 0);
                }
            });
        }

        // ---- Dropzone drag feedback ----
        [document.getElementById('dropzoneContainerDesktop'), document.getElementById('dropzoneContainerMobile')].forEach(dz => {
            if (!dz) return;
            ['dragenter', 'dragover'].forEach(evt =>
                dz.addEventListener(evt, e => { e.preventDefault(); dz.classList.add('dropzone-active'); }));
            ['dragleave', 'drop'].forEach(evt =>
                dz.addEventListener(evt, e => { e.preventDefault(); dz.classList.remove('dropzone-active'); }));
        });

        // ---- Responsive display (desktop vs mobile layout) ----
        function updateResponsiveDisplay() {
            const desktopMain = document.querySelector('.desktop-main');
            const footer = document.getElementById('desktopFooter');
            const wide = window.innerWidth >= 1024;
            if (desktopMain) desktopMain.style.display = wide ? 'block' : 'none';
            if (footer) footer.style.display = wide ? 'block' : 'none';
        }
        window.addEventListener('resize', updateResponsiveDisplay);
        updateResponsiveDisplay();

        initSaveData();
        goToStep(1);
    });
</script>
