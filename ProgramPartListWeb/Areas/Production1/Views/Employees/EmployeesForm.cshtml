<!-- ============================================================
     SCRIPT — STEP NAVIGATION + SAVE DATA
     Replace your entire existing <script>...</script> block with this.
     Also add  @Html.AntiForgeryToken()  once anywhere in the view.
     Optional CSS:  .field-invalid { outline: 2px solid #ba1a1a; }
     ============================================================ -->
<script>
    /* ------------------------------------------------------------
       STEP NAVIGATION
       Single source of truth: currentStep (1..7).
       ------------------------------------------------------------ */
    let currentStep = 1;
    const TOTAL_STEPS = 7;

    const SAVE_URL = '@Url.Action("SaveEmployee", "Employees", new { area = "Production1" })';

 

    const DESKTOP_NEXT_LABELS = {
        1: 'Save & Proceed to Employment',
        2: 'Save & Proceed to Addresses',
        3: 'Save & Proceed to Contacts',
        4: 'Save & Proceed to Education',
        5: 'Save & Proceed to Skills',
        6: 'Save & Proceed to Work History',
        7: 'Complete & Submit Record'
    };
    function syncStepper(step) {
        document.querySelectorAll('.stepper .step').forEach(el => {
            const active = parseInt(el.dataset.step, 10) === step;
            el.classList.toggle('step-active', active);
            el.setAttribute('aria-current', active ? 'step' : 'false');

            const num = el.querySelector('.step-num');
            if (num) {
                num.classList.toggle('step-num-active', active);
                num.classList.toggle('step-num-idle', !active);
            }
        });
    }

    function goToStep(step) {
        const newStep = Math.max(1, Math.min(TOTAL_STEPS, step));
        currentStep = newStep;

        syncStepper(newStep);

        // Show only the panel that matches this step.
        document.querySelectorAll('[data-step-panel]').forEach(panel => {
            panel.hidden = parseInt(panel.dataset.stepPanel, 10) !== newStep;
        });

        const nextLabel = document.getElementById('d-nextLabel');
        if (nextLabel) nextLabel.textContent = DESKTOP_NEXT_LABELS[newStep] || 'Save & Proceed';

        const pct = Math.round((newStep / TOTAL_STEPS) * 100);
        const overview = document.getElementById('overviewProgress');
        const bar = document.getElementById('overviewProgressBar');
        if (overview) overview.textContent = pct + '% (Step ' + newStep + ' of ' + TOTAL_STEPS + ')';
        if (bar) bar.style.width = pct + '%';

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ============================================================
       SAVE DATA
       ============================================================ */

    // WHY: the page renders BOTH a mobile and a desktop form with duplicate field
    // names (lastName, employeeCode, religion...). Reading document-wide would grab
    // the wrong copy, so we always read from whichever layout is currently visible.
    function getActiveRoot() {
        const desktop = document.querySelector('.desktop-main');
        return (desktop && desktop.style.display !== 'none')
            ? desktop
            : document.getElementById('mobileMain');
    }

    function val(root, name) {
        const el = root.querySelector('[name="' + name + '"]');
        return el ? (el.value || '').trim() : '';
    }

    // WHY: desktop DOB is <input type="date"> (yyyy-MM-dd) but mobile is free text
    // DD/MM/YYYY. The server only receives ISO so day/month can never be swapped.
    function toIsoDate(s) {
        if (!s) return null;
        if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
        const m = s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        return m ? m[3] + '-' + m[2] + '-' + m[1] : null;
    }

    function getGender(root) {
        if (root.id === 'mobileMain') {
            // Mobile: the active button carries bg-primary.
            const mMale = document.getElementById('m-gender-male');
            return mMale && mMale.classList.contains('bg-primary') ? 'Male' : 'Female';
        }
        // Desktop: buttons get data-gender + .is-selected in initSaveData().
        const sel = root.querySelector('[data-gender].is-selected');
        return sel ? sel.dataset.gender : '';
    }

    // Builds the payload in the exact shape of the C# EmployeeProfile model
    // (Information, Education[], Addresses[]) so the controller can bind it directly.
    // Property names are camelCase; MVC's model binder matches them case-insensitively.
    function collectEmployeeData() {
        const root = getActiveRoot();
        const vehicle = root.querySelector('input[name="vehicleMode"]:checked');

        // WHY: the desktop inputs only *display* uppercase via CSS; the typed value is
        // still whatever the encoder entered. HR records are uppercase, so normalise here.
        const lastName = val(root, 'lastName').toUpperCase();
        const firstName = val(root, 'givenName').toUpperCase();
        const middleName = val(root, 'middleName').toUpperCase();

        // Mobile uses four address inputs; desktop uses one free-text box.
        // FullAddress is a single column, so join the mobile parts into one string.
        let permAddress = val(root, 'permAddress');
        if (!permAddress) {
            permAddress = ['streetAddress', 'city', 'province', 'postalCode']
                .map(n => val(root, n)).filter(Boolean).join(', ');
        }
        const tempAddress = val(root, 'tempAddress');

        // SchoolLevel codes must match the SchoolLevel enum: 1 Elem, 2 HS, 3 College, 4 Voc.
        // WHY: rows with a blank school are skipped so we never insert empty education rows.
        const education = [];
        const addEdu = (level, school, course, year) => {
            if (!school) return;
            education.push({
                SchoolLevel: level,
                SchoolName: school,
                Course: course || null,
                YearGraduated: /^\d{4}$/.test(year) ? parseInt(year, 10) : null
            });
        };
        addEdu(3, val(root, 'collegeSchool'), val(root, 'collegeCourse'), val(root, 'collegeYear'));
        addEdu(2, val(root, 'hsSchool'), val(root, 'hsCourse'), val(root, 'hsYear'));

        const addresses = [];
        if (permAddress) addresses.push({ FullAddress: permAddress, IsPermanent: true });
        if (tempAddress) addresses.push({ FullAddress: tempAddress, IsPermanent: false });

        return {
            // ---- P1SA_Employees_Temp ----
            // 0 = new; the server resolves the real id by EmployeeCode
            EmployeeCode: val(root, 'employeeCode'),
            FullName: lastName + ', ' + firstName + (middleName ? ' ' + middleName : ''),
            FirstName: firstName,
            MiddleName: middleName,
            LastName: lastName,
            Process: val(root, 'process'),
            AgencyId: parseInt(val(root, 'agencyId'), 10) || 0,
            DepartmentId: parseInt(val(root, 'departmentId'), 10) || null,   // mobile sends text names -> null
            StatusId: 1,                         // Active

            // ---- P1SA_EmployeesInformation ----
            Information: {
                Gender: getGender(root) === 'Female',   // BIT: false = Male, true = Female
                Category: false,                        // not captured on this form (false = Direct Hired)
                DateOfBirth: toIsoDate(val(root, 'dateOfBirth')),
                DateHired: toIsoDate(val(root, 'dateHired')),
                DateResigned: null,
                ContactNumber: val(root, 'mobile'),
                SocialMedia: val(root, 'facebook'),
                PickUpPoint: parseInt(val(root, 'pickUpPoint'), 10) || 0,
                DirectedBy: null,
                JobTitleId: null,
                Remarks: val(root, 'remarks'),
                WIthVech: vehicle && vehicle.value === '1' ? 1 : 0   // property is spelled WIthVech in the model
            },

            // ---- P1SA_EmployeesEducation / P1SA_EmployeesAddress / skills ----
            Education: education,
            Addresses: addresses,
            Skilled: []
        };
    }

    // Jump to the step that contains a given field so the user can actually see it.
    function revealField(el) {
        const panel = el.closest('[data-step-panel]');
        if (panel) {
            const step = parseInt(panel.dataset.stepPanel, 10);
            // Mobile panels 1..6, desktop 1..7 — same numbering for the panel that owns the field.
            if (step !== currentStep) goToStep(step);
        }
        // WHY: wait a tick, the panel only becomes visible after goToStep toggles classes.
        setTimeout(() => {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.focus();
        }, 50);
    }

    // WHY: the markup already carries data-required / required hints; reuse them so there
    // is one source of truth. The server re-validates anyway (never trust the client).
    function validateEmployeeData(root, isDraft) {
        const errors = [];
        root.querySelectorAll('.field-invalid').forEach(e => e.classList.remove('field-invalid'));

        // A draft only needs the key (employee code); a final save needs every required field.
        const required = isDraft
            ? root.querySelectorAll('[name="employeeCode"]')
            : root.querySelectorAll('[data-required="true"], [required]');

        required.forEach(el => {
            if (!(el.value || '').trim()) {
                el.classList.add('field-invalid');
                errors.push(el);
            }
        });

        const dobEl = root.querySelector('[name="dateOfBirth"]');
        const iso = dobEl && toIsoDate(dobEl.value.trim());
        if (iso) {
            const dob = new Date(iso), now = new Date();
            let age = now.getFullYear() - dob.getFullYear();
            const m = now.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
            if (age < 18 && errors.indexOf(dobEl) === -1) {
                dobEl.classList.add('field-invalid');
                errors.push(dobEl);
            }
        }
        return errors;
    }

    function showToast(message, isError) {
        const t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:5rem;right:2rem;z-index:9999;padding:.75rem 1.5rem;' +
            'border-radius:.5rem;font-size:14px;color:#fff;box-shadow:0 8px 20px rgba(0,0,0,.2);' +
            'background:' + (isError ? '#ba1a1a' : '#2c3138');
        t.textContent = message;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3500);
    }

    let isSaving = false;

    async function saveEmployee(isDraft, btn) {
        if (isSaving) return;                    // WHY: stop double-click => duplicate inserts
        // const root = getActiveRoot();

        // const bad = validateEmployeeData(root, isDraft);
        // if (bad.length) {
        //     revealField(bad[0]);
        //     showToast('Please complete the required fields.', true);
        //     return;
        // }

        const payload = collectEmployeeData();
