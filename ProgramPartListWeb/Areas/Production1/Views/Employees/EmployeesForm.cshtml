@{
    ViewBag.Title = "EmployeesForm";
    Layout = "~/Areas/Production1/Views/Shared/_EmployeesLayout.cshtml";
}

<!-- BEGIN: MainContentWrapper -->
<main class="main-layout" data-purpose="main-layout">
    <!-- BEGIN: StepperNavigation -->
    <nav aria-label="Onboarding Progress Stepper" class="stepper">
        <div class="stepper-steps">
            <div class="step step-active" data-step="1" role="button" tabindex="0" aria-current="step">
                <span class="step-num step-num-active">1</span>
                <span>Personal Details</span>
            </div>
            <div class="step-line"></div>
            <div class="step" data-step="2" role="button" tabindex="0">
                <span class="step-num step-num-idle">2</span>
                <span>Employment Details</span>
            </div>
            <div class="step-line"></div>
            <div class="step" data-step="3" role="button" tabindex="0">
                <span class="step-num step-num-idle">3</span>
                <span>Contact &amp; Addresses</span>
            </div>
          
            <div class="step-line"></div>
            <div class="step" data-step="4" role="button" tabindex="0">
                <span class="step-num step-num-idle">4</span>
                <span>Education</span>
            </div>
            <div class="step-line"></div>
            <div class="step" data-step="5" role="button" tabindex="0">
                <span class="step-num step-num-idle">5</span>
                <span>Skills &amp; Certs</span>
            </div>
            <div class="step-line"></div>
            <div class="step" data-step="6" role="button" tabindex="0">
                <span class="step-num step-num-idle">6</span>
                <span>Work History</span>
            </div>
        </div>
        <!-- Mode tag -->
        <div class="mode-tag">
            <span class="material-symbols-outlined icon-16">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="7" r="5" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 22H5.266a2 2 0 0 1-1.985-2.248l.39-3.124A3 3 0 0 1 6.649 14H7m12 0v4m-2-2h4" />
                    </g>
                </svg>
            </span>
            <span>New Hire Mode</span>
        </div>
    </nav>
    <!-- END: StepperNavigation -->
    <!-- BEGIN: TwoColumnWorkspace -->
    <div class="workspace">

        <!-- BEGIN: LeftSidebar -->
        <aside class="sidebar" data-purpose="biometrics-and-summary-sidebar">
            <!-- Badge Photo Upload Card -->
            <section class="card" data-purpose="photo-uploader">
                <div class="card-head photo-head">
                    <h2 class="card-title">
                        <span>Employee Biometrics</span>
                    </h2>
                    <span class="card-tag">ID PHOTO</span>
                </div>
                <!-- Dropzone -->
                <div class="dropzone">
                    <div class="dropzone-icon">
                        <span class="material-symbols-outlined icon-30">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 512 512">
                                <path d="M0 0h512v512H0z" fill="none" />
                                <path fill="currentColor" d="M41 122.496v14h62v-14zm154.73 0l-32 32H137v46h30.682C192.4 159.898 237.08 132.738 288 132.738s95.6 27.16 120.318 67.758H487v-46h-74.73l-32-32c-92.27-9-92.27-9-184.54 0M288 150.738c-67.903 0-122.758 54.855-122.758 122.758S220.097 396.254 288 396.254s122.758-54.855 122.758-122.758S355.903 150.738 288 150.738m-263 3.758v46h94v-46zm263 14.713c57.49 0 104.287 46.796 104.287 104.286S345.49 377.783 288 377.783s-104.287-46.797-104.287-104.287S230.51 169.209 288 169.209m-21.787 22.042c-12.173.42-25.717 6.526-36.78 16.578c-20.025 18.19-26.342 43.853-14.11 57.318s38.38 9.634 58.406-8.558c20.023-18.192 26.34-43.855 14.108-57.32c-5-5.504-12.62-8.33-21.625-8.018zM25 218.496v142h94v-142zm112 0v142h40.412c-18.888-23.96-30.17-54.183-30.17-87c0-19.507 3.988-38.096 11.188-55zm280.57 0c7.2 16.904 11.188 35.493 11.188 55c0 32.817-11.282 63.04-30.17 87H487v-142zM25 378.496v14h94v-14zm112 0v14h75.89a141.5 141.5 0 0 1-18.536-14zm244.646 0a141.6 141.6 0 0 1-18.535 14H487v-14z" />
                            </svg>
                        </span>
                    </div>
                    <p class="dropzone-title">Drag 2x2 badge photo here</p>
                    <p class="dropzone-hint">PNG, JPG up to 5MB<br />(White background mandatory)</p>
                </div>
                <!-- Upload Controls -->
                <div class="upload-controls">
                    <button class="btn-upload" type="button">
                        <span class="material-symbols-outlined icon-16">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <g fill="none">
                                    <path fill="currentColor" d="M19.99 8.46c.24.53.36.8.36 1.01a1 1 0 0 1-.6.91c-.19.1-.48.1-1.06.1H6.42c-.62 0-.92 0-1.17.15s-.37.43-.64.98L1.7 17.77l.38-11.31c.02-.82.04-1.23.29-1.5s.65-.32 1.46-.42l1.33-.16h2.33c.36 0 .54 0 .71.06s.3.18.58.41l2.43 2.06c.27.22.4.33.55.4c.16.05.33.06.67.07l6.32.24c.26.01.38.02.5.05a1 1 0 0 1 .52.35c.07.1.12.21.23.44" opacity=".2" />
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.29 19.59h-3.6c-2.83 0-4.25 0-5.13-.88s-.87-2.3-.87-5.12V6.9a2.4 2.4 0 0 1 2.4-2.4h2.06c.9 0 1.35 0 1.77.12a3 3 0 0 1 .46.18c.39.2.72.5 1.38 1.1s.99.91 1.38 1.1a3 3 0 0 0 .46.19c.42.12.87.12 1.77.12h4.58a3 3 0 0 1 2.94 3.07" />
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.92 17.06c-.49 1.23-.73 1.84-1.24 2.18c-.5.35-1.16.35-2.48.35H7.38c-2.59 0-3.88 0-4.48-.85c-.6-.86-.16-2.07.72-4.51l.42-1.17c.47-1.28.7-1.92 1.21-2.28c.52-.36 1.2-.36 2.56-.36h9.86c2.67 0 4 0 4.6.87c.6.88.1 2.12-.89 4.6z" />
                                </g>
                            </svg>
                        </span>
                        <span>Browse PC</span>
                    </button>
                    <button class="btn-upload" type="button">
                        <span class="material-symbols-outlined icon-16">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="currentColor" fill-rule="evenodd" d="M5.5 6.25A2.25 2.25 0 0 0 3.25 8.5v7a2.25 2.25 0 0 0 2.25 2.25h8a2.25 2.25 0 0 0 2.25-2.25v-.787l3.191 1.596a1.25 1.25 0 0 0 1.809-1.118V8.809a1.25 1.25 0 0 0-1.809-1.118L15.75 9.286V8.5a2.25 2.25 0 0 0-2.25-2.25zm10.25 4.714v2.072l3.5 1.75V9.213zM14.25 8.5a.75.75 0 0 0-.75-.75h-8a.75.75 0 0 0-.75.75v7c0 .414.336.75.75.75h8a.75.75 0 0 0 .75-.75z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        <span>Webcam</span>
                    </button>
                </div>
            </section>

            <!-- Record Overview Card -->
            <section class="card overview-card" data-purpose="record-overview">
                <div class="card-head">
                    <h2 class="overview-title">Record Overview</h2>
                    <span class="badge-drafting">Drafting</span>
                </div>
                <div class="overview-rows">
                    <div class="overview-row">
                        <span class="overview-label">Badge Generation:</span>
                        <span class="overview-value">Pending Personal Info</span>
                    </div>
                    <div class="overview-row">
                        <span class="overview-label">Assigned Facility:</span>
                        <span class="overview-value val-warn">Plant Unassigned</span>
                    </div>
                    <div class="overview-row">
                        <span class="overview-label">Department:</span>
                        <span class="overview-value val-muted">Not specified</span>
                    </div>
                    <div class="overview-row">
                        <span class="overview-label">Encoding Progress:</span>
                        <span class="val-brand">14% (Step 1 of 7)</span>
                    </div>
                </div>
                <!-- Progress Bar -->
                <div class="progress-track">
                    <div class="progress-fill"></div>
                </div>
            </section>

            <!-- Statutory Compliance Note -->
            <div class="compliance-note">
                <span class="material-symbols-outlined icon-18 compliance-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5zm7 10c0 4.52-2.98 8.69-7 9.93c-4.02-1.24-7-5.41-7-9.93V6.3l7-3.11l7 3.11zm-11.59.59L6 13l4 4l8-8l-1.41-1.42L10 14.17z" />
                    </svg>
                </span>
                <p class="compliance-text">
                    Fields marked with an asterisk (<span class="req-star">*</span>) are strictly required for Subic plant badge sync and Philippine statutory compliance.
                </p>
            </div>
        </aside>
        <!-- END: LeftSidebar -->
        <!-- BEGIN: RightMainForm -->
        <section class="form-column" data-purpose="primary-form-section">
            <!-- STEP 1: Personal Details -->
            <div class="step-panel" data-step-panel="1">
                <!-- CARD 1: Legal Identification -->
                <div class="form-card">
                    <div class="form-card-head">
                        <div class="form-card-title-row">
                            <div class="form-card-title-group">
                                <span class="section-letter">A</span>
                                <h3 class="form-card-title">Legal Identification &amp; Core Name</h3>
                            </div>
                            <span class="form-card-meta">ISO 9001 / HRIS Document Standard</span>
                        </div>
                        <p class="form-card-desc">Ensure all spellings precisely match government-issued identification cards (PhilSys, Passport, or PSA Birth Certificate).</p>
                    </div>
                    <form class="form-stack">

                        <!-- Employee Code -->
                        <div class="field">
                            <div class="label-row">
                                <label class="field-label label-flex" for="employeeCode">
                                    <span>Employee Code</span>
                                    <span class="req">*</span>
                                </label>
                                <button class="link-btn" type="button">
                                    <span class="material-symbols-outlined icon-14">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32">
                                            <path d="M0 0h32v32H0z" fill="none" />
                                            <path fill="currentColor" d="M12 10H6.78A11 11 0 0 1 27 16h2A13 13 0 0 0 6 7.68V4H4v8h8Zm8 12h5.22A11 11 0 0 1 5 16H3a13 13 0 0 0 23 8.32V28h2v-8h-8Z" />
                                        </svg>
                                    </span>
                                    <span>Auto-generate</span>
                                </button>
                            </div>
                            <div class="input-wrap">
                                <div class="input-icon">
                                    <span class="material-symbols-outlined icon-18">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                            <path d="M0 0h24v24H0z" fill="none" />
                                            <g fill="none">
                                                <path fill="currentColor" fill-rule="evenodd" d="M16.3 17.39c2.82 0 4.24 0 5.11-.88s.88-2.3.88-5.12V8.98c0-2.83 0-4.25-.88-5.12c-.87-.88-2.29-.88-5.12-.88H7.71c-2.83 0-4.25 0-5.12.88c-.88.87-.88 2.29-.88 5.12v2.4c0 2.84 0 4.25.88 5.13c.87.88 2.29.88 5.12.88h.2A4.2 4.2 0 0 1 12 12.38c.38 0 .97.11.97.11s1.47.59 2.01 1.14c.3.3.76 1.04.76 1.04l.35 2.72z" clip-rule="evenodd" opacity=".2" />
                                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 6.27h6M6.72 9.32h10.56M5.2 17.39c-.46 0-.69 0-.88-.03a3 3 0 0 1-2.59-2.58c-.02-.2-.02-.43-.02-.89V8.98c0-2.83 0-4.25.88-5.12c.87-.88 2.29-.88 5.12-.88h8.58c2.83 0 4.25 0 5.12.88c.88.87.88 2.29.88 5.12V14l-.01.7a3 3 0 0 1-2.68 2.67c-.15.02-.34.02-.7.02" />
                                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m10.44 17.24l.23.28c.36.44.54.66.77.66c.24 0 .42-.22.78-.67l1.34-1.65" />
                                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.17 16.85A4.16 4.16 0 0 0 12 12.68a4.17 4.17 0 1 0 4.17 4.17" />
                                            </g>
                                        </svg>
                                    </span>
                                </div>
                                <input class="input input-muted has-icon" id="d-empCode"
                                       placeholder="e.g. SDP-2025-XXXX"
                                       type="text"
                                       value="SDP-2025-0842"
                                       data-required="true" data-validate="code"
                                       data-invalid-msg="Use letters, numbers and dashes only."
                                       name="employeeCode" />
                            </div>
                            <p class="field-hint">Designated for Subic Plant 2 Production Line badge synchronization</p>
                        </div>

                        <!-- Name Fields -->
                        <div class="grid-names">
                            <!-- Last Name -->
                            <div>
                                <label class="field-label" for="lastName">
                                    Last Name (Surname) <span class="req">*</span>
                                </label>
                                <input class="input"
                                       id="lastName"
                                       name="lastName" placeholder="e.g. DELA CRUZ"
                                       type="text"
                                       autocomplete="family-name"
                                       maxlength="50"
                                       data-required="true" />
                                <span class="field-hint">Include suffix in separate field if applicable</span>
                            </div>
                            <!-- First Name -->
                            <div>
                                <label class="field-label" for="firstName">
                                    Given Name (First Name) <span class="req">*</span>
                                </label>
                                <input class="input"
                                       id="d-firstName"
                                       name="givenName"
                                       placeholder="e.g. JUAN CARLOS"
                                       type="text"
                                       data-required="true"
                                       autocomplete="given-name"
                                       maxlength="50" />

                                <span class="field-hint">Full first given names</span>
                            </div>
                            <!-- Middle Name -->
                            <div>
                                <div class="label-row">
                                    <label class="field-label" for="middleName">Middle Name</label>
                                    <span class="field-meta">Optional</span>
                                </div>
                                <input class="input"
                                       id="d-middleName"
                                       name="middleName" placeholder="Leave empty if none" type="text"
                                       autocomplete="additional-name"
                                       maxlength="50" />

                                <span class="field-hint">Leave blank if no middle legal name</span>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- CARD 2: Demographics & Vital Details -->
                <div class="form-card" style="margin-top: 1em;">
                    <div class="form-card-head">
                        <div class="form-card-title-row">
                            <div class="form-card-title-group">
                                <span class="section-letter">B</span>
                                <h3 class="form-card-title">Demographics &amp; Vital Details</h3>
                            </div>
                            <span class="form-card-meta">Confidentiality Tier A</span>
                        </div>
                        <p class="form-card-desc">Required for automated medical insurance calculation and employee safety registries.</p>
                    </div>
                    <form class="form-stack">

                        <!-- Row: Birth Date & Biological Sex -->
                        <div class="grid-dob">
                            <!-- Date of Birth -->
                            <div>
                                <div class="label-row">
                                    <label class="field-label" for="dob">
                                        Date of Birth <span class="req">*</span>
                                    </label>
                                    <span class="age-pill">26 years old</span>
                                </div>
                                <div class="input-wrap">
                                    <div class="input-icon">
                                        <span class="material-symbols-outlined icon-18">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 56 56">
                                                <path d="M0 0h56v56H0z" fill="none" />
                                                <path fill="currentColor" d="M11.992 49.97h32.016c4.899 0 7.36-2.438 7.36-7.266V14.086c0-4.828-2.461-7.265-7.36-7.265H11.992c-4.875 0-7.36 2.414-7.36 7.265v28.618c0 4.851 2.485 7.265 7.36 7.265m-.328-3.774c-2.086 0-3.258-1.102-3.258-3.281V20.813c0-2.156 1.172-3.281 3.258-3.281h32.649c2.085 0 3.28 1.125 3.28 3.281v22.102c0 2.18-1.195 3.28-3.28 3.28zm11.742-20.25h1.383c.82 0 1.102-.235 1.102-1.055v-1.383c0-.82-.281-1.078-1.102-1.078h-1.383c-.82 0-1.078.258-1.078 1.078v1.383c0 .82.258 1.055 1.078 1.055m7.805 0h1.36c.843 0 1.101-.235 1.101-1.055v-1.383c0-.82-.258-1.078-1.102-1.078h-1.359c-.82 0-1.101.258-1.101 1.078v1.383c0 .82.28 1.055 1.101 1.055m7.781 0h1.383c.82 0 1.102-.235 1.102-1.055v-1.383c0-.82-.282-1.078-1.102-1.078h-1.383c-.82 0-1.101.258-1.101 1.078v1.383c0 .82.281 1.055 1.101 1.055M15.625 33.61h1.383c.82 0 1.102-.234 1.102-1.055v-1.383c0-.82-.282-1.054-1.102-1.054h-1.383c-.82 0-1.101.234-1.101 1.054v1.383c0 .82.28 1.055 1.101 1.055m7.781 0h1.383c.82 0 1.102-.234 1.102-1.055v-1.383c0-.82-.281-1.054-1.102-1.054h-1.383c-.82 0-1.078.234-1.078 1.054v1.383c0 .82.258 1.055 1.078 1.055m8.485 1.896a3.642 3.642 0 1 0 0-7.284a3.642 3.642 0 0 0 0 7.284m7.101-1.896h1.383c.82 0 1.102-.234 1.102-1.055v-1.383c0-.82-.282-1.054-1.102-1.054h-1.383c-.82 0-1.101.234-1.101 1.054v1.383c0 .82.281 1.055 1.101 1.055m-23.367 7.687h1.383c.82 0 1.102-.257 1.102-1.078v-1.383c0-.82-.282-1.054-1.102-1.054h-1.383c-.82 0-1.101.234-1.101 1.054v1.383c0 .82.28 1.078 1.101 1.078m7.781 0h1.383c.82 0 1.102-.257 1.102-1.078v-1.383c0-.82-.281-1.054-1.102-1.054h-1.383c-.82 0-1.078.234-1.078 1.054v1.383c0 .82.258 1.078 1.078 1.078m7.805 0h1.36c.843 0 1.101-.257 1.101-1.078v-1.383c0-.82-.258-1.054-1.102-1.054h-1.359c-.82 0-1.101.234-1.101 1.054v1.383c0 .82.28 1.078 1.101 1.078" />
                                            </svg>
                                        </span>
                                    </div>
                                    <input class="input has-icon"
                                           id="d-dob" type="date"
                                           name="dateOfBirth"
                                           value="1998-05-14"
                                           autocomplete="bday"
                                           data-required="true"
                                           data-validate="dob"
                                           data-invalid-msg="Employee must be 18 years old or above." />

                                </div>
                                <span class="field-hint">As declared in Birth Certificate</span>
                            </div>

                            <!-- Biological Sex (Segmented Switch) -->
                            <div>
                                <label class="field-label">
                                    Biological Sex <span class="req">*</span>
                                </label>
                                <div class="segmented">
                                    <button class="segment" type="button">
                                        <span class="material-symbols-outlined icon-16">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                                <path d="M0 0h24v24H0z" fill="none" />
                                                <g fill="none">
                                                    <circle cx="9.27" cy="14.73" r="6.67" fill="currentColor" opacity=".2" />
                                                    <circle cx="9.27" cy="14.73" r="6.67" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
                                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.02 9.98l6.36-6.35m.95 6.15v-3.1c0-1.9 0-2.84-.58-3.42s-1.53-.59-3.41-.59h-3.12" />
                                                </g>
                                            </svg>
                                        </span>
                                        <span>Male</span>
                                    </button>
                                    <button class="segment segment-active" type="button">
                                        <span class="material-symbols-outlined icon-16">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                                <path d="M0 0h24v24H0z" fill="none" />
                                                <g fill="none">
                                                    <circle cx="9.27" cy="14.73" r="6.67" fill="currentColor" opacity=".2" />
                                                    <circle cx="9.27" cy="14.73" r="6.67" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
                                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.02 9.98l6.36-6.35m.95 6.15v-3.1c0-1.9 0-2.84-.58-3.42s-1.53-.59-3.41-.59h-3.12" />
                                                </g>
                                            </svg>
                                        </span>
                                        <span>Female</span>
                                    </button>
                                </div>
                                <span class="field-hint">For statutory SSS, PhilHealth, and DOLE standards</span>
                            </div>
                        </div>

                        <!-- Row: Civil Status, Citizenship, Blood Type, Religion -->
                        <div class="grid-vitals">

                            <!-- Civil Status -->
                            <div>
                                <label class="field-label" for="civilStatus">
                                    Civil Status <span class="req">*</span>
                                </label>
                                <select class="input select" id="d-civilStatus" name="civilStatus" data-required="true">
                                    <option selected="" value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Widowed">Widowed</option>
                                    <option value="Separated">Separated</option>
