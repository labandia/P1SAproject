                        </svg>

                    </div>
                    <div class="card-content">
                        <div class="card-title">Work Experience Subform</div>
                        <div class="card-subtitle">Open the linked work experience table/form.</div>
                    </div>
                    <div class="card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </div>

        </main>

        <!-- FOOTER & EXIT -->
        <footer>
            <div class="footer-info">
                <i class="fa-solid fa-server"></i>
                <span>Employee Information System | Sanyo Denki Phils, Inc.</span>
            </div>

            <button class="exit-btn" onclick="exitSystem()">
                <i class="fa-solid fa-power-off"></i>
                Exit System
            </button>
        </footer>

    </div>

    <!-- JAVASCRIPT FOR INTERACTIVITY -->
    <script>
        // Update time dynamically
        function updateTime() {
            const now = new Date();
            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            const dateString = now.toLocaleDateString('en-US', options).toUpperCase();
            const timeString = now.toLocaleTimeString('en-US', { hour12: true, hour: '2-digit', minute:'2-digit' });

            document.querySelector('.system-info').innerHTML =
                `<div>Quality • People • A Better Tomorrow</div>
                 <div style="margin-top: 5px; color: #00E5FF;">${dateString} | ${timeString}</div>`;
        }

        // Initial call and set interval to update every minute
        updateTime();
        setInterval(updateTime, 60000);

        // Handle Card Clicks (Simulating opening forms)
        function handleCardClick(formName) {
            // In a real application, this would route to the specific form URL
            console.log(`Navigating to: ${formName}`);

            // Simple visual feedback
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
                background: rgba(0, 229, 255, 0.9); color: #0B1120; padding: 10px 20px;
                border-radius: 8px; font-weight: 600; font-size: 14px; z-index: 1000;
                box-shadow: 0 5px 15px rgba(0,229,255,0.4); transition: opacity 0.3s ease;
            `;
            toast.innerText = `Opening ${formName}...`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        // Handle Exit Button
        function exitSystem() {
            if(confirm("Are you sure you want to exit the Employee Information System?")) {
                // In a real app running in MS Access or a web portal, this would close the window
                window.close();
                // Fallback if window.close() is blocked by browser
                document.body.innerHTML = `
                    <div style="display:flex; justify-content:center; align-items:center; height:100vh; color:#94A3B8; font-family:'Inter', sans-serif;">
                        <h2>System Closed. You may now close this tab.</h2>
                    </div>
                `;
            }
        }
    </script>
</body>
</html>
