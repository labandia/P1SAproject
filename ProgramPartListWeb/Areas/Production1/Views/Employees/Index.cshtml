                            </g>
                        </svg>

                    </div>
                    <div class="card-content">
                        <div class="card-title">Employee List (All)</div>
                        <div class="card-subtitle">Open employee datasheet or continuous form.</div>
                    </div>
                    <div class="card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </div>
            </a>
                <!-- Card 5 -->
                <div class="card" onclick="handleCardClick('Work Experience Subform')">
                    <div class="card-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 32 32">
                            <path d="M0 0h32v32H0z" fill="none" />
