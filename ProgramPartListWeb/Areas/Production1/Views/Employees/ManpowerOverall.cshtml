
@{
    ViewBag.Title = "ManpowerOverall";
    Layout = "~/Areas/Production1/Views/Shared/_EmployListLayout.cshtml";
}

<div class="report-container">

    <!-- HEADER -->
    <header class="report-header">
        <div class="logo-block">
            <h1>SANYO DENKI<sup>&reg;</sup></h1>
            <p>SANYO DENKI PHILIPPINES INC.</p>
        </div>
    </header>

    <!-- TITLE -->
    <h2 class="report-title">EMPLOYEE SUMMARY REPORT</h2>

    <!-- COMPANY SECTION -->
    <section class="section-block">
        <h3 class="section-heading">COMPANY</h3>
        <table class="data-table" id="companyTable">
            <thead>
                <tr>
                    <th>COMPANY</th>
                    <th>BOYS</th>
                    <th>GIRLS</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody id="companyTableBody">
                <!-- Rows injected by JS -->
            </tbody>
        </table>
    </section>

    <!-- ADDRESS LOCATION SECTION -->
    <section class="section-block">
        <h3 class="section-heading">ADDRESS LOCATION</h3>
        <table class="data-table" id="addressTable">
            <thead>
                <tr>
                    <th>ADDRESS LOCATION</th>
                    <th>BOYS</th>
                    <th>GIRLS</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody id="addressTableBody">
                <!-- Rows injected by JS -->
            </tbody>
        </table>
    </section>

    <!-- FOOTER -->
    <footer class="report-footer">
        <div class="footer-item">
            <span>Prepared by: <strong id="preparedBy">—</strong></span>
        </div>
        <div class="footer-divider">|</div>
        <div class="footer-item">
            <span>Department: <strong id="department">—</strong></span>
        </div>
        <div class="footer-divider">|</div>
        <div class="footer-item">
            <span>Date Printed: <strong id="datePrinted">—</strong></span>
        </div>
    </footer>

</div>



<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod,
        getDepartmentName,
        formatDate
    } from '@Url.Content("~/Scripts/modules/index.js")';

    class ManpowerOverallController {
        constructor() {
            this.CompanyList = document.getElementById('companyTableBody');
            this.AddressList = document.getElementById('addressTableBody');
        }

        async init() {
            await this.LoadManpowerOverllList();
            // this.BindEvents();
        }


        async LoadManpowerOverllList() {
           try {
                const res = await getMethod('@Url.Action("GetOverallManpower", "Employees")',{});
                console.log(res);
                if (!res?.Success) {
                   console.log('No data found in Group Data');
                   return;
                }

               this.RenderCompanyList(res.data.company);
               this.RenderAddressList(res.data.address);

           } catch (error) {
                console.error('Error fetching attendance summary:', error);
           }
        }




        RenderCompanyList(employees) {

            if (!employees.length) {
                this.CompanyList.innerHTML = `
                     <tr>
                        <td colspan="4" style="text-align:center; padding:32px; color:#86868b;">
                            No data available.
                        </td>
                    </tr>`;
                return;
            }


            this.CompanyList.innerHTML = employees.map(r => `
                 <tr>
                     <td>${r.company}</td>
                     <td>${r.Boys}</td>
                     <td>${r.Girls}</td>
                     <td>${r.Total}</td>          
                 </tr>
             `).join('');

        }


        RenderAddressList(employees) {
            if (!employees.length) {
                this.AddressList.innerHTML = `
                      <tr>
                         <td colspan="4" style="text-align:center; padding:32px; color:#86868b;">
                             No data available.
                         </td>
                     </tr>`;
                return;
            }


            this.AddressList.innerHTML = employees.map(r => `
                  <tr>
                      <td>${r.PlacesName}</td>
                      <td>${r.Boys}</td>
                      <td>${r.Girls}</td>
                      <td>${r.Total}</td>          
                  </tr>
              `).join('');
        }


    }


    document.addEventListener('DOMContentLoaded', function () {
        const controller = new ManpowerOverallController();
        controller.init();
    });
</script>