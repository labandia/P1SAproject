<script type="module" asp-append-version="true">
    import {
        getMethod,
        postMethod
    } from '@Url.Content("~/Scripts/modules/index.js")';

    class FinalDashboardController {
        constructor() {
            this.CIRCLE_RADIUS = 52;
            this.CIRCLE_CIRCUMFERENCE = 2 * Math.PI * this.CIRCLE_RADIUS; // ≈326.726
            // ---- Audit info bar ----
            this.auditInfoBar = document.getElementById('auditInfoBar');
            this.refreshInterval = null;
            const today = new Date();

            this.monthName = today.toLocaleString('en-US', { month: 'long' });
            this.year = today.getFullYear();

            this.dashboardTitle = document.getElementById('dashboard-title');

            this.MonthTitle = document.getElementById('monthText');
            this.YearTitle = document.getElementById('yearText');


            // ---- DOM refs ----
            this.lineList = document.getElementById('line-list');
            this.tooltip = document.getElementById('tooltip');
            this.tooltipTitle = document.getElementById('tooltip-title');
            this.tooltipList = document.getElementById('tooltip-list');
            this.tooltipClose = document.getElementById('tooltip-close');
            //this.refreshText = document.getElementById('refreshText');
            this.bestLineNumber = document.getElementById('best-line-number');

            // ---- Award slide DOM refs ----
            this.dashboardEl = document.getElementById('dashboard');
            this.awardSlideOverlay = document.getElementById('awardSlideOverlay');
            this.awardWinnerName = document.getElementById('awardWinnerName');
            this.awardCertImage = document.getElementById('awardCertImage');
            this.awardSubtitle = document.getElementById('awardSubtitle');
            this.awardSlideDuration = 8000; // how long the WHOLE slide stays on screen, ms
            this.awardPerPersonDuration = 3000; // how long each individual awardee is shown, ms

            // ---- Info slide DOM refs (shown right after the award slide) ----
            this.infoSlideOverlay = document.getElementById('infoSlideOverlay');
            this.infoSlideFrame = document.getElementById('infoSlideFrame');
            this.infoSlideDuration = 6000; // how long the info slide stays on screen, ms


            // ---- Stop/Resume slide rotation ----
            this.stopBtn = document.getElementById('StopBtn');
            this.isSlideStopped = false;


            this.OpensDataManage = document.getElementById('commentBtn');


            // ---- Data generation ----
            this.lineNames = [
                'Line 01', 'Line 02', 'Line 03', 'Line 04', 'Line 05',
                'Line 06', 'Line 07', 'Line 08', 'Line 09', 'Line 10',
                'Line 11', 'Line 12', 'Line 13', 'Line 14', 'Line 15',
                'Line 16', 'Line 17', 'Line 18',
                'Cell Line', 'OilProof'
            ];

            this.groupMap = {
                'Line 01': 'L1', 'Line 02': 'L2', 'Line 03': 'L3', 'Line 04': 'L4',
                'Line 05': 'L5', 'Line 06': 'L6', 'Line 07': 'L7', 'Line 08': 'L8',
                'Line 09': 'L9', 'Line 10': 'L10', 'Line 11': 'L11', 'Line 12': 'L12',
                'Line 13': 'L13', 'Line 14': 'L14', 'Line 15': 'L15', 'Line 16': 'L16',
                'Line 17': 'L17', 'Line 18': 'L18',
                'Cell Line': 'CL',
                'OilProof': 'OP'
            };

            this.reverseGroupMap = Object.fromEntries(
                Object.entries(this.groupMap).map(([fullName, code]) => [code, fullName])
            );

            this.lineData = [];

        }

        async init() {


            await this.fetchMonthData();
            await this.fetch4MData();
            await this.fetchGroupData();
            await this.fetchAuditInfo();
            this.attachAuditInfoEditing();

            this.generateData();
            this.renderLines();

            await this.fetchBestLines();

            this.refreshInterval = setInterval(async () => {
                await this.fetch4MData();
                await this.fetchGroupData();
                //this.refreshText.textContent = 'Updated ' + new Date().toLocaleTimeString();
            }, 10000);

            this.bestLinesInterval = setInterval(async () => {
                await this.fetchBestLines();
            }, 60 * 1000);

            // Slide rotation: Main dashboard -> Info slide -> Award slide -> back to Main
            this.awardSlideInterval = setInterval(() => {
                this.showInfoSlide();
            }, 20 * 1000);

            this.OpensDataManage.addEventListener('click', (e) => {
                window.location.href = '/Production1/FinalAssembly/ManagementData';
            });

            this.stopBtn.addEventListener('click', () => {
                this.toggleSlideRotation();
            });
        }


        // ---- Month Display dashboard ----
        async fetchMonthData() {
            try {
                const res = await getMethod('@Url.Action("GetMonthyear", "FinalAssembly")', {});
                if (!res?.Success) {
                    console.log('No data found in 4M ');
                    return;
                }

                this.dashboardTitle.innerHTML = `
                     ${res.data.months} ${res.data.years}<br>
                     FA Line<br>
                     Monitoring
                `;

                this.MonthTitle.innerHTML = res.data.months;
                this.YearTitle.innerHTML = res.data.years;
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }

        // ---- Audit info: load + auto-save on Enter ----
        async fetchAuditInfo() {
            try {
                const res = await getMethod('@Url.Action("GetAuditInfo", "FinalAssembly")', {});
                if (!res?.Success || !res.data) return;
                //console.log(res);
                document.querySelectorAll('.audit-value[data-field]').forEach(el => {
                    const field = el.dataset.field;
                    if (res.data[field] !== undefined && res.data[field] !== null) {
                        el.textContent = res.data[field];
                        el.dataset.lastSaved = res.data[field];
                    }
                });
            } catch (error) {
                console.error('Error fetching audit info:', error);
            }
        }

        attachAuditInfoEditing() {
            if (!this.auditInfoBar) return;

            this.auditInfoBar.querySelectorAll('.audit-value[contenteditable]').forEach(el => {
                // Baseline so we can tell if anything actually changed
                if (el.dataset.lastSaved === undefined) {
                    el.dataset.lastSaved = el.textContent.trim();
                }

                el.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();   // no newline in a single-line chip
                        el.blur();            // triggers the blur handler below, which saves
                    }
                    if (e.key === 'Escape') {
                        el.textContent = el.dataset.lastSaved;
                        el.blur();
                    }
                });

                el.addEventListener('blur', () => this.saveAuditField(el));
            });
        }

        async saveAuditField(el) {
            const field = el.dataset.field;
            const value = el.textContent.trim();

            if (value === el.dataset.lastSaved) return; // nothing changed, skip the round-trip

            el.classList.add('saving');
            try {
                console.log(`Field ` + field);
                console.log(`Value ` + value);

                const res = await postMethod('@Url.Action("SaveAuditInfo", "FinalAssembly")', {
                    field: field,
                    value: value
                });

                if (res?.Success) {
                    el.dataset.lastSaved = value;
                    el.classList.remove('saving');
                    el.classList.add('saved');
                    setTimeout(() => el.classList.remove('saved'), 1000);
                } else {
                    throw new Error(res?.Message || 'Save failed');
                }
            } catch (error) {
                console.error('Error saving audit field:', field, error);
                el.classList.remove('saving');
                el.classList.add('save-error');
                el.textContent = el.dataset.lastSaved; // revert on failure
                setTimeout(() => el.classList.remove('save-error'), 2000);
            }
        }


        // ---- 4M Factors dashboard ----
        async fetch4MData() {
            try {
                const res = await getMethod('@Url.Action("GetListof4ManFactor", "FinalAssembly")', {});
                if (!res?.Success) {
                    console.log('No data found in 4M ');
                    return;
                }
                this.renderNcrBars(res.data);
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }

        // Resets a bar/fill to 0 and re-animates it to its target width,
        // recreating a "start page" fill-in effect on every refresh.
        animateBarFill(el, pct) {
            if (!el) return;

            // Kill any transition, snap to 0 instantly
            el.style.transition = 'none';
            el.style.width = '0%';
            el.classList.add('bar-refreshing');

            // Force reflow so the browser registers the 0% width
            // before we start the new transition
            void el.offsetWidth;

            requestAnimationFrame(() => {
                el.style.transition = 'width 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
                el.style.width = pct + '%';
            });

            // Clean up the shimmer class after it plays once
            clearTimeout(el._shimmerTimeout);
            el._shimmerTimeout = setTimeout(() => {
                el.classList.remove('bar-refreshing');
            }, 850);
        }

        renderNcrBars(data) {
            //console.log(data);
            const typeMap = {
                'In-Process': 'inprocess',
                'Rejected Lot': 'rejected',
                'Customer Complaint': 'claim'
            };

            const rows = (data || []).filter(r => r['NCRType'] !== 'Total');

            const updates = [];
            rows.forEach(row => {
                const key = typeMap[row['NCRType']];
                if (!key) return;

                const circle = document.getElementById(`ncr-${key}`);
                if (!circle) return;

                const pct = row['Percentage'] ?? 0;
                const pctLabel = document.getElementById(`ncr-${key}-pct`);
                if (pctLabel) pctLabel.textContent = `${pct}%`;

                updates.push({ el: circle, pct });
            });

            this.batchAnimateCircles(updates);
        }

        batchAnimateCircles(updates) {
            if (!updates || !updates.length) return;
            const C = this.CIRCLE_CIRCUMFERENCE;

            // Phase 1: reset (writes only)
            updates.forEach(({ el }) => {
                el.style.transition = 'none';
                el.style.strokeDashoffset = C;
                el.classList.add('bar-refreshing');
            });

            // Phase 2: single forced reflow for the whole batch
            void document.body.offsetHeight;

            // Phase 3: animate together
            requestAnimationFrame(() => {
                updates.forEach(({ el, pct }) => {
                    el.style.transition = 'stroke-dashoffset 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
                    el.style.strokeDashoffset = C - (pct / 100) * C;
                });
            });

            clearTimeout(this._shimmerCircleTimeout);
            this._shimmerCircleTimeout = setTimeout(() => {
                updates.forEach(({ el }) => el.classList.remove('bar-refreshing'));
            }, 850);
        }

        batchAnimateBars(updates) {
            if (!updates || !updates.length) return;

            // Phase 1: reset (writes only, no reads in between)
            updates.forEach(({ el }) => {
                el.style.transition = 'none';
                el.style.width = '0%';
                el.classList.add('bar-refreshing');
            });

            // Phase 2: a single forced reflow for the entire batch, instead
            // of one per bar.
            void document.body.offsetHeight;

            // Phase 3: animate all bars together in the same frame.
            requestAnimationFrame(() => {
                updates.forEach(({ el, pct }) => {
                    el.style.transition = 'width 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
                    el.style.width = pct + '%';
                });
            });

            clearTimeout(this._shimmerBatchTimeout);
            this._shimmerBatchTimeout = setTimeout(() => {
                updates.forEach(({ el }) => el.classList.remove('bar-refreshing'));
            }, 850);
        }


        async fetchGroupData() {
            try {
                const res = await getMethod('@Url.Action("GetListofGroupProcess", "FinalAssembly")', {});
                if (!res?.Success) {
                    console.log('No data found in Group Data ');
                    return;
                }

                //console.log(res.data);
                this.renderDistribution(res.data);
            } catch (error) {
                console.error('Error fetching group data:', error);
            }
        }

        renderDistribution(data) {
            // Percentages are now precomputed server-side in the 'FinalPercent' row (SortOrder 2)
            const finalPercentRow = (data || []).find(r => r['NCRType'] === 'FinalPercent');
            if (!finalPercentRow) {
                console.log('No FinalPercent row found in group data');
                return;
            }

            // Map DB group columns -> the bar ids used in the HTML.
            // 'Cell Line' = Group3, 'Harness' = Matprep, 'Oil Proof' = Oiloof per the display naming.
            const groupMap = [
                { key: 'Group1', barId: 'dist-group1' },
                { key: 'Group2', barId: 'dist-group2' },
                { key: 'Group3', barId: 'dist-cell' },
                { key: 'Harness', barId: 'dist-harness' },
                { key: 'MatPrep', barId: 'dist-mat' },
                { key: 'OP', barId: 'dist-oil' },
            ];

            const updates = [];
            groupMap.forEach(({ key, barId }) => {
                const el = document.getElementById(barId);
                if (!el) return;

                const pct = finalPercentRow[key] ?? 0;
                // Set the label text once, up front, instead of inside the
                // animation loop — keeps the batched animation phases clean.
                el.textContent = `${pct}%`;
                updates.push({ el, pct });
            });

            this.batchAnimateBars(updates);
        }

        async fetchBestLines() {
         try {
             const res = await getMethod('@Url.Action("GetBestLineList", "FinalAssembly")', {});
             if (!res?.Success) {
                 console.log('No data found in Group Data ');
                 return;
             }

             //console.log(res.data);
             this.applyBestLines(res.data);
         } catch (error) {
             console.error('Error fetching group data:', error);
         }
        }

        applyBestLines(data) {
            const typeMap = {
                'In-Process': '😒',
                'Rejected Lot': '😢',
                'Customer Complaint': '😭'
            };

            document.querySelectorAll('.line-row').forEach(row => {
                const emojiSpan = row.querySelector('.emoji');
                const ncrInfoSpan = row.querySelector('.ncr-info');
                if (emojiSpan) emojiSpan.textContent = '';
                if (ncrInfoSpan) ncrInfoSpan.textContent = '';
                row.classList.remove('highlight');
            });

            const setEmoji = (lineName, emoji, ncrTypeName, qty) => {
                if (!lineName) return;
                const row = document.querySelector(`.line-row[data-line="${lineName}"]`);
                if (row) {
                    const span = row.querySelector('.emoji');
                    const ncrInfoSpan = row.querySelector('.ncr-info');
                    if (span) span.textContent = emoji;
                    if (ncrInfoSpan) ncrInfoSpan.textContent = `${ncrTypeName} (${qty})`;
                    row.classList.add('highlight');
                }
            };

            const normalizeLine = (line) => {
                if (!line) return line;
                if (line.startsWith('CL')) return 'Cell Line';
                if (line.startsWith('OP')) return 'OilProof';
                return this.reverseGroupMap[line] || line;
            };

            const rows = data || [];
            const linesWithData = new Set();

            rows.forEach(row => {
                const lineName = normalizeLine(row['Line']);
                linesWithData.add(lineName);

                const emoji = typeMap[row['NCRType']];
                if (!emoji) return;

                const qty = row['Qty'] ?? 0;
                setEmoji(lineName, emoji, row['NCRType'], qty);

                const entry = this.lineData.find(d => d.name === lineName);
                if (entry) {
                    entry.total = qty;
                    entry.percentage = row['Percentage'] ?? 0;
                }
            });

            const linesWithoutData = this.lineNames.filter(name => !linesWithData.has(name));

            // Only restart the typing cycle if the missing-lines list actually changed
            const newKey = linesWithoutData.join('|');
            if (newKey !== this._lastMissingLinesKey) {
                this._lastMissingLinesKey = newKey;
                this.startMissingLinesTyping(linesWithoutData);
            }
        }

        // ---- Typewriter cycling through lines with no NCR data ----
        startMissingLinesTyping(lines) {
            // Stop any previous cycle before starting a new one
            if (this._typingRafId) cancelAnimationFrame(this._typingRafId);
            clearTimeout(this._typingPauseTimeout);

            if (!lines || lines.length === 0) {
                this.bestLineNumber.textContent = 'All Lines Reported';
                return;
            }

            const CHAR_INTERVAL_MS = 100;
            const HOLD_MS = 1500;

            let lineIndex = 0;
            let charIndex = 0;
            let lastTickTime = 0;
            let holding = false;
            let holdStart = 0;

            const step = (timestamp) => {
                // Pause all work while the page/tab isn't visible.
                if (document.hidden) {
                    this._typingRafId = requestAnimationFrame(step);
                    return;
                }

                if (holding) {
                    if (timestamp - holdStart >= HOLD_MS) {
                        holding = false;
                        lineIndex = (lineIndex + 1) % lines.length;
                        charIndex = 0;
                        this.bestLineNumber.textContent = '';
                        lastTickTime = timestamp;
                    }
                    this._typingRafId = requestAnimationFrame(step);
                    return;
                }

                if (timestamp - lastTickTime >= CHAR_INTERVAL_MS) {
                    lastTickTime = timestamp;
                    charIndex++;
                    const text = lines[lineIndex];
                    this.bestLineNumber.textContent = text.substring(0, charIndex);

                    if (charIndex >= text.length) {
                        holding = true;
                        holdStart = timestamp;
                    }
                }

                this._typingRafId = requestAnimationFrame(step);
            };

            this._typingRafId = requestAnimationFrame(step);
        }

        generateData() {
            this.lineData = this.lineNames.map(name => ({
                name: name,
                group: this.groupMap[name] || 'Other',
                inprocess: 0,
                rejected: 0,
                claim: 0
            }));
        }


        // ---- Render line rows ----
        renderLines() {
            // Build the whole list off-DOM (DocumentFragment) and attach once,
            // instead of appending 20 rows one at a time into a live DOM tree.
            const fragment = document.createDocumentFragment();
            this.lineData.forEach(d => {
                const row = document.createElement('div');
                row.className = 'line-row';
                row.dataset.line = d.name;
                row.dataset.group = d.group;
                row.innerHTML = `
                    <span class="name">${d.name}</span>
                    <span class="ncr-info"></span>
                    <span class="emoji"></span>
                `;
                fragment.appendChild(row);
            });

            this.lineList.innerHTML = '';
            this.lineList.appendChild(fragment);

            // Re-attach click events after render
            this.attachLineClicks();
        }

         // ---- Click handlers ----
        attachLineClicks() {
            document.querySelectorAll('.line-row').forEach(row => {
                row.addEventListener('click', (e) => {

                    const name = row.dataset.line;
                    const data = this.lineData.find(x => x.name === name);

                    if (!data) return;

                    const items = [
                        { name: 'In-Process', value: data.inprocess },
                        { name: 'Rejected', value: data.rejected },
                        { name: 'Claim', value: data.claim },
                        { name: 'Group', value: data.group }
                    ];

                    const rect = row.getBoundingClientRect();
                    this.showTooltip(
                        'Details for ' + name,
                        items,
                        rect.left + 10,
                        rect.bottom + 10
                    );
                });
            });
        }

        // ---- Tooltip functions ----
        showTooltip(title, items, x, y) {
            tooltipTitle.textContent = title;
            tooltipList.innerHTML = '';
            items.forEach(item => {
                const li = document.createElement('li');
                li.innerHTML = `<span>${item.name}</span><span>${item.value}</span>`;
                tooltipList.appendChild(li);
            });
            tooltip.style.left = x + 'px';
            tooltip.style.top = y + 'px';
            tooltip.classList.add('visible');
        }

        // ---- Award slide functions ----
        async fetchAwardData() {
            try {
                const res = await getMethod('@Url.Action("GetAwardData", "FinalAssembly")', {});


                if (res?.Success) {
                    return res.data; // expected: array of awardee objects
                }
                return null;
            } catch (error) {
                console.error('Error fetching award data:', error);
                return null;
            }
        }
        // Preloads certificate images so decoding happens BEFORE the slide
        // animates in, instead of stalling mid-transition while the TV's
        // decoder catches up. Results are cached so repeat awardees are free.
        preloadAwardImages(awardees) {
            const loads = awardees.map(a => {
                if (!a.CertificateImage) return Promise.resolve();

                const url = `@Url.Action("DisplaytheImage", "FinalAssembly")?filename=${encodeURIComponent('')}`.replace('filename=', 'filename=' + encodeURIComponent(a.CertificateImage));

                if (this._imagePreloadCache.has(url)) {
                    return Promise.resolve();
                }

                return new Promise(resolve => {
                    const img = new Image();
                    img.onload = () => {
                        this._imagePreloadCache.set(url, true);
                        resolve();
                    };
                    img.onerror = resolve;
                    img.src = url;
                });
            });

            return Promise.all(loads);
        }

        async showAwardSlide() {
            const data = await this.fetchAwardData();
            if (!data || !data.length) return;

            const awardees = data.filter(d => d.IsDisplayed).slice(0, 3);
            if (!awardees.length) return; // nothing flagged for display — skip this cycle silently

            // PERFORMANCE: skip the whole slide-in/out animation (transform of
            // the entire dashboard) if the awardee set hasn't changed since the
            // last time we actually showed it. This is the heaviest recurring
            // animation on the page, so avoid re-running it needlessly.
            const awardKey = awardees.map(a => `${a.EmployeeID}:${a.CertificateImage}`).join('|');
            if (awardKey === this._lastAwardKey) return;
            this._lastAwardKey = awardKey;

            // Preload images before starting the visible animation so there's
            // no decode stutter partway through the slide.
            await this.preloadAwardImages(awardees);

            this.dashboardEl.classList.add('slide-out-to-award');
            this.awardSlideOverlay.classList.remove('leaving');
            this.awardSlideOverlay.classList.add('active');

            // Total slide duration scales with how many people are being shown,
            // so each one gets a fair amount of time on screen
            const totalDuration = Math.max(this.awardSlideDuration, awardees.length * this.awardPerPersonDuration);

            this.cycleAwardees(awardees);

            clearTimeout(this._awardHideTimeout);
            this._awardHideTimeout = setTimeout(() => this.hideAwardSlide(), totalDuration);
        }

        // Steps through the awardees array, showing one at a time
        cycleAwardees(awardees) {
            clearInterval(this._awardCycleInterval);
            let index = 0;
            const renderCurrent = () => {
                const data = awardees[index];

                const imagePath = data.CertificateImage
                    ? `@Url.Action("DisplaytheImage", "FinalAssembly")?filename=${encodeURIComponent(data.CertificateImage)}`
                    : '@Url.Content("~/Content/Images/no-image.png")';

                document.getElementById("awardID").textContent = "ID Number : " + data.EmployeeID ?? '';
                document.getElementById("EarlyDefects").textContent = data.DefectDetect ?? '';
                this.awardWinnerName.textContent = data.WinnerName ?? '';
                this.awardCertImage.src = imagePath;
                this.awardSubtitle.textContent = "Line No : " +  data.AssignLine ?? '';
                this.awardSubtitle.style.display = data.AssignLine ? '' : 'none';
            };

            renderCurrent(); // show the first one immediately

            if (awardees.length > 1) {
                this._awardCycleInterval = setInterval(() => {
                    index = (index + 1) % awardees.length;
                    renderCurrent();
                }, this.awardPerPersonDuration);
            }
        }


        hideAwardSlide() {
            clearInterval(this._awardCycleInterval);

            // Award slide exits to the left...
            this.awardSlideOverlay.classList.add('leaving');
            this.awardSlideOverlay.classList.remove('active');

            // ...dashboard re-enters from the left back to center
            this.dashboardEl.classList.remove('slide-out-to-award');

            clearTimeout(this._awardCleanupTimeout);
            this._awardCleanupTimeout = setTimeout(() => {
                this.awardSlideOverlay.classList.remove('leaving');

                // Award slide is last in the rotation — nothing more to chain,
                // the main dashboard is back in view.
            }, 900);
        }

        // ---- Stop/Resume slide rotation ----
        toggleSlideRotation() {
            this.isSlideStopped ? this.resumeSlideRotation() : this.pauseSlideRotation();
        }

        pauseSlideRotation() {
            this.isSlideStopped = true;

            // Stop the recurring trigger that kicks off the info -> award chain
            clearInterval(this.awardSlideInterval);

            // Freeze whatever is currently on screen by cancelling its pending
            // auto-advance/hide timeouts, so the operator can leave a slide up
            // as long as they want instead of it cutting away mid-view.
            clearTimeout(this._infoHideTimeout);
            clearTimeout(this._awardHideTimeout);
            clearInterval(this._awardCycleInterval);

            // Flip the button to a "resume" state
            this.stopBtn.classList.add('stopped');
            const label = this.stopBtn.querySelector('span:last-child');
            if (label) label.textContent = 'Resume Slide';
        }

        resumeSlideRotation() {
            this.isSlideStopped = false;

            // Restart the 20s rotation trigger
            this.awardSlideInterval = setInterval(() => {
                this.showInfoSlide();
            }, 20 * 1000);

            this.stopBtn.classList.remove('stopped');
            const label = this.stopBtn.querySelector('span:last-child');
            if (label) label.textContent = 'Stop Slide';
        }



        // ---- Info slide functions (shown after the main dashboard, before the award slide) ----
        showInfoSlide() {
            if (!this.infoSlideOverlay) return;

            // Load the iframe only when the slide is about to be shown, so it
            // isn't sitting there refreshing/running in the background the
            // whole time the slide is hidden.
            if (this.infoSlideFrame) {
                const targetSrc = this.infoSlideFrame.dataset.src;
                if (targetSrc && this.infoSlideFrame.getAttribute('src') !== targetSrc) {
                    this.infoSlideFrame.src = targetSrc;
                }
            }

            this.infoSlideOverlay.classList.remove('leaving');
            this.infoSlideOverlay.classList.add('active');

            clearTimeout(this._infoHideTimeout);
            this._infoHideTimeout = setTimeout(() => this.hideInfoSlide(), this.infoSlideDuration);
        }

        hideInfoSlide() {
            if (!this.infoSlideOverlay) return;

            this.infoSlideOverlay.classList.add('leaving');
            this.infoSlideOverlay.classList.remove('active');

            clearTimeout(this._infoCleanupTimeout);
            this._infoCleanupTimeout = setTimeout(() => {
                this.infoSlideOverlay.classList.remove('leaving');

                // Unload the iframe while the slide is off-screen.
                if (this.infoSlideFrame) {
                    this.infoSlideFrame.src = 'about:blank';
                }

                // Info slide is next-to-last — show the award slide right after.
                this.showAwardSlide();
            }, 900);
        }
    }



    // ============================================
    // Screen Size Controller - ES6 Class
    // Displays screen and viewport dimensions
    // ============================================

    class ScreenSizeController {
        constructor() {
            // DOM refs
            this.screenSizeEl = document.getElementById('screenSize');
            this.viewportSizeEl = document.getElementById('viewportSize');
            this.badgeEl = document.getElementById('screenSizeBadge');

            // State
            this.isTV = false;
            this.resizeTimer = null;

            // Bind methods
            this.update = this.update.bind(this);
            this.handleResize = this.handleResize.bind(this);
        }

        // === GET SCREEN INFO ===
        getInfo() {
            const { width: screenW, height: screenH } = window.screen;
            const { innerWidth: viewW, innerHeight: viewH } = window;
            const dpr = window.devicePixelRatio || 1;
            const physW = Math.round(screenW * dpr);
            const physH = Math.round(screenH * dpr);

            return { screenW, screenH, viewW, viewH, dpr, physW, physH };
        }

        // === DETECT TV ===
        detectTV() {
            const ua = navigator.userAgent;
            const isTVUA = /tcl|android tv|smart-tv|webos|vizio|roku|fire tv|apple tv/i.test(ua);
            const hasCast = window.chrome?.hasOwnProperty('cast') ?? false;
            const isAndroidTV = ua.includes('Android') && ua.includes('TV');
            const isLarge = window.screen.width >= 1920 && window.screen.height >= 1080;

            return {
                isTV: isTVUA || hasCast || isAndroidTV || isLarge,
                isTCL: /tcl/i.test(ua),
                isAndroidTV
            };
        }

        // === UPDATE DISPLAY ===
        update() {
            const info = this.getInfo();
            const tv = this.detectTV();
            this.isTV = tv.isTV;

            // Update screen size
            let screenDisplay = `${info.screenW} × ${info.screenH}`;
            if (this.isTV && (info.screenW !== info.physW || info.screenH !== info.physH)) {
                screenDisplay = `${info.screenW}×${info.screenH} (${info.physW}×${info.physH})`;
            }
            this.screenSizeEl.textContent = screenDisplay;

            // Update viewport
            this.viewportSizeEl.textContent = `${info.viewW} × ${info.viewH}`;

            // Add TV badge if needed
            let badgeHTML = '';
            if (this.isTV) {
                const tvLabel = tv.isTCL ? '📺 TCL' : '📺 TV';
                badgeHTML = `<span class="tv-badge">${tvLabel}</span>`;
            }

            // Add DPR for TV
            let dprHTML = '';
            if (this.isTV) {
                dprHTML = `<span class="size-separator">·</span><span class="size-label">DPR</span><span class="size-value">${info.dpr.toFixed(1)}x</span>`;
            }

            // Rebuild badge
            this.badgeEl.innerHTML = `
            ${badgeHTML}
            <span class="size-label">Screen</span>
            <span class="size-value" id="screenSize">${screenDisplay}</span>
            <span class="size-separator">·</span>
            <span class="size-label">Viewport</span>
            <span class="size-value" id="viewportSize">${info.viewW} × ${info.viewH}</span>
            ${dprHTML}
        `;

            // Re-assign refs (since we rebuilt innerHTML)
            this.screenSizeEl = document.getElementById('screenSize');
            this.viewportSizeEl = document.getElementById('viewportSize');

            // Log debug
            this.logDebug(info, tv);
        }

        // === RESIZE HANDLER (debounced) ===
        handleResize() {
            clearTimeout(this.resizeTimer);
            this.resizeTimer = setTimeout(this.update, 150);
        }

        // === LOG DEBUG ===
        logDebug(info, tv) {
        }

        // === INIT ===
        init() {
            this.update();
            window.addEventListener('resize', this.handleResize);
            window.addEventListener('orientationchange', () => {
                setTimeout(this.update, 300);
            });
        }

        // === CLEANUP ===
        destroy() {
            window.removeEventListener('resize', this.handleResize);
            clearTimeout(this.resizeTimer);
        }
    }



    document.addEventListener('DOMContentLoaded', function () {
        const controller = new FinalDashboardController();
        controller.init();

        // Initialize screen size controller
        const screenController = new ScreenSizeController();
        screenController.init();

        // Store for cleanup if needed
        window.screenController = screenController;
    });
</script>
