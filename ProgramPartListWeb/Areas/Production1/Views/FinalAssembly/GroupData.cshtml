
@{
    ViewBag.Title = "GroupData";
    Layout = "~/Areas/Production1/Views/Shared/_FinalGroupData.cshtml";
}

<div class="dashboard">
    <header><h1>PRODUCTION OUTPUT DASHBOARD</h1></header>


    <!-- Top stats -->
    <section class="stats-row">
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>Total Output</div>
            <div class="stat-value" id="totalOutput">1,035,191</div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>Average Output</div>
            <div class="stat-value" id="avgOutput">63,473</div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.2" fill="#cfd8e3" /></svg>Target Output</div>
            <div class="stat-value" id="targetOutput">90437</div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" /><path d="M12 12l3-3" /></svg>Overall Efficiency</div>
            <div class="stat-value gauge-wrap" id="overallGaugeHost"></div>
        </div>
    </section>


    <!-- Group cards -->
    <section class="groups-row" id="groupsRow"></section>

    <!-- Chart -->
    <section class="chart-section">
        <h3>Daily Output Summary</h3>
        <div id="chartHost"></div>
        <div class="legend">
            <span><span class="dot" style="background:var(--accent-orange)"></span>Highest: <b id="legendHigh"></b></span>
            <span><span class="dot" style="background:#8bd53a"></span>Lowest: <b id="legendLow"></b></span>
            <span><span class="dot" style="background:#2fb6c4"></span>Days Tracked: <b id="legendDays"></b></span>
        </div>
    </section>



    <script>
/* ---------------------------------------------------------
   DATA — swap these values to repoint the dashboard at
   a different dataset.
--------------------------------------------------------- */
const DATA = {
  totalOutput: 1035191,
  avgOutput: 63473,
  targetOutput: 90437,
  overallEfficiency: 20,
  groups: [
    { name: "GROUP 1", total: 264128, avg: 16508, target: 29505, efficiency: 68 },
    { name: "GROUP 2", total: 457705, avg: 26924, target: 35280, efficiency: 42 },
    { name: "GROUP 3", total: 203754, avg: 12735, target: 16832, efficiency: 93 },
    { name: "OP",      total: 109604, avg: 7307,  target: 8820,  efficiency: 100 }
  ],
  daily: [
    { date: "1-Aug",  value: 25800 },
    { date: "2-Aug",  value: 41200 },
    { date: "3-Aug",  value: 66500 },
    { date: "4-Aug",  value: 58900 },
    { date: "5-Aug",  value: 33700 },
    { date: "6-Aug",  value: 29300 },
    { date: "7-Aug",  value: 35600 },
    { date: "8-Aug",  value: 47800 },
    { date: "9-Aug",  value: 52100 },
    { date: "10-Aug", value: 49700 },
    { date: "11-Aug", value: 60800 },
    { date: "12-Aug", value: 70200 },
    { date: "13-Aug", value: 44100 },
    { date: "14-Aug", value: 81136 },
    { date: "15-Aug", value: 67900 },
    { date: "16-Aug", value: 23493 }
  ]
};

const fmt = n => n.toLocaleString('en-US');

/* ---------- Semicircle gauge (SVG) ---------- */
function gaugeColor(pct) {
    if (pct >= 100) return '#2e9dfa';
    if (pct >= 85) return '#3ecf5a';
    if (pct >= 70) return '#e8c33e';
    return '#e2431e';
}

        function buildGauge(pct, size = 200) {

            const w = 270;
            const h = 102;

            const cx = w / 2;
            const cy = 112;
            const r = 92;

            const startX = cx - r;
            const startY = cy;

            const endX = cx + r;
            const endY = cy;

            const gaugePath = `
        M ${startX} ${startY}
        A ${r} ${r} 0 0 1 ${endX} ${endY}
    `;

            const valueColor = gaugeColor(pct);

            return `
        <svg
            viewBox="0 0 ${w} ${h}"
            preserveAspectRatio="xMidYMid meet"
            style="width:100%;height:100%;display:block;">

            <!-- Gauge background -->
            <path
                d="${gaugePath}"
                fill="none"
                stroke="#244c36"
                stroke-width="45"
                stroke-linecap="butt"
                pathLength="100"
            />

            <!-- Red -->
            <path
                d="${gaugePath}"
                fill="none"
                stroke="#e2431e"
                stroke-width="40"
                stroke-dasharray="20 80"
                pathLength="100"
            />

            <!-- Brown -->
            <path
                d="${gaugePath}"
                fill="none"
                stroke="#8a581c"
                stroke-width="40"
                stroke-dasharray="20 80"
                stroke-dashoffset="-20"
                pathLength="100"
            />

            <!-- Light Green -->
            <path
                d="${gaugePath}"
                fill="none"
                stroke="#8bd53a"
                stroke-width="40"
                stroke-dasharray="20 80"
                stroke-dashoffset="-40"
                pathLength="100"
            />

            <!-- Green progress -->
            <path
                d="${gaugePath}"
                fill="none"
                stroke="${valueColor}"
                stroke-width="40"
                stroke-dasharray="${pct} ${100 - pct}"
                pathLength="100"
            />

            <!-- Percentage -->
            <text
                x="${cx}"
                y="102"
                text-anchor="middle"
                font-size="40"
                font-weight="700"
                fill="${valueColor}">
                ${pct}%
            </text>

        </svg>
    `;
        }

/* ---------- Populate top stats ---------- */
document.getElementById('totalOutput').textContent = fmt(DATA.totalOutput);
document.getElementById('avgOutput').textContent = fmt(DATA.avgOutput);
document.getElementById('targetOutput').textContent = fmt(DATA.targetOutput);
document.getElementById('overallGaugeHost').innerHTML =
    buildGauge(DATA.overallEfficiency, 180);

/* ---------- Populate group cards ---------- */
const groupsRow = document.getElementById('groupsRow');
DATA.groups.forEach(g => {
  const card = document.createElement('div');
  card.className = 'group-card';
    card.innerHTML = `
    <h2>${g.name}</h2>
    <div class="group-row"><span>Total Output</span><span class="val">${fmt(g.total)}</span></div>
    <div class="group-row"><span>Avg Output</span><span class="val">${fmt(g.avg)}</span></div>
    <div class="group-row"><span>Target</span><span class="val">${fmt(g.target)}</span></div>
    <div class="group-gauge">${buildGauge(g.efficiency, 200)}</div>
`;
  groupsRow.appendChild(card);
});

/* ---------- Bar chart ---------- */
function buildChart(){
  const host = document.getElementById('chartHost');
  const w = host.clientWidth || 1240;
  const h = 230;
  const padL = 60, padR = 20, padT = 10, padB = 30;
  const plotW = w - padL - padR;
  const plotH = h - padT - padB;

  const values = DATA.daily.map(d => d.value);
  const maxVal = Math.max(...values);
  const minVal = Math.min(...values);
  const highest = Math.max(...values);
  const lowest = Math.min(...values);
  const targetLine = DATA.avgOutput > maxVal ? maxVal * 0.9 : DATA.avgOutput; // reference line
  const yMax = Math.ceil(maxVal / 10000) * 10000 + 10000;
  const scaleY = v => plotH - (v / yMax) * plotH;

  const n = DATA.daily.length;
  const bandW = plotW / n;
  const barW = bandW * 0.55;

  // gridlines + y labels
  let gridSvg = '';
  const steps = 5;
  for(let i=0;i<=steps;i++){
    const val = (yMax/steps)*i;
    const y = padT + scaleY(val);
    gridSvg += `<line x1="${padL}" y1="${y}" x2="${w-padR}" y2="${y}" stroke="rgba(255,255,255,0.07)" stroke-dasharray="3,4"/>`;
    gridSvg += `<text x="${padL-10}" y="${y+4}" text-anchor="end" font-size="11" fill="#8a97a9">${fmt(val)}</text>`;
  }

  // bars
  let barsSvg = '';
  DATA.daily.forEach((d,i) => {
    const x = padL + i*bandW + (bandW-barW)/2;
    const barH = plotH - scaleY(d.value);
    const y = padT + scaleY(d.value);
    let color, colorEnd;
    if (d.value === highest){ color = '#f5820a'; colorEnd = '#e2431e'; }
    else if (d.value === lowest){ color = '#a9e34b'; colorEnd = '#6fae1f'; }
    else if (d.value > yMax*0.55){ color = '#e8c33e'; colorEnd = '#8bd53a'; }
    else { color = '#8bd53a'; colorEnd = '#3ea34a'; }
    const gradId = `barGrad${i}`;
    barsSvg += `
      <defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${color}"/><stop offset="100%" stop-color="${colorEnd}"/>
      </linearGradient></defs>
      <rect x="${x}" y="${y}" width="${barW}" height="${barH}" rx="2" fill="url(#${gradId})"/>
      <text x="${x+barW/2}" y="${padT+plotH+18}" text-anchor="middle" font-size="11" fill="#9fb0c3">${d.date}</text>
    `;
  });

  const targetY = padT + scaleY(targetLine);

  const svg = `
  <svg viewBox="0 0 ${w} ${h}" style="width:100%;height:100%;display:block;" preserveAspectRatio="none">
    ${gridSvg}
    ${barsSvg}
    <line x1="${padL}" y1="${targetY}" x2="${w-padR}" y2="${targetY}" stroke="#e2431e" stroke-width="2"/>
  </svg>`;
  host.innerHTML = svg;
}
buildChart();
window.addEventListener('resize', () => {
  clearTimeout(window._chResize);
  window._chResize = setTimeout(buildChart, 150);
});
if (window.ResizeObserver){
  const ro = new ResizeObserver(() => {
    clearTimeout(window._chResizeObs);
    window._chResizeObs = setTimeout(buildChart, 100);
  });
  ro.observe(document.getElementById('chartHost'));
}

/* ---------- Legend ---------- */
document.getElementById('legendHigh').textContent = fmt(Math.max(...DATA.daily.map(d=>d.value)));
document.getElementById('legendLow').textContent = fmt(Math.min(...DATA.daily.map(d=>d.value)));
document.getElementById('legendDays').textContent = DATA.daily.length;
    </script>

</div>