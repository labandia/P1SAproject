
@{
    ViewBag.Title = "GroupData";
    Layout = "~/Areas/Production1/Views/Shared/_FinalGroupData.cshtml";
}

<div class="dashboard">
    <header>
        <h1>FINAL ASSY PRODUCTION DASHBOARD</h1>
        @*<span style="color: #fff;" class="screen-size-badge" id="screenSizeBadge">
            <span class="size-label">Screen</span>
            <span class="size-value" id="screenSize">-- × --</span>
            <span class="size-separator">·</span>
            <span class="size-label">Viewport</span>
            <span class="size-value" id="viewportSize">-- × --</span>
