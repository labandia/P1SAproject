    <!-- Top stats -->
    <section class="stats-row">
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>Total Output</div>
            <div class="stat-value" id="totalOutput">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>Average Output</div>
            <div class="stat-value" id="avgOutput">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-head">
                <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor" d="M3.496 12a8.5 8.5 0 0 0 8.235 8.498c.281.54.636 1.036 1.052 1.474q-.389.03-.785.03C6.474 22.002 1.996 17.524 1.996 12S6.474 1.998 11.998 1.998S22 6.476 22 12q0 .394-.03.781a6.5 6.5 0 0 0-1.474-1.05a8.502 8.502 0 0 0-17 .269m7.595 4.409a4.502 4.502 0 0 1 .907-8.91a4.5 4.5 0 0 1 4.409 3.593a6.6 6.6 0 0 1 1.51-.079A6.002 6.002 0 0 0 5.998 12c0 2.978 2.17 5.45 5.015 5.92a6.6 6.6 0 0 1 .078-1.512m.931-2.41h-.024a2 2 0 1 1 2-2v.024A6.5 6.5 0 0 0 12.022 14m5.478-2a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11m.501 8.503V18h2.502a.5.5 0 1 0 0-1H18v-2.5a.5.5 0 1 0-1 0V17h-2.504a.5.5 0 0 0 0 1h2.505v2.503a.5.5 0 1 0 1 0" />
                </svg>


                Target Output
            </div>
            <div class="stat-value" id="targetOutput">85,000</div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#cfd8e3" stroke-width="2"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" /><path d="M12 12l3-3" /></svg>Overall Efficiency</div>
            <div class="stat-value gauge-wrap" id="overallGaugeHost"></div>
        </div>
    </section>


    <!-- Group cards -->
    <section class="groups-row" id="groupsRow"></section>

    <!-- Chart -->
    <section class="chart-section">
        <h3>Daily Output Summary</h3>
        <div class="chart-container">
            <div id="chartHost"></div>
        </div>
        <div class="legend">
            <span><span class="dot" style="background:var(--accent-orange)"></span>Highest: <b id="legendHigh"></b></span>
            <span><span class="dot" style="background:#8bd53a"></span>Lowest: <b id="legendLow"></b></span>
            <span><span class="dot" style="background:#2fb6c4"></span>Days Tracked: <b id="legendDays"></b></span>
        </div>
    </section>



    <script type="module" asp-append-version="true">
        import {
            getMethod,
            postMethod
        } from '@Url.Content("~/Scripts/modules/index.js")';

      class GroupDashboardController {
        constructor() {
            this._animFrames = new Map(); // track in-flight animations per element
        }

        async init() {
            await this.fetchTotalGroupData();
            await this.fetchGroupListData();


            // Handle resize for chart
            const resizeHandler = () => {
                if (this._lastData) {
                    clearTimeout(this._resizeTimer);
                    this._resizeTimer = setTimeout(() => {
                        this.buildChart(this._lastData);
                    }, 150);
                }
            };

            window.addEventListener('resize', resizeHandler);


            // Auto-refresh data every 30 seconds
            this._refreshInterval = setInterval(() => {
                this.fetchTotalGroupData();
                this.fetchGroupListData();
            }, 10000);
        }

        async fetchTotalGroupData() {
            try {
                const res = await getMethod('@Url.Action("GetGroupDashboardData", "FinalAssembly")', {});
                if (!res?.Success) {
                    console.log('No data found in 4M ');
                    return;
                }
                console.log(res);
                this._lastData = res.data; // Store for resize
                this.renderdata(res.data);
                this.displayGroups(res.data);
                //this.buildChart(res.data);
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }

         async fetchGroupListData() {
             try {
                 const res = await getMethod('@Url.Action("GetGroupListData", "FinalAssembly")', {});
                 if (!res?.Success) {
                     console.log('No data found in 4M ');
                     return;
                 }
                 console.log(res);
                 this.buildChart(res.data);
             } catch (error) {
                 console.error('Error fetching 4M data:', error);
             }
         }


        renderdata(data) {
            const totalEl = document.getElementById("totalOutput");
            const avgEl = document.getElementById("avgOutput");
            const targetEl = document.getElementById("targetOutput");
            const gaugeEl = document.getElementById("overallGaugeHost");

            totalEl.innerText = "0";
            avgEl.innerText = "0";
            targetEl.innerText = "0";
            gaugeEl.dataset.pct = "0";

            this.animateNumber(totalEl, data.TotalOutput, 1200);
            this.animateNumber(avgEl, data.AverageOutput, 1200);
            this.animateNumber(targetEl, 85000, 1200);   // static target, not tied to API data
            this.animateGauge(gaugeEl, data.AverageEfficiency, 180, 1200);
        }


        displayGroups(DATA) {
            const groupsRow = document.getElementById('groupsRow');
            groupsRow.innerHTML = ''; // clear previous cards before re-rendering
            DATA.totalGroup.forEach((g, i) => {
                const card = document.createElement('div');
                card.className = 'group-card';
                card.innerHTML = `
                <h2>${g.GroupName}</h2>
                <div class="group-row" >Total Output</span><span class="val" id="grpTotal${i}">0</span></div>
                <div class="group-row" >Avg Output</span><span class="val" id="grpAvg${i}">0</span></div>
                <div class="group-row" >Target</span><span class="val" id="grpTarget${i}">0</span></div>
                <div class="group-gauge" id="grpGauge${i}"></div>
            `;
                groupsRow.appendChild(card);

                this.animateNumber(document.getElementById(`grpTotal${i}`), g.TotalOutput, 1200);
                this.animateNumber(document.getElementById(`grpAvg${i}`), g.AvgOutput, 1200);
                this.animateNumber(document.getElementById(`grpTarget${i}`), g.TargetOutput, 1200);
                this.animateGauge(document.getElementById(`grpGauge${i}`), g.Efficiency, 180, 1200);
            });
        }


        changeformatnumber(n) {
            return n.toLocaleString('en-US');
        }


        /* ---------- Semicircle gauge (SVG) ---------- */
        gaugeColor(pct) {
            if (pct >= 100) return '#2e9dfa';
            if (pct >= 85) return '#3ecf5a';
            if (pct >= 70) return '#e8c33e';
            return '#e2431e';
        }

        buildGauge(pct, size = 200) {

            const w = 270;
            const h = 102;

            const cx = w / 2;
            const cy = 112;
            const r = 92;

            const startX = cx - r;
            const startY = cy;

            const endX = cx + r;
            const endY = cy;

            const gaugePath = `
            M ${startX} ${startY}
            A ${r} ${r} 0 0 1 ${endX} ${endY}
        `;

            const valueColor = this.gaugeColor(pct);

            return `
            <svg
                viewBox="0 0 ${w} ${h}"
                preserveAspectRatio="xMidYMid meet"
                style="width:100%;height:100%;display:block;">

                <!-- Gauge background -->
                <path
                    d="${gaugePath}"
                    fill="none"
                    stroke="#244c36"
                    stroke-width="45"
                    stroke-linecap="butt"
                    pathLength="100"
                />

                <!-- Red -->
                <path
                    d="${gaugePath}"
                    fill="none"
                    stroke="#e2431e"
                    stroke-width="40"
                    stroke-dasharray="20 80"
                    pathLength="100"
                />

                <!-- Brown -->
                <path
                    d="${gaugePath}"
                    fill="none"
                    stroke="#8a581c"
                    stroke-width="40"
                    stroke-dasharray="20 80"
                    stroke-dashoffset="-20"
                    pathLength="100"
                />

                <!-- Light Green -->
                <path
                    d="${gaugePath}"
                    fill="none"
                    stroke="#8bd53a"
                    stroke-width="40"
                    stroke-dasharray="20 80"
                    stroke-dashoffset="-40"
                    pathLength="100"
                />

                <!-- Green progress -->
                <path
                    d="${gaugePath}"
                    fill="none"
                    stroke="${valueColor}"
                    stroke-width="40"
                    stroke-dasharray="${pct} ${100 - pct}"
                    pathLength="100"
                />

                <!-- Percentage -->
                <text
                    x="${cx}"
                    y="102"
                    text-anchor="middle"
                    font-size="40"
                    font-weight="700"
                    fill="${valueColor}">
                    ${pct}%
                </text>

            </svg>
        `;
        }


        /* ---------- Bar chart ---------- */
          /* ---------- Bar chart ---------- */
          buildChart(daily) {
              console.log(daily);
              const host = document.getElementById('chartHost');
              this._lastData = daily; // store for resize

              // Known non-group fields — everything else on each row is treated as a group column
              const KNOWN_KEYS = ['GroupDate', 'date', 'Total', 'value'];

              const getDate = d => d.GroupDate ?? d.date;
              const getTotal = d => {
                  if (typeof d.Total === 'number') return d.Total;
                  if (typeof d.value === 'number') return d.value;
                  // No total sent — sum the group columns
                  return Object.keys(d)
                      .filter(k => !KNOWN_KEYS.includes(k))
                      .reduce((sum, k) => sum + (Number(d[k]) || 0), 0);
              };

              // Check if we're in the small screen mode
              const isSmall = window.innerWidth <= 962 && window.innerHeight <= 542;

              // Get container width
              const containerWidth = host.parentElement ? host.parentElement.clientWidth : host.clientWidth;
              const w = containerWidth || 1240;

              // Adjust padding and sizes for small screens
              const padL = isSmall ? 15 : 60;
              const padR = isSmall ? 5 : 20;
              const padT = isSmall ? 3 : 10;
              const padB = isSmall ? 12 : 30;

              // Adjust height for small screens
              const h = isSmall ? 100 : 230;

              const plotW = w - padL - padR;
              const plotH = h - padT - padB;

              const values = daily.map(getTotal);
              const maxVal = Math.max(...values);
              const minVal = Math.min(...values);
              const highest = maxVal;
              const lowest = minVal;

              const avgOutput = values.reduce((a, b) => a + b, 0) / values.length;
              const targetLine = avgOutput > maxVal ? maxVal * 0.9 : avgOutput;

              const yMax = Math.ceil(maxVal / 10000) * 10000 + 10000;
              const scaleY = v => plotH - (v / yMax) * plotH;

              const n = daily.length;
              const bandW = plotW / n;
              const barW = isSmall ? bandW * 0.4 : bandW * 0.55;

              // Gridlines - skip on small screens for cleaner look
              let gridSvg = '';
              if (!isSmall) {
                  const steps = 5;
                  for (let i = 0; i <= steps; i++) {
                      const val = (yMax / steps) * i;
                      const y = padT + scaleY(val);
                      gridSvg += `<line class="grid-line" x1="${padL}" y1="${y}" x2="${w - padR}" y2="${y}" stroke="rgba(255,255,255,0.07)" stroke-dasharray="3,4" style="opacity:0; transition:opacity .5s ease ${i * 40}ms;"/>`;
                      gridSvg += `<text class="grid-line" x="${padL - 10}" y="${y + 4}" text-anchor="end" font-size="11" fill="#8a97a9" style="opacity:0; transition:opacity .5s ease ${i * 40}ms;">${this.changeformatnumber(val)}</text>`;
                  }
              }

              // Bars + table rows, built in the same pass over `daily`
              let barsSvg = '';
              let tableRowsHtml = '';
              let groupColumns = null;

              daily.forEach((d, i) => {
                  const dateLabelFull = getDate(d);
                  const total = getTotal(d);

                  const x = padL + i * bandW + (bandW - barW) / 2;
                  const barH = plotH - scaleY(total);
                  const y = padT + scaleY(total);
                  let color, colorEnd;
                  if (total === highest) { color = '#f5820a'; colorEnd = '#e2431e'; }
                  else if (total === lowest) { color = '#a9e34b'; colorEnd = '#6fae1f'; }
                  else if (total > yMax * 0.55) { color = '#e8c33e'; colorEnd = '#8bd53a'; }
                  else { color = '#8bd53a'; colorEnd = '#3ea34a'; }
                  const gradId = `barGrad${i}`;
                  const delay = Math.min(i * 45, 450);

                  const fontSize = isSmall ? 6 : 11;
                  const dateLabel = isSmall && dateLabelFull.length > 5 ? dateLabelFull.substring(0, 3) : dateLabelFull;

                  // NEW: label showing the actual output value above the bar
                  const valueFontSize = isSmall ? 6 : 11;
                  const valueLabelY = y - (isSmall ? 3 : 6); // sits just above the bar top

                  barsSvg += `
    <defs><linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${color}"/><stop offset="100%" stop-color="${colorEnd}"/>
    </linearGradient></defs>
    <rect class="bar-rect" x="${x}" y="${y}" width="${barW}" height="${barH}" rx="${isSmall ? 1 : 2}" fill="url(#${gradId})"
        style="transform-box:fill-box; transform-origin:bottom; transform:scaleY(0); transition:transform .65s cubic-bezier(.22,1,.36,1) ${delay}ms;"/>
    <text class="bar-value" x="${x + barW / 2}" y="${valueLabelY}" text-anchor="middle" font-size="${valueFontSize}" font-weight="600" fill="#e8edf3"
        style="opacity:0; transition:opacity .5s ease ${delay + 300}ms;">${this.changeformatnumber(total)}</text>
    <text x="${x + barW / 2}" y="${padT + plotH + (isSmall ? 12 : 18)}" text-anchor="middle" font-size="${fontSize}" fill="#9fb0c3">${dateLabel}</text>
`;
                  // Everything besides GroupDate/date/Total/value is treated as a group column
                  if (!groupColumns) {
                      groupColumns = Object.keys(d).filter(k => !KNOWN_KEYS.includes(k));
                  }

                  const groupCells = groupColumns.map(col => `<td>${this.changeformatnumber(Number(d[col]) || 0)}</td>`).join('');
                  tableRowsHtml += `<tr><td>${dateLabelFull}</td>${groupCells}<td>${this.changeformatnumber(total)}</td></tr>`;
              });

              const targetY = padT + scaleY(targetLine);
              const plotWpx = w - padL - padR;

              const svg = `
<svg viewBox="0 0 ${w} ${h}"
     style="width:100%;height:${isSmall ? '100%' : '100%'};display:block;"
     preserveAspectRatio="xMidYMid meet">
    ${gridSvg}
    ${barsSvg}
    <line class="target-line" x1="${padL}" y1="${targetY}" x2="${w - padR}" y2="${targetY}"
          stroke="#e2431e" stroke-width="${isSmall ? 1 : 2}"
          stroke-dasharray="${plotWpx}" stroke-dashoffset="${plotWpx}"
          style="transition:stroke-dashoffset .8s ease .5s;"/>
</svg>`;
              host.innerHTML = svg;

              // Trigger animations
              requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                      host.querySelectorAll('.bar-rect, .grid-line, .bar-value').forEach(el => {
                          el.style.opacity = '1';
                          if (el.classList.contains('bar-rect')) el.style.transform = 'scaleY(1)';
                      });
                      const targetLineEl = host.querySelector('.target-line');
                      if (targetLineEl) targetLineEl.style.strokeDashoffset = '0';
                  });
              });

              // Legend
              document.getElementById('legendHigh').textContent = this.changeformatnumber(highest);
              document.getElementById('legendLow').textContent = this.changeformatnumber(lowest);
              document.getElementById('legendDays').textContent = daily.length;

              // Group breakdown table, built from the same loop above
              const thead = document.getElementById('groupListHead');
              const tbody = document.getElementById('groupListBody');
              if (thead && tbody && groupColumns) {
                  thead.innerHTML = `<tr><th>GroupDate</th>${groupColumns.map(c => `<th>${c}</th>`).join('')}<th>Total</th></tr>`;
                  tbody.innerHTML = tableRowsHtml;
              }
          }

        //window.addEventListener('resize', () => {
        //    clearTimeout(window._chResize);
        //    window._chResize = setTimeout(buildChart, 150);
        //});
        //if (window.ResizeObserver) {
        //    const ro = new ResizeObserver(() => {
        //        clearTimeout(window._chResizeObs);
        //        window._chResizeObs = setTimeout(buildChart, 100);
        //    });
        //    ro.observe(document.getElementById('chartHost'));
        //}


        // Animates the text content of `el` from its current numeric value to `endValue`
        animateNumber(el, endValue, duration = 800) {
            if (!el) return;

            if (this._animFrames.has(el)) {
                cancelAnimationFrame(this._animFrames.get(el));
                this._animFrames.delete(el);
            }

            const startValue = parseFloat(el.innerText.replace(/,/g, '')) || 0;
            const change = endValue - startValue;

            // Value unchanged — still give a visual "refreshed" cue instead of a silent no-op
            if (change === 0) {
                el.innerText = this.changeformatnumber(endValue);
                el.style.transition = 'none';
                el.style.opacity = '0.35';
                requestAnimationFrame(() => {
                    el.style.transition = `opacity ${Math.min(duration, 400)}ms ease`;
                    el.style.opacity = '1';
                });
                return;
            }

            const startTime = performance.now();
            const ease = t => 1 - Math.pow(1 - t, 3);

            const step = (now) => {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = ease(progress);
                const current = startValue + change * eased;

                el.innerText = this.changeformatnumber(Math.round(current));

                if (progress < 1) {
                    const frameId = requestAnimationFrame(step);
                    this._animFrames.set(el, frameId);
                } else {
                    el.innerText = this.changeformatnumber(endValue);
                    this._animFrames.delete(el);
                }
            };

            const frameId = requestAnimationFrame(step);
            this._animFrames.set(el, frameId);
        }


        animateGauge(hostEl, endPct, size = 200, duration = 800) {
            if (!hostEl) return;

            const startPct = parseFloat(hostEl.dataset.pct || 0);
            const change = endPct - startPct;

            if (change === 0) {
                hostEl.innerHTML = this.buildGauge(endPct, size);
                hostEl.style.transition = 'none';
                hostEl.style.opacity = '0.35';
                requestAnimationFrame(() => {
                    hostEl.style.transition = `opacity ${Math.min(duration, 400)}ms ease`;
                    hostEl.style.opacity = '1';
                });
                hostEl.dataset.pct = endPct;
                return;
            }

            const startTime = performance.now();
            const ease = t => 1 - Math.pow(1 - t, 3);

            const step = (now) => {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = ease(progress);
                const current = Math.round(startPct + change * eased);

                hostEl.innerHTML = this.buildGauge(current, size);

                if (progress < 1) {
                    requestAnimationFrame(step);
                } else {
                    hostEl.innerHTML = this.buildGauge(endPct, size);
                    hostEl.dataset.pct = endPct;
                }
            };

            requestAnimationFrame(step);
        }
    }

     // ============================================
     // Screen Size Controller - ES6 Class
     // Displays screen and viewport dimensions
     // ============================================

        class ScreenSizeController {
     constructor() {
         // DOM refs
         this.screenSizeEl = document.getElementById('screenSize');
         this.viewportSizeEl = document.getElementById('viewportSize');
         this.badgeEl = document.getElementById('screenSizeBadge');

         // State
         this.isTV = false;
         this.resizeTimer = null;

         // Bind methods
         this.update = this.update.bind(this);
         this.handleResize = this.handleResize.bind(this);
     }

     // === GET SCREEN INFO ===
     getInfo() {
         const { width: screenW, height: screenH } = window.screen;
         const { innerWidth: viewW, innerHeight: viewH } = window;
         const dpr = window.devicePixelRatio || 1;
         const physW = Math.round(screenW * dpr);
         const physH = Math.round(screenH * dpr);

         return { screenW, screenH, viewW, viewH, dpr, physW, physH };
     }

     // === DETECT TV ===
     detectTV() {
         const ua = navigator.userAgent;
         const isTVUA = /tcl|android tv|smart-tv|webos|vizio|roku|fire tv|apple tv/i.test(ua);
         const hasCast = window.chrome?.hasOwnProperty('cast') ?? false;
         const isAndroidTV = ua.includes('Android') && ua.includes('TV');
         const isLarge = window.screen.width >= 1920 && window.screen.height >= 1080;

         return {
             isTV: isTVUA || hasCast || isAndroidTV || isLarge,
             isTCL: /tcl/i.test(ua),
             isAndroidTV
         };
     }

     // === UPDATE DISPLAY ===
     update() {
         const info = this.getInfo();
         const tv = this.detectTV();
         this.isTV = tv.isTV;

         // Update screen size
         let screenDisplay = `${info.screenW} × ${info.screenH}`;
         if (this.isTV && (info.screenW !== info.physW || info.screenH !== info.physH)) {
             screenDisplay = `${info.screenW}×${info.screenH} (${info.physW}×${info.physH})`;
         }
         this.screenSizeEl.textContent = screenDisplay;

         // Update viewport
         this.viewportSizeEl.textContent = `${info.viewW} × ${info.viewH}`;

         // Add TV badge if needed
         let badgeHTML = '';
         if (this.isTV) {
             const tvLabel = tv.isTCL ? '📺 TCL' : '📺 TV';
             badgeHTML = `<span class="tv-badge">${tvLabel}</span>`;
         }

         // Add DPR for TV
         let dprHTML = '';
         if (this.isTV) {
             dprHTML = `<span class="size-separator">·</span><span class="size-label">DPR</span><span class="size-value">${info.dpr.toFixed(1)}x</span>`;
         }

         // Rebuild badge
         this.badgeEl.innerHTML = `
         ${badgeHTML}
         <span class="size-label">Screen</span>
         <span class="size-value" id="screenSize">${screenDisplay}</span>
         <span class="size-separator">·</span>
         <span class="size-label">Viewport</span>
         <span class="size-value" id="viewportSize">${info.viewW} × ${info.viewH}</span>
         ${dprHTML}
     `;

         // Re-assign refs (since we rebuilt innerHTML)
         this.screenSizeEl = document.getElementById('screenSize');
         this.viewportSizeEl = document.getElementById('viewportSize');

         // Log debug
         this.logDebug(info, tv);
     }

     // === RESIZE HANDLER (debounced) ===
     handleResize() {
         clearTimeout(this.resizeTimer);
         this.resizeTimer = setTimeout(this.update, 150);
     }

     // === LOG DEBUG ===
     logDebug(info, tv) {
     }

     // === INIT ===
     init() {
         this.update();
         window.addEventListener('resize', this.handleResize);
         window.addEventListener('orientationchange', () => {
             setTimeout(this.update, 300);
         });
     }

     // === CLEANUP ===
     destroy() {
         window.removeEventListener('resize', this.handleResize);
         clearTimeout(this.resizeTimer);
     }


 }



