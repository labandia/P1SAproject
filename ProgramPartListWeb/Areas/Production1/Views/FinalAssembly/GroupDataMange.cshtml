
@{
    ViewBag.Title = "GroupDataMange";
    Layout = null;
}


<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Group Performance Management</title>
    <link href="~/Content/css/FinalDashMangement.css" rel="stylesheet" />
</head>

<body>

    <div class="dashboard">
        <!-- ─── Two-Column Grid ─── -->
        <div class="dashboard-grid">
            <!-- ═══ LEFT: FORMS ═══ -->

            <section class="forms-column">

                <div class="backcontainer">

                    <button id="backbtn">

                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 512 512">

                            <path d="M0 0h512v512H0z" fill="none" />

                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M249.38 336L170 256l79.38-80m-68.35 80H342" />

                            <path fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="32" d="M448 256c0-106-86-192-192-192S64 150 64 256s86 192 192 192s192-86 192-192Z" />

                        </svg>

                    </button>

                    <h4>Back to the Dashboard</h4>

                </div>

                <!-- Add / Edit Form -->

                <div class="form-card tab-panel active" id="formCard">

                    <div class="card-title">

                        <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 32 32">

                            <path d="M0 0h32v32H0z" fill="none" />

                            <path fill="currentColor" d="M19 21h-6a3 3 0 0 0-3 3v2h2v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2h2v-2a3 3 0 0 0-3-3m-3-1a4 4 0 1 0-4-4a4 4 0 0 0 4 4m0-6a2 2 0 1 1-2 2a2 2 0 0 1 2-2" />

                            <path fill="currentColor" d="M25 5h-3V4a2 2 0 0 0-2-2h-8a2 2 0 0 0-2 2v1H7a2 2 0 0 0-2 2v21a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2M12 4h8v4h-8Zm13 24H7V7h3v3h12V7h3Z" />

                        </svg>

                        <span id="formTitle">Add Group Performance Record</span>

                    </div>



                    <form id="dataForm" autocomplete="off">

                        <input type="hidden" id="editIndex" value="-1" />



                        <div class="form-group">

                            <label>Group Date <span class="required">*</span></label>

                            <input type="date" id="groupDate" required />

                        </div>



                        <div class="form-row">

                            <div class="form-group">

                                <label>Group 1 <span class="required">*</span></label>

                                <input type="number" id="group1" step="0.01" placeholder="e.g. 95.5" required />

                            </div>

                            <div class="form-group">

                                <label>Group 2 <span class="required">*</span></label>

                                <input type="number" id="group2" step="0.01" placeholder="e.g. 87.3" required />

                            </div>

                        </div>



                        <div class="form-row">

                            <div class="form-group">

                                <label>Group 3 <span class="required">*</span></label>

                                <input type="number" id="group3" step="0.01" placeholder="e.g. 92.1" required />

                            </div>

                            <div class="form-group">

                                <label>OP <span class="required">*</span></label>

                                <input type="number" id="opGroup" step="0.01" placeholder="e.g. 88.7" required />

                            </div>

                        </div>











                        <hr style="margin: 1.2em 0;" />



                        <div class="btn-group">

                            <button type="submit" class="btn btn-primary btn-block" id="submitBtn">

                                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24">

                                    <path d="M0 0h24v24H0z" fill="none" />

                                    <path fill="currentColor" d="M20 7.423v10.962q0 .69-.462 1.153T18.384 20H5.616q-.691 0-1.153-.462T4 18.384V5.616q0-.691.463-1.153T5.616 4h10.961zm-1 .427L16.15 5H5.616q-.27 0-.443.173T5 5.616v12.769q0 .269.173.442t.443.173h12.769q.269 0 .442-.173t.173-.443zm-5.587 8.102q.587-.586.587-1.414t-.587-1.413T12 12.539t-1.413.586T10 14.538t.587 1.414t1.413.586t1.414-.586M6.768 9.769h7.423v-3H6.77zM5 7.85V19V5z" />

                                </svg>

                                Add Record

                            </button>

                            <button type="button" class="btn btn-outline btn-block" id="cancelBtn" style="display:none;">

                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 48 48">

                                    <path d="M0 0h48v48H0z" fill="none" />

                                    <defs>

                                        <mask id="SVGt9zVddCE">

                                            <path fill="#555" fill-rule="evenodd" stroke="#fff" stroke-linejoin="round" stroke-width="4" d="M44 40.836q-7.34-8.96-13.036-10.168t-10.846-.365V41L4 23.545L20.118 7v10.167q9.523.075 16.192 6.833q6.668 6.758 7.69 16.836Z" clip-rule="evenodd" />

                                        </mask>

                                    </defs>

                                    <path fill="currentColor" d="M0 0h48v48H0z" mask="url(#SVGt9zVddCE)" />

                                </svg>

                                Cancel

                            </button>

                        </div>

                    </form>

                </div>



                <!-- Monthly Summary Form (replacing Best Employee) -->

                <form id="uploadCard" class="form-card tab-panel">

                    <input type="hidden" id="editSummaryIndex" value="-1" />



                    <div class="card-title">

                        <svg xmlns="http://www.w3.org/2000/svg" width="1.3em" height="1.3em" viewBox="0 0 32 32">

                            <path d="M0 0h24v24H0z" fill="none" />

                            <g fill="none" fill-rule="evenodd">

                                <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z" />

                                <path fill="currentColor" d="m8.076 7.26l.095.083l8.486 8.485a1 1 0 0 1-.246 1.595l-.116.05L5.91 21.3c-1.952.72-3.853-1.115-3.26-3.064l.05-.146L6.526 7.705a1 1 0 0 1 1.447-.516zm-.214 2.602l-3.285 8.92a.5.5 0 0 0 .562.664l.08-.023l8.918-3.286zm9.245 1.742c.911.048 2.16.24 3.246.892a1 1 0 0 1-.925 1.77l-.104-.055c-.682-.41-1.554-.57-2.322-.61a8 8 0 0 0-.95.004l-.316.031a1 1 0 0 1-.281-1.98a8.6 8.6 0 0 1 1.652-.053m2.025-2.786a1 1 0 0 1 .116 1.993l-.116.007h-.708a1 1 0 0 1-.116-1.993l.116-.007zM15.95 8.05a1 1 0 0 1 .083 1.32l-.083.094l-1.06 1.061a1 1 0 0 1-1.498-1.32l.083-.094l1.06-1.06a1 1 0 0 1 1.415 0m-2.587-5.266c.448 1.346.208 2.82-.072 3.85a10 10 0 0 1-.69 1.863a1 1 0 0 1-1.79-.893a8 8 0 0 0 .55-1.496c.227-.832.341-1.735.166-2.475l-.061-.216a1 1 0 1 1 1.897-.633m5.415 2.438a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0" />

                            </g>

                        </svg>

                        <span id="uploadFormTitle">Monthly Summary</span>

                    </div>



                    <p id="monthlyRecordCount" style="margin:-4px 0 14px;font-size:13px;color:#64748b;"></p>



                    <div class="form-group">

                        <label>Month/Year <span class="required">*</span></label>

                        <input type="month" id="summaryMonth" required />

                    </div>



                    <div class="form-row">

                        <div class="form-group">

                            <label>Group 1 Avg <span class="required">*</span></label>

                            <input type="number" id="summaryGroup1" step="0.01" placeholder="e.g. 92.5" required />

                        </div>

                        <div class="form-group">

                            <label>Group 2 Avg <span class="required">*</span></label>

                            <input type="number" id="summaryGroup2" step="0.01" placeholder="e.g. 88.3" required />

                        </div>

                    </div>



                    <div class="form-row">

                        <div class="form-group">

                            <label>Group 3 Avg <span class="required">*</span></label>

                            <input type="number" id="summaryGroup3" step="0.01" placeholder="e.g. 90.7" required />

                        </div>

                        <div class="form-group">

                            <label>OP Avg <span class="required">*</span></label>

                            <input type="number" id="summaryOP" step="0.01" placeholder="e.g. 85.2" required />

                        </div>

                    </div>



                    <div class="form-row">

                        <div class="form-group">

                            <label>Target Output <span class="required">*</span></label>

                            <input type="number" id="summaryTarget" step="1" placeholder="e.g. 1000" required />

                        </div>

                        <div class="form-group">

                            <label>Total Output <span class="required">*</span></label>

                            <input type="number" id="summaryTotal" step="1" placeholder="e.g. 960" required />

                        </div>

                    </div>



                    <div class="form-group">

                        <label>Overall Average <span class="required">*</span></label>

                        <input type="number" id="summaryAverage" step="0.01" placeholder="e.g. 89.2" required />

                    </div>



                    <div class="btn-group">

                        <button type="submit" class="btn btn-primary" id="updateDataBtn">

                            Save Summary

                        </button>



                        <button type="button" class="btn btn-outline btn-block" id="uploadCancelBtn" style="display:none;">

                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 48 48">

                                <path d="M0 0h48v48H0z" fill="none" />

                                <defs>

                                    <mask id="SVGt9zVddCE2">

                                        <path fill="#555" fill-rule="evenodd" stroke="#fff" stroke-linejoin="round" stroke-width="4" d="M44 40.836q-7.34-8.96-13.036-10.168t-10.846-.365V41L4 23.545L20.118 7v10.167q9.523.075 16.192 6.833q6.668 6.758 7.69 16.836Z" clip-rule="evenodd" />

                                    </mask>

                                </defs>

                                <path fill="currentColor" d="M0 0h48v48H0z" mask="url(#SVGt9zVddCE2)" />

                            </svg>

                            Cancel

                        </button>

                    </div>



                    <p style="margin-top:14px;font-size:13px;color:#64748b;">

                        Monthly summary aggregates daily group performance data.

                    </p>

                </form>



            </section>

            <!-- ═══ RIGHT: TABLES ═══ -->
            <section class="table-column">

                <!-- ================= GROUP RECORDS TABLE ================= -->

                <div id="recordTable" class="table-wrapper table-panel active">

                    <div class="table-toolbar">

                        <div class="left">

                            <h2><svg xmlns="http://www.w3.org/2000/svg" width="1.1em" height="1.1em" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="3" y1="15" x2="21" y2="15" /><line x1="9" y1="21" x2="9" y2="9" /></svg> Group Performance</h2>

                            <span class="record-count" id="recordCount">0 entries</span>

                        </div>

                        <div class="search-box">

                            <input type="month" id="searchMonth" />

                            <button id="searchBtn">

                                <svg xmlns="http://www.w3.org/2000/svg" width="1.1em" height="1.1em" viewBox="0 0 48 48">

                                    <path d="M0 0h48v48H0z" fill="none" />

                                    <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="4">

                                        <path d="M21 38c9.389 0 17-7.611 17-17S30.389 4 21 4S4 11.611 4 21s7.611 17 17 17Z" />

                                        <path stroke-linecap="round" d="M26.657 14.343A7.98 7.98 0 0 0 21 12a7.98 7.98 0 0 0-5.657 2.343m17.879 18.879l8.485 8.485" />

                                    </g>

                                </svg>

                                Filter

                            </button>

                            <button id="clearSearchBtn" style="background:#94a3b8;">Clear</button>

                        </div>

                    </div>



                    <div class="table-scroll maintable">

                        <table>

                            <thead>

                                <tr>

                                    <th>Date</th>

                                    <th>Group 1</th>

                                    <th>Group 2</th>

                                    <th>Group 3</th>

                                    <th>OP</th>

                                    <th>Target</th>

                                    <th>Total</th>

                                    <th>Average</th>

                                    <th style="text-align:center;">Actions</th>

                                </tr>

                            </thead>

                            <tbody id="tableBody">

                                <!-- rows injected by JS -->

                            </tbody>

                        </table>

                    </div>

                </div>



                <!-- ================= MONTHLY SUMMARY TABLE ================= -->

                <div id="uploadTable" class="table-wrapper table-panel">



                    <div class="table-toolbar">

                        <div class="left">

                            <h2>Monthly Summaries</h2>

                            <span class="record-count" id="summaryRecordCount">0 entries</span>

                        </div>



                        <div class="search-box">

                            <input type="month" id="summarySearchMonth" />

                            <button id="summarySearchBtn">Search</button>

                            <button id="summaryClearBtn" style="background:#94a3b8;">Clear</button>

                        </div>

                    </div>



                    <div class="table-scroll uploadTables">

                        <table>

                            <thead>

                                <tr>

                                    <th>Month</th>

                                    <th>Group 1 Avg</th>

                                    <th>Group 2 Avg</th>

                                    <th>Group 3 Avg</th>

                                    <th>OP Avg</th>

                                    <th>Target</th>

                                    <th>Total</th>

                                    <th>Overall Avg</th>

                                    <th>Actions</th>

                                </tr>

                            </thead>

                            <tbody id="summaryTableBody"></tbody>

                        </table>

                    </div>



                </div>



            </section>
        </div>
    </div>

    <!-- ─── Toast ─── -->

    <div class="toast" id="toast">

        <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>

        <span id="toastMessage">Done!</span>

    </div>

    <!-- ─── Delete Confirm Modal ─── -->

    <div class="modal-overlay" id="deleteModal" style="display:none;">

        <div class="modal-box">

            <p id="deleteModalText">Delete this record? This cannot be undone.</p>

            <div class="btn-group">

                <button class="btn btn-danger" id="confirmDeleteBtn"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg> Delete</button>

                <button class="btn btn-outline" id="cancelDeleteBtn"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg> Cancel</button>

            </div>

        </div>

    </div>

    <script type="module" asp-append-version="true">
        import {
            getMethod,
            postMethod
        } from '@Url.Content("~/Scripts/modules/index.js")';

        class GroupDataManageController {
               constructor() {
                   this.tbody = document.getElementById('tableBody');

                   this.form = document.getElementById('dataForm');
                   this.editIndexInput = document.getElementById('editIndex');
                   this.cancelBtn = document.getElementById('cancelBtn');
                   this.submitBtn = document.getElementById('submitBtn');

                   this.searchMonth = document.getElementById('searchMonth');
                   this.searchBtn = document.getElementById('searchBtn');
                   

                   const today = new Date();
                   this.currentMonthValue = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;
               }

               async init() {
                  this.searchMonth.value = this.currentMonthValue;

                   this.bindEvents();
                   await this.GetGroupDataList(this.currentMonthValue);
              }

            bindEvents() {
                this.form.addEventListener('submit', e => this.onSubmitRecord(e));
                // this.cancelBtn.addEventListener('click', () => this.resetRecordForm());

                // this.summaryForm.addEventListener('submit', e => this.onSubmitSummary(e));
                // this.uploadCancelBtn.addEventListener('click', () => this.resetSummaryForm());

                this.searchBtn.addEventListener('click', () => this.GetGroupDataList(this.searchMonth.value));
           

                // this.summarySearchBtn.addEventListener('click', () => this.GetSummaryData(this.summarySearchMonth.value));
                // this.summaryClearBtn.addEventListener('click', () => {
                //     this.summarySearchMonth.value = this.currentMonthValue;
                //     this.GetSummaryData(this.currentMonthValue);
                // });

                // Row-level buttons are added dynamically, so delegate from the tbody instead
                // of binding one listener per row (rows get rebuilt on every render).
                this.tbody.addEventListener('click', e => this.onRecordTableClick(e));
                // this.summaryTbody.addEventListener('click', e => this.onSummaryTableClick(e));

                // this.confirmDeleteBtn.addEventListener('click', () => this.onConfirmDelete());
                // this.cancelDeleteBtn.addEventListener('click', () => this.closeDeleteModal());
            }


               async GetGroupDataList(month) {
                   try {
                       const res = await getMethod('@Url.Action("GetManageGroupDataList", "FinalAssembly")', { month });
                       if (!res?.Success) {
                           console.log('No data Registration Found ');
                           return;
                       }
                       this.renderTable(res.data);
                   } catch (error) {
                       console.error('Error fetching 4M data:', error);
                   }
               }

            renderTable(data) {
                document.getElementById('recordCount').textContent = `${data.length} entries`;
                this.tbody.innerHTML = data.map(r => `
                        <tr data-id="${r.RecordId}">
                            <td>${this.formatDate(r.GroupDate)}</td>
                            <td>${r.Group1}</td>
                            <td>${r.Group2}</td>
                            <td>${r.Group3}</td>
                            <td>${r.OP}</td>
                            <td>${r.Target ?? ''}</td>
                            <td>${r.Total ?? ''}</td>
                            <td>${r.Average ?? ''}</td>
                            <td style="text-align:center;">
                                <button class="btn-icon edit-record" data-id="${r.RecordId}" title="Edit">✏️</button>
                            </td>
                        </tr>
                    `).join('');
            }
            // ───────────────────────── EDIT (populate form) ─────────────────────────
            onRecordTableClick(e) {
                const editBtn = e.target.closest('.edit-record');
                if (editBtn) this.loadRecordIntoForm(editBtn.dataset.id);
                // if (delBtn) this.openDeleteModal('record', delBtn.dataset.id);
            }
            loadRecordIntoForm(id) {
                const row = this.tbody.querySelector(`tr[data-id="${id}"]`);
                if (!row) return;
                const cells = row.children;

                this.editIndexInput.value = id;
                document.getElementById('groupDate').value = this.toDateInputValue(cells[0].textContent);
                document.getElementById('group1').value = cells[1].textContent;
                document.getElementById('group2').value = cells[2].textContent;
                document.getElementById('group3').value = cells[3].textContent;
                document.getElementById('opGroup').value = cells[4].textContent;

                document.getElementById('formTitle').textContent = 'Edit Group Performance Record';
                this.submitBtn.lastChild.textContent = ' Update Record';
                this.cancelBtn.style.display = 'inline-flex';
                this.form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // ───────────────────────── CREATE / UPDATE ─────────────────────────
            async onSubmitRecord(e) {
                e.preventDefault();

                const payload = {
                    RecordId: parseInt(this.editIndexInput.value, 10) || 0, // 0 = new record, backend inserts
                    GroupDate: document.getElementById('groupDate').value,
                    Group1: parseFloat(document.getElementById('group1').value),
                    Group2: parseFloat(document.getElementById('group2').value),
                    Group3: parseFloat(document.getElementById('group3').value),
                    OP: parseFloat(document.getElementById('opGroup').value)
                };
                console.log(payload);
                try {
                    const res = await postMethod('@Url.Action("AddGroupDataPerformance", "FinalAssembly")', payload);
                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Save failed.', false);
                        return;
                    }
                    this.showToast(payload.RecordId ? 'Record updated.' : 'Record added.', true);
                    this.resetRecordForm();
                    await this.GetGroupDataList(this.searchMonth.value);
                } catch (error) {
                    console.error('Error saving record:', error);
                    this.showToast('Save failed.', false);
                }
            }

            resetRecordForm() {
                this.form.reset();
                this.editIndexInput.value = -1;
                document.getElementById('formTitle').textContent = 'Add Group Performance Record';
                this.submitBtn.lastChild.textContent = ' Add Record';
                // this.cancelBtn.style.display = 'none';
            }

            // ───────────────────────── Helpers ─────────────────────────

            formatDate(iso) {
                const d = new Date(iso);
                return d.toLocaleDateString('en-CA'); // yyyy-MM-dd, matches <input type="date">
            }

            toDateInputValue(displayDate) {
                return new Date(displayDate).toISOString().slice(0, 10);
            }

            showToast(message, success = true) {
                const toast = document.getElementById('toast');
                document.getElementById('toastMessage').textContent = message;
                toast.classList.toggle('toast-error', !success);
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2500);
            }
        }


        document.addEventListener('DOMContentLoaded', function () {
            const controller = new GroupDataManageController();
               controller.init();
        });
    </script>
</body>
</html>
