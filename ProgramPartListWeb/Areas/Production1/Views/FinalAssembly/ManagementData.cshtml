        async init() {
            await this.GetRegistrationData();
            await this.fetchAwardData();

            this.bindDeleteModalEvents();
            this.bindFormEvents();
            this.bindFilterDropDownEvents();
            this.bindTableEvents();
            this.bindUploadEvents();
            this.bindUpdateEvents();
            this.bindTabEvents();
            this.bindUploadTableEvents();

            this.clicksearch.addEventListener('click', async (e) => {
                e.preventDefault();

                await GetRegistrationData();
            });

            document.querySelectorAll('.uppercase-input')
                .forEach(input => input.addEventListener('input', this.forceUpperCase));
        }

        // ─────────────────────────────────────────────
        // Tab Switching
        // ─────────────────────────────────────────────
        bindTabEvents() {

            this.tabButtons = document.querySelectorAll(".ChangeFormstab .tab-btn");

            this.tabPanels = {
                tabRecord: document.getElementById("formCard"),
                tabUpload: document.getElementById("uploadCard")
            };

            this.tablePanels = {
                tabRecord: document.getElementById("recordTable"),
                tabUpload: document.getElementById("uploadTable")
            };


            const switchTab = (tabId) => {

                // Buttons
                this.tabButtons.forEach(btn => {
                    btn.classList.toggle("active", btn.dataset.tab === tabId);
                });

                // Forms
                Object.entries(this.tabPanels).forEach(([key, panel]) => {
                    panel.classList.toggle("active", key === tabId);
                });

                // Tables
                Object.entries(this.tablePanels).forEach(([key, panel]) => {
                    panel.classList.toggle("active", key === tabId);
                });

            };

            // Button events
            this.tabButtons.forEach(btn => {

                btn.addEventListener("click", (e) => {
                    e.preventDefault();

                    switchTab(btn.dataset.tab);
                });

            });

            // Make callable from other methods
            this.switchTab = switchTab;

            // Default tab
            switchTab("tabRecord");
        }


        async fetchAwardData() {
            try {
                const res = await getMethod('@Url.Action("GetAwardData", "FinalAssembly")', {});
                console.log(res);

                if(res?.Success){
                    let getdata = res.data;
                    this.renderUploadsTable(getdata);
                }

            } catch (error) {
                console.error('Error fetching award data:', error);
                return null;
            }
        }

        async GetRegistrationData() {
            try {
                const currentMonth = new Date().getMonth() + 1;
                const res = await getMethod('@Url.Action("GetRegistrationList", "FinalAssembly")',
                    { search: this.searchText.value, month: currentMonth });
                if (!res?.Success) {
                    console.log('No data Registration Found ');
                    return;
                }
                this.renderTable(res.data);
            } catch (error) {
                console.error('Error fetching 4M data:', error);
            }
        }


        bindFilterDropDownEvents() {
            this.processGroupSelect.addEventListener('change', async (e) => {
                let val = e.target.value;
                console.log("group Category Selected : " + val);

                try {
                    const res = await getMethod('@Url.Action("GetProcessGroupList", "FinalAssembly")', {
                        groups: parseInt(val)
                    });
                    console.log(res);

                    // Clear existing items
                    this.processSelect.innerHTML = '<option value="0">Select Process</option>';

                    if (res?.Success && Array.isArray(res.data)) {

                        res.data.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item.ProcessID;
                            option.textContent = item.ProcessName;

                            this.processSelect.appendChild(option);
                        });
                    }

                } catch (error) {
                    console.error('Error fetching process list:', error);

                    // Reset dropdown on error
                    this.processSelect.innerHTML = '<option value="0">Select Process</option>';
                }
            });
        }




        renderTable(data) {
            if (!this.tbody) return;

            this.recordCount.textContent = `${data.length} ${data.length === 1 ? 'entry' : 'entries'}`;

            if (data.length === 0) {
                this.tbody.innerHTML = `
               <tr>
                   <td colspan="12" style="text-align:center; padding:32px; color:#86868b;">
                       No data available.
                   </td>
               </tr>`;
                return;
            }

            this.tbody.innerHTML = data.map(row => {

                return `
             <tr class='fade-in'
                 data-ncr-id="${row.NCRID}"
                 data-reg-no="${row.RegistrationNo ?? ''}"
                 data-model="${row.ModelShopOrder ?? ''}"
                 data-process-id="${row.ProcessID  ?? 0}"
                 data-fourm-id="${row.FourMID  ?? 0}"
                 data-ncr-type="${row.NCRTypeID ?? 0}"
                 data-group="${row.GroupID  ?? 0}"
                 data-line="${row.OriginID  ?? ''}">
                       <td>${row.CreatedDate}</td>
                       <td style='font-weight: 600;'>${row.RegistrationNo}</td>
                       <td>${row.ModelShopOrder}</td>
                       <td>${row.ProcessName || ''}</td>
                       <td>${row.FourMName}</td>
                       <td class="status-column">${row.NCRTypeName || ''}</td>
                       <td>${row.Line ?? row.OriginID ?? ''}</td>
                       <td style="text-align:center; white-space:nowrap;">
                           <button type="button" class="btn-icon btn-edit" title="Edit">
                              <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
	                            <path d="M0 0h24v24H0z" fill="none" />
	                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5 16l-1 4l4-1L19.586 7.414a2 2 0 0 0 0-2.828l-.172-.172a2 2 0 0 0-2.828 0zM15 6l3 3m-5 11h8" />
                            </svg>


                           </button>
                           <button type="button" class="btn-icon btn-delete" title="Delete">
                               <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
	                                <path d="M0 0h24v24H0z" fill="none" />
	                                <path fill="currentColor" d="M7.616 20q-.667 0-1.141-.475T6 18.386V6h-.5q-.213 0-.356-.144T5 5.499t.144-.356T5.5 5H9q0-.31.23-.54t.54-.23h4.46q.31 0 .54.23T15 5h3.5q.213 0 .356.144t.144.357t-.144.356T18.5 6H18v12.385q0 .666-.475 1.14t-1.14.475zM17 6H7v12.385q0 .269.173.442t.443.173h8.769q.269 0 .442-.173t.173-.442zm-6.335 10.856q.143-.144.143-.356v-8q0-.213-.144-.356T10.307 8t-.356.144t-.143.356v8q0 .213.144.356q.144.144.356.144q.213 0 .357-.144m3.384 0q.143-.144.143-.356v-8q0-.213-.144-.356Q13.904 8 13.692 8q-.213 0-.357.144t-.143.356v8q0 .213.144.356t.357.144t.356-.144M7 6v13z" />
                                </svg>

                           </button>
                       </td>
               </tr>`;

            }).join('');

        }
        renderUploadsTable(data) {
                if (!this.uploadtbody) return;

                //this.recordCount.textContent = `${data.length} ${data.length === 1 ? 'entry' : 'entries'}`;

                this.currentMonthAwardCount = this.countWinnersThisMonth(data);
                this.updateMonthlyWinnerCountUI();

                if (data.length === 0) {
                    this.uploadtbody.innerHTML = `
                    <tr>
                       <td colspan="7" style="text-align:center; padding:32px; color:#86868b;">
                           No data available.
                       </td>
                   </tr>`;
                    return;
                }

                this.uploadtbody.innerHTML = data.map(row => {
                    const imagePath = row.CertificateImage ?? row.ImagePath ?? '';
                    const isDisplayed = row.IsDisplayed ? '1' : '0';


                    return `
                 <tr class='fade-in'
                     data-award-id="${row.AwardID}"
                     data-employee-id="${row.EmployeeID ?? ''}"
                     data-winner-name="${row.WinnerName ?? ''}"
                     data-line="${row.AssignLine ?? ''}"
                     data-defect="${row.DefectDetect ?? ''}"
                     data-image="${imagePath}"
                     data-is-displayed="${isDisplayed}">
                           <td>${row.Months}</td>
                           <td>${imagePath ? `<button type="button" class="btn-link btn-row-view" title="View image">View</button>` : '—'}</td>
                           <td>${row.EmployeeID}</td>
                           <td style='font-weight: 600;'>${row.WinnerName}</td>
                           <td>${row.AssignLine}</td>
                           <td>${row.DefectDetect || ''}</td>
                           
                           <td style="text-align:center; white-space:nowrap;">
                               <button type="button" class="btn-icon btn-edit" title="Edit">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m5 16l-1 4l4-1L19.586 7.414a2 2 0 0 0 0-2.828l-.172-.172a2 2 0 0 0-2.828 0zM15 6l3 3m-5 11h8" />
                                </svg>


                               </button>
                               <button type="button" class="btn-icon btn-delete" title="Delete">
                                   <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24">
                                        <path d="M0 0h24v24H0z" fill="none" />
                                        <path fill="currentColor" d="M7.616 20q-.667 0-1.141-.475T6 18.386V6h-.5q-.213 0-.356-.144T5 5.499t.144-.356T5.5 5H9q0-.31.23-.54t.54-.23h4.46q.31 0 .54.23T15 5h3.5q.213 0 .356.144t.144.357t-.144.356T18.5 6H18v12.385q0 .666-.475 1.14t-1.14.475zM17 6H7v12.385q0 .269.173.442t.443.173h8.769q.269 0 .442-.173t.173-.442zm-6.335 10.856q.143-.144.143-.356v-8q0-.213-.144-.356T10.307 8t-.356.144t-.143.356v8q0 .213.144.356q.144.144.356.144q.213 0 .357-.144m3.384 0q.143-.144.143-.356v-8q0-.213-.144-.356Q13.904 8 13.692 8q-.213 0-.357.144t-.143.356v8q0 .213.144.356t.357.144t.356-.144M7 6v13z" />
                                    </svg>

                               </button>
                           </td>
                   </tr>`;

                }).join('');

        }

        bindFormEvents() {
            this.backbtn.addEventListener('click', ()=>{
                window.location.href = '/Production1/FinalAssembly/Dashboard';
            });

            this.form.addEventListener('submit', (e) => this.handleSubmit(e));
            this.cancelBtn.addEventListener('click', () => this.resetForm());
        }

        bindTableEvents() {
            this.tbody.addEventListener('click', (e) => {
                const editBtn = e.target.closest('.btn-edit');
                const deleteBtn = e.target.closest('.btn-delete');

                if (editBtn) {
                    const row = editBtn.closest('tr');
                    this.populateFormForEdit(row);
                } else if (deleteBtn) {
                    const row = deleteBtn.closest('tr');
                    this.openDeleteModal(row.dataset.ncrId);
                }
            });
        }

        bindUploadEvents() {
            // clicking the styled button opens the real (hidden) file picker
            this.uploadBtn.addEventListener('click', () => this.fileInput.click());

            this.fileInput.addEventListener('change', () => {
                const file = this.fileInput.files[0];
                if (!file) return;

                // client-side type check — server re-validates this too, don't trust the client alone
                const allowedTypes = ['image/png', 'image/jpeg'];
                if (!allowedTypes.includes(file.type)) {
                    alert('Only PNG or JPEG images are allowed.');
                    this.fileInput.value = '';
                    this.selectedCertificateFile = null;
                    return;
                }

                // just stash it — actual submit happens on "Update" click
                this.selectedCertificateFile = file;
            });
        }

        bindUpdateEvents() {
              this.uploadForm.addEventListener("submit", async (e) => {
              e.preventDefault();

                if (!this.uploadForm.reportValidity())
                    return;


                const isEditing = parseInt(this.editAwardIndexInput.value, 10) > 0;

                if (isEditing && !this.selectedCertificateFile) {
                    this.showToast('Please select a new image before updating this record.', true);
                    return;
                }

                if (!isEditing && this.currentMonthAwardCount >= this.MAX_WINNERS_PER_MONTH) {
                    this.showToast(`Only ${this.MAX_WINNERS_PER_MONTH} winners can be added per month.`, true);
                    return;
                }

                const formData = new FormData();

                formData.append("AwardID", this.editAwardIndexInput.value || -1);
                formData.append("EmployeeID", document.getElementById("employeeIDText").value.trim());
                formData.append("WinnerName", this.nameInput.value.trim());
                formData.append("AssignLine", document.getElementById("lineText").value.trim());
                formData.append("DefectDetect", document.getElementById("defectText").value.trim());
                formData.append("isDisplayed", this.isDisplayedInput.checked);

                if (this.selectedCertificateFile) {
                    formData.append("certificateImage", this.selectedCertificateFile);
                }

                const data = Object.fromEntries(formData);

                console.log(data);
                this.updateBtn.disabled = true;

                try {
                    const res = await postMethod(
                        '@Url.Action("SaveAwardsData", "FinalAssembly")',
                        formData
                    );
                    console.log(res);
                    if (!res?.Success) {
                        this.showToast(res?.Message || "Update failed.", true);
                        return;
                    }

                    this.showToast(isEditing ? "Record updated." : "Record saved successfully.");

                    this.resetUploadForm();

                    await this.fetchAwardData();

                } catch (err) {
                    console.error(err);
                    this.showToast("Update failed.", true);
                } finally {
                    this.updateBtn.disabled = false;
                }
            });



             @*this.updateBtn.addEventListener('click', async () => {
                    const name = this.nameInput.value.trim();
                    if (!name) {
                        alert('Enter the winner\'s name first.');
                        return;
                    }

                    const formData = new FormData();
                    formData.append('awardeesName', name);
                    formData.append('isDisplayed', this.isDisplayedInput.checked);

                    if (this.selectedCertificateFile) {
                        formData.append('certificateImage', this.selectedCertificateFile);
                    }

                    //const data = Object.fromEntries(formData);
                     try {
                        const res = await postMethod('@Url.Action("UploadCertificate", "FinalAssembly")', formData);

                        if (!res?.Success) {
                            this.showToast(res?.Message || 'Update failed.', true);
                            return;
                        }

                        this.showToast('Update Winner Successfully.');
                        this.fileInput.value = '';
                        this.selectedCertificateFile = null;
                        await this.fetchAwardData();
                    } catch (err) {
                        console.error(err);
                        this.showToast('Update failed: network or server error.', true);
                    } finally {
                        this.updateBtn.disabled = false;
                    }
                });*@


                this.viewImageBtn.addEventListener("click", (e) => {
                    e.preventDefault();

                    if (!this.imageFileName) {
                        alert("No image available.");
                        return;
                    }

                    const url = `@Url.Action("DisplaytheImage", "FinalAssembly")?filename=${encodeURIComponent(this.imageFileName)}`;

                    window.open(url, "_blank");
                });
        }

        bindDeleteModalEvents() {
            document.getElementById('cancelDeleteBtn').addEventListener('click', () => this.closeDeleteModal());
            document.getElementById('confirmDeleteBtn').addEventListener('click', () => this.handleDelete());
        }

        populateFormForEdit(row) {

            this.editIndexInput.value = row.dataset.ncrId;
            this.regNoInput.value = row.dataset.regNo;
            this.modelInput.value = row.dataset.model;
            this.processSelect.value = row.dataset.processId;
            this.fourMSelect.value = row.dataset.fourmId;
            this.ncrTypeSelect.value = row.dataset.ncrType;
            this.lineSelect.value = row.dataset.line;
            this.GroupID.value = row.dataset.group;

            this.formTitle.textContent = 'Edit Record';
            this.submitBtn.innerHTML = '<i class="fas fa-check"></i> Update Record';
            this.cancelBtn.style.display = '';

            document.getElementById('formCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // ─────────────────────────────────────────────
        // Upload Images table — Edit / Delete / View
        // ─────────────────────────────────────────────
        bindUploadTableEvents() {
            if (!this.uploadtbody) return;

            this.uploadtbody.addEventListener('click', (e) => {
                const editBtn = e.target.closest('.btn-edit');
                const deleteBtn = e.target.closest('.btn-delete');
                const viewBtn = e.target.closest('.btn-row-view');

                if (editBtn) {
                    const row = editBtn.closest('tr');
                    this.populateUploadFormForEdit(row);
                } else if (deleteBtn) {
                    console.log("assdsd");
                    const row = deleteBtn.closest('tr');
                    console.log("ID " + row.dataset.awardId);
                    this.openDeleteModal(row.dataset.awardId, 'award');
                } else if (viewBtn) {
                    const row = viewBtn.closest('tr');
                    this.viewImage(row.dataset.image);
                }
            });

            this.uploadCancelBtn.addEventListener('click', () => this.resetUploadForm());
        }

        populateUploadFormForEdit(row) {
            this.editAwardIndexInput.value = row.dataset.awardId;
            this.employeeIDInput.value = row.dataset.employeeId || '';
            this.nameInput.value = row.dataset.winnerName || '';
            this.lineTextInput.value = row.dataset.line || '';
            this.defectTextInput.value = row.dataset.defect || '';
            this.isDisplayedInput.checked = row.dataset.isDisplayed === '1';


            this.imageFileName = row.dataset.image || '';
            this.selectedCertificateFile = null;
            this.fileInput.value = '';

            this.uploadFormTitle.textContent = 'Edit Uploaded Image';
            this.updateBtn.textContent = 'Update Record';
            this.uploadCancelBtn.style.display = '';
            this.updateMonthlyWinnerCountUI();


            this.uploadForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        resetUploadForm() {
            this.uploadForm.reset();
            this.editAwardIndexInput.value = -1;
            this.selectedCertificateFile = null;
            this.imageFileName = '';

            this.uploadFormTitle.textContent = 'Upload Images';
            this.updateBtn.textContent = 'Save Database';
            this.uploadCancelBtn.style.display = 'none';

            this.updateMonthlyWinnerCountUI();
        }

        updateMonthlyWinnerCountUI() {
            if (!this.monthlyWinnerCountEl) return;

            const atLimit = this.currentMonthAwardCount >= this.MAX_WINNERS_PER_MONTH;
            const isEditing = parseInt(this.editAwardIndexInput?.value, 10) > 0;

            this.monthlyWinnerCountEl.textContent =
                `${this.currentMonthAwardCount} / ${this.MAX_WINNERS_PER_MONTH} winners added this month`;
            this.monthlyWinnerCountEl.style.color = atLimit ? '#dc2626' : '#64748b';

            // Only block new adds — editing an existing winner is still allowed at the limit.
            this.updateBtn.disabled = atLimit && !isEditing;
        }

        countWinnersThisMonth(data) {
            if (!Array.isArray(data)) return 0;

            const now = new Date();
            const editingAwardId = parseInt(this.editAwardIndexInput?.value, 10) || -1;

            return data.filter(row => {
                // an award currently being edited shouldn't block itself
                if (editingAwardId > 0 && parseInt(row.AwardID, 10) === editingAwardId) return false;

                const raw = row.CreatedDate ?? row.UpdatedDate ?? row.ModifiedDate;
                if (!raw) return true; // no date to check — count it to be safe

                const d = new Date(raw);
                if (isNaN(d)) return true;

                return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
            }).length;
        }


        openDeleteModal(id, type = 'ncr') {
            this.pendingDeleteId = id;
            this.pendingDeleteType = type;


            this.deleteModalText.textContent = type === 'award'
                ? 'Delete this uploaded image record? This cannot be undone.'
                : 'Delete this NCR record? This cannot be undone.';

            this.deleteModal.style.display = 'flex';
        }

        viewImage(filename) {
            if (!filename) {
                alert('No image available.');
                return;
            }

            const url = `@Url.Action("DisplaytheImage", "FinalAssembly")?filename=${encodeURIComponent(filename)}`;
            window.open(url, '_blank');
        }

        closeDeleteModal() {
            this.pendingDeleteId = null;
            this.pendingDeleteType = null;
            this.deleteModal.style.display = 'none';
        }

        resetForm() {
            this.form.reset();
            this.editIndexInput.value = -1;
            this.formTitle.textContent = 'Add New Record';
            this.submitBtn.innerHTML = '<i class="fas fa-plus"></i> Add Record';
            this.cancelBtn.style.display = 'none';
        }

        async handleSubmit(e) {
            e.preventDefault();

            //if (!this.form.reportValidity()) return;

            const ncrId = parseInt(this.editIndexInput.value, 10);
            const payload = {
                NCRID: ncrId > 0 ? ncrId : 0,
                RegistrationNo: this.regNoInput.value.trim(),
                ModelShopOrder: this.modelInput.value.trim(),
                ProcessID: parseInt(this.processSelect.value, 10),
                FourMID: parseInt(this.fourMSelect.value, 10),
                NCRTypeID: parseInt(this.ncrTypeSelect.value, 10),
                OriginID: this.lineSelect.value,
                GroupID : this.GroupID.value
            };

               this.submitBtn.disabled = true;
                try {
                    const res = await postMethod('@Url.Action("SaveRegistration", "FinalAssembly")', payload);
                    console.log(res);
                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Save failed.', true);
                        return;
                    }

                    this.showToast(payload.NCRID > 0 ? 'Record updated.' : 'Record added.');
                    this.resetForm();
                    await this.GetRegistrationData();
                } catch (error) {
                    console.error('Error saving record:', error);
                    this.showToast('Save failed.', true);
                } finally {
                    this.submitBtn.disabled = false;
                }
         }

        //openDeleteModal(ncrId) {
        //    this.pendingDeleteId = ncrId;
        //    this.deleteModal.style.display = 'flex';
        //}

        closeDeleteModal() {
            this.pendingDeleteId = null;
            this.deleteModal.style.display = 'none';
        }

        async handleDelete() {
            if (!this.pendingDeleteId) return;

            const isAward = this.pendingDeleteType === 'award';
            console.log(isAward);
            try {

                const res = await postMethod(
                    isAward
                        ? '@Url.Action("DeleteAwardsData", "FinalAssembly")'
                        : '@Url.Action("deleteRegistration", "FinalAssembly")',
                    isAward
                        ? { AwardID: this.pendingDeleteId }
                        : { NCRID: this.pendingDeleteId }
                );

                if (!res?.Success) {
                    this.showToast(res?.Message || 'Delete failed.', true);
                    return;
                }

                this.showToast('Record deleted.');

                if (isAward) {
                    // If the deleted row was mid-edit, drop back to the default upload form.
                    if (parseInt(this.editAwardIndexInput.value, 10) === parseInt(this.pendingDeleteId, 10)) {
                        this.resetUploadForm();
                    }
                    await this.fetchAwardData();
                } else {
                    // If the deleted row was mid-edit, drop back to Add mode.
                    if (parseInt(this.editIndexInput.value, 10) === parseInt(this.pendingDeleteId, 10)) {
                        this.resetForm();
                    }
                    await this.GetRegistrationData();
                }
            } catch (error) {
                console.error('Error deleting record:', error);
                this.showToast('Delete failed.', true);
            } finally {
                this.closeDeleteModal();
            }
        }

        forceUpperCase(e) {
            const input = e.target;
            const { selectionStart: start, selectionEnd: end } = input;
            input.value = input.value.toUpperCase();
            input.setSelectionRange(start, end);
        }

        showToast(message, isError = false) {
            this.toastMessage.textContent = message;
            this.toast.classList.toggle('toast-error', isError);
            this.toast.classList.add('show');
            clearTimeout(this._toastTimer);
            this._toastTimer = setTimeout(() => this.toast.classList.remove('show'), 3000);
        }
    }


    document.addEventListener('DOMContentLoaded', function () {
        const controller = new RegistrationFinalController();
        controller.init();
    });
    </script>

</body>
</html>
