                        <tr><td class="px-3 py-2 text-left">6mm Compound Application</td><td>4%</td><td>85%</td><td>46</td><td>49</td><td>57</td><td>48</td><td>56</td><td>55</td><td>60</td><td>63</td><td>66</td><td>66</td></tr>
                        <tr><td class="px-3 py-2 text-left">8mm Compound Application</td><td>0.5%</td><td>85%</td><td>36</td><td>56</td><td>72</td><td>59</td><td>61</td><td>74</td><td>76</td><td>81</td><td>81</td><td>86</td></tr>
                    </tbody>
                    <tfoot class="bg-slate-100 font-bold text-slate-900">
                        <tr>
                            <td class="px-3 py-2 text-left">TOTAL</td>
                            <td>100%</td>
                            <td>85%</td>
                            <td>44</td>
                            <td>50</td>
                            <td>60</td>
                            <td>52</td>
                            <td>56</td>
                            <td>61</td>
                            <td>64</td>
