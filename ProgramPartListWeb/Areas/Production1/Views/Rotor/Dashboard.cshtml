@{
    ViewBag.Title = "Performance Dashboard";
    Layout = "~/Areas/Production1/Views/Shared/_EfficiencyLayout.cshtml";
}

<div class="flex flex-wrap items-end gap-3 bg-white border border-slate-300 rounded-md p-4">
    <div>
        <label class="block text-xs text-slate-600 mb-1">Period</label>
        <select id="filterType" class="border border-slate-300 rounded px-3 py-2 text-sm">
            <option value="Today">Today</option>
            <option value="ThisWeek">This Week</option>
            <option value="ThisMonth">This Month</option>
            <option value="Custom">Custom Range</option>
        </select>
    </div>
    <div id="customRange" class="hidden flex gap-3">
        <div>
            <label class="block text-xs text-slate-600 mb-1">From</label>
            <input type="date" id="customFrom" class="border border-slate-300 rounded px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-xs text-slate-600 mb-1">To</label>
            <input type="date" id="customTo" class="border border-slate-300 rounded px-3 py-2 text-sm" />
        </div>
    </div>
</div>

<main class="flex-1 px-6 py-6 space-y-6 bg-slate-50/40">

    <!-- ===== HEADER ===== -->
    <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 pb-4 border-b border-slate-300">
        <div class="flex items-center gap-4">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">DYNAMIC BALANCE</h1>
            <span class="h-8 w-px bg-slate-300"></span>
            <h2 class="text-2xl font-light tracking-wide text-slate-700">PERFORMANCE DASHBOARD</h2>
        </div>
        <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <span>Manpower</span><span>&bull;</span>
            <span>Efficiency</span><span>&bull;</span>
            <span>Weekly Trend</span><span>&bull;</span>
            <span>Monthly Summary</span>
        </nav>
    </header>

    <!-- ===== MAIN GRID ===== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- ===== LEFT: MANPOWER STATUS (cols 1-5) ===== -->
        <section class="lg:col-span-5 space-y-4">
            <h3 class="text-lg font-bold text-slate-900 uppercase">1. Manpower Status</h3>

            <div>
                <h4 class="text-sm font-semibold text-slate-700 mb-2">A. Manpower Overview</h4>
