<script type="module">
       import {
           getMethod,
           postMethod,
           formatDate
       } from '@Url.Content("~/Scripts/modules/index.js")';


       class DashboardEfficiencyController {
           constructor() {
               this.filterType = document.getElementById('filterType');
               this.customWrap = document.getElementById('customRange');

               this.customFrom = document.getElementById('customFrom');
               this.customTo = document.getElementById('customTo');
               this.manpowerBody = document.getElementById('manpowerBody');
               this.manpowerFoot = document.getElementById('manpowerFoot');

               this.kpi = {
                   total: document.getElementById('kpiTotal'),
                   remaining: document.getElementById('kpiRemaining'),
                   improved: document.getElementById('kpiImproved'),
                   rate: document.getElementById('kpiRate')
               };
           }

           async init() {
               this.filterType.addEventListener('change', () => {
                   this.toggleCustom();
                   if (this.filterType.value !== 'Custom') this.load();
               });

               this.customFrom.addEventListener('change', () => this.onCustomChange());
               this.customTo.addEventListener('change', () => this.onCustomChange());

               this.toggleCustom();
               this.load();
               this.loadEffiencyWeekly();
           }

           toggleCustom() {
               this.customWrap.classList.toggle('hidden', this.filterType.value !== 'Custom');
           }

           onCustomChange() {
               if (this.customFrom.value && this.customTo.value) this.load();
           }

           // ───────────────────────── READ ─────────────────────────
           async load() {
               const params = { filter: this.filterType.value };

               if (this.filterType.value === 'Custom') {
                   if (!this.customFrom.value || !this.customTo.value) return;
                   params.from = this.customFrom.value;
                   params.to = this.customTo.value;
               }

               console.log(params);
                try {
                    const res = await getMethod('@Url.Action("GetEfficiencySummary", "Rotor")', params);

                    console.log(res);
                    if (!res?.Success) {
                        this.showError(res?.Message || 'Failed to load efficiency summary.');
                        return;
                    }
                    this.render(res.data || []);
                } catch (error) {
                    console.error('Error fetching efficiency records:', error);
                    this.showToast('Failed to load records.', false);
                }
           }



            async loadEffiencyWeekly() {

                const params = {
                    filter: this.filterType.value
                };

                // Custom date range
                if (this.filterType.value === 'Custom') {

                    if (!this.customFrom.value || !this.customTo.value) {
                        this.showError('Please select both start and end dates.');
                        return;
                    }

                    if (this.customFrom.value > this.customTo.value) {
                        this.showError('Start date cannot be greater than end date.');
                        return;
                    }

                    params.from = this.customFrom.value;
                    params.to = this.customTo.value;
                }

                console.log('Efficiency Weekly Parameters:', params);

                try {

                    const res = await getMethod(
                        '@Url.Action("GetEfficiencyWeeklySummary", "Rotor")',
                        params
                    );
                    console.log(res);
                    //console.log('Efficiency Weekly Response:', res);

                    //if (!res?.Success) {
                    //    this.showError(
                    //        res?.Message || 'Failed to load efficiency summary.'
                    //    );
                    //    return;
                    //}

                    //Response contains dynamic columns and process data
                    //const result = res.data;

                    //if (!result?.data || result.data.length === 0) {
                    //    this.showError('No efficiency records found.');
                    //    return;
                    //}

                    //this.renderWeeksummary(result);

                } catch (error) {

                    console.error('Error fetching efficiency records:', error);

                    this.showToast('Failed to load records.', false);
                }
           }




           renderWeeksummary(data) {

               const header = document.getElementById('efficiencyHeader');
               const body = document.getElementById('efficiencyBody');

               header.innerHTML = '';
               body.innerHTML = '';

               // Fixed columns
               const fixedColumns = [
                   'Process',
                   'Remaining %',
                   'Target'
               ];

               fixedColumns.forEach(column => {
                   const th = document.createElement('th');
                   th.textContent = column;
                   th.className = 'px-3 py-3 text-center';
                   header.appendChild(th);
               });

               // Dynamic columns: Jan, Feb, Mar, Apr, W1, W2...
               data.columns.forEach(column => {
                   const th = document.createElement('th');
                   th.textContent = column;
                   th.className = 'px-3 py-3 text-center';
                   header.appendChild(th);
               });

               // Process records
               data.data.forEach(item => {

                   const tr = document.createElement('tr');

                   if (item.ProcessId === 99) {
                       tr.className = 'font-bold bg-slate-100';
                   } else {
                       tr.className = 'border-b hover:bg-slate-50';
                   }

                   const values = [
                       item.ProcessName,
                       `${item.RemainingPct}%`,
                       `${item.Target}%`
                   ];

                   values.forEach(value => {
                       const td = document.createElement('td');
                       td.textContent = value;
                       td.className = 'px-3 py-3 text-center';
                       tr.appendChild(td);
                   });

                   // Dynamic period values
                   data.columns.forEach(column => {

                       const td = document.createElement('td');

                       const value = item.PeriodValues?.[column] ?? 0;

                       td.textContent = Number(value).toLocaleString();

                       td.className = 'px-3 py-3 text-center tabular-nums';

                       tr.appendChild(td);
                   });

                   body.appendChild(tr);
               });
           }





           render(rows) {
               const total = rows.find(r => r.ProcessId === 99);
               const processes = rows.filter(r => r.ProcessId !== 99);

               this.manpowerBody.innerHTML = processes.map(r => `
                <tr>
                    <td class="px-3 py-2">${r.ProcessName}</td>
                    <td class="px-3 py-2 text-center">${r.Manpower}</td>
                    <td class="px-3 py-2 text-center">${r.Remaining}</td>
                    <td class="px-3 py-2 text-center">${r.Improved}</td>
                    <td class="px-3 py-2 text-center">${r.RatePct ?? 0}%</td>
                </tr>`).join('');

               if (total) {
                   this.manpowerFoot.innerHTML = `
                <tr>
                    <td class="px-3 py-2">TOTAL</td>
                    <td class="px-3 py-2 text-center">${total.Manpower}</td>
                    <td class="px-3 py-2 text-center">${total.Remaining}</td>
                    <td class="px-3 py-2 text-center">${total.Improved}</td>
                    <td class="px-3 py-2 text-center">${total.RatePct ?? 0}%</td>
                </tr>`;

                   this.kpi.total.textContent = total.Manpower;
                   this.kpi.remaining.textContent = total.Remaining;
                   this.kpi.improved.textContent = total.Improved;
                   this.kpi.rate.textContent = `${total.RatePct ?? 0}%`;
               }
           }


           showError(message) {
               this.manpowerBody.innerHTML = `
                <tr><td colspan="5" class="px-3 py-4 text-center text-red-600">${message}</td></tr>`;
               this.manpowerFoot.innerHTML = '';
           }
       }

      document.addEventListener('DOMContentLoaded', function() {
           const controller = new DashboardEfficiencyController();
           controller.init();
       });
</script>