                            <tr><td class="px-3 py-2">3mm Impeller Drilling</td><td class="px-3 py-2 text-center">80</td><td class="px-3 py-2 text-center">71</td><td class="px-3 py-2 text-center">22</td><td class="px-3 py-2 text-center">31%</td></tr>
                            <tr><td class="px-3 py-2">3mm Compound Application</td><td class="px-3 py-2 text-center">515</td><td class="px-3 py-2 text-center">387</td><td class="px-3 py-2 text-center">129</td><td class="px-3 py-2 text-center">33%</td></tr>
                            <tr><td class="px-3 py-2">5mm Compound Application</td><td class="px-3 py-2 text-center">17</td><td class="px-3 py-2 text-center">15</td><td class="px-3 py-2 text-center">4</td><td class="px-3 py-2 text-center">27%</td></tr>
                            <tr><td class="px-3 py-2">6mm Compound Application</td><td class="px-3 py-2 text-center">29</td><td class="px-3 py-2 text-center">23</td><td class="px-3 py-2 text-center">5</td><td class="px-3 py-2 text-center">22%</td></tr>
                            <tr><td class="px-3 py-2">8mm Compound Application</td><td class="px-3 py-2 text-center">3</td><td class="px-3 py-2 text-center">3</td><td class="px-3 py-2 text-center">1</td><td class="px-3 py-2 text-center">33%</td></tr>
