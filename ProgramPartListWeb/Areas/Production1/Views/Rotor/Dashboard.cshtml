                            <circle cx="373.3" cy="37.6" r="3.5" />
                            <circle cx="440" cy="31.3" r="3.5" />
                        </g>
                        <!-- value labels -->
                        <g font-size="11" fill="#1e293b" text-anchor="middle">
                            <text x="40" y="62">52%</text>
                            <text x="106.7" y="53">56%</text>
                            <text x="173.3" y="43">61%</text>
                            <text x="240" y="37">64%</text>
                            <text x="306.7" y="33">66%</text>
                            <text x="373.3" y="30">67%</text>
