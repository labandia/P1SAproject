                    <div class="bg-white border border-slate-300 rounded-md p-4 text-center">
                        <p class="text-xs text-slate-600">Remaining Manpower</p>
                        <p class="mt-2 text-3xl font-bold text-slate-900">652</p>
                    </div>
                    <div class="bg-white border border-slate-300 rounded-md p-4 text-center">
                        <p class="text-xs text-slate-600">Improved Count</p>
                        <p class="mt-2 text-3xl font-bold text-slate-900">205</p>
                    </div>
                    <div class="bg-white border border-slate-300 rounded-md p-4 text-center">
                        <p class="text-xs text-slate-600">Overall Rate</p>
                        <p class="mt-2 text-3xl font-bold text-slate-900">31%</p>
