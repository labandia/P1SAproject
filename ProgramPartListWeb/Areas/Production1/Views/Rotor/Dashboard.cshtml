                            <text x="40" y="200">W1</text>
                            <text x="106.7" y="200">W2</text>
                            <text x="173.3" y="200">W3</text>
                            <text x="240" y="200">W4</text>
                            <text x="306.7" y="200">W5</text>
                            <text x="373.3" y="200">W6</text>
                            <text x="440" y="200">W7</text>
                        </g>
