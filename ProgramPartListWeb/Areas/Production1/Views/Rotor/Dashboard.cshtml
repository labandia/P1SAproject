    <!-- ===== FOOTER ===== -->
    <footer class="flex flex-col sm:flex-row sm:justify-between gap-2 pt-4 border-t border-slate-300 text-xs text-slate-500">
        <span>Prepared by: DYNAMIC BALANCE Production Monitoring</span>
        <span>Updated: 27 October 2026</span>
    </footer>

</main>


<script type="module">
       import {
           getMethod,
           postMethod,
           formatDate
       } from '@Url.Content("~/Scripts/modules/index.js")';


       class DashboardEfficiencyController {
           constructor() {
               this.filterType = document.getElementById('filterType');
               this.customWrap = document.getElementById('customRange');

               this.customFrom = document.getElementById('customFrom');
               this.customTo = document.getElementById('customTo');
           }

           async init() {
               this.filterType.addEventListener('change', () => {
                   this.toggleCustom();
                   console.log(this.filterType.value);
                   // if (this.filterType.value !== 'Custom') this.load();
               });
           }

           toggleCustom() {
               this.customWrap.classList.toggle('hidden', this.filterType.value !== 'Custom');
           }

           onCustomChange() {
               if (this.customFrom.value && this.customTo.value) this.load();
           }

           // ───────────────────────── READ ─────────────────────────
           async GetSummaryManpowerList() {
               const params = { filter: this.filterType.value };
               console.log(params);
                @*try {
                    const res = await getMethod('@Url.Action("GetSummaryManpower", "Rotor")', {
                        from: this.searchFrom.value,
                        to: this.searchTo.value
                    });

                    console.log(res);

                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Failed to load records.', false);
                        return;
                    }
                    this.rows = res.data || [];
                    this.renderTable();
                } catch (error) {
                    console.error('Error fetching efficiency records:', error);
                    this.showToast('Failed to load records.', false);
                }*@
           }


           showError(message) {
               this.manpowerBody.innerHTML = `
                <tr><td colspan="5" class="px-3 py-4 text-center text-red-600">${message}</td></tr>`;
               this.manpowerFoot.innerHTML = '';
           }
       }

      document.addEventListener('DOMContentLoaded', function() {
           const controller = new DashboardEfficiencyController();
           controller.init();
       });
</script>