                        <tr><td class="px-3 py-2 text-left">3mm Compound Application</td><td>59%</td><td>85%</td><td>36</td><td>37</td><td>44</td><td>40</td><td>41</td><td>46</td><td>48</td><td>50</td><td>48</td><td>51</td></tr>
