           bindDataMenu() {
               const modal = byId('dataMenuModal');
               const openBtn = byId('dataMenuBtn');

               if (!modal || !openBtn) return;

               const closeBtn = byId('closeDataModal');
               const previousFocus = () => openBtn.focus();

               const openModal = () => {
                   modal.classList.add('show');
                   modal.setAttribute('aria-hidden', 'false');

                   document.body.style.overflow = 'hidden';

                   if (closeBtn) closeBtn.focus();
               };

               const closeModal = () => {
                   modal.classList.remove('show');
                   modal.setAttribute('aria-hidden', 'true');

                   document.body.style.overflow = '';

                   previousFocus();
               };

               openBtn.addEventListener('click', openModal);

               if (closeBtn) {
                   closeBtn.addEventListener('click', closeModal);
               }



               // Close when clicking outside the workspace.
               modal.addEventListener('click', e => {
                   if (e.target === modal) {
                       closeModal();
                   }
               });

               // Close using Escape.
               document.addEventListener('keydown', e => {
                   if (
                       e.key === 'Escape' &&
                       modal.classList.contains('show')
                   ) {
                       closeModal();
                   }
               });

               // Sidebar navigation.
               const modules = modal.querySelectorAll('.dw-module');

               const panels = {
                   csv: byId('dwPanelCsv'),
                   cycle: byId('dwPanelCycle'),
                   records: byId('dwPanelRecords'),
                   shoporder: byId('dwPanelShoporder')
               };

               modules.forEach(button => {
                   button.addEventListener('click', () => {
                       const selected = button.dataset.workspace;

                       modules.forEach(item => {
                           item.classList.toggle('active', item === button);
                       });

                       Object.keys(panels).forEach(key => {
                           if (panels[key]) {
                               panels[key].classList.toggle(
                                   'active',
                                   key === selected
                               );
                           }
                       });
                   });
               });

               // Export using the existing controller method.
               const exportBtn = byId('exportEfficiencyCsv');

               if (exportBtn) {
                   exportBtn.addEventListener('click', () => {
                       this.exportCSV();
                   });
               }

               // CSV import: connect to the existing CSV controls.
               const importBtn = byId('openCsvUpload');

               if (importBtn) {
                   importBtn.addEventListener('click', () => {
                       closeModal();

                       const csvFile = byId('csvFile');

