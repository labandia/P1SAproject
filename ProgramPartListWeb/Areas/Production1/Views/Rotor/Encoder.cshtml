                               'Add the CSV upload controls to enable importing.',
                               false
                           );
                       }
                   });
               }

               // Open the existing Cycle Time Master modal.
               const openCycleTime = () => {
                   closeModal();

                   if (typeof this.openCycleModal === 'function') {
                       this.openCycleModal();
                   } else {
                       this.showToast(
