           // Reusable searchable select. Items: { value, text, sub?, data? }. The search matches text and sub.
           createCombo(inputId, {
               getItems,
               remote,
               onSelect,
               onClear,
               normalize,
               selectFirstOnEnter = false,
               emptyText = 'No match',
               invalidMsg = 'Select a value from the list.'
           }) {
               const input = byId(inputId);

               if (!input) {
                   console.error(`Combo input not found: ${inputId}`);
                   return;
               }

               const combo = input.closest('.combo');
               const list = combo?.querySelector('.combo-list');

               if (!combo || !list) {
                   console.error(`Combo container or list not found: ${inputId}`);
                   return;
               }

               const MAX = 100;

               let shown = [];
               let active = -1;
               let selected = null;
               let cache = [];
               let timer = null;

               // Render the matching items
               const render = () => {
                   const q = input.value.trim().toLowerCase();

                   const items = remote
                       ? cache
                       : (getItems ? getItems() : []).filter(i =>
                           `${i.text} ${i.sub ?? ''}`.toLowerCase().includes(q)
                       );

                   shown = items.slice(0, MAX);

                   list.innerHTML = shown.length
                       ? shown.map((item, index) => `
                <li role="option" data-n="${index}">
                    ${this.esc(item.text)}
                    ${item.sub ? `<small>${this.esc(item.sub)}</small>` : ''}
                </li>
            `).join('')
                       : `<li class="empty">${this.esc(emptyText)}</li>`;

                   active = shown.length ? 0 : -1;

                   highlight();
               };

               // Highlight selected dropdown item
               const highlight = () => {
                   const elements = [...list.querySelectorAll('li[data-n]')];

                   elements.forEach((el, index) => {
                       el.classList.toggle('active', index === active);
                   });

                   if (active >= 0) {
                       elements[active]?.scrollIntoView({
                           block: 'nearest'
                       });
                   }
               };

               const open = () => {
                   if (remote) {
                       render();
                   } else {
                       render();
                   }

                   combo.classList.add('open');
               };

               const close = () => {
                   combo.classList.remove('open');
               };

               // Select an item
               const choose = item => {
                   if (!item) return;

                   selected = item;

                   input.value = item.value;

                   close();

                   onSelect?.(item, true);
               };

               // Find an exact matching item first
               const findExact = (value, items) => {
                   const search = String(value ?? '').trim().toLowerCase();

                   return items.find(item =>
                       String(item.value ?? '').trim().toLowerCase() === search ||
                       String(item.text ?? '').trim().toLowerCase() === search
                   );
               };

               // Focus opens dropdown
               input.addEventListener('focus', () => {
                   open();
               });

               // Search while typing
               input.addEventListener('input', () => {
                   selected = null;

                   onClear?.();

                   combo.classList.add('open');

                   if (!remote) {
                       render();
                       return;
                   }

                   clearTimeout(timer);

                   timer = setTimeout(async () => {
                       const q = input.value.trim();

                       try {
                           const items = await remote(q);

                           // Ignore old search results
                           if (q !== input.value.trim()) return;

                           cache = items || [];

                           render();
                       } catch (error) {
                           console.error(`Combo search error: ${inputId}`, error);
                           cache = [];
                           render();
                       }
                   }, 250);
               });

               // Validate manually typed values when leaving the field
               input.addEventListener('blur', async () => {
                   close();

                   if (selected && selected.value === input.value) {
                       return;
                   }

                   const value = input.value.trim();

                   if (!value) {
                       selected = null;
                       onClear?.();
                       return;
                   }

                   try {
                       const searchValue = normalize
                           ? normalize(value)
                           : value;

                       const pool = remote
                           ? await remote(searchValue)
                           : (getItems ? getItems() : []);

                       const hit = findExact(searchValue, pool || []);

                       if (hit) {
                           selected = hit;
                           input.value = hit.value;
                           onSelect?.(hit, false);
                           return;
                       }

                       this.showToast(invalidMsg, false);

                       input.value = '';
                       selected = null;

                       onClear?.();

                   } catch (error) {
                       console.error(`Combo validation error: ${inputId}`, error);
                   }
               });

               // Keyboard navigation
               input.addEventListener('keydown', e => {

                   if (e.key === 'ArrowDown') {
                       e.preventDefault();

                       if (!combo.classList.contains('open')) {
                           open();
                       }

                       if (shown.length) {
                           active = Math.min(active + 1, shown.length - 1);
                           highlight();
                       }

                       return;
                   }

                   if (e.key === 'ArrowUp') {
                       e.preventDefault();

                       if (shown.length) {
                           active = Math.max(active - 1, 0);
                           highlight();
                       }

                       return;
                   }

                   if (e.key === 'Enter') {
                       e.preventDefault();

                       if (!combo.classList.contains('open')) {
                           open();
                       }

                       // Already selected: move to next field
                       if (selected && selected.value === input.value) {
                           this.focusNext(input);
                           return;
                       }

                       const value = input.value.trim();

                       // Try exact match first
                       let hit = findExact(value, shown);

                       // If there is no exact match, use the highlighted item
                       if (!hit && shown.length) {
                           if (!value && !selectFirstOnEnter) {
                               return;
                           }

                           hit = shown[active >= 0 ? active : 0];
                       }

                       if (hit) {
                           choose(hit);
                           this.focusNext(input);
                       }

                       return;
                   }

                   if (e.key === 'Escape') {
                       close();
                   }
               });

               // Mouse and touch selection
               list.addEventListener('pointerdown', e => {
                   const li = e.target.closest('li[data-n]');

                   if (!li) return;

                   e.preventDefault();

                   const item = shown[parseInt(li.dataset.n, 10)];

                   choose(item);
               });
           }

           // ───────────────────────── CSV UPLOAD (panel not on page yet) ─────────────────────────
           parseCSV() {
               const file = byId('csvFile').files[0];
               if (!file) { this.showToast('Choose a CSV file first.', false); return; }

               const reader = new FileReader();
               reader.onload = ev => {
                   const text = ev.target.result.replace(/^\uFEFF/, ''); // strip BOM
                   const lines = text.split(/\r?\n/).filter(l => l.trim());
                   if (lines.length < 2) { this.showToast('CSV is empty.', false); return; }

                   const headers = this.splitCSVLine(lines[0]).map(h => h.trim().toLowerCase());
                   const idx = (name) => headers.findIndex(h => h.includes(name));

                   const map = {
                       date: idx('date'),
                       shift: idx('shift'),
                       mc: idx('mc') >= 0 ? idx('mc') : idx('machine'),
                       shop: idx('shop'),
                       model: idx('model'),
                       process: idx('process'),
                       effy: idx('effy'),
                       output: idx('output'),
                       dt: idx('dt') >= 0 ? idx('dt') : idx('downtime'),
                       start: idx('start'),
                       end: idx('end')
                   };

                   const processMap = { 'COVER DRILLING': 1, 'IMPELLER': 2, 'EPIFORM': 3 };

                   this.csvRows = lines.slice(1).map((line, i) => {
                       const c = this.splitCSVLine(line);
                       const procName = String(c[map.process] ?? '').trim().toUpperCase();
                       const procId = processMap[procName] || parseInt(procName, 10) || 0;
                       const shiftRaw = String(c[map.shift] ?? '').trim().toUpperCase();

                       const row = {
                           __row: i + 2,
                           __error: null,
                           Shift: shiftRaw.startsWith('N'),
                           MachineNo: String(c[map.mc] ?? '').trim(),
                           ShopOrder: String(c[map.shop] ?? '').trim(),
                           EffyCode: String(c[map.effy] ?? '').trim(),
                           getModel: String(c[map.model] ?? '').trim(),
                           Output: parseInt(c[map.output], 10) || 0,
                           DowntimeMin: parseInt(c[map.dt], 10) || 0,
                           StartOpe: String(c[map.start] ?? '').trim(),
                           EndOpe: String(c[map.end] ?? '').trim(),
                           WorkDate: this.normalizeDate(String(c[map.date] ?? '').trim())
                       };

                       const errs = [];
                       if (!row.MachineNo) errs.push('MC.#');
                       if (!row.EffyCode) errs.push('Effy Code');
                       if (!row.WorkDate) errs.push('Date');
                       if (!row.StartOpe) errs.push('Start');
                       if (!row.EndOpe) errs.push('End');
                       if (errs.length) row.__error = 'Missing: ' + errs.join(', ');

                       return row;
                   });

                   this.renderCSVPreview();
                   byId('csvUploadBtn').disabled = this.csvRows.filter(r => !r.__error).length === 0;
                   this.showToast(`Parsed ${this.csvRows.length} row(s).`, true);
               };
               reader.readAsText(file);
           }

           // Handles quoted CSV fields ("a,b","c")
           splitCSVLine(line) {
               const out = []; let cur = ''; let q = false;
               for (let i = 0; i < line.length; i++) {
                   const ch = line[i];
                   if (q) {
                       if (ch === '"' && line[i + 1] === '"') { cur += '"'; i++; }
                       else if (ch === '"') { q = false; }
                       else cur += ch;
                   } else {
                       if (ch === '"') q = true;
                       else if (ch === ',') { out.push(cur); cur = ''; }
                       else cur += ch;
                   }
               }
               out.push(cur);
               return out;
           }

           normalizeDate(s) {
               if (!s) return '';
               if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10);                  // ISO
               let m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);                        // MM/DD/YYYY
               if (m) return `${m[3]}-${m[1].padStart(2, '0')}-${m[2].padStart(2, '0')}`;
               m = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/);                              // DD-MM-YYYY
               if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
               const d = new Date(s);
               if (!isNaN(d)) return d.toISOString().slice(0, 10);
               return '';
           }

           renderCSVPreview() {
               const body = byId('csvPreviewBody');
               if (!this.csvRows.length) {
                   body.innerHTML = '<tr><td colspan="13" class="empty">No rows parsed.</td></tr>';
                   byId('csvSummary').textContent = '';
                   return;
               }
               const procName = id => ({ 1: 'COVER DRILLING', 2: 'IMPELLER', 3: 'EPIFORM' }[id] || '—');

               body.innerHTML = this.csvRows.map(r => `
                   <tr style="${r.__error ? 'background:#fde8e8;' : ''}">
                       <td>${r.__row}</td>
                       <td>${this.esc(r.WorkDate)}</td>
                       <td>${r.Shift ? 'NS' : 'DS'}</td>
                       <td>${this.esc(r.MachineNo)}</td>
                       <td>${this.esc(r.ShopOrder)}</td>
                       <td>${this.esc(r.getModel)}</td>
                       <td>${this.esc(r.EffyCode)}</td>
                       <td class="num">${r.Output}</td>
                       <td class="num">${r.DowntimeMin}</td>
                       <td>${this.esc(r.StartOpe)}</td>
                       <td>${this.esc(r.EndOpe)}</td>
                       <td>${r.__error
                           ? `<span class="pill eff-low">${this.esc(r.__error)}</span>`
                           : `<span class="pill eff-good">OK</span>`}
                       </td>
                   </tr>
               `).join('');

               const good = this.csvRows.filter(r => !r.__error).length;
               byId('csvSummary').textContent = `${good} valid / ${this.csvRows.length} total rows.`;
           }

           clearCSV() {
               this.csvRows = [];
               byId('csvFile').value = '';
               byId('csvUploadBtn').disabled = true;
               byId('csvPreviewBody').innerHTML = '<tr><td colspan="13" class="empty">Choose a CSV file and click Preview.</td></tr>';
               byId('csvSummary').textContent = '';
           }

           async uploadCSV() {
               const rows = this.csvRows.filter(r => !r.__error);
               if (!rows.length) { this.showToast('No valid rows to upload.', false); return; }

               const btn = byId('csvUploadBtn');
               btn.disabled = true;
               try {
                   const res = await postMethod('@Url.Action("UploadEfficiencyCsv", "Rotor")', { rows });
                   if (!res?.Success) {
                       this.showToast(res?.Message || 'Upload failed.', false);
                       return;
                   }
                   this.showToast(`Uploaded ${res.Inserted ?? rows.length} row(s).`, true);
                   this.clearCSV();
                   await this.GetEfficiencyList();
               } catch (error) {
                   console.error('Upload error:', error);
                   this.showToast('Upload failed.', false);
               } finally {
                   btn.disabled = false;
               }
           }

           // ───────────────────────── CYCLE TIME CRUD (panel not on page yet) ─────────────────────────
           async loadCycleTimes() {
               try {
                   const res = await getMethod('@Url.Action("GetCycleTimeList", "Rotor")');
                   this.cycleRows = res?.Success ? (res.data || []) : [];
                   this.renderCycleTable();
                   await this.loadModels();   // refresh the combobox cache so the encoder picks up edits
               } catch (error) {
                   console.error('Error loading cycle times:', error);
                   this.cycleRows = [];
                   this.renderCycleTable();
               }
           }

           renderCycleTable() {
               const q = (byId('ctSearch').value || '').toLowerCase();
               const pf = byId('ctProcessFilter').value;
               const procName = id => ({ 1: 'COVER DRILLING', 2: 'IMPELLER', 3: 'EPIFORM' }[id] || `#${id}`);

               const list = this.cycleRows.filter(r =>
                   (!pf || String(r.ProcessId) === pf) &&
                   (!q || [r.Model, r.Partnumber].some(v => String(v ?? '').toLowerCase().includes(q)))
               );

               byId('ctBody').innerHTML = list.map(r => `
                   <tr>
                       <td>${this.esc(procName(r.ProcessId))}</td>
                       <td>${this.esc(r.Model)}</td>
                       <td>${this.esc(r.Partnumber)}</td>
                       <td class="num">${this.esc(r.CycleTimeSec)}</td>
                       <td class="num">${r.EasedCycleTimeSec ?? '—'}</td>
                       <td style="text-align:center;">
                           <button class="btn-icon ct-edit" data-id="${r.CycleTimeId}" title="Edit">✏️</button>
                           <button class="btn-icon ct-delete" data-id="${r.CycleTimeId}" title="Delete">🗑️</button>
                       </td>
                   </tr>
               `).join('') || '<tr><td colspan="6" class="empty">No cycle time records.</td></tr>';
           }

           onCycleTableClick(e) {
               const edit = e.target.closest('.ct-edit');
               const del = e.target.closest('.ct-delete');
               if (edit) this.openCycleModal(parseInt(edit.dataset.id, 10));
               if (del) this.deleteCycleTime(parseInt(del.dataset.id, 10));
           }

           openCycleModal(id = 0) {
               const r = id ? this.cycleRows.find(x => x.CycleTimeId === id) : null;
               byId('ctId').value = id || 0;
               byId('ctProcessId').value = r?.ProcessId ?? 1;
               byId('ctModel').value = r?.Model ?? '';
               byId('ctPartnumber').value = r?.Partnumber ?? '';
               byId('ctCycleSec').value = r?.CycleTimeSec ?? '';
               byId('ctEasedSec').value = r?.EasedCycleTimeSec ?? '';
               byId('ctModalTitle').textContent = id ? `Edit Cycle Time #${id}` : 'New Cycle Time';
               byId('ctModal').style.display = 'block';
           }

           closeCycleModal() {
               byId('ctModal').style.display = 'none';
               byId('ctForm').reset();
               byId('ctId').value = 0;
           }

           async saveCycleTime(e) {
               e.preventDefault();
               const id = parseInt(byId('ctId').value, 10) || 0;

               const payload = {
                   CycleTimeId: id,
                   ProcessId: parseInt(byId('ctProcessId').value, 10),
                   Model: byId('ctModel').value.trim(),
                   Partnumber: byId('ctPartnumber').value.trim(),
                   CycleTimeSec: parseFloat(byId('ctCycleSec').value),
                   EasedCycleTimeSec: byId('ctEasedSec').value ? parseFloat(byId('ctEasedSec').value) : null
               };

               try {
                   const action = id
                       ? '@Url.Action("UpdateCycleTime", "Rotor")'
                       : '@Url.Action("AddCycleTime", "Rotor")';
                   const res = await postMethod(action, payload);
                   if (!res?.Success) { this.showToast(res?.Message || 'Save failed.', false); return; }

                   this.showToast(id ? 'Cycle time updated.' : 'Cycle time added.', true);
                   this.closeCycleModal();
                   await this.loadCycleTimes();
               } catch (error) {
                   console.error('Save cycle time error:', error);
                   this.showToast('Save failed.', false);
               }
           }

           async deleteCycleTime(id) {
               if (!confirm('Delete this cycle time entry?')) return;
               try {
                   const res = await postMethod('@Url.Action("DeleteCycleTime", "Rotor")', { id });
                   if (!res?.Success) { this.showToast(res?.Message || 'Delete failed.', false); return; }
                   this.showToast('Cycle time deleted.', true);
                   await this.loadCycleTimes();
               } catch (error) {
                   console.error('Delete cycle time error:', error);
                   this.showToast('Delete failed.', false);
               }
           }

           // Reads the label straight from the Process <select>, so it stays in sync with the HTML
           processName(id) {
               const process = this.processes.find(
                   x => String(x.ProcessId) === String(id)
               );

               return process ? process.ProcessName : '';
           }

           // Single place that applies a chosen model record to the form
           applyModel(m) {
               this.cycle = m ?? null;

               byId('model').value = m?.Model ?? '';
               byId('Partnumber').value = m?.Partnumber ?? '';

               // Automatically set Process Name and Process ID
               if (m && m.ProcessId != null) {

                   const process = this.processes.find(
                       p => String(this.procId(p)) === String(m.ProcessId)
                   );

                   byId('ProcessName').value = process
                       ? this.procName(process)
                       : (m.ProcessName ?? '');

                   byId('ProcessId').value = parseInt(m.ProcessId, 10);

               } else {
                   byId('ProcessName').value = '';
                   byId('ProcessId').value = '';
               }

               this.calcForm();
           }
           // Moves focus to the next editable field. Returns false when there is none (last field).
           focusNext(current) {
               const fields = [...this.form.querySelectorAll('input, select')]
                   .filter(el => el.type !== 'hidden' && !el.readOnly && !el.disabled && el.offsetParent !== null);

               const next = fields[fields.indexOf(current) + 1];
               if (!next) return false;

               next.focus();
               if (next.tagName === 'INPUT' && next.select) {
                   try { next.select(); } catch { /* date/time inputs don't support select() */ }
               }
               return true;
           }

           // "930" -> "09:30", "9" -> "09:00", "1945" -> "19:45". Returns null if invalid, '' if empty.
           normalizeTime(raw) {
               const d = String(raw ?? '').replace(/\D/g, '').slice(0, 4);
               if (!d) return '';
               let h, m;
               if (d.length <= 2) { h = d; m = '00'; }
               else if (d.length === 3) { h = '0' + d[0]; m = d.slice(1); }
               else { h = d.slice(0, 2); m = d.slice(2); }
               if (+h > 23 || +m > 59) return null;
               return `${h.padStart(2, '0')}:${m}`;
           }

           // Get Process Name using Process ID
           // processName(id) {
           //     const process = PROCESS_LIST.find(
           //         x => x.ProcessId === parseInt(id, 10)
           //     );

           //     return process ? process.ProcessName : '';
           // }
         
           // Get Process ID using Process Name
           getProcessId(name) {
               if (!name) return 0;

               const process = PROCESS_LIST.find(
                   x => x.ProcessName.toLowerCase() === name.trim().toLowerCase()
               );

               return process ? process.ProcessId : 0;
           }


           shiftBadge(isNight) {
               return isNight
                   ? `<span class="shift-badge night">${ICON_MOON}<span>NS</span></span>`
                   : `<span class="shift-badge day">${ICON_SUN}<span>DS</span></span>`;
           }

       }

       document.addEventListener('DOMContentLoaded', function () {
           const controller = new EfficiencyManageController();
           controller.init();
       });
</script>