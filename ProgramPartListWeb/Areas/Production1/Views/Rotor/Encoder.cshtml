@{
    Layout = "~/Areas/Production1/Views/Shared/_EfficiencyLayout.cshtml";
}

<!-- ========== MAIN LAYOUT ========== -->
<main class="main-layout">

    <!-- ========== FORM PANEL (LEFT) ========== -->
    <aside class="form-panel" data-purpose="efficiency-entry-sidebar">
        <div class="form-header">
            <div class="form-header-top" style="display: flex; justify-content: space-between;">
                <h2 id="formTitle">Efficency Data  Entry</h2>

                <div class="calc-item" style="display: flex; justify-content: space-between;"><span class="calc-value" id="aShift">—</span></div>
            </div>
        </div>

        <form class="form-body" id="dataForm" autocomplete="off">
            <input type="hidden" id="editIndex" value="0">
            <div class="form-fields">

                <!-- Date | Machine -->
                <div class="field-row">
                    <div class="field"><label>Date <span class="req">*</span></label><input id="workDate" type="date" required></div>

                    
                    <div class="field">
                        <label>Machine No. <span class="req">*</span></label>
                        <div class="combo" id="machineCombo">
                            <input id="machineNo" placeholder="D-1 … D-200" autocomplete="off" required>
                            <ul class="combo-list" id="machineList" role="listbox"></ul>
                        </div>
                    </div>

                </div>

                <div class="field">
                    <label>Shop Order <span class="req">*</span></label>
                    <div class="combo">
                        <input id="shopOrder" placeholder="Enter shop order" autocomplete="off" required>
                        <ul class="combo-list" role="listbox"></ul>
                    </div>
                </div>



                <!-- Shop Order -->
                <div class="field-row">
                    <div class="field">
                        <label>Partnumber <span class="req">*</span></label>
                        <div class="combo">
                            <input id="Partnumber" placeholder="Search part number…" autocomplete="off" required>
                            <ul class="combo-list" role="listbox"></ul>
                        </div>
                    </div>

                    <div class="field">
                        <label>Model</label>
                        <input id="model" readonly placeholder="from part number">
                    </div>
                </div>

                <!-- Model | Process -->
                <div class="field">
                    <label>Process <span class="req">*</span></label>

                    <div class="combo">
                        <input id="ProcessName"
                               placeholder="Search process..."
                               autocomplete="off"
                               required>

                        <input type="hidden" id="ProcessId" />

                        <ul class="combo-list" role="listbox"></ul>
                    </div>
                </div>

                <!-- Employee code | name -->
                <div class="field-row">
                    <div class="field">
                        <label>Employee Code <span class="req">*</span></label>
                        <div class="combo">
                            <input id="employeeCode" placeholder="Effy code / name" autocomplete="off" required>
                            <ul class="combo-list" role="listbox"></ul>
                        </div>
                    </div>
                    <div class="field">
                        <label>Employee Name</label>
                        <input id="employeeName" readonly placeholder="from employee code">
                    </div>
                </div>

                <!-- Shift | Start | End -->
                <div class="field-row">
                    <div class="field">
                        <label>Start <span class="req">*</span></label>
                        <input id="startOpe" type="text" inputmode="numeric" maxlength="5"
                               placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                               title="24-hour time, e.g. 07:30 or 19:45" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label>End <span class="req">*</span></label>
                        <input id="endOpe" type="text" inputmode="numeric" maxlength="5"
                               placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                               title="24-hour time, e.g. 07:30 or 19:45" autocomplete="off" required>
                    </div>
                </div>

                <!-- Output | Downtime -->
                <div class="field-row">
                    <div class="field"><label>Output <span class="req">*</span></label><input id="output" type="number" min="0" step="1" required placeholder="0"></div>
                    <div class="field"><label>Downtime (min)</label><input id="downtimeMin" type="number" min="0" step="1" value="0"></div>
                </div>

                <!-- AUTO CALC SUMMARY -->
                <div class="calc-box">
                    <div class="calc-box-header">
                        <span>Auto-Calculated Summary</span>
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div class="calc-grid-3">
                        <div class="calc-item"><span class="calc-label">Span (min)</span><span class="calc-value" id="aSpan">—</span></div>
                        <div class="calc-item"><span class="calc-label">Work Hours</span><span class="calc-value" id="aHours">—</span></div>
                        <div class="calc-item"><span class="calc-label">Cycle Time</span><span class="calc-value blue" id="aCycle">—</span></div>
                    </div>
                    <br />
                    <div class="calc-grid-3">
                        <div class="calc-item"><span class="calc-label">Target</span><span class="calc-value" id="aTarget">—</span></div>
                        <div class="calc-item"><span class="calc-label">Target (Eased)</span><span class="calc-value" id="aTargetEased">—</span></div>
                        <div class="calc-item"><span class="calc-label">Efficiency</span><span class="calc-value emerald" id="aEff">—</span></div>
                    </div>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="submitBtn">Add Record</button>
                <button type="button" class="btn btn-outline-emerald" id="cancelBtn">Clear Form</button>
            </div>
        </form>
    </aside>

    <!-- ========== TABLE PANEL (RIGHT) ========== -->
    <section class="table-panel" data-purpose="records-view-panel">

        <!-- TOOLBAR -->
        <div class="table-toolbar">
            <div class="toolbar-item"><label>From</label><input id="searchFrom" type="date" class="mono"></div>
            <div class="toolbar-item"><label>To</label><input id="searchTo" type="date" class="mono"></div>
            <button id="searchBtn" class="toolbar-btn emerald" type="button"><i class="fa-solid fa-rotate"></i> Load</button>
            <div class="toolbar-item"><input id="searchText" placeholder="Search machine, code, shop order, model…"></div>
            <div class="toolbar-item">
                <select id="filterShift">
                    <option value="">All shifts</option>
                    <option value="D">Day (D)</option>
                    <option value="N">Night (N)</option>
                </select>
            </div>

            <div class="toolbar-item">
                <select id="filterProcess">
                    <option value="">All processes</option>
                </select>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Shift</th>
                        <th>MC.#</th>
                        <th>Shop Order</th>
                        <th>Partnumber/ Model</th>
                        <th>Process</th>
                        <th>Code / Full Name</th>
                        <th>Output</th>
                        <th>DT (min)</th>
                        <th>Start - End</th>
                        <th>Work Hrs</th>
                        <th>Target</th>
                        <th>Eff.</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>

        <!-- FOOTER SUMMARY -->
        <div class="pagination">
            <div class="page-info"><strong id="recordCount">0 entries</strong></div>
            <div class="kpis">
                <span>Output<strong id="kOutput">0</strong></span>
                <span>Target<strong id="kTarget">0</strong></span>
                <span>Efficiency<strong id="kEff">—</strong></span>
            </div>
        </div>

    </section>
</main>

<div id="toast" class="toast"><span id="toastMessage"></span></div>
















<script type="module">
       import {
           getMethod,
           postMethod,
           formatDate
       } from '@Url.Content("~/Scripts/modules/index.js")';

       const byId = id => document.getElementById(id);

        const PROCESS_LIST = [
            { ProcessId: 1, ProcessName: '3mm Cover Drilling' },
            { ProcessId: 2, ProcessName: '3mm Impeller Drilling' },
            { ProcessId: 3, ProcessName: '3mm Compound Application' },
            { ProcessId: 4, ProcessName: '5mm Compound Application' },
            { ProcessId: 5, ProcessName: '6mm Compound Application' },
            { ProcessId: 6, ProcessName: '8mm Compound Application' }
         ];

         const ICON_SUN = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	            <path d="M0 0h24v24H0z" fill="none" />
	            <g fill="none">
		            <circle cx="11.97" cy="11.99" r="4.73" fill="currentColor" opacity=".2" transform="rotate(90 11.97 11.99)" />
		            <circle cx="11.97" cy="11.99" r="4.73" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="rotate(90 11.97 11.99)" />
		            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1.56 11.99H4.3m15.45.01h2.7m-10.5 10.34v-2.62m0-15.38V1.66M18 5.87l2.02-2.02M4 19.87l1.75-1.75m.07-12.34L3.9 3.85m16.11 16.12l-1.86-1.86" />
	            </g>
            </svg>
            `;

                // Simple moon in the same style (fill + outline)
                const ICON_MOON = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	            <path d="M0 0h24v24H0z" fill="none" />
	            <g fill="none">
		            <path fill="currentColor" d="M11.71 22.3a9.96 9.96 0 0 1-9.95-9.95c0-5.5 3.57-8.3 6.12-8.92c0 0-1.56 5.28 2.42 10.2c4.8 4.79 10.48.75 10.7 1.68c.23.93-3.79 7-9.29 7" opacity=".2" />
		            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1.76 12.35a9.96 9.96 0 0 0 18.96 4.25c.4-.84.6-1.25.37-1.5s-.71-.08-1.71.25c-2.33.77-6.18 1.34-9.15-1.63a8.2 8.2 0 0 1-2.13-8.6c.35-1.17.53-1.76.26-1.97c-.26-.2-.72.05-1.62.58a10 10 0 0 0-4.98 8.62M15.6 6.13h-1.24c-.94 0-1.42 0-1.55-.29c-.13-.3.18-.65.8-1.36l.96-1.11c.61-.71.92-1.07.79-1.36s-.6-.3-1.55-.3h-1.3m9.78 7.27h-1.93c-.94 0-1.4 0-1.54-.3c-.13-.29.17-.64.78-1.35l1.75-2.05c.61-.72.92-1.07.78-1.36c-.13-.3-.6-.3-1.54-.3h-2" />
		            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.14 12.3h-1.28c-.6 0-.9 0-.97-.18c-.08-.19.12-.4.53-.84l1.08-1.14c.4-.43.61-.65.53-.83s-.37-.18-.97-.18h-1.3" />
	            </g>
            </svg>
            `;


       class EfficiencyManageController {
           constructor() {
               this.tbody = byId('tableBody');
               this.isNight = false;   // false = DS, true = NS (set automatically from Start)


               this.form = byId('dataForm');
               this.editIndexInput = byId('editIndex');
               this.cancelBtn = byId('cancelBtn');
               this.submitBtn = byId('submitBtn');

               this.searchFrom = byId('searchFrom');
               this.searchTo = byId('searchTo');
               this.searchBtn = byId('searchBtn');
               this.searchText = byId('searchText');
               this.filterShift = byId('filterShift');

               this.rows = [];      // last loaded list
               this.cycle = null;   // cycle-time info for the model currently selected

               const d = new Date();
               this.todayValue = new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

               this.machines = Array.from({ length: 200 }, (_, i) => `D-${i + 1}`);
               this.models = [];     // [{ ProcessId, Model, Partnumber, CycleTimeSec, EasedCycleTimeSec }]
               this.employees = [];  // [{ EmployeeCode, FullName, EffyCode }]
               this.csvRows = [];    // parsed CSV preview rows (CSV panel not on page yet)
               this.cycleRows = [];  // cycle time master rows (Cycle panel not on page yet)
               this.processes = [];   // [{ ProcessId, ProcessName }]

               this.isSubmitting = false;
           }

           async init() {
               this.searchFrom.value = this.searchTo.value = this.todayValue;
               byId('workDate').value = this.todayValue;
               this.startClock();

               this.bindEvents();
               this.calcForm();
               await Promise.all([this.loadModels(), this.loadEmployees(), this.loadProcessList()]);
               await this.GetEfficiencyList();
           }

           startClock() {
               const el = byId('liveClock');
               if (!el) return;
               const tick = () => { el.textContent = new Date().toLocaleTimeString('en-GB'); };
               tick();
               setInterval(tick, 1000);
           }

           static DAY_START = 6 * 60 + 30;    // 06:30 → 390
           static NIGHT_START = 18 * 60 + 30; // 18:30 → 1110
           // Night shift if the start time is 18:00–05:59 (change the hours to match your shifts)
           autoShift() {
               const v = this.normalizeTime(byId('startOpe').value);
               if (!v) return;

               const [h, m] = v.split(':').map(Number);
               const mins = h * 60 + m;

               const isDay = mins >= EfficiencyManageController.DAY_START &&
                   mins < EfficiencyManageController.NIGHT_START;

               this.isNight = !isDay;
           }

           bindEvents() {
               // null-safe binder for panels that aren't on the page yet
               const on = (id, evt, fn) => byId(id)?.addEventListener(evt, fn);

               // Enter = next field; on the last field it submits.
               // Combo inputs handle their own Enter (see createCombo).
               this.form.addEventListener('keydown', e => {
                   if (e.key !== 'Enter') return;
                   const el = e.target;
                   if (!['INPUT', 'SELECT'].includes(el.tagName)) return;   // buttons behave normally
                   if (el.closest('.combo')) return;                        // handled inside createCombo

                   e.preventDefault();
                   if (!this.focusNext(el)) this.submitBtn.click();         // last input → trigger Add Record
               });

               this.form.addEventListener('submit', e => this.onSubmitRecord(e));
               this.cancelBtn.addEventListener('click', () => this.resetRecordForm());

               this.searchBtn.addEventListener('click', () => this.GetEfficiencyList());
               this.searchText.addEventListener('input', () => this.renderTable());
               this.filterShift.addEventListener('change', () => this.renderTable());

               // Date filter: validate range, then reload from the server
               const onDateChange = () => {
                   const from = this.searchFrom.value;
                   const to = this.searchTo.value;
                   if (from && to && from > to) {
                       this.showToast('"From" date cannot be later than "To" date.', false);
                       this.searchTo.value = from;
                   }
                   this.GetEfficiencyList();
               };

               this.searchFrom.addEventListener('change', onDateChange);
               this.searchTo.addEventListener('change', onDateChange);

               // Military time inputs: auto-insert ":" while typing, normalize on blur
               ['startOpe', 'endOpe'].forEach(id => {
                   const el = byId(id);

                   el.addEventListener('input', () => {
                       const d = el.value.replace(/\D/g, '').slice(0, 4);
                       el.value = d.length > 2 ? `${d.slice(0, 2)}:${d.slice(2)}` : d;
                       if (id === 'startOpe') this.autoShift();
                   });

                   el.addEventListener('blur', () => {
                       const t = this.normalizeTime(el.value);
                       if (t === null) {
                           this.showToast('Enter a valid 24-hour time (00:00 – 23:59).', false);
                           el.value = '';
                       } else {
                           el.value = t;
                       }
                       this.calcForm();
                       if (id === 'startOpe') this.autoShift();
                   });

                   // NEW: also fires on autofill / paste / programmatic commit
                   if (id === 'startOpe') {
                       el.addEventListener('change', () => this.autoShift());
                   }
               });




               ['startOpe', 'endOpe', 'output', 'downtimeMin'].forEach(id =>
                   byId(id).addEventListener('input', () => this.calcForm()));

               // Models are already filtered by process inside the combo, so no refetch is needed
               //byId('processId').addEventListener('change', () => {
               //    byId('model').value = '';
               //    byId('Partnumber').value = '';
               //    ById('ProcessName').value = '';
               //    this.cycle = null;
               //    this.calcForm();
               //});

               // Row buttons (edit/delete) are not rendered yet; enable together with the buttons in renderTable
               // this.tbody.addEventListener('click', e => this.onRecordTableClick(e));

               this.setupCombos();

               // CSV Upload (skipped while the panel isn't on the page)
               on('csvParseBtn', 'click', () => this.parseCSV());
               on('csvUploadBtn', 'click', () => this.uploadCSV());
               on('csvClearBtn', 'click', () => this.clearCSV());

               // Cycle Time (skipped while the panel isn't on the page)
               on('ctNewBtn', 'click', () => this.openCycleModal());
               on('ctRefreshBtn', 'click', () => this.loadCycleTimes());
               on('ctSearch', 'input', () => this.renderCycleTable());
               on('ctProcessFilter', 'change', () => this.renderCycleTable());
               on('ctForm', 'submit', e => this.saveCycleTime(e));
               on('ctCancelBtn', 'click', () => this.closeCycleModal());
               on('ctBody', 'click', e => this.onCycleTableClick(e));
               this.filterProcess = byId('filterProcess');
               this.filterProcess.addEventListener('change', () => this.renderTable());


               this.bindDataMenu();
           }

           // ───────────────────────── READ ─────────────────────────
           async GetEfficiencyList() {
               try {
                   const res = await getMethod('@Url.Action("GetEfficiencyList", "Rotor")', {
                       from: this.searchFrom.value,
                       to: this.searchTo.value
                   });

                   console.log(res);

                   if (!res?.Success) {
                       this.showToast(res?.Message || 'Failed to load records.', false);
                       return;
                   }
                   this.rows = res.data || [];
                   this.renderTable();
               } catch (error) {
                   console.error('Error fetching efficiency records:', error);
                   this.showToast('Failed to load records.', false);
               }
           }

           filteredRows() {
               const q = this.searchText.value.toLowerCase();
               const sh = this.filterShift.value;
               const pr = this.filterProcess.value.trim().toLowerCase();
               return this.rows.filter(r =>
                   (!sh || String(r.ShiftCode ?? '').toUpperCase().startsWith(sh)) &&
                   (!pr || String(r.ProcessName ?? '').trim().toLowerCase() === pr) &&
                   (!q || [r.MachineNo, r.EffyCode, r.EmployeeCode, r.ShopOrder, r.Partnumber, r.getModel, r.Model, r.ProcessName]
                       .some(v => String(v ?? '').toLowerCase().includes(q))));
           }

           renderTable() {
               const list = this.filteredRows();

               // Only rows with a target count toward overall efficiency (no cycle time = no target).
               const withTarget = list.filter(r => r.Target > 0);
               const totalOut = list.reduce((a, r) => a + this.num(r.Output), 0);
               const totalTarget = withTarget.reduce((a, r) => a + this.num(r.Target), 0);
               const outForTarget = withTarget.reduce((a, r) => a + this.num(r.Output), 0);

               byId('recordCount').textContent = `${list.length} entries`;
               byId('kOutput').textContent = this.fmt(totalOut);
               byId('kTarget').textContent = this.fmt(totalTarget);
               byId('kEff').textContent = totalTarget ? `${(outForTarget / totalTarget * 100).toFixed(2)}%` : '—';

               this.tbody.innerHTML = list.map(r => `
                   <tr data-id="${r.EfficiencyID}">
                       <td>${this.esc(r.WorkDateText)}</td>
                      <td>${this.shiftBadge(String(r.ShiftCode ?? '').toUpperCase().startsWith('N'))}</td>
                       <td>${this.esc(r.MachineNo)}</td>
                       <td style='color: #4338ca; font-weight: 600;'>${this.esc(r.ShopOrder)}</td>

                       <td class="ShopOrderLayout " style="text-align: left;">
                          <span class='ShopOrderLayout_ShopOrder' style='font-size: .7rem; font-weight: 800;'>${this.esc(r.Partnumber) }</span>
                          <p style="margin:.2em 0;color:#8a8f9e; font-size: .7rem;">${this.esc(r.getModel ?? r.Model) }</p>
                       </td>

                       <td>${this.esc(r.ProcessName)}</td>

                       <td class="ShopOrderLayout " style="text-align: left;">
                            <span class='ShopOrderLayout_ShopOrder' style='font-size: .7rem;'>${this.esc(r.EffyCode)}</span>
                            <p style="margin:.2em 0;color:#8a8f9e; font-size: .7rem;">${this.esc(r.FullName ) }</p>     
                       </td>
                       <td class="num">${this.fmt(r.Output)}</td>
                       <td class="num">${r.DowntimeMin}</td>
                       <td>${this.esc(r.StartOpeText)} - ${this.esc(r.EndOpeText)}</td>
                       <td class="num">${this.fmt(r.WorkHours)}</td>
                       <td class="num">${r.Target ?? '—'}</td>
                       <td>${this.effPill(r.Efficiency)}</td>
                   </tr>
               `).join('') || '<tr><td colspan="15" class="empty">No records for this range.</td></tr>';
           }

           // ───────────────────────── EDIT / DELETE (row buttons, not enabled yet) ─────────────────────────
           onRecordTableClick(e) {
               const editBtn = e.target.closest('.edit-record');
               const delBtn = e.target.closest('.delete-record');
               if (editBtn) this.loadRecordIntoForm(parseInt(editBtn.dataset.id, 10));
               if (delBtn) this.onDeleteRecord(parseInt(delBtn.dataset.id, 10));
           }

           async loadRecordIntoForm(id) {
               const r = this.rows.find(x => x.EfficiencyID === id);
               if (!r) return;

               this.editIndexInput.value = id;
               byId('ProcessId').value = r.ProcessId ?? '';

               byId('ProcessName').value =
                   this.processName(r.ProcessId) || r.ProcessName || '';

               byId('workDate').value = r.WorkDate;
               this.isNight = r.ShiftRaw === true || String(r.ShiftRaw).toLowerCase() === 'true';
               byId('machineNo').value = r.MachineNo;
               byId('shopOrder').value = r.ShopOrder;
               byId('output').value = r.Output;
               byId('downtimeMin').value = r.DowntimeMin;
               byId('startOpe').value = String(r.StartOpe ?? '').slice(0, 5);
               byId('endOpe').value = String(r.EndOpe ?? '').slice(0, 5);

               byId('formTitle').textContent = `Edit Efficiency Record #${id}`;
               this.submitBtn.textContent = 'Update Record';

               this.cycle = this.models.find(x => x.ProcessId === r.ProcessId && x.Partnumber === r.Partnumber)
                   ?? this.models.find(x => x.ProcessId === r.ProcessId && x.Model === r.Model)
                   ?? null;
               byId('Partnumber').value = this.cycle?.Partnumber ?? r.Partnumber ?? '';
               byId('model').value = this.cycle?.Model ?? r.Model ?? '';
               byId('employeeCode').value = r.EffyCode ?? '';
               byId('employeeName').value = this.employees.find(e => String(e.EffyCode) === String(r.EffyCode))?.FullName ?? '';
               this.calcForm();
           }

           async onDeleteRecord(id) {
               if (!confirm('Delete this record?')) return;
               try {
                   // NOTE: other calls use the "Rotor" controller; confirm this one is correct
                   const res = await postMethod('@Url.Action("DeleteEfficiencyRecord", "Efficiency")', { id });
                   if (!res?.Success) {
                       this.showToast(res?.Message || 'Delete failed.', false);
                       return;
                   }
                   this.showToast('Record deleted.', true);
                   await this.GetEfficiencyList();
               } catch (error) {
                   console.error('Error deleting record:', error);
                   this.showToast('Delete failed.', false);
               }
           }

           // ───────────────────────── CREATE ─────────────────────────
          async onSubmitRecord(e) {
                e.preventDefault();

                if (this.isSubmitting) return;
                this.isSubmitting = true;
                this.submitBtn.disabled = true;

                let saved = false;   // <-- new

                try {
                    const effyCode = byId('employeeCode').value.trim();
                    const emp = this.employees.find(x => String(x.EffyCode) === effyCode);

                    if (!emp) {
                        this.showToast('Select a valid Effy Code.', false);
                        byId('employeeCode').focus();
                        return;
                    }
                    if (!emp.EffyCode) {
                        this.showToast('This employee has no Effy Code registered.', false);
                        byId('employeeCode').focus();
                        return;
                    }

                    const processId = parseInt(byId('ProcessId').value, 10);
                    const processName = byId('ProcessName').value.trim();

                    if (!processName || !Number.isInteger(processId) || processId <= 0) {
                        this.showToast('Please select a valid process.', false);
