                        </table>
                    </div>

                </section>

                <!-- EFFICIENCY RECORDS PANEL -->
                <section class="dw-panel" id="dwPanelRecords">

                    <div class="dw-panel-heading">
                        <div>
                            <h3>Employees  Management Code</h3>



                        </div>
                    </div>
                    <!-- TABLE -->
                    <div class="table-scroll" style="margin-top: 1em;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Employee Code</th>
                                    <th>Employee ID</th>
                                    <th>Full Name </th>
                                    <th>Process</th>
                                    <th>Affiliation</th>

                                </tr>
                            </thead>
                            <tbody id="EmployeeBody"></tbody>
                        </table>
                    </div>

                </section>

            </div>
        </div>


    </section>
</div>












<script type="module">
       import {
           getMethod,
           postMethod,
           formatDate
       } from '@Url.Content("~/Scripts/modules/index.js")';

       const byId = id => document.getElementById(id);

       class EfficiencyManageController {
           constructor() {
               this.tbody = byId('tableBody');

               this.form = byId('dataForm');
               this.editIndexInput = byId('editIndex');
               this.cancelBtn = byId('cancelBtn');
               this.submitBtn = byId('submitBtn');

               this.searchFrom = byId('searchFrom');
               this.searchTo = byId('searchTo');
               this.searchBtn = byId('searchBtn');
               this.searchText = byId('searchText');
               this.filterShift = byId('filterShift');

               this.rows = [];      // last loaded list
               this.cycle = null;   // cycle-time info for the model currently selected

               const d = new Date();
               this.todayValue = new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

               this.machines = Array.from({ length: 200 }, (_, i) => `D-${i + 1}`);
               this.models = [];     // [{ ProcessId, Model, Partnumber, CycleTimeSec, EasedCycleTimeSec }]
               this.employees = [];  // [{ EmployeeCode, FullName, EffyCode }]
               this.csvRows = [];    // parsed CSV preview rows (CSV panel not on page yet)
               this.cycleRows = [];  // cycle time master rows (Cycle panel not on page yet)
               this.processes = [];   // [{ ProcessId, ProcessName }]

               this.isSubmitting = false;
           }

           async init() {
               this.searchFrom.value = this.searchTo.value = this.todayValue;
               byId('workDate').value = this.todayValue;
               this.startClock();

               this.bindEvents();
               this.calcForm();
               await Promise.all([this.loadModels(), this.loadEmployees(), this.loadProcessList()]);
               await this.GetEfficiencyList();
           }

           startClock() {
               const el = byId('liveClock');
               if (!el) return;
               const tick = () => { el.textContent = new Date().toLocaleTimeString('en-GB'); };
               tick();
               setInterval(tick, 1000);
           }

           // Night shift if the start time is 18:00–05:59 (change the hours to match your shifts)
           autoShift() {
               const v = byId('startOpe').value;
               if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(v)) return;
               const h = parseInt(v.slice(0, 2), 10);
               byId('shift').value = (h >= 18 || h < 6) ? 'true' : 'false';
           }

           bindEvents() {
               // null-safe binder for panels that aren't on the page yet
               const on = (id, evt, fn) => byId(id)?.addEventListener(evt, fn);

               // Enter = next field; on the last field it submits.
               // Combo inputs handle their own Enter (see createCombo).
               this.form.addEventListener('keydown', e => {
                   if (e.key !== 'Enter') return;
                   const el = e.target;
                   if (!['INPUT', 'SELECT'].includes(el.tagName)) return;   // buttons behave normally
                   if (el.closest('.combo')) return;                        // handled inside createCombo

                   e.preventDefault();
                   if (!this.focusNext(el)) this.submitBtn.click();         // last input → trigger Add Record
               });

               this.form.addEventListener('submit', e => this.onSubmitRecord(e));
               this.cancelBtn.addEventListener('click', () => this.resetRecordForm());

               this.searchBtn.addEventListener('click', () => this.GetEfficiencyList());
               this.searchText.addEventListener('input', () => this.renderTable());
               this.filterShift.addEventListener('change', () => this.renderTable());

               // Military time inputs: auto-insert ":" while typing, normalize on blur
               ['startOpe', 'endOpe'].forEach(id => {
                   const el = byId(id);

                   el.addEventListener('input', () => {
                       const d = el.value.replace(/\D/g, '').slice(0, 4);
                       el.value = d.length > 2 ? `${d.slice(0, 2)}:${d.slice(2)}` : d;
                       if (id === 'startOpe') this.autoShift();
                   });

                   el.addEventListener('blur', () => {
                       const t = this.normalizeTime(el.value);
                       if (t === null) {
                           this.showToast('Enter a valid 24-hour time (00:00 – 23:59).', false);
                           el.value = '';
                       } else {
                           el.value = t;
                       }
                       this.calcForm();
                       if (id === 'startOpe') this.autoShift();
                   });
               });




               ['startOpe', 'endOpe', 'output', 'downtimeMin'].forEach(id =>
                   byId(id).addEventListener('input', () => this.calcForm()));

               // Models are already filtered by process inside the combo, so no refetch is needed
               //byId('processId').addEventListener('change', () => {
               //    byId('model').value = '';
               //    byId('Partnumber').value = '';
               //    ById('ProcessName').value = '';
               //    this.cycle = null;
               //    this.calcForm();
               //});

               // Row buttons (edit/delete) are not rendered yet; enable together with the buttons in renderTable
               // this.tbody.addEventListener('click', e => this.onRecordTableClick(e));

               this.setupCombos();

               // CSV Upload (skipped while the panel isn't on the page)
               on('csvParseBtn', 'click', () => this.parseCSV());
               on('csvUploadBtn', 'click', () => this.uploadCSV());
               on('csvClearBtn', 'click', () => this.clearCSV());

               // Cycle Time (skipped while the panel isn't on the page)
               on('ctNewBtn', 'click', () => this.openCycleModal());
               on('ctRefreshBtn', 'click', () => this.loadCycleTimes());
               on('ctSearch', 'input', () => this.renderCycleTable());
               on('ctProcessFilter', 'change', () => this.renderCycleTable());
               on('ctForm', 'submit', e => this.saveCycleTime(e));
               on('ctCancelBtn', 'click', () => this.closeCycleModal());
               on('ctBody', 'click', e => this.onCycleTableClick(e));
               this.filterProcess = byId('filterProcess');
               this.filterProcess.addEventListener('change', () => this.renderTable());


               this.bindDataMenu();
           }

           // ───────────────────────── READ ─────────────────────────
           async GetEfficiencyList() {
               try {
                   const res = await getMethod('@Url.Action("GetEfficiencyList", "Rotor")', {
                       from: this.searchFrom.value,
                       to: this.searchTo.value
                   });

                   if (!res?.Success) {
                       this.showToast(res?.Message || 'Failed to load records.', false);
                       return;
                   }
                   this.rows = res.data || [];
                   this.renderTable();
               } catch (error) {
                   console.error('Error fetching efficiency records:', error);
                   this.showToast('Failed to load records.', false);
               }
           }

           filteredRows() {
               const q = this.searchText.value.toLowerCase();
               const sh = this.filterShift.value;
               const pr = this.filterProcess.value.trim().toLowerCase();
               return this.rows.filter(r =>
                   (!sh || String(r.ShiftCode ?? '').toUpperCase().startsWith(sh)) &&
                   (!pr || String(r.ProcessName ?? '').trim().toLowerCase() === pr) &&
                   (!q || [r.MachineNo, r.EffyCode, r.EmployeeCode, r.ShopOrder, r.Partnumber, r.getModel, r.Model, r.ProcessName]
                       .some(v => String(v ?? '').toLowerCase().includes(q))));
           }

           renderTable() {
               const list = this.filteredRows();

               // Only rows with a target count toward overall efficiency (no cycle time = no target).
               const withTarget = list.filter(r => r.Target > 0);
               const totalOut = list.reduce((a, r) => a + this.num(r.Output), 0);
               const totalTarget = withTarget.reduce((a, r) => a + this.num(r.Target), 0);
               const outForTarget = withTarget.reduce((a, r) => a + this.num(r.Output), 0);

               byId('recordCount').textContent = `${list.length} entries`;
               byId('kOutput').textContent = this.fmt(totalOut);
               byId('kTarget').textContent = this.fmt(totalTarget);
               byId('kEff').textContent = totalTarget ? `${(outForTarget / totalTarget * 100).toFixed(2)}%` : '—';

               this.tbody.innerHTML = list.map(r => `
                   <tr data-id="${r.EfficiencyID}">
                       <td>${this.esc(r.WorkDateText)}</td>
                       <td>${this.esc(r.ShiftCode)}</td>
                       <td>${this.esc(r.MachineNo)}</td>
                       <td>${this.esc(r.Partnumber)}</td>
                       <td>${this.esc(r.getModel ?? r.Model)}</td>
                       <td>${this.esc(r.ShopOrder)}</td>
                       <td>${this.esc(r.ProcessName)}</td>
                       <td>${this.esc(r.EffyCode)}</td>
                       <td>${this.esc(r.FullName)}</td>
                       <td class="num">${this.fmt(r.Output)}</td>
                       <td class="num">${r.DowntimeMin}</td>
                       <td>${this.esc(r.StartOpeText)}</td>
                       <td>${this.esc(r.EndOpeText)}</td>
                       <td class="num">${this.fmt(r.WorkHours)}</td>
                       <td class="num">${r.Target ?? '—'}</td>
                       <td class="num">${r.TargetEased ?? '—'}</td>
                       <td>${this.effPill(r.Efficiency)}</td>
                   </tr>
               `).join('') || '<tr><td colspan="15" class="empty">No records for this range.</td></tr>';
           }

           // ───────────────────────── EDIT / DELETE (row buttons, not enabled yet) ─────────────────────────
           onRecordTableClick(e) {
               const editBtn = e.target.closest('.edit-record');
               const delBtn = e.target.closest('.delete-record');
               if (editBtn) this.loadRecordIntoForm(parseInt(editBtn.dataset.id, 10));
               if (delBtn) this.onDeleteRecord(parseInt(delBtn.dataset.id, 10));
           }

           async loadRecordIntoForm(id) {
               const r = this.rows.find(x => x.EfficiencyID === id);
               if (!r) return;

               this.editIndexInput.value = id;
               // byId('processId').value = r.ProcessId;
               byId('workDate').value = r.WorkDate;
               byId('shift').value = String(r.ShiftRaw);
               byId('machineNo').value = r.MachineNo;
               byId('shopOrder').value = r.ShopOrder;
               byId('output').value = r.Output;
               byId('downtimeMin').value = r.DowntimeMin;
               byId('startOpe').value = String(r.StartOpe ?? '').slice(0, 5);
               byId('endOpe').value = String(r.EndOpe ?? '').slice(0, 5);

               byId('formTitle').textContent = `Edit Efficiency Record #${id}`;
               this.submitBtn.textContent = 'Update Record';

               this.cycle = this.models.find(x => x.ProcessId === r.ProcessId && x.Partnumber === r.Partnumber)
                   ?? this.models.find(x => x.ProcessId === r.ProcessId && x.Model === r.Model)
                   ?? null;
               byId('Partnumber').value = this.cycle?.Partnumber ?? r.Partnumber ?? '';
               byId('model').value = this.cycle?.Model ?? r.Model ?? '';
               byId('employeeCode').value = r.EffyCode ?? '';
               byId('employeeName').value = this.employees.find(e => String(e.EffyCode) === String(r.EffyCode))?.FullName ?? '';
               this.calcForm();
           }

           async onDeleteRecord(id) {
               if (!confirm('Delete this record?')) return;
               try {
                   // NOTE: other calls use the "Rotor" controller; confirm this one is correct
                   const res = await postMethod('@Url.Action("DeleteEfficiencyRecord", "Efficiency")', { id });
                   if (!res?.Success) {
                       this.showToast(res?.Message || 'Delete failed.', false);
                       return;
                   }
                   this.showToast('Record deleted.', true);
                   await this.GetEfficiencyList();
               } catch (error) {
                   console.error('Error deleting record:', error);
                   this.showToast('Delete failed.', false);
               }
           }

           // ───────────────────────── CREATE ─────────────────────────
          async onSubmitRecord(e) {
                e.preventDefault();

                if (this.isSubmitting) return;
                this.isSubmitting = true;
                this.submitBtn.disabled = true;

                try {
                    const effyCode = byId('employeeCode').value.trim();
                    const emp = this.employees.find(x => String(x.EffyCode) === effyCode);

                    if (!emp) {
                        this.showToast('Select a valid Effy Code.', false);
                        byId('employeeCode').focus();
                        return;
                    }
                    if (!emp.EffyCode) {
                        this.showToast('This employee has no Effy Code registered.', false);
                        byId('employeeCode').focus();
                        return;
                    }

                    if (!byId('ProcessName').value) {
                        this.showToast('Select a part number to set the process.', false);
                        byId('Partnumber').focus();
                        return;
                    }

                    const payload = {
                        WorkDate: byId('workDate').value,
                        Shift: byId('shift').value === 'true',
                        MachineNo: byId('machineNo').value,
                        ShopOrder: byId('shopOrder').value.trim(),
                        EffyCode: emp.EffyCode,
                        getModel: byId('model').value.trim(),
                        Partnumber: byId('Partnumber').value.trim(),
                        ProcessName : byId('ProcessName').value.trim(),
                        Output: parseInt(byId('output').value, 10) || 0,
                        DowntimeMin: parseInt(byId('downtimeMin').value, 10) || 0,
                        StartOpe: byId('startOpe').value,
                        EndOpe: byId('endOpe').value
                    };

                    const res = await postMethod('@Url.Action("AddRecordForMonitoring", "Rotor")', payload);
                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Save failed.', false);
                        return;
                    }
                    this.showToast('Record added.', true);

                    this.searchFrom.value = this.searchTo.value = payload.WorkDate;
                    this.resetRecordForm({ keepHeader: true });
                    await this.GetEfficiencyList();
                    byId('shopOrder').focus();   // was machineNo
                } catch (error) {
                    console.error('Error saving record:', error);
                    this.showToast('Save failed.', false);
                } finally {
                    this.isSubmitting = false;
                    this.submitBtn.disabled = false;
                }
            }

           resetRecordForm({ keepHeader = false } = {}) {
               // remember the values before form.reset() wipes them
               const keep = keepHeader
                   ? {
                       workDate: byId('workDate').value,
                       shift: byId('shift').value,
                       machineNo: byId('machineNo').value
                   }
                   : null;

               this.form.reset();
