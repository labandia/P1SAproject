@{
    Layout = "~/Areas/Production1/Views/Shared/_EfficiencyLayout.cshtml";
}

<!-- ========== MAIN LAYOUT ========== -->
<main class="main-layout">

    <!-- ========== FORM PANEL (LEFT) ========== -->
    <aside class="form-panel" data-purpose="efficiency-entry-sidebar">
        <div class="form-header">
            <div class="form-header-top">
                <div class="form-header-badge">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h2 id="formTitle">Efficency Data  Entry</h2>
                </div>
            </div>
        </div>

        <form class="form-body" id="dataForm" autocomplete="off">
            <input type="hidden" id="editIndex" value="0">
            <div class="form-fields">

                <!-- Date | Machine -->
                <div class="field-row-3">
                    <div class="field"><label>Date <span class="req">*</span></label><input id="workDate" type="date" required></div>

                    <div class="field">
                        <label>Shift</label>
                        <select id="shift">
                            <option value="false">DS</option>
                            <option value="true">NS</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Machine No. <span class="req">*</span></label>
                        <div class="combo" id="machineCombo">
                            <input id="machineNo" placeholder="D-1 … D-200" autocomplete="off" required>
                            <ul class="combo-list" id="machineList" role="listbox"></ul>
                        </div>
                    </div>

                </div>

                <!-- Shop Order -->
                <div class="field-row">
                    <div class="field">
                        <label>Shop Order <span class="req">*</span></label>
                        <input id="shopOrder" placeholder="Enter shop order" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label>Partnumber <span class="req">*</span></label>
                        <div class="combo">
                            <input id="Partnumber" placeholder="Search part number…" autocomplete="off" required>
                            <ul class="combo-list" role="listbox"></ul>
                        </div>
                    </div>
                </div>

                <!-- Model | Process -->
                <div class="field-row">
                    <div class="field">
                        <label>Model</label>
                        <input id="model" readonly placeholder="from part number">
                    </div>
                    <div class="field">
                        <label>Process <span class="req">*</span></label>
                        <input id="ProcessName" placeholder="Enter shop order" autocomplete="off" required>
                    </div>
                </div>

                <!-- Employee code | name -->
                <div class="field-row-5">
                    <div class="field">
                        <label>Employee Code <span class="req">*</span></label>
                        <div class="combo">
                            <input id="employeeCode" placeholder="Effy code / name" autocomplete="off" required>
                            <ul class="combo-list" role="listbox"></ul>
                        </div>
                    </div>
                    <div class="field">
                        <label>Employee Name</label>
                        <input id="employeeName" readonly placeholder="from employee code">
                    </div>
                </div>

                <!-- Shift | Start | End -->
                <div class="field-row">
                    <div class="field">
                        <label>Start <span class="req">*</span></label>
                        <input id="startOpe" type="text" inputmode="numeric" maxlength="5"
                               placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                               title="24-hour time, e.g. 07:30 or 19:45" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label>End <span class="req">*</span></label>
                        <input id="endOpe" type="text" inputmode="numeric" maxlength="5"
                               placeholder="HH:mm" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                               title="24-hour time, e.g. 07:30 or 19:45" autocomplete="off" required>
                    </div>
                </div>

                <!-- Output | Downtime -->
                <div class="field-row">
                    <div class="field"><label>Output <span class="req">*</span></label><input id="output" type="number" min="0" step="1" required placeholder="0"></div>
                    <div class="field"><label>Downtime (min)</label><input id="downtimeMin" type="number" min="0" step="1" value="0"></div>
                </div>

                <!-- AUTO CALC SUMMARY -->
                <div class="calc-box">
                    <div class="calc-box-header">
                        <span>Auto-Calculated Summary</span>
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div class="calc-grid-3">
                        <div class="calc-item"><span class="calc-label">Span (min)</span><span class="calc-value" id="aSpan">—</span></div>
                        <div class="calc-item"><span class="calc-label">Work Hours</span><span class="calc-value" id="aHours">—</span></div>
                        <div class="calc-item"><span class="calc-label">Cycle Time</span><span class="calc-value blue" id="aCycle">—</span></div>
                    </div>
                    <div class="calc-grid-2">
                        <div class="calc-item"><span class="calc-label">Target</span><span class="calc-value" id="aTarget">—</span></div>
                        <div class="calc-item"><span class="calc-label">Target (Eased)</span><span class="calc-value" id="aTargetEased">—</span></div>
                        <div class="calc-item text-right"><span class="calc-label">Efficiency</span><span class="calc-value emerald" id="aEff">—</span></div>
                    </div>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="submitBtn">Add Record</button>
                <button type="button" class="btn btn-outline-emerald" id="cancelBtn">Clear Form</button>
            </div>
        </form>
    </aside>

    <!-- ========== TABLE PANEL (RIGHT) ========== -->
    <section class="table-panel" data-purpose="records-view-panel">

        <!-- TOOLBAR -->
        <div class="table-toolbar">
            <div class="toolbar-item"><label>From</label><input id="searchFrom" type="date" class="mono"></div>
            <div class="toolbar-item"><label>To</label><input id="searchTo" type="date" class="mono"></div>
            <button id="searchBtn" class="toolbar-btn emerald" type="button"><i class="fa-solid fa-rotate"></i> Load</button>
            <div class="toolbar-item"><input id="searchText" placeholder="Search machine, code, shop order, model…"></div>
            <div class="toolbar-item">
                <select id="filterShift">
                    <option value="">All shifts</option>
                    <option value="D">Day (D)</option>
                    <option value="N">Night (N)</option>
                </select>
            </div>

            <div class="toolbar-item">
                <select id="filterProcess">
                    <option value="">All processes</option>
                </select>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Shift</th>
                        <th>MC.#</th>
                        <th>Shop Order</th>
                        <th>Model</th>
                        <th>Partnumber</th>
                        <th>Process</th>
                        <th>Effy Code</th>
                        <th>Full Name</th>
                        <th>Output</th>
                        <th>DT (min)</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Work Hrs</th>
                        <th>Target</th>
                        <th>Target (Eased)</th>
                        <th>Eff.</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>

        <!-- FOOTER SUMMARY -->
        <div class="pagination">
            <div class="page-info"><strong id="recordCount">0 entries</strong></div>
            <div class="kpis">
                <span>Output<strong id="kOutput">0</strong></span>
                <span>Target<strong id="kTarget">0</strong></span>
                <span>Efficiency<strong id="kEff">—</strong></span>
            </div>
        </div>

    </section>
</main>

<div id="toast" class="toast"><span id="toastMessage"></span></div>







<!-- DATA & OPERATIONS WORKSPACE -->
