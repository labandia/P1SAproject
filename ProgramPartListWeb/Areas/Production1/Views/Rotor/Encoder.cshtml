
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Encoder</title>
    <title>Employee Information System</title>
    <link href="~/Content/css/EfficiencyDesign.css" rel="stylesheet" />
</head>
<body>
    <header>
        <div class="brand">Production Control · Digital Encoder</div>
        <h1>Efficiency Daily Monitor</h1>
        <div class="subtitle">Saved to PMACS_TEST · target and efficiency calculated from cycle time</div>
    </header>
    <main>
        <div class="toolbar">
            <button class="primary" id="newBtn">＋ New Record</button>
            <button id="exportBtn">Export CSV</button>
            <button id="printBtn">Print Report</button>
        </div>

        <nav class="tabs">
            <button class="tab active" data-tab="records">Records</button>
            <button class="tab" data-tab="encoder">Data Encoder</button>
        </nav>

        <!-- RECORDS -->
        <section class="panel active" id="records">
            <div class="kpis">
                <div class="kpi"><div class="label">Records</div><div class="value" id="kRecords">0</div></div>
                <div class="kpi"><div class="label">Total Output</div><div class="value" id="kOutput">0</div></div>
                <div class="kpi"><div class="label">Total Target</div><div class="value" id="kTarget">0</div></div>
                <div class="kpi"><div class="label">Overall Efficiency</div><div class="value" id="kEff">0%</div></div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Daily Records</h2><span class="small" id="recordCount">0 entries</span></div>
                <div class="card-body">
                    <div class="filters no-print">
                        <input id="searchFrom" type="date" title="From">
                        <input id="searchTo" type="date" title="To">
                        <button id="searchBtn">Load</button>
                        <input id="searchText" placeholder="Search machine, code, shop order, part…">
                        <select id="filterShift"><option value="">All shifts</option><option value="D">Day (D)</option><option value="N">Night (N)</option></select>
                    </div>
                    <div class="table-wrap">
                        <table id="dataTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Shift</th>
                                    <th>MC.#</th>
                                    <th>Shop Order</th>
                                    <th>Model</th>
                                    <th>Process</th>
                                    <th>Effy Code</th>
                                    <th>Output</th>
                                    <th>DT (min)</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Work Hrs</th>
                                    <th>Target</th>
                                    <th>Target (Eased)</th>
                                    <th>Eff.</th>
                                    <th class="no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ENCODER (create / update) -->
        <section class="panel" id="encoder">
            <div class="card">
                <div class="card-head"><h2 id="formTitle">Add Efficiency Record</h2><span class="small">Fields with <span style="color:#b22222;font-weight:700;">*</span> are required</span></div>
                <div class="card-body">
                    <form id="dataForm">
                        <input type="hidden" id="editIndex" value="0">

                        <div class="form-grid">
                            <div class="field">
                                <label>Process <span class="req">*</span></label>
                                <select id="processId" required>
                                    <option value="1">COVER DRILLING</option>
                                    <option value="2">IMPELLER</option>
                                    <option value="3">EPIFORM</option>
                                </select>
                            </div>
                            <div class="field"><label>Date <span class="req">*</span></label><input id="workDate" type="date" required></div>
                            <div class="field">
                                <label>Shift <span class="req">*</span></label>
                                <select id="shift" required>
                                    <option value="false">D — Day</option>
                                    <option value="true">N — Night</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Machine No. <span class="req">*</span></label>
                                <div class="combo" id="machineCombo">
                                    <input id="machineNo" placeholder="Search D-1 … D-200" autocomplete="off" required>
                                    <ul class="combo-list" id="machineList" role="listbox"></ul>
                                </div>
                            </div>

                            <div class="field">
                                <label>Shop Order <span class="req">*</span></label>
                                <div class="combo">
                                    <input id="shopOrder" placeholder="Search shop order…" autocomplete="off" required>
                                    <ul class="combo-list" role="listbox"></ul>
                                </div>
                            </div>
                            @*<div class="field"><label>Partnumber</label><input id="partnumber" placeholder="optional · e.g. 00847759-01"></div>*@
                            
                       
                            <div class="field">
                                <label>Model</label>
                                <div class="combo">
                                    <input id="model" placeholder="Search model…" autocomplete="off">
                                    <ul class="combo-list" role="listbox"></ul>
                                </div>
                            </div>
                            <div class="field">
                                <label>Employee Code <span class="req">*</span></label>
                                <div class="combo">
                                    <input id="employeeCode" placeholder="Search code or name…" autocomplete="off" required>
                                    <ul class="combo-list" role="listbox"></ul>
                                </div>
                            </div>
                            <div class="field">
                                <label>Employee Name</label>
                                <input id="employeeName" readonly placeholder="from employee code">
                            </div>
                            <div class="field"><label>Output <span class="req">*</span></label><input id="output" type="number" min="0" step="1" required placeholder="0"></div>
                            <div class="field"><label>Downtime (min)</label><input id="downtimeMin" type="number" min="0" step="1" value="0"></div>
                            <div class="field"><label>Start <span class="req">*</span></label><input id="startOpe" type="time" required></div>
                            <div class="field"><label>End <span class="req">*</span></label><input id="endOpe" type="time" required></div>
                        </div>

                        <div class="auto-group">
                            <div class="auto-group-head"><h3>Auto‑Calculated</h3></div>
                            <div class="auto-grid">
                                <div class="field"><label>Span (min)</label><input id="aSpan" readonly></div>
                                <div class="field"><label>Work Hours</label><input id="aHours" readonly></div>
                                <div class="field"><label>Cycle Time (cur / eased)</label><input id="aCycle" readonly></div>
                                <div class="field"><label>Target (current)</label><input id="aTarget" readonly></div>
                                <div class="field"><label>Target (eased)</label><input id="aTargetEased" readonly></div>
                                <div class="field"><label>Efficiency (%)</label><input id="aEff" readonly placeholder="Output ÷ Target × 100"></div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="primary" id="submitBtn">Add Record</button>
                            <button type="button" id="cancelBtn">Clear Form</button>
                            <button type="button" id="viewRecordsBtn">View Records</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>
    <footer>Efficiency Daily Monitor • PMACS_TEST</footer>

    <div id="toast"><span id="toastMessage"></span></div>

    <script type="module" asp-append-version="true">
        import {
            getMethod,
            postMethod,
            formatDate
        } from '@Url.Content("~/Scripts/modules/index.js")';

        const byId = id => document.getElementById(id);

        class EfficiencyManageController {
            constructor() {
                this.tbody = byId('tableBody');

                this.form = byId('dataForm');
                this.editIndexInput = byId('editIndex');
                this.cancelBtn = byId('cancelBtn');
                this.submitBtn = byId('submitBtn');

                this.searchFrom = byId('searchFrom');
                this.searchTo = byId('searchTo');
                this.searchBtn = byId('searchBtn');
                this.searchText = byId('searchText');
                this.filterShift = byId('filterShift');

                this.rows = [];      // last loaded list; the edit form is filled from here, not parsed from the table
                this.cycle = null;   // cycle-time info for the part currently typed in the form

                const d = new Date();
                this.todayValue = new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);


                this.machines = Array.from({ length: 200 }, (_, i) => `D-${i + 1}`);
                this.models = [];     // [{ Model, Partnumber, CycleTimeSec, EasedCycleTimeSec }]
                this.employees = [];  // [{ EmployeeCode, Name }]
            }

            async init() {
                this.searchFrom.value = this.searchTo.value = this.todayValue;
                byId('workDate').value = this.todayValue;

                this.bindEvents();
                await Promise.all([this.loadModels(), this.loadEmployees()]);
                await this.GetEfficiencyList();
            }

            bindEvents() {
                this.form.addEventListener('submit', e => this.onSubmitRecord(e));
                this.cancelBtn.addEventListener('click', () => this.resetRecordForm());

                this.searchBtn.addEventListener('click', () => this.GetEfficiencyList());
                this.searchText.addEventListener('input', () => this.renderTable());
                this.filterShift.addEventListener('change', () => this.renderTable());

                byId('newBtn').addEventListener('click', () => { this.resetRecordForm(); this.showTab('encoder'); });
                byId('viewRecordsBtn').addEventListener('click', () => this.showTab('records'));
                byId('exportBtn').addEventListener('click', () => this.exportCSV());
                byId('printBtn').addEventListener('click', () => window.print());
                document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => this.showTab(t.dataset.tab)));

                // Live preview + lookups
                ['startOpe', 'endOpe', 'output', 'downtimeMin'].forEach(id => byId(id).addEventListener('input', () => this.calcForm()));
                //byId('partnumber').addEventListener('change', () => this.lookupPart());
                byId('processId').addEventListener('change', async () => {
                    await this.loadModels();   // models depend on the process
                    // await this.lookupPart();

                    byId('model').value = '';
                    this.cycle = null;
                    this.calcForm();
                });
                // Row buttons are rebuilt on every render, so delegate from the tbody.
                this.tbody.addEventListener('click', e => this.onRecordTableClick(e));
                this.setupCombos();
            }

            // ───────────────────────── READ ─────────────────────────
            async GetEfficiencyList() {
                try {
                    const res = await getMethod('@Url.Action("GetEfficiencyList", "Rotor")', {
                        from: this.searchFrom.value,
                        to: this.searchTo.value
                    });

                    console.log(res);
                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Failed to load records.', false);
                        return;
                    }
                    this.rows = res.data || [];
                    this.renderTable();
                } catch (error) {
                    console.error('Error fetching efficiency records:', error);
                    this.showToast('Failed to load records.', false);
                }
            }

            filteredRows() {
                const q = this.searchText.value.toLowerCase();
                const sh = this.filterShift.value;
                return this.rows.filter(r =>
                    (!sh || r.Shift === sh) &&
                    (!q || [r.MachineNo, r.EffyCode, r.EmployeeCode, r.ShopOrder, r.Partnumber, r.Model, r.ProcessName]
                        .some(v => String(v ?? '').toLowerCase().includes(q))));
            }

            renderTable() {
                const list = this.filteredRows();

                // Only rows with a target count toward overall efficiency (no cycle time = no target).
                const withTarget = list.filter(r => r.Target > 0);
                const totalOut = list.reduce((a, r) => a + this.num(r.Output), 0);
                const totalTarget = withTarget.reduce((a, r) => a + this.num(r.Target), 0);
                const outForTarget = withTarget.reduce((a, r) => a + this.num(r.Output), 0);

                byId('recordCount').textContent = `${list.length} entries`;
                byId('kRecords').textContent = list.length;
                byId('kOutput').textContent = this.fmt(totalOut);
                byId('kTarget').textContent = this.fmt(totalTarget);
                byId('kEff').textContent = totalTarget ? `${(outForTarget / totalTarget * 100).toFixed(2)}%` : '—';

                this.tbody.innerHTML = list.map(r => `
                    <tr data-id="${r.EfficiencyID}">
                        <td>${this.esc(r.WorkDateText)}</td>
                        <td>${this.esc(r.ShiftCode)}</td>
                        <td>${this.esc(r.MachineNo)}</td>
                        <td>${this.esc(r.ShopOrder)}</td>
                        <td>${this.esc(r.getModel)}</td>
                        <td>${this.esc(r.ProcessName)}</td>
                        <td>${this.esc(r.EffyCode)}</td>
                        <td class="num">${this.fmt(r.Output)}</td>
                        <td class="num">${r.DowntimeMin}</td>
                        <td>${this.esc(r.StartOpeText)}</td>
                        <td>${this.esc(r.EndOpeText)}</td>
                        <td class="num">${this.fmt(r.WorkHours)}</td>
                        <td class="num">${r.Target ?? '—'}</td>
                        <td class="num">${r.TargetEased ?? '—'}</td>
                        <td>${this.effPill(r.Efficiency)}</td>
                        <td class="no-print" style="text-align:center;">
                            <button class="btn-icon edit-record" data-id="${r.EfficiencyID}" title="Edit">✏️</button>
                            <button class="btn-icon delete-record" data-id="${r.EfficiencyID}" title="Delete">🗑️</button>
                        </td>
                    </tr>
                `).join('') || '<tr><td colspan="16" class="empty">No records for this range.</td></tr>';
            }

            // ───────────────────────── EDIT / DELETE (row buttons) ─────────────────────────
            onRecordTableClick(e) {
                const editBtn = e.target.closest('.edit-record');
                const delBtn = e.target.closest('.delete-record');
                if (editBtn) this.loadRecordIntoForm(parseInt(editBtn.dataset.id, 10));
                if (delBtn) this.onDeleteRecord(parseInt(delBtn.dataset.id, 10));
            }

            async loadRecordIntoForm(id) {
                const r = this.rows.find(x => x.EfficiencyID === id);
                if (!r) return;

                this.editIndexInput.value = id;
                byId('processId').value = r.ProcessId;
                byId('workDate').value = r.WorkDate;
                byId('shift').value = String(r.ShiftRaw);
                byId('machineNo').value = r.MachineNo;
                byId('shopOrder').value = r.ShopOrder;
                byId('output').value = r.Output;
                byId('downtimeMin').value = r.DowntimeMin;
                byId('startOpe').value = r.StartOpe;
                byId('endOpe').value = r.EndOpe;

                byId('formTitle').textContent = `Edit Efficiency Record #${id}`;
                this.submitBtn.textContent = 'Update Record';

                this.cycle = this.models.find(x => x.ProcessId === r.ProcessId && x.Model === r.Model) ?? null;
                byId('model').value = this.cycle?.Model ?? r.Model ?? '';
                byId('employeeCode').value = r.EmployeeCode ?? '';
                byId('employeeName').value = this.employees.find(e => e.EmployeeCode === r.EmployeeCode)?.FullName ?? '';
                this.calcForm();
                this.showTab('encoder');
            }

            async onDeleteRecord(id) {
                if (!confirm('Delete this record?')) return;
                try {
                    const res = await postMethod('@Url.Action("DeleteEfficiencyRecord", "Efficiency")', { id });
                    if (!res?.Success) {
                        this.showToast(res?.Message || 'Delete failed.', false);
                        return;
                    }
                    this.showToast('Record deleted.', true);
                    await this.GetEfficiencyList();
                } catch (error) {
                    console.error('Error deleting record:', error);
                    this.showToast('Delete failed.', false);
                }
            }

            // ───────────────────────── CREATE / UPDATE ─────────────────────────
            async onSubmitRecord(e) {
                e.preventDefault();

                const employeeCode = byId('employeeCode').value.trim();
                const emp = this.employees.find(
                    x => x.EmployeeCode === employeeCode
                );

                if (!emp) {
                    this.showToast('Select a valid employee.', false);
                    byId('employeeCode').focus();
                    return;
                }
                if (!emp.EffyCode) {
                    this.showToast('This employee has no Effy Code registered.', false);
                    byId('employeeCode').focus();
                    return;
                }

                // Partnumber: byId('partnumber').value,

                // WorkDate: byId('workDate').value,
                const payload = {
                    Shift: byId('shift').value === 'true',
                    MachineNo: byId('machineNo').value,
                    ShopOrder: byId('shopOrder').value,
                    ProcessId: parseInt(byId('processId').value, 10),
                    EffyCode: emp.EffyCode,
                    Model: byId('model').value.trim(),
                    Output: parseInt(byId('output').value, 10) || 0,
                    DowntimeMin: parseInt(byId('downtimeMin').value, 10) || 0,
                    StartOpe: byId('startOpe').value,
                    EndOpe: byId('endOpe').value
                };
                console.log(payload);
                this.submitBtn.disabled = true;
                try {
                    const res = await postMethod('@Url.Action("AddRecordForMonitoring", "Rotor")', {
                        Shift: byId('shift').value === 'true',
                        MachineNo: byId('machineNo').value,
                        ShopOrder: byId('shopOrder').value,
                        EffyCode: emp.EffyCode,
                        getModel: byId('model').value.trim(),
                        ProcessId: parseInt(byId('processId').value, 10),
                        Output: parseInt(byId('output').value, 10) || 0,
                        DowntimeMin: parseInt(byId('downtimeMin').value, 10) || 0,
                        StartOpe: byId('startOpe').value,
                        EndOpe: byId('endOpe').value
                    });
                    console.log(res);
                    if (!res?.Success) {
                       this.showToast(res?.Message || 'Save failed.', false);
                       return;
                    }
                    this.showToast(payload.EfficiencyID ? 'Record updated.' : 'Record added.', true);

                    this.searchFrom.value = this.searchTo.value = payload.WorkDate;
                    this.resetRecordForm();
                    await this.GetEfficiencyList();
                    this.showTab('records');
                } catch (error) {
                    console.error('Error saving record:', error);
                    this.showToast('Save failed.', false);
                } finally {
                    this.submitBtn.disabled = false;
                }
            }

            resetRecordForm() {
                this.form.reset();
                this.editIndexInput.value = 0;
                this.cycle = null;
                byId('workDate').value = this.todayValue;
                byId('formTitle').textContent = 'Add Efficiency Record';
                this.submitBtn.textContent = 'Add Record';
                this.calcForm();
            }

            // ───────────────────────── LOOKUPS + LIVE PREVIEW ─────────────────────────
            async lookupPart() {
                @*const partnumber = byId('partnumber').value.trim();
                if (!partnumber) {
                    this.cycle = null;
                    byId('model').value = '';
                    return this.calcForm();
                }
                try {
                    const res = await getMethod('@Url.Action("LookupPart", "Efficiency")', {
                        processId: byId('processId').value,
                        partnumber
                    });
                    const d = res?.Success ? res.data : null;
                    this.cycle = d?.Found ? d : null;
                    byId('model').value = d?.Found ? (d.Model ?? '') : '';
                    if (!d?.Found) this.showToast('No cycle time for this process + partnumber, so no target is calculated.', false);
                } catch (error) {
                    this.cycle = null;
                }
                this.calcForm();*@
            }

           async lookupEffy() {
                const effyCode = byId('effyCode').value.trim();
                if (!effyCode) { byId('employeeCode').value = ''; byId('employeeName').value = ''; return; }
                try {
                    const res = await getMethod('@Url.Action("LookupEffy", "Efficiency")', { effyCode });
                    const d = res?.Success ? res.data : null;
                    byId('employeeCode').value = d?.Found ? d.EmployeeCode : '';
                    byId('employeeName').value = d?.Found
                        ? (this.employees.find(e => e.EmployeeCode === d.EmployeeCode)?.FullName ?? '')
                        : '';
                    if (!d?.Found) this.showToast('Employee code is not registered.', false);
                } catch (error) {
                    console.error('Error looking up Effy code:', error);
                }
            }

            // Same formula as the server (CalcTarget); the saved/listed value always comes from the server.
            calcForm() {
                const toMin = v => { if (!v) return null; const p = v.split(':'); return this.num(p[0]) * 60 + this.num(p[1]); };
                const s = toMin(byId('startOpe').value);
                const e = toMin(byId('endOpe').value);
                const span = (s === null || e === null) ? null : (e >= s ? e - s : e - s + 1440); // overnight-safe

                const output = this.num(byId('output').value);
                const downtime = this.num(byId('downtimeMin').value);
                const FACTOR = 0.51;

                // Target = working hours * 3600 / cycle time (sec) * 0.51
                const workHours = span === null ? null : Math.max(0, (span - downtime) / 60);
                const target = sec => (workHours === null || !sec)
                    ? null
                    : Math.floor(workHours * 3600 / sec * FACTOR);

                const t1 = this.cycle ? target(this.cycle.CycleTimeSec) : null;
                const t2 = this.cycle ? target(this.cycle.EasedCycleTimeSec) : null;

                byId('aSpan').value = span ?? '';
                byId('aHours').value = workHours === null ? '' : workHours.toFixed(2);
                byId('aCycle').value = this.cycle ? `${this.cycle.CycleTimeSec}` : '';
                byId('aTarget').value = t1 ?? '';
                byId('aTargetEased').value = t2 ?? '';
                byId('aEff').value = t1 ? (output / t1 * 100).toFixed(2) : '';
            }

            // ───────────────────────── EXPORT ─────────────────────────
            exportCSV() {
                const head = ['DATE', 'SHIFT', 'MC.#', 'SHOP ORDER', 'PARTNUMBER', 'MODEL', 'PROCESS', 'EFFY CODE', 'EMP. CODE', 'OUTPUT', 'DOWNTIME', 'START', 'END', 'WORK HOURS', 'TARGET', 'TARGET (EASED)', 'EFFICIENCY'];
                const keys = ['WorkDate', 'Shift', 'MachineNo', 'ShopOrder', 'Partnumber', 'Model', 'ProcessName', 'EffyCode', 'EmployeeCode', 'Output', 'DowntimeMin', 'StartOpe', 'EndOpe', 'WorkHours', 'Target', 'TargetEased', 'Efficiency'];
                const csv = [head, ...this.filteredRows().map(r => keys.map(k => r[k] ?? ''))]
                    .map(row => row.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\r\n');

                const a = document.createElement('a');
                a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' }));
                a.download = 'Efficiency_Daily_Monitor.csv';
                a.click();
                URL.revokeObjectURL(a.href);
            }

            // ───────────────────────── Helpers ─────────────────────────
            showTab(id) {
                document.querySelectorAll('.panel').forEach(x => x.classList.toggle('active', x.id === id));
                document.querySelectorAll('.tab').forEach(x => x.classList.toggle('active', x.dataset.tab === id));
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            num(v) { return Number(v) || 0; }
            fmt(v) { return this.num(v).toLocaleString('en-US', { maximumFractionDigits: 2 }); }

            // Values come from the database, so escape them before putting them in innerHTML.
            esc(s) {
                return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            }

            effPill(v) {
                if (v === null || v === undefined) return '—';
                const cls = v >= 100 ? 'eff-good' : v >= 80 ? 'eff-mid' : 'eff-low';
                return `<span class="pill ${cls}">${Number(v).toFixed(2)}%</span>`;
            }

            showToast(message, success = true) {
                const toast = byId('toast');
                byId('toastMessage').textContent = message;
                toast.classList.toggle('toast-error', !success);
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2500);
            }

            // ───────────────────────── LISTS ─────────────────────────
                async loadModels() {
                    try {
                        const res = await getMethod('@Url.Action("GetModelList", "Rotor")');
                        this.models = res?.Success ? (res.data || []) : [];
                        console.log(res);
                        //console.log(this.models);
                    } catch (error) {
                        console.error('Error loading models:', error);
                        this.models = [];
                    }
                }

                async loadEmployees() {
                    try {
                        const res = await getMethod('@Url.Action("GetEmployeeList", "Rotor")');
                        this.employees = res?.Success ? (res.data || []) : [];

                        console.log(res);
                    } catch (error) {
                        console.error('Error loading employees:', error);
                        this.employees = [];
                    }
                }

                // ───────────────────────── COMBOBOXES ─────────────────────────
                setupCombos() {
                    // Machine No.
                    this.createCombo('machineNo', {
                        getItems: () => this.machines.map(m => ({ value: m, text: m })),
                        normalize: raw => { const r = raw.trim().toUpperCase().replace(/^D-?/, ''); return r ? `D-${r}` : ''; },
                        emptyText: 'No matching machine',
                        invalidMsg: 'Select a machine from D-1 to D-200.'
                    });

                 

                    // Model → fills Cycle Time (and the partnumber, so the server can calculate the same target)
                    this.createCombo('model', {
                        getItems: () => this.models
                            .filter(m => m.ProcessId === parseInt(byId('processId').value, 10))
                            .map(m => ({ value: m.Model, text: m.Model, sub: `${m.CycleTimeSec}s`, data: m })),
                        emptyText: 'No model for this process',
                        invalidMsg: 'Select a model from the list.',
                        onSelect: item => { this.cycle = item.data; this.calcForm(); },
                        onClear: () => { this.cycle = null; this.calcForm(); }
                    });

                    // Employee Code → fills Employee Name
                    this.createCombo('employeeCode', {
                        getItems: () => this.employees.map(e => ({ value: e.EmployeeCode, text: e.EmployeeCode, sub: e.FullName, data: e })),
                        emptyText: 'No matching employee',
                        invalidMsg: 'Select an employee from the list.',
                        onSelect: item => { byId('employeeName').value = item.data.FullName ?? ''; },
                        onClear: () => { byId('employeeName').value = ''; }
                    });

                    // Shop Order → searched on the server, fills Model + Cycle Time
                    this.createCombo('shopOrder', {
                        remote: async q => {
                            if (q.length < 3) return [];
                            try {
                                const res = await getMethod('@Url.Action("SearchByShopOrderFromCSV", "Rotor")', { ShopOrders: q });
                                return res?.Success
                                    ? (res.data || []).map(s => ({ value: s.ShopOrder, text: s.ShopOrder, sub: s.Model, data: s }))
                                    : [];
                            } catch (error) {
                                console.error('Error searching shop orders:', error);
                                return [];
                            }
                        },
                        emptyText: 'Type at least 3 characters',
                        invalidMsg: 'Select a shop order from the list.',
                        onSelect: item => {
                            const pid = parseInt(byId('processId').value, 10);
                            this.cycle = this.models.find(m => m.ProcessId === pid && m.Model === item.data.Model) ?? null;
                            byId('model').value = this.cycle?.Model ?? '';
                            if (!this.cycle) this.showToast('No cycle time for this model in the selected process.', false);
                            this.calcForm();
                        },
                        onClear: () => { }
                     });
                }

                // Reusable searchable select. Items: { value, text, sub?, data? }. The search matches text and sub.
            createCombo(inputId, { getItems, remote, onSelect, onClear, normalize, emptyText = 'No match', invalidMsg = 'Select a value from the list.' }) {
                const input = byId(inputId);
                const combo = input.closest('.combo');
                const list = combo.querySelector('.combo-list');
                const MAX = 100;
                let shown = [], active = -1, selected = null, cache = [], timer;

                const render = () => {
                    const q = input.value.trim().toLowerCase();
                    const items = remote
                        ? cache
                        : getItems().filter(i => `${i.text} ${i.sub ?? ''}`.toLowerCase().includes(q));
                    shown = items.slice(0, MAX);
                    list.innerHTML = shown.length
                        ? shown.map((i, n) => `<li role="option" data-n="${n}">${this.esc(i.text)}${i.sub ? `<small>${this.esc(i.sub)}</small>` : ''}</li>`).join('')
                        : `<li class="empty">${this.esc(emptyText)}</li>`;
                    active = -1;
                };
                const open = () => { render(); combo.classList.add('open'); };
                const close = () => combo.classList.remove('open');
                const choose = item => { selected = item; input.value = item.value; close(); onSelect?.(item, true); };
                const highlight = () => {
                    const els = [...list.querySelectorAll('li[data-n]')];
                    els.forEach((el, i) => el.classList.toggle('active', i === active));
                    els[active]?.scrollIntoView({ block: 'nearest' });
                };

                input.addEventListener('focus', open);
                input.addEventListener('input', () => {
                    selected = null;
                    combo.classList.add('open');
                    if (!remote) return render();
                    clearTimeout(timer);
                    timer = setTimeout(async () => {
                        const q = input.value.trim();
                        const items = await remote(q);
                        if (q !== input.value.trim()) return;   // a newer keystroke superseded this result
                        cache = items;
                        render();
                    }, 250);
                });

                input.addEventListener('blur', async () => {
                    close();
                    if (selected && selected.value === input.value) return;

                    const v = normalize ? normalize(input.value) : input.value.trim();
                    const pool = (remote && v) ? await remote(v) : (getItems ? getItems() : []);
                    const hit = pool.find(i => i.value === v);
                    if (hit) { selected = hit; input.value = hit.value; onSelect?.(hit, false); return; }

                    if (input.value.trim()) this.showToast(invalidMsg, false);
                    input.value = '';
                    selected = null;
                    onClear?.();
                });

                input.addEventListener('keydown', e => {
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (!combo.classList.contains('open')) open();
                        active = Math.min(active + 1, shown.length - 1); highlight();
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        active = Math.max(active - 1, 0); highlight();
                    } else if (e.key === 'Enter' && combo.classList.contains('open') && shown.length) {
                        e.preventDefault();
                        choose(shown[active >= 0 ? active : 0]);
                    } else if (e.key === 'Escape') {
                        close();
                    }
                });

                list.addEventListener('mousedown', e => {
                    const li = e.target.closest('li[data-n]');
                    if (li) { e.preventDefault(); choose(shown[+li.dataset.n]); }
                });
            }



        }

        document.addEventListener('DOMContentLoaded', function () {
            const controller = new EfficiencyManageController();
            controller.init();
        });
    </script>

</body>
</html>
