           // ───────────────────────── LIVE PREVIEW ─────────────────────────
           // Same formula as the server (CalcTarget); the saved/listed value always comes from the server.

           calcForm() {
               const toMin = (value) => {
                   if (!value) return 0;

                   const [hours, minutes] = value.split(':').map(Number);
                   return (hours * 60) + minutes;
               };

               // Get start and end time
               const start = toMin(byId('startOpe')?.value);
               const end = toMin(byId('endOpe')?.value);

               const output = Number(byId('output')?.value) || 0;
               const downtime = Number(byId('downtimeMin')?.value) || 0;

               // Get Cycle Time from selected Partnumber / Model
               const cycleTimeSec = Number(this.cycle?.CycleTimeSec) || 0;
               const easedCycleTimeSec = Number(this.cycle?.EasedCycleTimeSec) || 0;

               // Calculate time span (supports overnight)
               let span = end - start;

               if (span < 0) {
                   span += 1440;
               }

               // Calculate working hours
               const workMinutes = Math.max(0, span);
               const workHours = workMinutes / 60 ;

               // Calculate Target
               const target = cycleTimeSec > 0
                   ? Math.round((workHours * 3600) / cycleTimeSec)
                   : 0;

               const finalTarget = Math.round(target);

               // Calculate Eased Target
               const targetEased = easedCycleTimeSec > 0
                   ? Math.floor((workHours.toFixed(2) * 3600) / easedCycleTimeSec)
                   : 0;

               // Calculate Efficiency
               const efficiency = target > 0
                   ? (output / target) * 100
                   : 0;

               const dtpics = Math.round((downtime * 60) / cycleTimeSec);

               // Target Less DP
               const targetless = target - dtpics.toFixed(1);

               const targetEfficient = targetless > 0
                   ? (output / targetless) * 100
                   : 0;


               // console.log("Target : " + target);
               // console.log("Cycle Time : " + cycleTimeSec.toFixed(2));
               // console.log("D.T. IN PCS: " + dtpics);
               // console.log("Target less DP: " + targetless);
               // console.log(`Final Efficiency : ${output}  / ${targetless} : ${targetEfficient}`);
               const box = document.querySelector('.calc-box');
               box.classList.toggle('is-night', this.isNight && !!byId('startOpe').value);


               // Display Summary
               byId('aSpan').textContent =
                   `${Math.floor(span / 60)}h ${span % 60}m`;

               byId('aHours').textContent = workHours.toFixed(2);
               byId('aCycle').textContent = cycleTimeSec > 0
                   ? cycleTimeSec.toFixed(2)
                   : '—';

               byId('aTarget').textContent = target.toLocaleString();
               byId('aTargetEased').textContent = targetEased.toLocaleString();
               byId('aEff').textContent = `${targetEfficient.toFixed(2)}%`;

               const shiftEl = byId('aShift');
               if (byId('startOpe').value) {
                   shiftEl.innerHTML = this.shiftBadge(this.isNight);
               } else {
                   shiftEl.textContent = '—';
               }
           }


           // ───────────────────────── EXPORT ─────────────────────────
           exportCSV() {
               const head = ['DATE', 'SHIFT', 'MC.#', 'SHOP ORDER', 'PARTNUMBER', 'MODEL', 'PROCESS', 'EFFY CODE', 'EMP. CODE', 'OUTPUT', 'DOWNTIME', 'START', 'END', 'WORK HOURS', 'TARGET', 'TARGET (EASED)', 'EFFICIENCY'];
               const keys = ['WorkDate', 'ShiftCode', 'MachineNo', 'ShopOrder', 'Partnumber', 'getModel', 'ProcessName', 'EffyCode', 'EmployeeCode', 'Output', 'DowntimeMin', 'StartOpe', 'EndOpe', 'WorkHours', 'Target', 'TargetEased', 'Efficiency'];
               const csv = [head, ...this.filteredRows().map(r => keys.map(k => r[k] ?? ''))]
                   .map(row => row.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\r\n');

               const a = document.createElement('a');
               a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' }));
               a.download = 'Efficiency_Daily_Monitor.csv';
               a.click();
               URL.revokeObjectURL(a.href);
           }

           // ───────────────────────── Helpers ─────────────────────────
           num(v) { return Number(v) || 0; }
           fmt(v) { return this.num(v).toLocaleString('en-US', { maximumFractionDigits: 2 }); }

           // Values come from the database, so escape them before putting them in innerHTML.
           esc(s) {
               return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
           }

           effPill(v) {
               if (v === null || v === undefined) return '—';
               const cls = v >= 100 ? 'eff-good' : v >= 80 ? 'eff-mid' : 'eff-low';
               return `<span class="pill ${cls}">${Number(v).toFixed(2)}%</span>`;
           }

