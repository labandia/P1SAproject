<!DOCTYPE html>
<html lang="en">
<head>
    @Html.Partial("_SystemConfig")
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="~/Content/Images/inventory-management.ico">
    <meta name="description" content="Learn how to improve your website with caching, accessibility, and SEO best practices.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Production Control · Efficiency Monitor</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/css/EfficiencyDesign.css" rel="stylesheet" />

    <script src="~/Scripts/xlsx.full.min.js"></script>

    @Styles.Render("~/Content/shared-css")

    @Scripts.Render("~/bundles/shared-js")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- ========== HEADER ========== -->
    <header class="app-header">
        <div class="header-left">
            <div class="header-icon">
                <i class="fa-regular fa-file-lines"></i>
            </div>
            <div>
                <div class="header-title">
                    <h1>Efficiency Daily Monitor</h1>
                </div>
                <p class="header-subtitle">Digital Encoder · Rotor Section</p>
            </div>
        </div>
        <div class="header-right">
            <div class="nav-group">
                <a href="/Production1/Rotor/Dashboard" class="nav-btn" style="text-decoration:none;">
                    <i class="fa-solid fa-gauge-high"></i><span class="nav-text">Dashboard</span>
                </a>
                <a class="nav-btn" href="/Production1/Rotor/Encoder" style="text-decoration:none;">
                    <i class="fa-regular fa-keyboard"></i><span class="nav-text">Encoder</span>
                </a>
                <button class="nav-btn" id="dataMenuBtn" type="button"
                        aria-haspopup="dialog" aria-controls="dataMenuModal">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <span class="nav-text">Data</span>
                </button>
            </div>
            <div class="live-clock" id="liveClock">--:--:--</div>
            <div class="db-status" title="Database Connected: PMACS_TEST">
                <i class="fa-solid fa-database"></i>
                <span class="dot"></span>
            </div>
        </div>
    </header>


    @RenderBody()





    <!-- ========== DATA & OPERATIONS WORKSPACE ========== -->
    <div class="data-workspace-overlay" id="dataMenuModal" aria-hidden="true">
        <section class="data-workspace" role="dialog" aria-modal="true" aria-labelledby="dataWorkspaceTitle">

            <header class="dw-header">
                <div class="dw-brand">
                    <div class="dw-brand-icon"><i class="fa-solid fa-table-cells-large"></i></div>
                    <div class="dw-heading">
                        <div class="dw-title-row">
                            <h2 id="dataWorkspaceTitle">Data &amp; Operations Workspace</h2>
                            <span class="dw-status"><span class="dw-status-dot"></span>SYNC ONLINE</span>
                        </div>
                        <p>Manage data synchronization, cycle times, and production efficiency records.</p>
                    </div>
                </div>
                <div class="dw-window-actions">
                    <button type="button" class="dw-icon-btn" id="closeDataModal" aria-label="Close workspace">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </header>

            <div class="dw-body">
                <aside class="dw-sidebar">
                    <div class="dw-sidebar-label">WORKSPACE MODULES</div>

                    <button type="button" class="dw-module active" data-workspace="csv">
                        <i class="fa-regular fa-file-lines"></i>
                        <span class="dw-module-text">Import data</span>
                        <span class="dw-module-badge">Ready</span>
                    </button>
                    <button type="button" class="dw-module" data-workspace="cycle">
                        <i class="fa-solid fa-stopwatch"></i>
                        <span class="dw-module-text">Cycle Time Master</span>
                        <span class="dw-module-badge" data-count="cycle">0</span>
                    </button>
                    <button type="button" class="dw-module" data-workspace="records">
                        <i class="fa-solid fa-id-badge"></i>
                        <span class="dw-module-text">Employee Codes</span>
                        <span class="dw-module-badge" data-count="employee">0</span>
                    </button>
                    <button type="button" class="dw-module" data-workspace="shoporder">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span class="dw-module-text">Shop Orders</span>
                        <span class="dw-module-badge" data-count="shoporder">0</span>
                    </button>

                    <div class="dw-sidebar-bottom">
                        <div class="dw-capacity"><span>DATA OPERATIONS</span><strong>READY</strong></div>
                        <div class="dw-capacity-bar"><span></span></div>
                        <div class="dw-help">
                            <i class="fa-regular fa-circle-question"></i>
                            <span>Workspace documentation</span>
                        </div>
                    </div>
                </aside>

                <div class="dw-content">

                    <!-- IMPORT PANEL -->
                    <section class="dw-panel active" id="dwPanelCsv">
                        <div class="dw-panel-heading">
                            <div>
                                <h3>Import Data</h3>
                                <p>Upload one Excel file containing the Cycle Time, Employee Codes and Shop Orders sheets, review the validation result, then submit the valid rows.</p>
                            </div>
                            <span class="dw-ready-badge"><i class="fa-solid fa-circle-check"></i> Available</span>
                        </div>

                        <div class="dw-action-grid">
                            <button type="button" class="dw-action-card" data-upload>
                                <div class="dw-action-icon"><i class="fa-solid fa-file-excel"></i></div>
                                <div class="dw-action-copy">
                                    <strong>Upload File</strong>
                                    <span>One Excel file (.xlsx, .xls) with all three sheets: Cycle Time, Employee Codes, Shop Orders</span>
                                </div>
                                <i class="fa-solid fa-chevron-right dw-chevron"></i>
                            </button>

                            <button type="button" class="dw-action-card" data-template>
                                <div class="dw-action-icon"><i class="fa-solid fa-download"></i></div>
                                <div class="dw-action-copy">
                                    <strong>Download Template</strong>
                                    <span>Excel workbook with the three sheets, ready to fill in</span>
                                </div>
                                <i class="fa-solid fa-chevron-right dw-chevron"></i>
                            </button>
                        </div>

                        <div class="dw-info">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>The data type is detected from the column headers. Existing records are updated and new ones are added. Invalid rows are skipped and listed in the preview.</span>
                        </div>
                    </section>

                    <!-- CYCLE TIME PANEL -->
                    <section class="dw-panel" id="dwPanelCycle">
                        <div class="dw-panel-heading">
                            <div>
                                <h3>Cycle Time Master</h3>
                                <p>Maintain process cycle times used in efficiency calculations.</p>
                            </div>
                            <div class="dw-tools">
                                <input type="search" class="dw-search" data-search="cycle" placeholder="Search...">
                                <button type="button" class="dw-add-btn" data-add="cycle"><i class="fa-solid fa-plus"></i> Add</button>
                            </div>
                        </div>
                        <div class="table-scroll dw-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Part number</th>
                                        <th>Model</th>
                                        <th>Process name</th>
                                        <th>Cycle time (sec)</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="CycleTimeBody"></tbody>
                            </table>
                        </div>
                    </section>

                    <!-- EMPLOYEE CODES PANEL -->
                    <section class="dw-panel" id="dwPanelRecords">
                        <div class="dw-panel-heading">
                            <div>
                                <h3>Employee Code Management</h3>
                                <p>Map each efficiency code to an employee ID.</p>
                            </div>
                            <div class="dw-tools">
                                <input type="search" class="dw-search" data-search="employee" placeholder="Search...">
                                <button type="button" class="dw-add-btn" data-add="employee"><i class="fa-solid fa-plus"></i> Add</button>
                            </div>
                        </div>
                        <div class="table-scroll dw-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Employee code</th>
                                        <th>Employee ID</th>
                                        <th>Full name</th>
                                        <th>Process</th>
                                        <th>Affiliation</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="EmployeeBody"></tbody>
                            </table>
                        </div>
                    </section>

                    <!-- SHOP ORDER PANEL -->
                    <section class="dw-panel" id="dwPanelShoporder">
                        <div class="dw-panel-heading">
                            <div>
                                <h3>Shop Order Management</h3>
                                <p>Shop orders used to auto-fill part number and model in the encoder.</p>
                            </div>
                            <div class="dw-tools">
                                <input type="search" class="dw-search" data-search="shoporder" placeholder="Search...">
                                <button type="button" class="dw-add-btn" data-add="shoporder"><i class="fa-solid fa-plus"></i> Add</button>
                            </div>
                        </div>
                        <div class="table-scroll dw-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Shop order</th>
                                        <th>Part number</th>
                                        <th>Model</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="ShopOrderBody"></tbody>
                            </table>
                        </div>
                    </section>

                </div>
            </div>
        </section>
    </div>

    <!-- ========== CYCLE TIME FORM ========== -->
    <div class="form-overlay" id="cycleFormOverlay" aria-hidden="true">
        <form id="cycleForm" class="fm-card" novalidate>
            <header class="fm-head">
                <div class="fm-icon"><i class="fa-solid fa-stopwatch"></i></div>
                <div class="fm-titles">
                    <h3 id="cycleFormTitle"></h3>
                    <p>Cycle time per part number and process.</p>
                </div>
                <button type="button" class="fm-x" data-close-form aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </header>
            <div class="fm-body">
                <input type="hidden" name="Id" value="0">
                <div class="fm-field fm-span-2">
                    <label for="cyPartnumber">Part number <span class="fm-req">*</span></label>
                    <input type="text" id="cyPartnumber" name="Partnumber" placeholder="e.g. 00847759-01" required maxlength="50" autocomplete="off">
                </div>
                <div class="fm-field fm-span-2">
                    <label for="cyModel">Model <span class="fm-req">*</span></label>
                    <input type="text" id="cyModel" name="Model" placeholder="e.g. LG92*38" required maxlength="50" autocomplete="off">
                </div>
                <div class="fm-field">
                    <label for="cyProcessName">Process name <span class="fm-req">*</span></label>
                    <select id="cyProcessName" name="ProcessName" required>
                        <option value="0">Select process</option>
                        <option value="1">3mm Cover Drilling</option>
                        <option value="2">3mm Impeller Drilling</option>
                        <option value="3">3mm Compound Application</option>

                        <option value="4">5mm Compound Application</option>
                        <option value="5">6mm Compound Application</option>
                        <option value="6">8mm Compound Application</option>
                    </select>
                </div>
                <div class="fm-field">
                    <label for="cyCycleTimeSec">Cycle time (sec) <span class="fm-req">*</span></label>
                    <input type="number" id="cyCycleTimeSec" name="CycleTimeSec" step="0.01" min="0" placeholder="0.00" required>
                </div>


            </div>
            <div id="cycleFormError" class="fm-error" role="alert"></div>
            <footer class="fm-foot">
                <button type="button" class="fm-btn" data-close-form>Cancel</button>
                <button type="submit" class="fm-btn fm-btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            </footer>
        </form>
    </div>

    <!-- ========== EMPLOYEE CODE FORM ========== -->
    <div class="form-overlay" id="employeeFormOverlay" aria-hidden="true">
        <form id="employeeForm" class="fm-card" novalidate>
            <header class="fm-head">
                <div class="fm-icon"><i class="fa-solid fa-id-badge"></i></div>
                <div class="fm-titles">
                    <h3 id="employeeFormTitle"></h3>
                    <p>Links an efficiency code to an employee ID.</p>
                </div>
                <button type="button" class="fm-x" data-close-form aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </header>
            <div class="fm-body">
                <input type="hidden" name="Id" value="0">
                <div class="fm-field">
                    <label for="emEffyCode">Employee code (Effy) <span class="fm-req">*</span></label>
                    <input type="text" id="emEffyCode" name="EffyCode" placeholder="e.g. S2CR1040" required maxlength="30" autocomplete="off">
                </div>
                <div class="fm-field">
                    <label for="emEmployeeCode">Employee ID <span class="fm-req">*</span></label>
                    <input type="text" id="emEmployeeCode" name="EmployeeCode" placeholder="e.g. 12345" required maxlength="30" autocomplete="off">
                </div>
            </div>
            <div id="employeeFormError" class="fm-error" role="alert"></div>
            <footer class="fm-foot">
                <button type="button" class="fm-btn" data-close-form>Cancel</button>
                <button type="submit" class="fm-btn fm-btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            </footer>
        </form>
    </div>

    <!-- ========== SHOP ORDER FORM ========== -->
    <div class="form-overlay" id="shoporderFormOverlay" aria-hidden="true">
        <form id="shoporderForm" class="fm-card" novalidate>
            <header class="fm-head">
                <div class="fm-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="fm-titles">
                    <h3 id="shoporderFormTitle"></h3>
                    <p>12-digit shop order with its part number and model.</p>
                </div>
                <button type="button" class="fm-x" data-close-form aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </header>
            <div class="fm-body">
                <input type="hidden" name="Id" value="0">
                <div class="fm-field fm-span-2">
                    <label for="soShopOrder">Shop order <span class="fm-req">*</span></label>
                    <input type="text" id="soShopOrder" name="ShopOrder" placeholder="12 digits" required
                           inputmode="numeric" pattern="\d{12}" title="Exactly 12 digits" autocomplete="off">
                </div>
                <div class="fm-field">
                    <label for="soPartnumber">Part number <span class="fm-req">*</span></label>
                    <input type="text" id="soPartnumber" name="Partnumber" placeholder="e.g. 00885817-01" required maxlength="50" autocomplete="off">
                </div>
                <div class="fm-field">
                    <label for="soModel">Model</label>
                    <input type="text" id="soModel" name="Model" placeholder="e.g. LG92*38" maxlength="50" autocomplete="off">
                </div>
            </div>
            <div id="shoporderFormError" class="fm-error" role="alert"></div>
            <footer class="fm-foot">
                <button type="button" class="fm-btn" data-close-form>Cancel</button>
                <button type="submit" class="fm-btn fm-btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save</button>
            </footer>
        </form>
    </div>

    <!-- ========== IMPORT DIALOG (Excel) ========== -->
    <div class="form-overlay" id="importOverlay" aria-hidden="true">
        <div class="fm-card fm-wide" role="dialog" aria-modal="true" aria-labelledby="importTitle">
            <header class="fm-head">
                <div class="fm-icon"><i class="fa-solid fa-file-arrow-up"></i></div>
                <div class="fm-titles">
                    <h3 id="importTitle">Import Data</h3>
                    <p id="importHint"></p>
                </div>
                <button type="button" class="fm-x" data-close-import aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </header>

            <div class="fm-body fm-stack">
                <label class="imp-drop" id="importDrop" for="importFile">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <strong id="importFileName">Choose an Excel file or drop it here</strong>
                    <span>First row of each sheet must be the header row.</span>
                    <input type="file" id="importFile" accept=".xlsx,.xls" hidden>
                </label>

                <div class="imp-tabs" id="importTabs" hidden></div>

                <div class="imp-summary" id="importSummary" hidden></div>

                <div class="imp-preview" id="importPreviewWrap" hidden>
                    <table class="data-table">
                        <thead id="importHead"></thead>
                        <tbody id="importBody"></tbody>
                    </table>
                </div>
            </div>

            <div id="importError" class="fm-error" role="alert"></div>
            <footer class="fm-foot">
                <button type="button" class="fm-btn fm-btn-left" id="importTemplateBtn">
                    <i class="fa-solid fa-download"></i> Template
                </button>
                <button type="button" class="fm-btn" data-close-import>Cancel</button>
                <button type="button" class="fm-btn fm-btn-primary" id="importSubmitBtn" disabled>
                    <i class="fa-solid fa-cloud-arrow-up"></i> <span>Import</span>
                </button>
            </footer>
        </div>
    </div>



    <script type="module">
    import { getMethod, postMethod } from '@Url.Content("~/Scripts/modules/index.js")';

    const byId = id => document.getElementById(id);
    const CHUNK = 500; // rows per import request (keeps JSON payloads under MVC's default limit)

    // ======================================================================
    // CONFIG
    // ======================================================================
    const ENTITIES = {
        cycle: {
            label: 'Cycle Time', panel: 'cycle', bodyId: 'CycleTimeBody',
            overlayId: 'cycleFormOverlay', formId: 'cycleForm', titleId: 'cycleFormTitle', errorId: 'cycleFormError',
            idKey: 'CycleID',
            fields: ['Partnumber', 'Model', 'ProcessName',  'CycleTimeSec'],
            cols:    ['Partnumber', 'Model', 'ProcessName', 'CycleTimeSec'],
            listUrl: '@Url.Action("GetModelList", "Rotor")',
            saveUrl: '@Url.Action("SaveCycleTime", "Rotor")',
            deleteUrl: '@Url.Action("DeleteCycleTime", "Rotor")',
            describe: r => `${r.Partnumber} `
        },
        employee: {
            label: 'Employee Code', panel: 'records', bodyId: 'EmployeeBody',
            overlayId: 'employeeFormOverlay', formId: 'employeeForm', titleId: 'employeeFormTitle', errorId: 'employeeFormError',
            idKey: 'EmployID',
            fields:  ['EffyCode', 'EmployeeCode'],
            cols:    ['EffyCode', 'EmployeeCode', 'FullName', 'Process', 'AgencyName'],
            listUrl: '@Url.Action("GetEmployeeList", "Rotor")',
            saveUrl: '@Url.Action("SaveEditEmployeeCode", "Rotor")',
            deleteUrl: '@Url.Action("DeleteEmployeeCode", "Rotor")',
            describe: r => `${r.EffyCode} (${r.FullName || 'no name'})`
        },
        shoporder: {
            label: 'Shop Order', panel: 'shoporder', bodyId: 'ShopOrderBody',
            overlayId: 'shoporderFormOverlay', formId: 'shoporderForm', titleId: 'shoporderFormTitle', errorId: 'shoporderFormError',
            idKey: 'StagingId',
            fields:  ['ShopOrder', 'Partnumber', 'Model'],
            cols:    ['ShopOrder', 'Partnumber', 'Model'],
            listUrl: '@Url.Action("SearchByShopOrderFromCSV", "Rotor")',
            saveUrl: '@Url.Action("SaveShopOrder", "Rotor")',
            deleteUrl: '@Url.Action("DeleteShopOrder", "Rotor")',
            describe: r => `${r.ShopOrder}`
        }
    };

    // ======================================================================
    // IMPORT CONFIG - rows are sent with the SAME property names / types as the C# models:
    //   cycle     -> EfficiencyCycleTime         { Partnumber, Model, ProcessId (byte), CycleTimeSec (decimal 9,2) }
    //   employee  -> EfficiencyEmployeeCode      { EffyCode, EmployeeCode }
    //   shoporder -> EfficiencyShopOrderStaging  { ShopOrder, Partnumber, Model }
    // Header names are matched after lower-casing and stripping everything except a-z / 0-9.
    // ======================================================================
    // Same mapping as EfficiencyCycleTime.ProcessId (1 = COVER DRILLING, 2 = IMPELLER, 3 = EPIFORM)
    const PROCESSES = [
        { id: 1, name: 'COVER DRILLING' },
        { id: 2, name: 'IMPELLER' },
        { id: 3, name: 'EPIFORM' }
    ];
    const norm = s => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
    // accepts the process name (any spacing/case) or the numeric ProcessId 1/2/3
    const findProcess = v => PROCESSES.find(p => norm(p.name) === norm(v) || String(p.id) === String(v).trim());

    const IMPORTS = {
        cycle: {
            title: 'Import Cycle Time Data',
            url: '@Url.Action("ImportCycleTime", "Rotor")',
            columns: [
                { key: 'Partnumber',   aliases: ['partnumber', 'partno', 'partnum'], required: true, maxLen: 50 },   // NVARCHAR(50)
                { key: 'Model',        aliases: ['model'], required: false, maxLen: 100 },                          // NVARCHAR(100) NULL
                { key: 'ProcessName',  aliases: ['processname', 'process', 'processid'], required: true,           // -> ProcessId (FK EfficiencyProcess)
                  normalize: v => findProcess(v)?.name ?? v,
                  validate: v => findProcess(v) ? '' : 'must be COVER DRILLING, IMPELLER or EPIFORM (or 1/2/3)' },
                { key: 'CycleTimeSec', aliases: ['cycletimesec', 'cycletime', 'ct'], required: true,               // DECIMAL(9,2), > 0
                  validate: v => (v !== '' && !isNaN(v) && Number(v) > 0 && Number(v) <= 9999999.99) ? '' : 'must be a number > 0 (max 9,999,999.99)' }
            ],
            // shape sent to the server = EfficiencyCycleTime
            toPayload: o => ({
                Partnumber: o.Partnumber,
                Model: o.Model || null,
                ProcessId: findProcess(o.ProcessName).id,
                CycleTimeSec: Math.round(Number(o.CycleTimeSec) * 100) / 100
            }),
            dupKey: o => (o.Partnumber + '|' + findProcess(o.ProcessName)?.id).toLowerCase()   // unique per Partnumber + ProcessId
        },
        employee: {
            title: 'Import Employee Codes',
            url: '@Url.Action("ImportEmployeeCode", "Rotor")',
            columns: [
                { key: 'EffyCode', aliases: ['effycode', 'code'], required: true, maxLen: 20 },                  // NVARCHAR(20), PK
                { key: 'EmployeeCode', aliases: ['employeecode', 'employeeid', 'empid', 'idnumber'], required: true, maxLen: 20 }
            ],
            // shape sent to the server = EfficiencyEmployeeCode (EmployID / FullName / Process / AgencyName are filled by the DB)
            toPayload: o => ({ EffyCode: o.EffyCode, EmployeeCode: o.EmployeeCode }),
            dupKey: o => o.EffyCode.toLowerCase()
        },
        shoporder: {
            title: 'Import Shop Order Data',
            url: '@Url.Action("ImportShopOrders", "Rotor")',
            columns: [
                { key: 'ShopOrder',   aliases: ['shoporder', 'so'], required: true, maxLen: 20,                     // NVARCHAR(20)
                  validate: v => /^\d{12}$/.test(v) ? '' : 'must be 12 digits' },
                { key: 'Partnumber',  aliases: ['partnumber', 'partno', 'partnum'], required: true, maxLen: 50 },
                { key: 'Model',       aliases: ['model'], required: false, maxLen: 50 }
            ],
            // shape sent to the server = EfficiencyShopOrderStaging
            toPayload: o => ({ ShopOrder: o.ShopOrder, Partnumber: o.Partnumber, Model: o.Model || null }),
            dupKey: o => o.ShopOrder.toLowerCase()
        }
    };

    // ======================================================================
    // Import helpers (SheetJS reads .xlsx, .xls and .csv)
    // ======================================================================
const SHEET_NAMES = { cycle: 'CYCLETIME', employee: 'CODE', shoporder: 'CSV' };
        const ACTIVE_IMPORTS = ['shoporder', 'employee'];   // add 'employee' / 'cycle' here when ready
    const cellText = v => (v instanceof Date) ? v.toISOString().slice(0, 10) : String(v ?? '').trim();

    // SheetJS is a classic script loaded in <head>; check it actually loaded (CDN may be blocked on the factory network)
    function sheetJsReady() {
        if (typeof window.XLSX !== 'undefined') return true;
        alert('The Excel library (SheetJS) failed to load. Check the internet connection, or host xlsx.full.min.js locally and update the <script> tag in the layout.');
        return false;
    }

    function downloadTemplate() {
        if (!sheetJsReady()) return;
        const wb = XLSX.utils.book_new();
        Object.keys(IMPORTS).forEach(key => {
            const headers = IMPORTS[key].columns.map(c => c.key);
            const ws = XLSX.utils.aoa_to_sheet([headers]);
            ws['!cols'] = headers.map(h => ({ wch: Math.max(16, h.length + 4) }));
            XLSX.utils.book_append_sheet(wb, ws, SHEET_NAMES[key]);
        });
        XLSX.writeFile(wb, 'Efficiency_Import_Template.xlsx');
    }

    // ======================================================================
    // MAIN CONTROLLER
    // ======================================================================
    class DataManagementController {
        constructor() {
            this.rows = { cycle: [], employee: [], shoporder: [] };
            this.loaded = {};
            this.filters = { cycle: '', employee: '', shoporder: '' };
            this.importState = null;
            this.modal = byId('dataMenuModal');
            this.bindModal();
            this.bindEvents();
            this.bindImport();
        }

        // ---------- workspace modal ----------
        bindModal() {
            byId('dataMenuBtn').addEventListener('click', () => this.openModal());
            byId('closeDataModal').addEventListener('click', () => this.closeModal());
            this.modal.addEventListener('mousedown', e => { if (e.target === this.modal) this.closeModal(); });

            document.querySelectorAll('.dw-module').forEach(btn =>
                btn.addEventListener('click', () => this.showModule(btn.dataset.workspace)));

            document.addEventListener('keydown', e => {
                if (e.key !== 'Escape') return;
                // close the top-most layer first
                const imp = byId('importOverlay');
                if (imp.classList.contains('open')) return this.closeImport();
                const form = Object.keys(ENTITIES).find(k => byId(ENTITIES[k].overlayId).classList.contains('open'));
                if (form) return this.closeForm(form);
                if (this.modal.classList.contains('show')) this.closeModal();
            });
        }

        openModal() {
            this.modal.classList.add('show');
            this.modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            this.ensureLoaded('cycle'); this.ensureLoaded('employee'); this.ensureLoaded('shoporder');
        }

        closeModal() {
            this.modal.classList.remove('show');
            this.modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        showModule(name) {
            const panels = { csv: 'dwPanelCsv', cycle: 'dwPanelCycle', records: 'dwPanelRecords', shoporder: 'dwPanelShoporder' };
            document.querySelectorAll('.dw-module').forEach(b => b.classList.toggle('active', b.dataset.workspace === name));
            Object.entries(panels).forEach(([k, id]) => byId(id).classList.toggle('active', k === name));
        }

        // ---------- events (CRUD) ----------
        bindEvents() {
            document.addEventListener('click', e => {
                const add = e.target.closest('[data-add]');
                if (add) return this.openForm(add.dataset.add, null);

                // single Upload File button (Excel / CSV)
                if (e.target.closest('[data-upload]')) return this.openImport(true);

                // Download Template button
                if (e.target.closest('[data-template]')) return downloadTemplate();

                const btn = e.target.closest('.row-btn');
                if (!btn) return;
                const { entity, id } = btn.dataset;
                const row = this.rows[entity].find(r => String(this.getId(entity, r)) === id);
                if (!row) return;
                if (btn.classList.contains('edit'))   this.openForm(entity, row);
                if (btn.classList.contains('delete')) this.deleteRow(entity, row);
            });

            document.addEventListener('input', e => {
                const s = e.target.closest('[data-search]');
                if (!s) return;

                this.filters[s.dataset.search] = s.value.trim().toLowerCase();
                this.render(s.dataset.search);
            });

            Object.keys(ENTITIES).forEach(key => {
                const cfg = ENTITIES[key];
                const overlay = byId(cfg.overlayId);
                byId(cfg.formId).addEventListener('submit', e => { e.preventDefault(); this.submitForm(key); });
                overlay.querySelectorAll('[data-close-form]').forEach(b => b.addEventListener('click', () => this.closeForm(key)));
                overlay.addEventListener('mousedown', e => { if (e.target === overlay) this.closeForm(key); });
            });
        }

        openForm(key, row) {
            const cfg = ENTITIES[key], form = byId(cfg.formId);


            if (row) {
                const id = row[cfg.idKey];
                if (id === undefined || id === null) {
                    console.error(`idKey "${cfg.idKey}" not found in row`, row);
                    alert('Cannot edit: record ID is missing from the list data.');
                    return;
                }
                form.elements['Id'].value = id;
            } else {
                form.elements['Id'].value = 0;
            }

            form.reset();
            form.elements['Id'].value = row ? this.getId(key, row) : 0;   // 0 = insert
            cfg.fields.forEach(n => {
                const el = form.elements[n];
                if (el) el.value = row ? (row[n] ?? '') : '';
            });
            byId(cfg.titleId).textContent = (row ? 'Edit ' : 'Add ') + cfg.label;
            byId(cfg.errorId).textContent = '';
            const overlay = byId(cfg.overlayId);
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            form.elements[cfg.fields[0]]?.focus();
        }

        closeForm(key) {
            const overlay = byId(ENTITIES[key].overlayId);
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
        }

        async submitForm(key) {
            const cfg = ENTITIES[key], form = byId(cfg.formId);
            byId(cfg.errorId).textContent = '';

            if (!form.reportValidity()) return;

            // Use the entity-specific key (CycleId / EmployeeId / ShopOrderId)
            const payload = { [cfg.idKey]: Number(form.elements['Id'].value) || 0 };
            cfg.fields.forEach(n => {
                const el = form.elements[n];
                if (!el) { console.warn(`Field "${n}" not found in ${cfg.formId}`); return; }
                payload[n] = el.value.trim();
            });

            const saveBtn = form.querySelector('[type="submit"]');
            saveBtn.disabled = true;

            console.log("URL" + cfg.saveUrl);
            console.log(payload);
            try {
                const res = await postMethod(cfg.saveUrl, payload);
                console.log(res);
                if (!res?.Success) {
                    this.showError(key, res?.Message || `Unable to save ${cfg.label.toLowerCase()}.`);
                    return;
                }
                this.closeForm(key);
                await this.load(key);
            } catch (ex) {
                console.error('Save failed:', ex);
                this.showError(key, ex?.message || 'Unexpected error while saving.');
            } finally { saveBtn.disabled = false; }
        }

        async deleteRow(key, row) {
            const cfg = ENTITIES[key];
            if (!confirm(`Delete ${cfg.describe(row)}? This cannot be undone.`)) return;
            try {
                const res = await postMethod(cfg.deleteUrl, { [cfg.idKey]: this.getId(key, row) });
                if (!res?.Success) { alert(res?.Message || 'Delete failed.'); return; }
                await this.load(key);
            } catch (ex) {
                console.error('Delete failed:', ex);
                alert('Unexpected error while deleting.');
            }
        }

        showError(key, msg) {
            const el = byId(ENTITIES[key].errorId);
            el.textContent = msg;
            el.classList.remove('shake');
            void el.offsetWidth;            // restart the animation if the same error repeats
            el.classList.add('shake');
        }

        // ---------- loading / rendering ----------
        ensureLoaded(key) { if (!this.loaded[key]) { this.loaded[key] = true; return this.load(key); } }

        async load(key) {
            try {
                const res = await getMethod(ENTITIES[key].listUrl);
                this.rows[key] = res?.Success ? (res.data || []) : [];
                console.log(key, Object.keys(this.rows[key][0] || {}));
            } catch (ex) {
                console.error(`Error loading ${key}:`, ex);
                this.rows[key] = [];
            }
            this.render(key);
        }

        render(key) {
            const cfg = ENTITIES[key], f = this.filters[key];
            const list = f
                ? this.rows[key].filter(r => cfg.cols.some(c => String(r[c] ?? '').toLowerCase().includes(f)))
                : this.rows[key];

            const badge = document.querySelector(`[data-count="${key}"]`);
            if (badge) badge.textContent = this.rows[key].length;

            byId(cfg.bodyId).innerHTML = list.map(r => `
                <tr>
                    ${cfg.cols.map(c => `<td>${this.esc(r[c])}</td>`).join('')}
                    ${this.actionCell(key, r)}
                </tr>`).join('') ||
                `<tr><td colspan="${cfg.cols.length + 1}" class="empty">No records found.</td></tr>`;
        }

        actionCell(entity, r) {
            const id = this.esc(this.getId(entity, r));
            return `
                <td class="col-actions">
                    <div class="row-actions">
                        <button type="button" class="row-btn edit" title="Edit" data-entity="${entity}" data-id="${id}"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" class="row-btn delete" title="Delete" data-entity="${entity}" data-id="${id}"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </td>`;
        }

        esc(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        // ======================================================================
        // EXCEL / CSV IMPORT
        // ======================================================================
        bindImport() {
            const overlay = byId('importOverlay'), file = byId('importFile'), drop = byId('importDrop');

            overlay.querySelectorAll('[data-close-import]').forEach(b => b.addEventListener('click', () => this.closeImport()));
            overlay.addEventListener('mousedown', e => { if (e.target === overlay) this.closeImport(); });

            file.addEventListener('change', () => { if (file.files[0]) this.readFile(file.files[0]); });
            ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
            ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
            drop.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f) this.readFile(f); });

            byId('importSubmitBtn').addEventListener('click', () => this.submitImport());
            byId('importTemplateBtn').addEventListener('click', () => downloadTemplate());
        }

        openImport(pickNow) {
            this.importState = { datasets: [], active: 0 };
            byId('importTitle').textContent = 'Import Data';
            byId('importHint').textContent = 'One Excel file with the sheets: Cycle Time, Employee Codes, Shop Orders. All sheets found are imported together.';
            byId('importFile').value = '';
            byId('importFileName').textContent = 'Choose an Excel file or drop it here';
            byId('importSummary').hidden = true;
            byId('importTabs').hidden = true;
            byId('importPreviewWrap').hidden = true;
            byId('importError').textContent = '';
            this.setImportBtn(false);

            const overlay = byId('importOverlay');
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            if (pickNow) byId('importFile').click();   // still inside the user's click, so the browser allows it
        }

        closeImport() {
            const overlay = byId('importOverlay');
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
            this.importState = null;
        }

        setImportBtn(enabled, label) {
            const b = byId('importSubmitBtn');
            b.disabled = !enabled;
            b.querySelector('span').textContent = label || 'Import';
        }

        // Which entity does this header row belong to? (all required columns must be present)
        detectEntity(headers) {
            let best = null, bestScore = 0;
            Object.keys(IMPORTS).forEach(key => {
                const cols = IMPORTS[key].columns;
                const found = cols.filter(c => headers.some(h => c.aliases.includes(h)));
                const allRequired = cols.filter(c => c.required).every(c => headers.some(h => c.aliases.includes(h)));
                if (allRequired && found.length > bestScore) { best = key; bestScore = found.length; }
            });
            return best;
        }

        validateSheet(key, sheetName, rows, headers) {
            const cfg = IMPORTS[key];
            const idx = {};
            cfg.columns.forEach(c => { idx[c.key] = headers.findIndex(h => c.aliases.includes(h)); });

            const valid = [], invalid = [], seen = new Set();
            rows.slice(1).forEach((r, i) => {
                const obj = {}, problems = [];
                cfg.columns.forEach(c => {
                    const raw = idx[c.key] >= 0 ? r[idx[c.key]] : '';
                    let v = cellText(raw);
                    // Excel strips leading zeros from numeric shop orders, so restore them
                    if (key === 'shoporder' && c.key === 'ShopOrder' && typeof raw === 'number' && /^\d{1,11}$/.test(v)) {
                        v = v.padStart(12, '0');
                    }
                    if (v !== '' && c.normalize) v = c.normalize(v);
                    obj[c.key] = v;
                    if (c.required && v === '') problems.push(`${c.key} is empty`);
                    else if (v !== '' && c.maxLen && v.length > c.maxLen) problems.push(`${c.key} is longer than ${c.maxLen} characters`);
                    else if (v !== '' && c.validate) { const m = c.validate(v); if (m) problems.push(`${c.key} ${m}`); }
                });

                // duplicate rows inside the same sheet (same key the database uses)
                if (!problems.length) {
                    const dk = cfg.dupKey(obj);
                    if (seen.has(dk)) problems.push('duplicate in file'); else seen.add(dk);
                }

                const line = i + 2; // 1-based, header is line 1
                problems.length ? invalid.push({ line, obj, problems }) : valid.push(obj);
            });
            return { key, sheetName, total: rows.length - 1, valid, invalid, done: false };
        }

        async readFile(file) {
            const err = byId('importError');
            err.textContent = '';
            if (!sheetJsReady()) return;
            if (!/\.(xlsx|xls)$/i.test(file.name)) { err.textContent = 'Please choose an Excel file (.xlsx or .xls).'; return; }
            byId('importFileName').textContent = file.name;

            let wb;
            try {
                wb = XLSX.read(await file.arrayBuffer(), { type: 'array' });
            } catch (ex) {
                console.error(ex);
                err.textContent = 'Unable to read the file. Is it a valid Excel file?';
                return;
            }

            const datasets = [], skipped = [], problems = [];
            wb.SheetNames.forEach(name => {
                const rows = XLSX.utils.sheet_to_json(wb.Sheets[name], { header: 1, defval: '', raw: true, blankrows: false });
                if (!rows.length) return;
                const headers = rows[0].map(norm);

                // 1) match by sheet name (Cycle Time / Employee Codes / Shop Orders), 2) fall back to the column headers
                const byName = Object.keys(SHEET_NAMES).find(k => norm(SHEET_NAMES[k]) === norm(name));
                if (byName && !ACTIVE_IMPORTS.includes(byName)) return;   // disabled for now, ignore silently

                let key = byName;
                if (byName) {
                    const missing = IMPORTS[byName].columns
                        .filter(c => c.required && !headers.some(h => c.aliases.includes(h)))
                        .map(c => c.key);
                    if (missing.length) { problems.push(`${name}: missing column(s) ${missing.join(', ')}`); return; }
                } else {
                    key = this.detectEntity(headers);
                }
                if (key && !ACTIVE_IMPORTS.includes(key)) return;         // header-detected but disabled
                if (!key) { skipped.push(name); return; }
                if (rows.length < 2) { skipped.push(name + ' (no data rows)'); return; }
                datasets.push(this.validateSheet(key, name, rows, headers));
            });

            // always show the sheets in the same order: Cycle Time, Employee Codes, Shop Orders
            const order = Object.keys(IMPORTS);
            datasets.sort((a, b) => order.indexOf(a.key) - order.indexOf(b.key));

            const notes = [];
            if (problems.length) notes.push(problems.join('; '));
            const absent = order.filter(k => !datasets.some(d => d.key === k)).map(k => SHEET_NAMES[k]);
            if (datasets.length && absent.length) notes.push('Not in this file (nothing imported for): ' + absent.join(', '));
            if (skipped.length) notes.push('Skipped sheet(s): ' + skipped.join(', '));

            if (!datasets.length) {
                this.importState.datasets = [];
                byId('importSummary').hidden = true;
                byId('importTabs').hidden = true;
                byId('importPreviewWrap').hidden = true;
                this.setImportBtn(false);
                err.textContent = 'No importable sheet found. Use Download Template and keep the sheet names and column headers.'
                    + (notes.length ? ' ' + notes.join(' | ') : '');
                return;
            }

            this.importState.datasets = datasets;
            this.importState.active = 0;
            this.renderImportPreview();
            if (notes.length) err.textContent = notes.join(' | ');
        }

        switchDataset(i) {
            this.importState.active = i;
            this.renderImportPreview();
        }

        renderImportPreview() {
            const st = this.importState;
            const ds = st.datasets[st.active], cfg = IMPORTS[ds.key];
            const { valid, invalid, total } = ds;

            // tabs (only when more than one sheet was detected)
            const tabs = byId('importTabs');
            tabs.hidden = st.datasets.length < 2;
            tabs.innerHTML = st.datasets.map((d, i) =>
                `<button type="button" class="imp-chip ${i === st.active ? 'active' : ''}" data-tab="${i}">${this.esc(SHEET_NAMES[d.key])} (${d.valid.length})</button>`
            ).join('');
            tabs.querySelectorAll('[data-tab]').forEach(b => b.addEventListener('click', () => this.switchDataset(Number(b.dataset.tab))));

            const sum = byId('importSummary');
            sum.hidden = false;
            sum.innerHTML = `
                <span class="imp-chip"><i class="fa-solid fa-table"></i> ${this.esc(SHEET_NAMES[ds.key])}</span>
                <span class="imp-chip">${total} rows</span>
                <span class="imp-chip ok"><i class="fa-solid fa-check"></i> ${valid.length} valid</span>
                <span class="imp-chip ${invalid.length ? 'bad' : ''}"><i class="fa-solid fa-triangle-exclamation"></i> ${invalid.length} invalid</span>`;

            const cols = cfg.columns.map(c => c.key);
            byId('importHead').innerHTML = `<tr><th>Line</th>${cols.map(c => `<th>${c}</th>`).join('')}<th>Status</th></tr>`;

            const LIMIT = 100;
            const all = [
                ...invalid.map(x => ({ line: x.line, obj: x.obj, msg: x.problems.join('; '), bad: true })),
                ...valid.map(o => ({ line: '', obj: o, msg: 'OK', bad: false }))
            ].slice(0, LIMIT);

            byId('importBody').innerHTML = all.map(r => `
                <tr class="${r.bad ? 'imp-bad' : ''}">
                    <td>${r.line}</td>
                    ${cols.map(c => `<td>${this.esc(r.obj[c])}</td>`).join('')}
                    <td class="imp-msg">${this.esc(r.msg)}</td>
                </tr>`).join('');
            byId('importPreviewWrap').hidden = false;

            byId('importError').textContent = total > LIMIT ? `Preview shows the first ${LIMIT} rows (invalid rows first).` : '';

            const totalValid = st.datasets.reduce((n, d) => n + (d.done ? 0 : d.valid.length), 0);
            this.setImportBtn(totalValid > 0, totalValid ? `Import ${totalValid} row${totalValid > 1 ? 's' : ''}` : 'Import');
        }


        async submitImport() {
            const st = this.importState;
            if (!st || !st.datasets.length) return;

            const err = byId('importError');
            err.textContent = '';

            this.setImportBtn(false, 'Importing...');

            const report = [];
            const failed = [];

            try {
                for (const ds of st.datasets) {
                    if (ds.done || !ds.valid.length) continue;

                    const cfg = IMPORTS[ds.key];

                    let inserted = 0;
                    let updated = 0;
                    let skipped = 0;
                    let sent = 0;
                    let error = null;

                    console.log(`========== IMPORT: ${SHEET_NAMES[ds.key]} ==========`);

                    console.log('Total Valid Rows:', ds.valid.length);
                    console.log('Total Invalid Rows:', ds.invalid.length);

                    for (let i = 0; i < ds.valid.length; i += CHUNK) {

                        const rows = ds.valid
                            .slice(i, i + CHUNK)
                            .map(cfg.toPayload);

                        console.log(`[IMPORT] Chunk ${Math.floor(i / CHUNK) + 1}`);
                        console.log('[IMPORT] Rows:', rows.length);
                        console.log('[IMPORT] Payload:', rows);

                        let res;

                        try {
                            res = await postMethod(cfg.url, { rows });

                            console.log('[IMPORT] Server Response:', res);

                        } catch (ex) {
                            console.error('[IMPORT] Request Error:', ex);

                            res = {
                                Success: false,
                                Message: ex?.message || 'Request failed.'
                            };
                        }

                        if (!res?.Success) {
                            error = res?.Message || 'Import failed.';
                            console.error('[IMPORT] Failed:', error);
                            break;
                        }

                        const chunkInserted = Number(res.Inserted || 0);
                        const chunkUpdated = Number(res.Updated || 0);
                        const chunkSkipped = Number(res.MissingCount || 0);

                        inserted += chunkInserted;
                        updated += chunkUpdated;
                        skipped += chunkSkipped;

                        sent += rows.length;

                        console.log('[IMPORT] Chunk Summary:', {
                            Uploaded: rows.length,
                            Inserted: chunkInserted,
                            Updated: chunkUpdated,
                            Skipped: chunkSkipped
                        });
                    }

                    if (error) {
                        failed.push(
                            `${SHEET_NAMES[ds.key]}: ${error}` +
                            (sent ? ` (${sent} rows already saved)` : '')
                        );

                        continue;
                    }

                    // Mark sheet as successfully imported.
                    ds.done = true;

                    report.push(
                        `${SHEET_NAMES[ds.key]}: ` +
                        `Uploaded ${sent}, ` +
                        `Added ${inserted}, ` +
                        `Updated ${updated}, ` +
                        `Skipped ${skipped + ds.invalid.length}`
                    );

                    console.log('[IMPORT] SHEET COMPLETED:', {
                        Sheet: SHEET_NAMES[ds.key],
                        Uploaded: sent,
                        Inserted: inserted,
                        Updated: updated,
                        Skipped: skipped + ds.invalid.length
                    });
                }

                // Refresh successfully imported sheets.
                const doneKeys = [
                    ...new Set(
                        st.datasets
                            .filter(d => d.done)
                            .map(d => d.key)
                    )
                ];

                for (const k of doneKeys) {
                    if (this.loaded[k]) {
                        await this.load(k);
                    }
                }

                if (!failed.length) {
                    alert(
                        'Import complete.\n\n' +
                        (report.join('\n') || 'No pending records.')
                    );

                    this.closeImport();
                    return;
                }

                if (report.length) {
                    alert(
                        'Imported:\n' +
                        report.join('\n') +
                        '\n\nFailed:\n' +
                        failed.join('\n')
                    );
                }

                this.renderImportPreview();

                err.textContent = failed.join(' | ');

                this.setImportBtn(true, 'Retry failed sheets');

            } catch (ex) {
                console.error('[IMPORT] Unexpected error:', ex);

                err.textContent =
                    'Unexpected error while importing: ' + ex.message;

                this.setImportBtn(true, 'Retry');
            }
        }


        // inside the class
        getId(entity, row) {
            const want = ENTITIES[entity].idKey.toLowerCase();
            const k = Object.keys(row).find(p => p.toLowerCase() === want);
            return k ? row[k] : undefined;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        window.dataMgmt = new DataManagementController();   // data loads the first time the workspace opens
    });
    </script>
</body>
</html>

